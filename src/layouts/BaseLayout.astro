---
import '../styles/global.css';


export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "WorldMarket — Pay with USD or lock tokens to get competitive account plans and AI credentials.",
  ogImage = "/images/worldclaw_hero_core.png",
} = Astro.props;

const siteName = "WorldMarket";
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300..800&family=Plus+Jakarta+Sans:wght@300..800&display=swap" rel="stylesheet">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://comfyatlas.com" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4RBFJ76E2B"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4RBFJ76E2B');
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-black text-[#F8FAFC] selection:bg-[#E7AC08]/30 selection:text-white">
    <slot />
  </body>
</html>
