---
import { SITE, t, localizedPath, type Locale } from '../lib/i18n';

export interface Crumb {
  label: string;
  href?: string; // omit on the last/current item
}

export interface Props {
  locale: Locale;
  trail: Crumb[];
}

const { locale, trail } = Astro.props;

// Always prepend Home
const home = { label: t(locale, 'nav.home'), href: localizedPath(locale, '/') };
const items = [home, ...trail];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, SITE.url).toString() } : {}),
  })),
};
---
<nav aria-label="Breadcrumb" class="not-prose text-xs text-ink-500 mb-6">
  <ol class="flex flex-wrap items-center gap-1">
    {items.map((c, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <span class="text-ink-300" aria-hidden="true">/</span>}
        {c.href ? (
          <a href={c.href} class="hover:text-ink-900 transition">{c.label}</a>
        ) : (
          <span class="text-ink-700" aria-current="page">{c.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
