---
---
<div id="cart-overlay" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300">
  <div 
    id="cart-drawer" 
    class="absolute right-0 top-0 h-full w-full max-w-md bg-[#0B0F1A]/95 border-l border-[#38BDF8]/20 shadow-2xl p-6 sm:p-8 flex flex-col translate-x-full transition-transform duration-300 ease-out backdrop-blur-xl"
  >
    <!-- Header -->
    <div class="flex items-center justify-between pb-5 border-b border-white/10 mb-6">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <h3 class="font-outfit text-xl font-extrabold text-white">已选商品清单</h3>
      </div>
      <button 
        id="cart-close" 
        type="button" 
        class="p-1.5 rounded-full border border-white/10 hover:border-[#38BDF8]/40 text-slate-400 hover:text-white transition-colors cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- 商品列表 -->
    <div id="cart-items-container" class="flex-grow overflow-y-auto space-y-4 pr-1">
      <p class="text-slate-500 text-center py-16 text-xs">清单目前为空，请在商品库中选购。</p>
    </div>

    <!-- 结算区 -->
    <div class="pt-5 border-t border-white/10 mt-6">
      <div class="flex items-center justify-between text-slate-400 text-xs mb-2">
        <span>交付方式</span>
        <span class="text-[#38BDF8] font-bold font-mono tracking-wider">自动秒发 / 零运费</span>
      </div>
      <div class="flex items-center justify-between text-white text-base font-bold mb-6">
        <span>合计估算</span>
        <span id="cart-total" class="font-mono text-xl text-[#38BDF8] font-black drop-shadow-[0_0_8px_rgba(56,189,248,0.4)]">$0.00</span>
      </div>
      
      <button 
        id="checkout-btn" 
        type="button" 
        disabled
        class="w-full py-3.5 rounded-xl bg-gradient-to-r from-[#0284C7] to-[#38BDF8] text-white font-extrabold text-xs tracking-wider uppercase transition-all duration-300 disabled:opacity-30 disabled:pointer-events-none hover:brightness-110 active:scale-98 shadow-[0_0_20px_rgba(56,189,248,0.35)] flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>前往收银台安全结算</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  let cart: any[] = [];

  function getCurrencyMode(): 'cny' | 'usd' {
    const lang = localStorage.getItem('active_language') || 'en';
    return ['zh-CN', 'zh-TW', 'ja', 'ko'].includes(lang) ? 'cny' : 'usd';
  }

  const overlay = document.getElementById('cart-overlay');
  const drawer = document.getElementById('cart-drawer');
  const closeBtn = document.getElementById('cart-close');
  const itemsContainer = document.getElementById('cart-items-container');
  const totalEl = document.getElementById('cart-total');
  const checkoutBtn = document.getElementById('checkout-btn') as HTMLButtonElement;

  window.addEventListener('open-cart', () => openCart());
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeCart();
  });
  closeBtn?.addEventListener('click', closeCart);
  checkoutBtn?.addEventListener('click', () => {
    window.location.href = '/checkout';
  });

  function openCart() {
    loadCart();
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    drawer?.classList.remove('translate-x-full');
  }

  function closeCart() {
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    drawer?.classList.add('translate-x-full');
  }

  function loadCart() {
    try {
      cart = JSON.parse(localStorage.getItem('cart') || '[]');
    } catch {
      cart = [];
    }
    renderCart();
  }

  function renderCart() {
    if (!itemsContainer || !totalEl || !checkoutBtn) return;
    const currency = getCurrencyMode();

    if (cart.length === 0) {
      itemsContainer.innerHTML = `<p class="text-slate-500 text-center py-16 text-xs">清单目前为空，请在商品库中选购。</p>`;
      totalEl.textContent = currency === 'cny' ? '¥0.00' : '$0.00';
      checkoutBtn.disabled = true;
      return;
    }

    checkoutBtn.disabled = false;
    let total = 0;

    itemsContainer.innerHTML = cart.map((item, index) => {
      const price = currency === 'cny' ? (item.priceCny || item.price * 7.1) : item.price;
      const itemSubtotal = price * item.quantity;
      total += itemSubtotal;
      const formattedPrice = currency === 'cny' ? `¥${itemSubtotal.toFixed(2)}` : `$${itemSubtotal.toFixed(2)}`;

      return `
        <div class="flex items-center justify-between p-3 rounded-2xl bg-[#06080F]/70 border border-[#38BDF8]/20 text-xs">
          <div class="flex items-center gap-3 min-w-0 flex-1">
            <img src="${item.image || '/images/default_product.jpg'}" onerror="this.src='/images/default_product.jpg'" class="w-10 h-10 rounded-xl object-cover bg-black/50 border border-white/10 shrink-0" />
            <div class="min-w-0 flex-1 pr-2">
              <h4 class="font-bold text-white truncate">${item.name}</h4>
              <span class="text-[10px] text-slate-400 block mt-0.5">${item.size ? `规格: ${item.size} | ` : ''}数量: ${item.quantity}</span>
            </div>
          </div>
          <div class="flex flex-col items-end gap-1 shrink-0">
            <span class="font-bold font-mono text-[#38BDF8]">${formattedPrice}</span>
            <button type="button" onclick="window.removeCartItem(${index})" class="text-[10px] text-rose-400 hover:text-rose-300">移除</button>
          </div>
        </div>
      `;
    }).join('');

    totalEl.textContent = currency === 'cny' ? `¥${total.toFixed(2)}` : `$${total.toFixed(2)}`;
  }

  (window as any).removeCartItem = function(index: number) {
    cart.splice(index, 1);
    localStorage.setItem('cart', JSON.stringify(cart));
    renderCart();
  };
</script>
