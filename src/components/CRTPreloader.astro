<!-- Cozy Puppy Chibi Preloader Overlay Wrapper -->
<div 
  id="crt-preloader-wrapper" 
  class="fixed inset-0 z-50 bg-black flex items-center justify-center font-sora select-none transition-opacity duration-500 ease-out"
>
  <!-- Chibi Box Container -->
  <div 
    id="crt-monitor" 
    class="glass-card max-w-md w-11/12 p-8 text-center bg-[#171412]/90 border border-[#292929] shadow-[0_12px_35px_rgba(0,0,0,0.9)] flex flex-col justify-between items-center relative gap-6 backdrop-blur-md"
  >
    <!-- Bouncing puppy loader mascot -->
    <div class="relative w-32 h-32 select-none animate-chibi-standby">
      <div class="absolute inset-0 bg-[#E7AC08]/10 rounded-full -z-10 border border-[#FAC514]/30 shadow-[0_0_20px_rgba(231,172,8,0.15)]"></div>
      <img 
        src="/images/chibi_puppy_hero.png" 
        alt="Loading Mascot" 
        class="w-full h-full object-cover rounded-full p-2"
        draggable="false"
      />
    </div>

    <!-- Main Loading Log Info -->
    <div class="w-full space-y-4 text-center">
      <h3 class="text-lg font-semibold text-white font-sora">🐶 퍼피숍 준비 중... 🐾</h3>
      
      <!-- Terminal Log Text -->
      <div id="crt-terminal-log" class="text-xs text-white/60 font-medium min-h-[32px] max-w-xs mx-auto leading-relaxed font-mono">
        <!-- Text typed dynamically -->
      </div>

      <!-- Loading Bar -->
      <div class="space-y-2 pt-2 border-t border-[#292929]">
        <div class="flex items-center justify-between text-xs font-semibold text-white/80 font-sora">
          <span>로딩 상태</span>
          <span id="crt-progress-percentage" class="text-[#FAC514]">0%</span>
        </div>
        <!-- Progress Bar Container -->
        <div class="w-full h-4 border border-[#292929] bg-black/40 p-0.5 rounded-full overflow-hidden">
          <div 
            id="crt-progress-fill" 
            class="h-full bg-gradient-to-r from-[#E7AC08] to-[#FAC514] border-r border-[#FAC514] rounded-full w-0 transition-all duration-100 ease-out"
          ></div>
        </div>
      </div>

    </div>

    <!-- Footer Action -->
    <div class="w-full flex items-center justify-between text-[10px] font-bold text-white/50 border-t border-[#292929] pt-4 font-sora">
      <span>상태: 매우 사랑스러움 🧁</span>
      <button 
        id="crt-skip-btn" 
        type="button" 
        class="px-4 py-1.5 border border-white/10 hover:bg-white/5 bg-transparent text-white/80 rounded-full font-sora text-xs font-semibold transition-all duration-200 active:scale-95"
      >
        건너뛰기 🐾
      </button>
    </div>

  </div>
</div>

<script>
  const logLines = [
    "🐾 퍼피 OS 시작 중...",
    "🐶 보안 도메인 연결 완료",
    "✨ 사랑스러운 분위기 충전 중...",
    "🍰 디지털 계정 금고 준비 완료!",
    "🧁 달콤한 쿠키 준비 중...",
    "🐾 준비 완료! 행복한 시간 되세요!"
  ];

  const wrapper = document.getElementById('crt-preloader-wrapper');
  const monitor = document.getElementById('crt-monitor');
  const terminalLog = document.getElementById('crt-terminal-log');
  const progressPercent = document.getElementById('crt-progress-percentage');
  const progressFill = document.getElementById('crt-progress-fill');
  const skipBtn = document.getElementById('crt-skip-btn');

  function initPreloader() {
    const hasPlayed = sessionStorage.getItem('crt_loader_played');
    if (hasPlayed === 'true') {
      if (wrapper) wrapper.style.display = 'none';
      return;
    }

    document.body.style.overflow = 'hidden';
    startTerminalTyping();

    skipBtn?.addEventListener('click', () => {
      triggerFadeOut();
    });
  }

  async function startTerminalTyping() {
    if (!terminalLog || !progressPercent || !progressFill) return;

    let lineIndex = 0;
    
    for (const line of logLines) {
      terminalLog.textContent = '';
      
      for (let i = 0; i < line.length; i++) {
        terminalLog.textContent += line[i];
        await delay(Math.random() * 10 + 5);
      }
      
      await delay(200);

      const targetProgress = Math.floor(((lineIndex + 1) / logLines.length) * 80);
      await updateProgress(targetProgress);

      lineIndex++;
    }

    await updateProgress(100);
    await delay(300);

    triggerFadeOut();
  }

  function updateProgress(percentage) {
    return new Promise((resolve) => {
      let currentWidth = parseFloat(progressFill?.style.width || '0');
      const step = () => {
        if (currentWidth < percentage) {
          currentWidth += 2;
          if (progressFill) progressFill.style.width = currentWidth + '%';
          if (progressPercent) progressPercent.textContent = Math.floor(currentWidth) + '%';
          requestAnimationFrame(step);
        } else {
          resolve(true);
        }
      };
      step();
    });
  }

  function triggerFadeOut() {
    if (!wrapper) return;
    
    wrapper.style.opacity = '0';

    setTimeout(() => {
      wrapper.style.display = 'none';
      document.body.style.overflow = '';
      sessionStorage.setItem('crt_loader_played', 'true');
    }, 500);
  }

  function delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  initPreloader();
</script>
