<!-- Cozy Puppy Chibi Preloader Overlay Wrapper -->
<div 
  id="crt-preloader-wrapper" 
  class="fixed inset-0 z-50 bg-[#FFFDFB] flex items-center justify-center font-quicksand select-none transition-opacity duration-500 ease-out"
>
  <!-- Chibi Box Container -->
  <div 
    id="crt-monitor" 
    class="glass-card max-w-md w-11/12 p-8 text-center bg-white flex flex-col justify-between items-center relative gap-6"
  >
    <!-- Bouncing puppy loader mascot -->
    <div class="relative w-32 h-32 select-none animate-cute-bounce">
      <div class="absolute inset-0 bg-[#FFD6E0] rounded-full -z-10 border-2 border-[#3E2A1E] shadow-[2px_2px_0px_#3E2A1E]"></div>
      <img 
        src="/images/chibi_puppy_hero.png" 
        alt="Loading Mascot" 
        class="w-full h-full object-cover rounded-full p-2"
        draggable="false"
      />
    </div>

    <!-- Main Loading Log Info -->
    <div class="w-full space-y-4 text-center">
      <h3 class="text-xl font-bold text-[#3E2A1E] font-fredoka">🐶 퍼피숍 준비 중... 🐾</h3>
      
      <!-- Terminal Log Text -->
      <div id="crt-terminal-log" class="text-xs text-[#6D5A50] font-bold min-h-[32px] max-w-xs mx-auto leading-relaxed">
        <!-- Text typed dynamically -->
      </div>

      <!-- Loading Bar -->
      <div class="space-y-2 pt-2 border-t-2 border-[#E8E1D9]">
        <div class="flex items-center justify-between text-xs font-bold text-[#3E2A1E] font-fredoka">
          <span>로딩 상태</span>
          <span id="crt-progress-percentage">0%</span>
        </div>
        <!-- Progress Bar Container -->
        <div class="w-full h-5 border-2 border-[#3E2A1E] bg-[#FFFDF9] p-0.5 rounded-full overflow-hidden shadow-[2px_2px_0px_#3E2A1E]">
          <div 
            id="crt-progress-fill" 
            class="h-full bg-[#FF9EAF] border-r-2 border-[#3E2A1E] rounded-full w-0 transition-all duration-100 ease-out"
          ></div>
        </div>
      </div>

    </div>

    <!-- Footer Action -->
    <div class="w-full flex items-center justify-between text-[10px] font-bold text-[#6D5A50] border-t-2 border-[#E8E1D9] pt-4 font-quicksand">
      <span>상태: 매우 사랑스러움 🧁</span>
      <button 
        id="crt-skip-btn" 
        type="button" 
        class="px-4 py-2 border-2 border-[#3E2A1E] bg-[#FFD6E0] hover:bg-[#FFB3C6] text-[#3E2A1E] rounded-xl font-fredoka text-xs font-bold transition-all duration-200 active:scale-95 shadow-[2px_2px_0px_#3E2A1E]"
      >
        건너뛰기 🐾
      </button>
    </div>

  </div>
</div>

<script>
  const logLines = [
    "🐾 퍼피 OS 시작 중...",
    "🐶 보안 도메인 연결 완료",
    "✨ 사랑스러운 분위기 충전 중...",
    "🍰 디지털 계정 금고 준비 완료!",
    "🧁 달콤한 쿠키 준비 중...",
    "🐾 준비 완료! 행복한 시간 되세요!"
  ];

  const wrapper = document.getElementById('crt-preloader-wrapper');
  const monitor = document.getElementById('crt-monitor');
  const terminalLog = document.getElementById('crt-terminal-log');
  const progressPercent = document.getElementById('crt-progress-percentage');
  const progressFill = document.getElementById('crt-progress-fill');
  const skipBtn = document.getElementById('crt-skip-btn');

  function initPreloader() {
    const hasPlayed = sessionStorage.getItem('crt_loader_played');
    if (hasPlayed === 'true') {
      if (wrapper) wrapper.style.display = 'none';
      return;
    }

    document.body.style.overflow = 'hidden';
    startTerminalTyping();

    skipBtn?.addEventListener('click', () => {
      triggerFadeOut();
    });
  }

  async function startTerminalTyping() {
    if (!terminalLog || !progressPercent || !progressFill) return;

    let lineIndex = 0;
    
    for (const line of logLines) {
      terminalLog.textContent = '';
      
      for (let i = 0; i < line.length; i++) {
        terminalLog.textContent += line[i];
        await delay(Math.random() * 10 + 5);
      }
      
      await delay(200);

      const targetProgress = Math.floor(((lineIndex + 1) / logLines.length) * 80);
      await updateProgress(targetProgress);

      lineIndex++;
    }

    await updateProgress(100);
    await delay(300);

    triggerFadeOut();
  }

  function updateProgress(percentage) {
    return new Promise((resolve) => {
      let currentWidth = parseFloat(progressFill?.style.width || '0');
      const step = () => {
        if (currentWidth < percentage) {
          currentWidth += 2;
          if (progressFill) progressFill.style.width = currentWidth + '%';
          if (progressPercent) progressPercent.textContent = Math.floor(currentWidth) + '%';
          requestAnimationFrame(step);
        } else {
          resolve(true);
        }
      };
      step();
    });
  }

  function triggerFadeOut() {
    if (!wrapper) return;
    
    wrapper.style.opacity = '0';

    setTimeout(() => {
      wrapper.style.display = 'none';
      document.body.style.overflow = '';
      sessionStorage.setItem('crt_loader_played', 'true');
    }, 500);
  }

  function delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  initPreloader();
</script>
