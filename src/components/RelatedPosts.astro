---
import { localizedPath, t, type Locale } from '../lib/i18n';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  current: CollectionEntry<'blog'>;
  all: CollectionEntry<'blog'>[];
  locale: Locale;
}

const { current, all, locale } = Astro.props;

// score by shared tags, then by recency. exclude the current post.
const candidates = all.filter((p) => p.id !== current.id);
const currentTags = new Set(current.data.tags ?? []);

const scored = candidates.map((p) => {
  const shared = (p.data.tags ?? []).filter((t) => currentTags.has(t)).length;
  return { post: p, shared };
});

scored.sort((a, b) => {
  if (b.shared !== a.shared) return b.shared - a.shared;
  return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
});

const related = scored.slice(0, 3).map((s) => s.post);

// strip zh/ prefix when building zh slugs (mirrors [slug].astro logic)
const slugFor = (id: string) => (locale === 'zh' ? id.replace(/^zh\//, '') : id);

const heading = locale === 'zh' ? '相关教程' : 'Related guides';
---
{related.length > 0 && (
  <aside class="not-prose mt-16 pt-8 border-t border-ink-100">
    <h2 class="text-sm font-semibold tracking-wide uppercase text-ink-500 mb-5">{heading}</h2>
    <ul class="grid sm:grid-cols-3 gap-5">
      {related.map((post) => (
        <li>
          <a href={localizedPath(locale, `/blog/${slugFor(post.id)}/`)} class="block group">
            <h3 class="text-base font-semibold text-ink-900 group-hover:text-accent transition leading-snug">
              {post.data.title}
            </h3>
            <p class="mt-2 text-sm text-ink-600 line-clamp-2">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}
