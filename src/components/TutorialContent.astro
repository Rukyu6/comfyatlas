---
interface Tutorial {
  id: string;
  name: string;
  parent_name: string;
  emoji: string;
  content_html: string;
}

interface Props {
  tutorials: Tutorial[];
  activeId: string;
}

const { tutorials, activeId } = Astro.props;
---

<div class="glass-content-viewer flex-grow rounded-3xl border border-[#3E2A1E]/10 bg-white/50 backdrop-blur-md shadow-sm p-6 md:p-10 min-h-[500px] relative overflow-hidden transition-all duration-300">
  <!-- Decorative Background Glow -->
  <div class="absolute -right-20 -top-20 w-60 h-60 rounded-full bg-gradient-to-tr from-[#FFD6E0]/20 to-[#FFB3C6]/20 blur-3xl pointer-events-none"></div>
  
  <!-- Cute Viewer Badge -->
  <div class="absolute top-0 left-8 bg-gradient-to-r from-[#FFD6E0] to-[#FFB3C6] border border-[#FF6B8B]/30 text-[10px] font-fredoka font-bold text-[#3E2A1E] px-3.5 py-1 rounded-b-xl shadow-sm tracking-wider uppercase select-none">
    Guide Viewer 🐾
  </div>

  <div id="tutorial-content-viewport" class="tutorial-viewer-content select-text pt-4 relative z-10">
    {tutorials.map((tut) => {
      const isActive = tut.id === activeId;
      return (
        <article
          id={`tutorial-pane-${tut.id}`}
          class={`tutorial-pane ${isActive ? "active-pane animate-fade-in" : "hidden"} space-y-6`}
        >
          <!-- Article Header -->
          <div class="border-b border-[#3E2A1E]/10 pb-5 mb-6">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#FF6B8B] font-quicksand bg-[#FFD6E0]/30 px-3 py-1 rounded-full border border-[#FF6B8B]/20 mb-3 inline-block select-none">
              {tut.parent_name}
            </span>
            <h1 class="text-2xl md:text-3xl font-black font-fredoka text-[#3E2A1E] tracking-wide mt-1 flex items-center gap-2">
              {tut.emoji && <span class="select-none scale-105">{tut.emoji}</span>}
              <span>{tut.name}</span>
            </h1>
          </div>

          <!-- HTML Content Body -->
          <div class="prose max-w-none text-[#3E2A1E] font-sans text-sm leading-relaxed" set:html={tut.content_html} />
        </article>
      );
    })}
  </div>
</div>

<style is:global>
  /* Base transitions */
  .tutorial-pane {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .tutorial-pane.hidden {
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
  }
  .tutorial-pane.active-pane {
    opacity: 1;
    transform: translateY(0);
  }

  /* Fade-in Animation */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in {
    animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Premium Content Styles */
  .tutorial-viewer-content h1 {
    font-size: 1.4rem !important;
    font-weight: 800 !important;
    color: #3E2A1E !important;
    margin-top: 2rem !important;
    margin-bottom: 1rem !important;
    font-family: 'Fredoka', sans-serif !important;
    border-left: 4px solid #FF6B8B;
    padding-left: 0.75rem;
  }
  
  .tutorial-viewer-content h2 {
    font-size: 1.2rem !important;
    font-weight: 800 !important;
    color: #3E2A1E !important;
    margin-top: 1.75rem !important;
    margin-bottom: 0.75rem !important;
    font-family: 'Fredoka', sans-serif !important;
  }

  .tutorial-viewer-content h3 {
    font-size: 1.05rem !important;
    font-weight: 700 !important;
    color: #3E2A1E !important;
    margin-top: 1.5rem !important;
    margin-bottom: 0.5rem !important;
    font-family: 'Fredoka', sans-serif !important;
  }

  .tutorial-viewer-content p {
    margin-bottom: 1rem !important;
    font-family: 'Quicksand', sans-serif;
    font-weight: 500;
    color: #6D5A50;
    line-height: 1.75;
  }

  .tutorial-viewer-content p strong {
    color: #3E2A1E;
    font-weight: 700;
  }

  .tutorial-viewer-content ul.bullet-list {
    list-style-type: disc !important;
    padding-left: 1.5rem !important;
    margin-bottom: 1.25rem !important;
    font-family: 'Quicksand', sans-serif;
    font-weight: 500;
    color: #6D5A50;
  }

  .tutorial-viewer-content ol.ordered-list {
    list-style-type: decimal !important;
    padding-left: 1.5rem !important;
    margin-bottom: 1.25rem !important;
    font-family: 'Quicksand', sans-serif;
    font-weight: 500;
    color: #6D5A50;
  }

  .tutorial-viewer-content li {
    margin-bottom: 0.5rem !important;
  }

  .tutorial-viewer-content li p {
    margin-bottom: 0px !important;
    display: inline;
  }

  .tutorial-viewer-content a {
    color: #FF6B8B !important;
    font-weight: 700;
    text-decoration: underline !important;
    transition: all 0.2s ease;
  }

  .tutorial-viewer-content a:hover {
    color: #FF8CA3 !important;
    opacity: 0.9;
  }

  .tutorial-viewer-content code {
    background-color: rgba(62, 42, 30, 0.05) !important;
    border: 1px solid rgba(62, 42, 30, 0.1) !important;
    color: #FF6B8B !important;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
    padding: 0.15rem 0.35rem !important;
    border-radius: 0.375rem !important;
    font-size: 0.85em !important;
  }

  .tutorial-viewer-content img {
    border: 1px solid rgba(62, 42, 30, 0.1) !important;
    border-radius: 1.5rem !important;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05) !important;
    max-width: 100% !important;
    height: auto !important;
    margin: 2rem auto !important;
    display: block !important;
    transition: transform 0.3s ease;
  }
  
  .tutorial-viewer-content img:hover {
    transform: scale(1.01);
  }

  .tutorial-viewer-content hr.custom-horizontal-rule {
    border: none !important;
    border-top: 1px dashed rgba(62, 42, 30, 0.15) !important;
    margin: 2rem 0 !important;
  }

  .tutorial-viewer-content details.cq-details {
    border: 1px solid rgba(62, 42, 30, 0.1);
    border-radius: 1rem;
    padding: 0.75rem 1rem;
    background-color: rgba(62, 42, 30, 0.02);
    margin-bottom: 1.5rem;
  }

  .tutorial-viewer-content details.cq-details summary {
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    color: #3E2A1E;
    cursor: pointer;
    user-select: none;
    outline: none;
  }
</style>
