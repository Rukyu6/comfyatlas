---
import { type Locale } from '../lib/i18n';

export interface Props {
  file: string; // e.g. "first-workflow.json"
  title: string;
  note?: string;
  locale: Locale;
}

const { file, title, note, locale } = Astro.props;
const labels = locale === 'zh'
  ? { heading: '可下载工作流', download: '下载', desc: '把 .json 文件拖到 ComfyUI 画布上即可加载。CC0 公有领域,随便用。' }
  : { heading: 'Free workflow download', download: 'Download', desc: 'Drag the .json file onto your ComfyUI canvas to load it. CC0 public domain — use however you like.' };

const url = `/workflows/${file}`;
---
<aside class="not-prose my-8 p-5 rounded-lg border border-accent/30 bg-accent/5">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
    <div class="flex-1 min-w-0">
      <p class="text-xs font-semibold tracking-wide uppercase text-accent mb-1">{labels.heading}</p>
      <p class="font-semibold text-ink-900">{title}</p>
      {note && <p class="mt-1 text-sm text-ink-600">{note}</p>}
      <p class="mt-2 text-xs text-ink-500">{labels.desc}</p>
    </div>
    <a
      href={url}
      download
      class="shrink-0 inline-flex items-center gap-2 bg-accent text-white px-4 py-2 rounded-lg font-medium hover:bg-accent-dark transition text-sm"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      {labels.download} {file}
    </a>
  </div>
</aside>
