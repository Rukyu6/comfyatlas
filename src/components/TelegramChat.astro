---
// Telegram Support Chat Widget Component
const botUsername = import.meta.env.PUBLIC_TELEGRAM_BOT_USERNAME || 'PuppyShop_Support_Bot';
const telegramLink = `https://t.me/${botUsername}`;
---

<!-- Fixed Container -->
<div class="fixed bottom-6 right-6 z-50 select-none font-sans">
  
  <!-- Chat Popup Window -->
  <div 
    id="telegram-chat-window" 
    class="hidden opacity-0 scale-95 origin-bottom-right transition-all duration-300 w-80 sm:w-96 rounded-2xl glass-card border border-white/10 shadow-2xl overflow-hidden mb-4"
  >
    <!-- Header -->
    <div class="bg-gradient-to-r from-sky-600 to-blue-500 p-4 text-white flex items-center justify-between">
      <div class="flex items-center gap-3">
        <!-- Bot Avatar indicator -->
        <div class="relative">
          <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center font-bold text-sm border border-white/20">
            🐶
          </div>
          <!-- Online status dot -->
          <span class="absolute bottom-0 right-0 w-3 h-3 bg-emerald-400 border-2 border-blue-500 rounded-full"></span>
        </div>
        <div class="text-left">
          <h4 class="text-xs font-bold font-outfit uppercase tracking-wider">Puppy Support Bot</h4>
          <span class="text-[9px] text-sky-100 flex items-center gap-1 font-semibold">
            ● ONLINE SUPPORT
          </span>
        </div>
      </div>
      <!-- Close trigger -->
      <button 
        type="button" 
        id="telegram-close-btn" 
        class="text-sky-100 hover:text-white hover:bg-white/10 p-1.5 rounded-full transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Message Body -->
    <div class="p-4 space-y-4 max-h-[250px] overflow-y-auto bg-black/60">
      
      <!-- Bot welcome bubble -->
      <div class="flex items-start gap-2.5 max-w-[85%] text-left">
        <div class="w-6 h-6 rounded-full bg-zinc-800 flex items-center justify-center text-xs shrink-0 select-none">🤖</div>
        <div class="bg-zinc-900 border border-white/5 rounded-2xl rounded-tl-none p-3 text-[11px] text-zinc-300 leading-relaxed font-light">
          Hello! Welcome to <strong>Puppy Shop</strong> support. 👋
          <br/><br/>
          I can instantly decrypt your digital card keys, verify your bank wire transfer, or help you track shipping coordinates.
        </div>
      </div>

      <!-- Instruction bubble -->
      <div class="flex items-start gap-2.5 max-w-[85%] text-left">
        <div class="w-6 h-6 rounded-full bg-zinc-800 flex items-center justify-center text-xs shrink-0 select-none">🤖</div>
        <div class="bg-zinc-900 border border-white/5 rounded-2xl rounded-tl-none p-3 text-[11px] text-zinc-300 leading-relaxed font-light">
          Type your inquiry below or tap <strong>"Start Chat"</strong> to open Telegram.
        </div>
      </div>

    </div>

    <!-- Input Area -->
    <div class="p-3 bg-zinc-950 border-t border-white/5 text-left space-y-2">
      <!-- Decorative Input -->
      <div class="relative">
        <textarea 
          id="telegram-chat-input"
          placeholder="Describe your issue (e.g., Verify Order ord_8372)..."
          rows="2"
          class="w-full bg-black/40 border border-zinc-800 rounded-xl pl-3 pr-10 py-2.5 text-[11px] text-white placeholder-zinc-600 focus:outline-none focus:border-sky-500/50 transition-all duration-300 resize-none font-sans"
        ></textarea>
        <button 
          type="button" 
          id="telegram-send-btn"
          class="absolute right-2.5 bottom-3.5 text-sky-400 hover:text-white p-1 rounded-lg hover:bg-sky-500/10 active:scale-95 transition"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 transform rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </button>
      </div>

      <!-- Action Button -->
      <a 
        href={telegramLink}
        target="_blank"
        rel="noopener noreferrer"
        id="telegram-direct-btn"
        class="w-full py-2.5 bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold rounded-xl text-[10px] font-outfit uppercase tracking-wider transition duration-300 flex items-center justify-center gap-2 shadow-[0_0_15px_rgba(56,189,248,0.25)] hover:scale-[1.01] decoration-none"
      >
        <!-- Mini Telegram Icon -->
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2C6.48 2 2 6.48 2 12c0 5.52 4.48 10 10 10s10-4.48 10-10c0-5.52-4.48-10-10-10zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.2-.08-.06-.19-.04-.27-.02-.12.02-1.96 1.25-5.54 3.69-.52.36-1 .53-1.42.52-.47-.01-1.37-.27-2.03-.49-.82-.27-1.47-.42-1.42-.88.03-.24.36-.49.99-.74 3.89-1.69 6.48-2.8 7.78-3.33 3.69-1.52 4.45-1.78 4.95-1.79.11 0 .36.03.52.16.13.11.17.27.19.38.02.13.02.38-.01.52z"/>
        </svg>
        Start Chat on Telegram
      </a>
    </div>

  </div>

  <!-- Pulse Floating Circle Button -->
  <button 
    id="telegram-widget-trigger" 
    type="button" 
    class="relative w-14 h-14 rounded-full bg-gradient-to-tr from-sky-500 via-sky-600 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white shadow-2xl flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95 group"
  >
    <!-- Background pulse indicator -->
    <span class="absolute -inset-1.5 bg-sky-500/25 rounded-full filter blur-md animate-ping opacity-60 pointer-events-none"></span>

    <!-- Message count indicator -->
    <span class="absolute -top-0.5 -right-0.5 w-4 h-4 rounded-full bg-red-500 text-[9px] font-black text-white flex items-center justify-center shadow-md animate-bounce">
      1
    </span>

    <!-- TG Icon SVG -->
    <svg class="h-6 w-6 transform group-hover:rotate-12 transition-transform duration-300" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2C6.48 2 2 6.48 2 12c0 5.52 4.48 10 10 10s10-4.48 10-10c0-5.52-4.48-10-10-10zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.2-.08-.06-.19-.04-.27-.02-.12.02-1.96 1.25-5.54 3.69-.52.36-1 .53-1.42.52-.47-.01-1.37-.27-2.03-.49-.82-.27-1.47-.42-1.42-.88.03-.24.36-.49.99-.74 3.89-1.69 6.48-2.8 7.78-3.33 3.69-1.52 4.45-1.78 4.95-1.79.11 0 .36.03.52.16.13.11.17.27.19.38.02.13.02.38-.01.52z"/>
    </svg>
  </button>
</div>

<script define:vars={{ telegramLink }}>
  const trigger = document.getElementById('telegram-widget-trigger');
  const windowBox = document.getElementById('telegram-chat-window');
  const closeBtn = document.getElementById('telegram-close-btn');
  const sendBtn = document.getElementById('telegram-send-btn');
  const textarea = document.getElementById('telegram-chat-input');

  function toggleWidget() {
    if (windowBox.classList.contains('hidden')) {
      // Open
      windowBox.classList.remove('hidden');
      setTimeout(() => {
        windowBox.classList.remove('opacity-0', 'scale-95');
      }, 50);
    } else {
      // Close
      windowBox.classList.add('opacity-0', 'scale-95');
      setTimeout(() => {
        windowBox.classList.add('hidden');
      }, 300);
    }
  }

  function handleSend() {
    const text = textarea.value.trim();
    if (!text) return;
    
    // Construct Telegram deep-link with start parameters
    // Format: https://t.me/botname?start=base64Text or simple text query
    const encodedText = encodeURIComponent(text);
    const deepLink = `${telegramLink}?start=${encodedText}`;

    // Clear textarea
    textarea.value = '';

    // Open link in a new tab
    window.open(deepLink, '_blank');
  }

  // Event handlers
  trigger?.addEventListener('click', toggleWidget);
  closeBtn?.addEventListener('click', toggleWidget);

  sendBtn?.addEventListener('click', handleSend);
  textarea?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSend();
    }
  });
</script>
