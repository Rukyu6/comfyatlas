---
const telegramLink = 'https://t.me/puppyshop2Bot';
---
<div class="fixed bottom-6 right-6 z-50 select-none font-outfit">
  
  <!-- 聊天弹窗窗口 -->
  <div 
    id="telegram-chat-window" 
    class="hidden opacity-0 scale-95 origin-bottom-right transition-all duration-300 w-84 sm:w-96 rounded-3xl bg-[#0B0F1A]/95 border border-[#38BDF8]/30 shadow-[0_20px_50px_rgba(0,0,0,0.9)] overflow-hidden mb-4 backdrop-blur-xl flex flex-col"
  >
    <!-- 顶栏：苍蓝灵压渐变，纯矢量SVG -->
    <div class="bg-gradient-to-r from-[#0284C7] to-[#38BDF8] p-3.5 text-white flex items-center justify-between border-b border-[#38BDF8]/30 shrink-0">
      <div class="flex items-center gap-2.5">
        <div class="relative">
          <div class="w-8 h-8 rounded-full bg-[#06080F] flex items-center justify-center border border-[#38BDF8]/60 shadow-md">
            <svg class="w-4 h-4 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
            </svg>
          </div>
          <span class="absolute bottom-0 right-0 w-2 h-2 bg-emerald-400 border-2 border-[#06080F] rounded-full"></span>
        </div>
        <div class="text-left">
          <h4 class="text-xs font-bold text-white tracking-wide">Soul Society 专席支持</h4>
          <span class="text-[9px] text-white/80 font-mono">
            ONLINE: 24/7 实时对接
          </span>
        </div>
      </div>
      <button 
        type="button" 
        id="telegram-close-btn" 
        class="text-white hover:bg-white/10 p-1 rounded-full transition cursor-pointer"
        aria-label="关闭"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- 消息对话区域 (支持动态追加与自动滚动) -->
    <div id="telegram-chat-messages" class="p-3.5 space-y-3 h-[240px] overflow-y-auto bg-[#06080F]/70 border-b border-[#38BDF8]/15 text-xs">
      <!-- 官方系统欢迎引导 -->
      <div class="flex items-start gap-2 max-w-[90%] text-left">
        <div class="w-6 h-6 rounded-full bg-[#0284C7]/20 border border-[#38BDF8]/40 text-[#38BDF8] flex items-center justify-center text-[9px] font-mono shrink-0">
          SYS
        </div>
        <div class="bg-[#0B0F1A] border border-[#38BDF8]/25 rounded-2xl rounded-tl-none p-3 text-[11px] text-slate-300 leading-relaxed shadow-sm">
          欢迎光临。如需咨询账号现货、提取卡密或技术协助，可直接在下方输入框打字发送，或点击下方按钮直连 Telegram 私聊。
        </div>
      </div>
    </div>

    <!-- 底部双通道交互区 (既可直接网页留言发送，也可直连TG) -->
    <div class="p-3 bg-[#06080F]/95 space-y-2.5 shrink-0">
      
      <!-- 网页在线直接发送输入框 -->
      <form id="telegram-send-form" class="flex items-center gap-2">
        <input 
          type="text" 
          id="telegram-chat-input" 
          placeholder="在此输入问题，按回车直接发送..." 
          class="flex-1 bg-[#0B0F1A] border border-[#38BDF8]/30 rounded-xl px-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-[#38BDF8] focus:ring-1 focus:ring-[#38BDF8]/40 transition"
          autocomplete="off"
        />
        <button 
          type="submit" 
          id="telegram-send-btn" 
          class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-[#0284C7] to-[#38BDF8] text-white hover:brightness-110 active:scale-95 transition shadow-sm cursor-pointer shrink-0 flex items-center justify-center"
          title="发送消息"
        >
          <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </form>

      <!-- 一键直达 Telegram 私聊按钮 -->
      <a 
        href={telegramLink} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-full py-2 rounded-xl bg-white/5 hover:bg-[#0284C7]/20 border border-[#38BDF8]/30 text-[#38BDF8] hover:text-white font-bold text-[11px] shadow-xs flex items-center justify-center gap-2 transition active:scale-98"
      >
        <svg class="w-3.5 h-3.5 text-[#38BDF8]" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12c0 5.52 4.48 10 10 10s10-4.48 10-10c0-5.52-4.48-10-10-10zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.2-.08-.06-.19-.04-.27-.02-.12.02-1.96 1.25-5.54 3.69-.52.36-1 .53-1.42.52-.47-.01-1.29-.27-1.95-.49-.82-.27-1.47-.42-1.42-.88.03-.24.36-.49.99-.74 3.89-1.69 6.48-2.8 7.78-3.33 3.69-1.52 4.45-1.78 4.95-1.79.11 0 .36.03.52.16.13.11.17.27.19.38.02.13.02.38-.01.52z"/>
        </svg>
        <span>在 Telegram 直连专席客服 (@puppyshop2Bot)</span>
      </a>
    </div>

  </div>

  <!-- 苍蓝灵压浮空圆钮 -->
  <button 
    id="telegram-widget-trigger" 
    type="button" 
    class="relative w-13 h-13 rounded-full bg-gradient-to-tr from-[#0284C7] to-[#38BDF8] border border-[#38BDF8]/60 text-white shadow-[0_0_25px_rgba(56,189,248,0.45)] flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95 group cursor-pointer"
    aria-label="打开在线客服"
  >
    <span class="absolute -inset-1 bg-[#38BDF8]/25 rounded-full filter blur-md animate-ping opacity-75 pointer-events-none"></span>

    <svg class="h-5 w-5 transform group-hover:scale-110 transition-transform duration-300 text-white" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2C6.48 2 2 6.48 2 12c0 5.52 4.48 10 10 10s10-4.48 10-10c0-5.52-4.48-10-10-10zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.2-.08-.06-.19-.04-.27-.02-.12.02-1.96 1.25-5.54 3.69-.52.36-1 .53-1.42.52-.47-.01-1.29-.27-1.95-.49-.82-.27-1.47-.42-1.42-.88.03-.24.36-.49.99-.74 3.89-1.69 6.48-2.8 7.78-3.33 3.69-1.52 4.45-1.78 4.95-1.79.11 0 .36.03.52.16.13.11.17.27.19.38.02.13.02.38-.01.52z"/>
    </svg>
  </button>
</div>

<script>
  import { authInstance, onAuthStateChanged } from '../lib/firebase.js';

  const trigger = document.getElementById('telegram-widget-trigger');
  const windowBox = document.getElementById('telegram-chat-window');
  const closeBtn = document.getElementById('telegram-close-btn');
  const sendForm = document.getElementById('telegram-send-form') as HTMLFormElement;
  const chatInput = document.getElementById('telegram-chat-input') as HTMLInputElement;
  const messagesBox = document.getElementById('telegram-chat-messages');

  let currentUserEmail = '';
  let currentUsername = '';

  onAuthStateChanged(authInstance, (user) => {
    if (user) {
      currentUserEmail = user.email || '';
      currentUsername = user.displayName || user.email?.split('@')[0] || '';
    }
  });

  function toggleWidget() {
    if (!windowBox) return;
    if (windowBox.classList.contains('hidden')) {
      windowBox.classList.remove('hidden');
      setTimeout(() => {
        windowBox.classList.remove('opacity-0', 'scale-95');
        chatInput?.focus();
      }, 30);
    } else {
      windowBox.classList.add('opacity-0', 'scale-95');
      setTimeout(() => {
        windowBox.classList.add('hidden');
      }, 250);
    }
  }

  trigger?.addEventListener('click', toggleWidget);
  closeBtn?.addEventListener('click', toggleWidget);

  // 处理直接在线发送留言
  sendForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = chatInput.value.trim();
    if (!text || !messagesBox) return;

    // 1. 立即在界面上追加用户的消息气泡
    const userBubble = document.createElement('div');
    userBubble.className = 'flex items-start justify-end gap-2 max-w-[90%] ml-auto text-right';
    userBubble.innerHTML = `
      <div class="bg-gradient-to-r from-[#0284C7] to-[#38BDF8] text-white rounded-2xl rounded-tr-none p-3 text-[11px] leading-relaxed shadow-sm break-all">
        ${text}
      </div>
      <div class="w-6 h-6 rounded-full bg-white/10 border border-white/20 text-white flex items-center justify-center text-[9px] font-mono shrink-0">
        ME
      </div>
    `;
    messagesBox.appendChild(userBubble);
    chatInput.value = '';
    messagesBox.scrollTop = messagesBox.scrollHeight;

    // 2. 将消息秒级推送到后台 Telegram 机器人
    try {
      await fetch('/api/support-notify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message: text,
          email: currentUserEmail || undefined,
          username: currentUsername || undefined
        })
      });

      // 3. 模拟即时确认回复
      setTimeout(() => {
        const botReply = document.createElement('div');
        botReply.className = 'flex items-start gap-2 max-w-[90%] text-left animate-fadeIn';
        botReply.innerHTML = `
          <div class="w-6 h-6 rounded-full bg-[#0284C7]/20 border border-[#38BDF8]/40 text-[#38BDF8] flex items-center justify-center text-[9px] font-mono shrink-0">
            SYS
          </div>
          <div class="bg-[#0B0F1A] border border-[#38BDF8]/25 rounded-2xl rounded-tl-none p-3 text-[11px] text-slate-300 leading-relaxed shadow-sm">
            您的咨询已即时推送至管理员席位！客服将尽快接入，您也可以点击下方按钮直连 Telegram 私聊。
          </div>
        `;
        messagesBox.appendChild(botReply);
        messagesBox.scrollTop = messagesBox.scrollHeight;
      }, 600);
    } catch (err) {
      console.error("Message dispatch failed:", err);
    }
  });
</script>
