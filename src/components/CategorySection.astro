---
import { localizedPath, t, type Locale } from '../lib/i18n';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  category: 'getting-started' | 'workflow-extensions' | 'models' | 'troubleshooting';
  posts: CollectionEntry<'blog'>[];
  locale: Locale;
}

const { category, posts, locale } = Astro.props;
const slugFor = (id: string) => (locale === 'zh' ? id.replace(/^zh\//, '') : id);
const labelKey = `category.${category}` as const;
---
{posts.length > 0 && (
  <section class="max-w-5xl mx-auto px-4 py-10 border-t border-ink-100">
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="text-sm font-semibold tracking-wide uppercase text-ink-500">{t(locale, labelKey)}</h2>
      <span class="text-xs text-ink-400">{posts.length}</span>
    </div>
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {posts.map((post) => (
        <li class="group">
          <a href={localizedPath(locale, `/blog/${slugFor(post.id)}/`)} class="block p-5 rounded-lg border border-ink-100 hover:border-accent/40 hover:shadow-sm transition h-full">
            <h3 class="font-semibold text-ink-900 group-hover:text-accent transition leading-snug">
              {post.data.title}
            </h3>
            <p class="mt-2 text-sm text-ink-600 line-clamp-2">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
