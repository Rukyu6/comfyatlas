<header class="glass-nav fixed top-0 left-0 w-full z-40 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="font-outfit text-2xl font-black tracking-widest text-white hover:text-[#C5A880] transition-colors">
      PUPPY SHOP<span class="text-[#C5A880]">.</span>
    </a>

    <!-- Menu Links -->
    <nav class="hidden md:flex items-center gap-8 font-outfit text-sm uppercase tracking-wider font-semibold text-zinc-400">
      <a href="/#apparel" class="hover:text-white transition-colors">Apparel</a>
      <a href="/#digital" class="hover:text-white transition-colors">Digital Vault</a>
      <a href="/#how-it-works" class="hover:text-white transition-colors">How It Works</a>
    </nav>

    <!-- Header Actions (Auth + i18n + Cart) -->
    <div class="flex items-center gap-4">
      
      <!-- Language Switcher Dropdown -->
      <div class="relative inline-block text-left" id="lang-switcher-root">
        <button 
          id="lang-switcher-btn" 
          type="button" 
          class="px-3.5 py-2 bg-zinc-900 border border-zinc-800 hover:border-white/20 text-white text-xs font-bold font-outfit uppercase tracking-wider rounded-xl transition flex items-center gap-2 active:scale-95"
        >
          <span id="active-lang-flag">🇺🇸</span>
          <span id="active-lang-label" class="hidden sm:inline">English</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-zinc-500" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div 
          id="lang-switcher-dropdown" 
          class="hidden absolute right-0 mt-2 w-48 rounded-2xl bg-zinc-950 border border-white/5 shadow-2xl p-2 z-50 text-left max-h-[320px] overflow-y-auto scrollbar"
        >
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-zinc-300 hover:text-white hover:bg-white/5 transition text-left" data-lang="en" data-flag="🇺🇸">
            <span class="text-sm">🇺🇸</span> English
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-zinc-300 hover:text-white hover:bg-white/5 transition text-left" data-lang="zh-CN" data-flag="🇨🇳">
            <span class="text-sm">🇨🇳</span> 中文
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-zinc-300 hover:text-white hover:bg-white/5 transition text-left" data-lang="fr" data-flag="🇫🇷">
            <span class="text-sm">🇫🇷</span> Français
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-zinc-300 hover:text-white hover:bg-white/5 transition text-left" data-lang="de" data-flag="🇩🇪">
            <span class="text-sm">🇩🇪</span> Deutsch
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-zinc-300 hover:text-white hover:bg-white/5 transition text-left" data-lang="es" data-flag="🇪🇸">
            <span class="text-sm">🇪🇸</span> Español
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-zinc-300 hover:text-white hover:bg-white/5 transition text-left" data-lang="zh-TW" data-flag="🇹🇼">
            <span class="text-sm">🇹🇼</span> 中文 (繁体)
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-zinc-300 hover:text-white hover:bg-white/5 transition text-left" data-lang="ja" data-flag="🇯🇵">
            <span class="text-sm">🇯🇵</span> 日本語
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-zinc-300 hover:text-white hover:bg-white/5 transition text-left" data-lang="ru" data-flag="🇷🇺">
            <span class="text-sm">🇷🇺</span> Русский
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-zinc-300 hover:text-white hover:bg-white/5 transition text-left" data-lang="ko" data-flag="🇰🇷">
            <span class="text-sm">🇰🇷</span> 한국어
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-zinc-300 hover:text-white hover:bg-white/5 transition text-left" data-lang="it" data-flag="🇮🇹">
            <span class="text-sm">🇮🇹</span> Italiano
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-zinc-300 hover:text-white hover:bg-white/5 transition text-left" data-lang="hi" data-flag="🇮🇳">
            <span class="text-sm">🇮🇳</span> हिन्दी
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-zinc-300 hover:text-white hover:bg-white/5 transition text-left" data-lang="pt" data-flag="🇧🇷">
            <span class="text-sm">🇧🇷</span> Português
          </button>
        </div>
      </div>

      <!-- User Profile Dropdown Container -->
      <div id="header-auth-container" class="relative">
        <!-- Rendered client-side -->
        <a 
          href="/login" 
          class="px-4 py-2 border border-white/10 bg-white/5 hover:bg-white/10 hover:border-[#C5A880]/30 text-white text-xs font-bold font-outfit uppercase tracking-wider rounded-xl transition active:scale-95 inline-block decoration-none"
        >
          Sign In
        </a>
      </div>

      <!-- Cart Trigger -->
      <button 
        id="cart-trigger" 
        type="button" 
        class="relative p-2.5 rounded-full border border-white/10 hover:border-[#C5A880]/30 hover:bg-[#C5A880]/5 text-white transition-all duration-300 active:scale-95"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <span 
          id="cart-badge" 
          class="absolute -top-1 -right-1 w-5 h-5 bg-[#C5A880] text-black font-bold font-outfit text-xs rounded-full flex items-center justify-center opacity-0 scale-50 transition-all duration-300"
        >
          0
        </span>
      </button>

    </div>
  </div>
</header>

<style is:global>
  /* Custom overrides for Google Translate widgets to keep the layout clean */
  .skiptranslate {
    display: none !important;
  }
  body {
    top: 0px !important;
  }
  .goog-logo-link, .goog-te-gadget span, .goog-te-banner-frame {
    display: none !important;
  }
  .goog-te-gadget {
    color: transparent !important;
    font-size: 0px !important;
  }
  #goog-gt-tt, .goog-te-balloon-frame {
    display: none !important;
  }
  .goog-text-highlight {
    background: transparent !important;
    box-shadow: none !important;
    box-sizing: border-box !important;
  }
</style>

<script>
  import { authInstance, onAuthStateChanged, signOut } from '../lib/firebase.js';

  // --- Auth logic ---
  const authContainer = document.getElementById('header-auth-container');
  const adminEmail = import.meta.env.PUBLIC_ADMIN_EMAIL || 'rukyucrono@gmail.com';

  onAuthStateChanged(authInstance, (user) => {
    if (!authContainer) return;

    if (!user) {
      // Show Guest state: Sign In button
      authContainer.innerHTML = `
        <a 
          href="/login" 
          class="px-4 py-2 border border-white/10 bg-white/5 hover:bg-white/10 hover:border-[#C5A880]/30 text-white text-xs font-bold font-outfit uppercase tracking-wider rounded-xl transition active:scale-95 inline-block decoration-none"
        >
          Sign In
        </a>
      `;
      return;
    }

    // Show Logged-in state: User menu dropdown button
    const email = user.email || '';
    const nameLabel = user.displayName || email.split('@')[0];
    const isAdmin = email === adminEmail;
    
    authContainer.innerHTML = `
      <div class="relative inline-block text-left">
        <button 
          id="header-user-btn" 
          type="button" 
          class="px-4 py-2 bg-zinc-900 border border-zinc-800 hover:border-[#C5A880]/30 text-white text-xs font-bold font-outfit uppercase tracking-wider rounded-xl transition flex items-center gap-2 active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-[#C5A880]" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
          </svg>
          <span class="max-w-[80px] truncate">${nameLabel}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-zinc-500" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div 
          id="header-user-dropdown" 
          class="hidden absolute right-0 mt-2 w-56 rounded-2xl bg-zinc-950 border border-white/5 shadow-2xl p-2 z-50 text-left"
        >
          <div class="px-4 py-3 border-b border-white/5 text-[10px] text-zinc-500 uppercase tracking-widest font-mono">
            Account: <span class="text-zinc-300 font-bold block truncate mt-0.5">${email}</span>
          </div>
          <div class="py-1">
            <a 
              href="/orders" 
              class="flex items-center gap-2.5 px-4 py-2.5 rounded-xl text-xs text-zinc-300 hover:text-white hover:bg-white/5 transition font-outfit"
            >
              Order Vault
            </a>
            ${isAdmin ? `
              <a 
                href="/admin/dashboard" 
                class="flex items-center gap-2.5 px-4 py-2.5 rounded-xl text-xs text-[#C5A880] hover:text-[#F5E3C6] hover:bg-[#C5A880]/5 transition font-outfit font-bold"
              >
                Merchant Dashboard
              </a>
            ` : ''}
          </div>
          <div class="border-t border-white/5 pt-1.5 mt-1.5">
            <button 
              id="header-logout-btn" 
              type="button" 
              class="w-full flex items-center gap-2.5 px-4 py-2.5 rounded-xl text-xs text-red-400 hover:text-white hover:bg-red-500/10 transition font-outfit text-left"
            >
              Sign Out
            </button>
          </div>
        </div>
      </div>
    `;

    // Dropdown toggle events
    const userBtn = document.getElementById('header-user-btn');
    const userDropdown = document.getElementById('header-user-dropdown');
    const logoutBtn = document.getElementById('header-logout-btn');

    userBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      userDropdown?.classList.toggle('hidden');
    });

    document.addEventListener('click', () => {
      userDropdown?.classList.add('hidden');
    });

    logoutBtn?.addEventListener('click', async () => {
      await signOut(authInstance);
      window.location.reload();
    });
  });

  // --- Google Translate / i18n Switcher ---
  const langSwitcherBtn = document.getElementById('lang-switcher-btn');
  const langDropdown = document.getElementById('lang-switcher-dropdown');
  const activeFlag = document.getElementById('active-lang-flag');
  const activeLabel = document.getElementById('active-lang-label');

  const langMap = {
    'en': { flag: '🇺🇸', label: 'English' },
    'zh-CN': { flag: '🇨🇳', label: '中文' },
    'fr': { flag: '🇫🇷', label: 'Français' },
    'de': { flag: '🇩🇪', label: 'Deutsch' },
    'es': { flag: '🇪🇸', label: 'Español' },
    'zh-TW': { flag: '🇹🇼', label: '中文 (繁体)' },
    'ja': { flag: '🇯🇵', label: '日本語' },
    'ru': { flag: '🇷🇺', label: 'Русский' },
    'ko': { flag: '🇰🇷', label: '한국어' },
    'it': { flag: '🇮🇹', label: 'Italiano' },
    'hi': { flag: '🇮🇳', label: 'हिन्दी' },
    'pt': { flag: '🇧🇷', label: 'Português' }
  };

  function getCookie(name) {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop().split(';').shift();
    return null;
  }

  function setLanguageCookie(langCode) {
    if (langCode === 'en') {
      document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
      document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=" + window.location.hostname;
    } else {
      document.cookie = "googtrans=/en/" + langCode + "; path=/;";
      document.cookie = "googtrans=/en/" + langCode + "; path=/; domain=" + window.location.hostname;
    }
  }

  // Load state from cookie
  const googtrans = getCookie('googtrans');
  let currentLang = 'en';
  if (googtrans) {
    const code = googtrans.split('/').pop();
    if (code && langMap[code]) {
      currentLang = code;
    }
  }

  // Update button visual on load
  if (activeFlag && activeLabel && langMap[currentLang]) {
    activeFlag.textContent = langMap[currentLang].flag;
    activeLabel.textContent = langMap[currentLang].label;
  }

  // Dropdown toggle
  langSwitcherBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    langDropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    langDropdown?.classList.add('hidden');
  });

  // Bind clicks
  document.querySelectorAll('.lang-item').forEach(item => {
    item.addEventListener('click', () => {
      const lang = item.getAttribute('data-lang');
      const flag = item.getAttribute('data-flag');
      const label = item.textContent.trim().replace(flag, '').trim();

      if (!lang) return;

      setLanguageCookie(lang);

      const selectEl = document.querySelector('.goog-te-combo') as HTMLSelectElement;
      if (selectEl) {
        selectEl.value = lang;
        selectEl.dispatchEvent(new Event('change'));
        if (activeFlag) activeFlag.textContent = flag;
        if (activeLabel) activeLabel.textContent = label;
      } else {
        window.location.reload();
      }
    });
  });

  // Inject Google Translate script dynamically in background
  if (!document.getElementById('google_translate_script') && typeof window !== 'undefined') {
    const trDiv = document.createElement('div');
    trDiv.id = 'google_translate_element';
    trDiv.style.display = 'none';
    document.body.appendChild(trDiv);

    (window as any).googleTranslateElementInit = function() {
      new (window as any).google.translate.TranslateElement({
        pageLanguage: 'en',
        layout: (window as any).google.translate.TranslateElement.InlineLayout.SIMPLE,
        autoDisplay: false
      }, 'google_translate_element');
    };

    const script = document.createElement('script');
    script.id = 'google_translate_script';
    script.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
    document.body.appendChild(script);
  }
</script>
