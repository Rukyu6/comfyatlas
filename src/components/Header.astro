<header class="glass-nav fixed top-0 left-0 w-full z-40 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="font-sora text-xl font-semibold tracking-tight text-white hover:text-[#FAC514] transition-colors flex items-center gap-2.5">
      <span class="flex justify-center items-center w-7 h-7"><img src="/images/worldclaw_hero_core.png" class="w-7 h-7 object-contain rounded-full" alt="WorldClaw Logo"/></span>
      <span>WORLDCLAW</span><span class="text-[#E7AC08]">.</span>
    </a>

    <!-- Menu Links -->
    <nav class="hidden md:flex items-center gap-8 font-sora text-sm font-semibold text-white/70">
      <a href="/#digital" class="hover:text-white transition-colors text-xs tracking-tight">Digital Vault / 상품분류</a>
      <a href="/query" class="hover:text-white transition-colors text-xs tracking-tight">Order Query / 주문조회</a>
      <a href="/#how-it-works" class="hover:text-white transition-colors text-xs tracking-tight">How It Works / 이용안내</a>
    </nav>

    <!-- Header Actions (Auth + i18n + Cart) -->
    <div class="flex items-center gap-4">
      
      <!-- Language Switcher Dropdown -->
      <div class="relative inline-block text-left" id="lang-switcher-root">
        <button 
          id="lang-switcher-btn" 
          type="button" 
          class="px-3.5 py-2 bg-transparent border border-white/10 hover:bg-white/5 text-white/80 text-xs font-semibold font-sora rounded-full transition flex items-center gap-2 active:scale-95"
        >
          <span id="active-lang-flag">🇰🇷</span>
          <span id="active-lang-label" class="hidden sm:inline">한국어</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-white/50" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div 
          id="lang-switcher-dropdown" 
          class="hidden absolute right-0 mt-2 w-48 rounded-2xl bg-[#171412]/95 border border-[#292929] shadow-[0_12px_35px_rgba(0,0,0,0.85)] p-2 z-50 text-left max-h-[320px] overflow-y-auto scrollbar backdrop-blur-md"
        >
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-white/80 hover:bg-white/10 font-medium transition text-left" data-lang="en" data-flag="🇺🇸">
            <span class="text-sm">🇺🇸</span> English
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-white/80 hover:bg-white/10 font-medium transition text-left" data-lang="zh-CN" data-flag="🇨🇳">
            <span class="text-sm">🇨🇳</span> 中文
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-white/80 hover:bg-white/10 font-medium transition text-left" data-lang="fr" data-flag="🇫🇷">
            <span class="text-sm">🇫🇷</span> Français
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-white/80 hover:bg-white/10 font-medium transition text-left" data-lang="de" data-flag="🇩🇪">
            <span class="text-sm">🇩🇪</span> Deutsch
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-white/80 hover:bg-white/10 font-medium transition text-left" data-lang="es" data-flag="🇪🇸">
            <span class="text-sm">🇪🇸</span> Español
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-white/80 hover:bg-white/10 font-medium transition text-left" data-lang="zh-TW" data-flag="🇹🇼">
            <span class="text-sm">🇹🇼</span> 中文 (繁体)
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-white/80 hover:bg-white/10 font-medium transition text-left" data-lang="ja" data-flag="🇯🇵">
            <span class="text-sm">🇯🇵</span> 日本語
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-white/80 hover:bg-white/10 font-medium transition text-left" data-lang="ru" data-flag="🇷🇺">
            <span class="text-sm">🇷🇺</span> Русский
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-white/80 hover:bg-white/10 font-medium transition text-left" data-lang="ko" data-flag="🇰🇷">
            <span class="text-sm">🇰🇷</span> 한국어
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-white/80 hover:bg-white/10 font-medium transition text-left" data-lang="it" data-flag="🇮🇹">
            <span class="text-sm">🇮🇹</span> Italiano
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-white/80 hover:bg-white/10 font-medium transition text-left" data-lang="hi" data-flag="🇮🇳">
            <span class="text-sm">🇮🇳</span> हिन्दी
          </button>
          <button type="button" class="lang-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs text-white/80 hover:bg-white/10 font-medium transition text-left" data-lang="pt" data-flag="🇧🇷">
            <span class="text-sm">🇧🇷</span> Português
          </button>
        </div>
      </div>

      <!-- User Profile Dropdown Container -->
      <div id="header-auth-container" class="relative">
        <!-- Rendered client-side -->
        <a 
          href="/login" 
          class="px-5 py-2 bg-[#E7AC08] hover:bg-[#FAC514] border border-[#FAC514] text-[#080808] text-xs font-bold font-sora rounded-full transition active:scale-95 inline-block decoration-none"
        >
          Sign In
        </a>
      </div>

      <!-- Cart Trigger -->
      <button 
        id="cart-trigger" 
        type="button" 
        class="relative p-2.5 rounded-full border border-white/10 bg-transparent hover:bg-white/5 text-white transition-all duration-300 active:scale-95"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <span 
          id="cart-badge" 
          class="absolute -top-1 -right-1 w-5 h-5 bg-[#E7AC08] text-[#080808] font-bold font-sora text-[10px] rounded-full flex items-center justify-center opacity-0 scale-50 transition-all duration-300 border border-[#FAC514]"
        >
          0
        </span>
      </button>

    </div>
  </div>
</header>

<style is:global>
  /* Custom overrides for Google Translate widgets to keep the layout clean */
  .skiptranslate {
    display: none !important;
  }
  body {
    top: 0px !important;
  }
  .goog-logo-link, .goog-te-gadget span, .goog-te-banner-frame {
    display: none !important;
  }
  .goog-te-gadget {
    color: transparent !important;
    font-size: 0px !important;
  }
  #goog-gt-tt, .goog-te-balloon-frame {
    display: none !important;
  }
  .goog-text-highlight {
    background: transparent !important;
    box-shadow: none !important;
    box-sizing: border-box !important;
  }
</style>

<script>
  import { authInstance, onAuthStateChanged, signOut, getDoc, doc, dbInstance } from '../lib/firebase.js';

  // --- Auth logic ---
  const authContainer = document.getElementById('header-auth-container');
  const adminEmail = import.meta.env.PUBLIC_ADMIN_EMAIL || 'rukyucrono@gmail.com';

  onAuthStateChanged(authInstance, async (user) => {
    if (!authContainer) return;

    if (!user) {
      // Show Guest state: Sign In button
      authContainer.innerHTML = `
        <a 
          href="/login" 
          class="px-5 py-2 bg-[#E7AC08] hover:bg-[#FAC514] border border-[#FAC514] text-[#080808] text-xs font-bold font-sora rounded-full transition active:scale-95 inline-block decoration-none"
        >
          Sign In
        </a>
      `;
      return;
    }

    // Show Logged-in state: User menu dropdown button
    const email = user.email || '';
    const nameLabel = user.displayName || email.split('@')[0];
    const isAdmin = email === adminEmail;
    
    // First render with $0
    renderUserDropdown(nameLabel, email, isAdmin, 0);

    // Fetch user balance
    try {
      const userDocRef = doc(dbInstance, 'users', user.uid);
      const userDocSnap = await getDoc(userDocRef);
      let balanceUsd = 0;
      if (userDocSnap.exists()) {
        balanceUsd = userDocSnap.data()?.balance_usd || 0;
      }
      renderUserDropdown(nameLabel, email, isAdmin, balanceUsd);
    } catch (e) {
      console.error("Failed to fetch user balance:", e);
    }
  });

  function renderUserDropdown(nameLabel: string, email: string, isAdmin: boolean, balanceUsd: number) {
    if (!authContainer) return;
    const balanceCny = (balanceUsd * 6.8).toFixed(2);

    authContainer.innerHTML = `
      <div class="relative inline-block text-left">
        <button 
          id="header-user-btn" 
          type="button" 
          class="px-4 py-2 bg-transparent border border-white/10 hover:bg-white/5 text-white text-xs font-bold font-sora rounded-full transition flex items-center gap-2 active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-[#E7AC08]" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
          </svg>
          <span class="max-w-[80px] truncate">${nameLabel}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-white/50" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div 
          id="header-user-dropdown" 
          class="hidden absolute right-0 mt-2 w-56 rounded-2xl bg-[#1C1917]/95 border border-[#292929] shadow-[0_12px_35px_rgba(0,0,0,0.85)] p-2 z-50 text-left text-white backdrop-blur-md"
        >
          <div class="px-4 py-3 border-b border-[#292929] text-[10px] text-white/50 uppercase tracking-widest font-mono">
            Account: <span class="text-white font-bold block truncate mt-0.5">${email}</span>
          </div>

          <!-- Wallet Balance -->
          <div class="px-4 py-2.5 border-b border-[#292929] text-[10px] text-white/50 font-sora">
            USDT Balance / 잔액: 
            <span class="text-[#FAC514] font-bold block text-sm mt-0.5">$${balanceUsd.toFixed(2)} <span class="text-xs text-white/40 font-normal font-sans">(¥${balanceCny} CNY)</span></span>
          </div>

          <div class="py-1">
            <a 
              href="/orders" 
              class="flex items-center gap-2.5 px-4 py-2.5 rounded-xl text-xs text-white/80 hover:bg-white/10 transition font-sora font-semibold"
            >
              Order Vault
            </a>
            ${isAdmin ? `
              <a 
                href="/admin/dashboard" 
                class="flex items-center gap-2.5 px-4 py-2.5 rounded-xl text-xs text-[#FAC514] hover:bg-white/10 transition font-sora font-semibold"
              >
                Operations Room
              </a>
            ` : ''}
          </div>
          <div class="border-t border-[#292929] pt-1.5 mt-1.5">
            <button 
              id="header-logout-btn" 
              type="button" 
              class="w-full flex items-center gap-2.5 px-4 py-2.5 rounded-xl text-xs text-red-400 hover:bg-red-500/10 transition font-sora font-semibold text-left"
            >
              Sign Out
            </button>
          </div>
        </div>
      </div>
    `;

    // Dropdown toggle events
    const userBtn = document.getElementById('header-user-btn');
    const userDropdown = document.getElementById('header-user-dropdown');
    const logoutBtn = document.getElementById('header-logout-btn');

    userBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      userDropdown?.classList.toggle('hidden');
    });

    logoutBtn?.addEventListener('click', async () => {
      await signOut(authInstance);
      window.location.reload();
    });
  }

  // --- Google Translate / i18n Switcher ---
  const langSwitcherBtn = document.getElementById('lang-switcher-btn');
  const langDropdown = document.getElementById('lang-switcher-dropdown');
  const activeFlag = document.getElementById('active-lang-flag');
  const activeLabel = document.getElementById('active-lang-label');

  const langMap = {
    'en': { flag: '🇺🇸', label: 'English' },
    'zh-CN': { flag: '🇨🇳', label: '中文' },
    'fr': { flag: '🇫🇷', label: 'Français' },
    'de': { flag: '🇩🇪', label: 'Deutsch' },
    'es': { flag: '🇪🇸', label: 'Español' },
    'zh-TW': { flag: '🇹🇼', label: '中文 (繁体)' },
    'ja': { flag: '🇯🇵', label: '日本語' },
    'ru': { flag: '🇷🇺', label: 'Русский' },
    'ko': { flag: '🇰🇷', label: '한국어' },
    'it': { flag: '🇮🇹', label: 'Italiano' },
    'hi': { flag: '🇮🇳', label: 'हिन्दी' },
    'pt': { flag: '🇧🇷', label: 'Português' }
  };

  // Convert ISO codes to translate.js names
  function isoToTranslateJs(iso) {
    const map = {
      'en': 'english',
      'zh-CN': 'chinese_simplified',
      'zh-TW': 'chinese_traditional',
      'fr': 'french',
      'de': 'german',
      'es': 'spanish',
      'ja': 'japanese',
      'ru': 'russian',
      'ko': 'korean',
      'it': 'italian',
      'hi': 'hindi',
      'pt': 'portuguese'
    };
    return map[iso] || iso;
  }

  // Determine current language from LocalStorage
  let currentLang = 'ko';
  const localSavedLang = localStorage.getItem('active_language');
  if (localSavedLang && langMap[localSavedLang]) {
    currentLang = localSavedLang;
  } else {
    localStorage.setItem('active_language', 'ko');
  }

  // Update button visual state immediately on page load
  if (activeFlag && activeLabel && langMap[currentLang]) {
    activeFlag.textContent = langMap[currentLang].flag;
    activeLabel.textContent = langMap[currentLang].label;
  }

  // Dropdown toggle
  langSwitcherBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    langDropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    langDropdown?.classList.add('hidden');
  });

  // Bind clicks
  document.querySelectorAll('.lang-item').forEach(item => {
    item.addEventListener('click', () => {
      const lang = item.getAttribute('data-lang');
      const flag = item.getAttribute('data-flag');
      const label = item.textContent.trim().replace(flag, '').trim();

      if (!lang || !flag) return;

      // 1. Instantly update the visual labels in the header
      if (activeFlag) activeFlag.textContent = flag;
      if (activeLabel) activeLabel.textContent = label;

      // 2. Persist in local storage
      localStorage.setItem('active_language', lang);

      // 3. Trigger translate.js translation
      const translate = (window as any).translate;
      if (translate) {
        const translateJsLang = isoToTranslateJs(lang);
        translate.changeLanguage(translateJsLang);
      }

      // 4. Dispatch custom event for currency dynamic updates
      window.dispatchEvent(new CustomEvent('language:change', { detail: { lang } }));
    });
  });

  // Inject translate.js script dynamically in background (works inside China!)
  if (!document.getElementById('translate_js_script') && typeof window !== 'undefined') {
    const script = document.createElement('script');
    script.id = 'translate_js_script';
    script.src = 'https://cdn.staticfile.net/translate.js/3.18.66/translate.js';
    script.onload = () => {
      const translate = (window as any).translate;
      if (translate) {
        translate.language.setLocal('english');
        translate.service.use('client.edge');
        translate.selectLanguageTag.show = false;
        translate.listener.start();
        translate.execute();
        
        // Auto translate on load if a language was previously saved
        if (currentLang && currentLang !== 'en') {
          const translateJsLang = isoToTranslateJs(currentLang);
          setTimeout(() => {
            translate.changeLanguage(translateJsLang);
          }, 150);
        }
      }
    };
    document.body.appendChild(script);
  }
</script>
