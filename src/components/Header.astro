---
import { SITE, t, localizedPath, type Locale } from '../lib/i18n';

export interface Props {
  locale: Locale;
  pathname: string;
}
const { locale, pathname } = Astro.props;
---
<header class="border-b border-ink-100 bg-white/80 backdrop-blur sticky top-0 z-30">
  <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
    <a href={localizedPath(locale, '/')} class="flex items-center gap-2 font-semibold text-ink-900">
      <span class="inline-block w-7 h-7 rounded-md bg-accent text-white grid place-items-center text-sm font-bold">C</span>
      <span>{SITE.name}</span>
    </a>
    <nav class="flex items-center gap-5 text-sm">
      <a href={localizedPath(locale, '/blog/')} class="text-ink-600 hover:text-ink-900 transition">{t(locale, 'nav.guides')}</a>
      <a href={localizedPath(locale, '/about/')} class="text-ink-600 hover:text-ink-900 transition">{t(locale, 'nav.about')}</a>
      <div class="flex items-center gap-1 text-xs">
        {SITE.locales.map((l) => (
          <a
            href={localizedPath(l, pathname)}
            class:list={[
              'px-2 py-1 rounded transition',
              l === locale ? 'bg-ink-900 text-white' : 'text-ink-500 hover:bg-ink-50',
            ]}
          >
            {l === 'en' ? 'EN' : '中'}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>
