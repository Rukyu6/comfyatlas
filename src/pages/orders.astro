---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="历史订单与会员资产 — Soul Society">
  <Header />

  <!-- 苍蓝灵压背景漫射冷焰 -->
  <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[750px] h-[350px] bg-gradient-to-b from-[#0284C7]/20 via-[#38BDF8]/10 to-transparent rounded-full filter blur-[140px] pointer-events-none z-0"></div>

  <main class="flex-grow pt-32 pb-24 px-6 max-w-5xl mx-auto w-full relative z-10 text-white animate-fadeIn font-outfit">
    <div class="space-y-8">
      
      <!-- Top header layout -->
      <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-white/10 pb-6">
        <div class="space-y-1">
          <span class="text-[#38BDF8] uppercase tracking-widest text-xs font-mono font-bold block">SOUL SOCIETY • USER VAULT</span>
          <h1 class="text-3xl font-black text-white tracking-tight">我的历史订单与资产</h1>
        </div>
        <p class="text-slate-400 text-xs mt-2 md:mt-0 font-mono flex items-center gap-2" id="orders-user-badge">
          <span class="w-2 h-2 rounded-full bg-[#38BDF8] animate-ping"></span>
          <span>正在检索当前账户权限...</span>
        </p>
      </div>

      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        
        <!-- Orders Column (lg:col-span-2) -->
        <div class="lg:col-span-2 space-y-6">
          <h2 class="text-lg font-bold text-white flex items-center gap-2.5">
            <svg class="w-5 h-5 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
            <span>我的历史订单</span>
          </h2>
          
          <!-- Loading State -->
          <div id="orders-loading" class="text-center py-20 text-slate-400">
            <div class="animate-spin inline-block w-8 h-8 border-4 border-[#38BDF8] border-t-transparent rounded-full mb-3"></div>
            <p class="text-xs uppercase tracking-widest font-mono text-slate-300">RETRIEVING DISPATCH RECORDS...</p>
          </div>

          <!-- Empty State (彻底告别旧版土黄，纯净苍蓝高光) -->
          <div id="orders-empty" class="hidden text-center py-16 glass-card p-8 max-w-md mx-auto border border-[#38BDF8]/20 bg-[#0B0F1A]/90 rounded-3xl shadow-xl">
            <div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 mx-auto mb-3">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
            </div>
            <h3 class="text-white font-extrabold text-sm">暂无任何历史购买记录</h3>
            <p class="text-xs text-slate-400 mt-2 leading-relaxed">
              您当前账户尚未下单。下单后购买的卡密凭据与自动发货记录将永久留存于此。
            </p>
            <a 
              href="/#digital" 
              class="inline-block mt-6 px-6 py-2.5 bg-gradient-to-r from-[#0284C7] to-[#38BDF8] text-white hover:brightness-110 font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-[0_0_20px_rgba(56,189,248,0.35)] active:scale-95 cursor-pointer"
            >
              浏览数字商品库
            </a>
          </div>

          <!-- Orders List Container -->
          <div id="orders-list" class="hidden space-y-6">
          </div>
        </div>

        <!-- Wallet Column (lg:col-span-1) -->
        <div class="lg:col-span-1 space-y-6">
          <h2 class="text-lg font-bold text-white flex items-center gap-2.5">
            <svg class="w-5 h-5 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
            <span>会员钱包资产</span>
          </h2>
          
          <!-- Balance Summary Card -->
          <div class="glass-card p-6 bg-[#0B0F1A]/90 border border-[#38BDF8]/20 rounded-3xl space-y-4 shadow-xl">
            <div class="flex items-center justify-between border-b border-white/5 pb-3">
              <span class="text-xs font-bold text-slate-400">可用账户余额</span>
              <span class="text-[10px] text-emerald-400 bg-emerald-500/15 border border-emerald-500/30 px-2 py-0.5 rounded-full font-mono">
                ACTIVE
              </span>
            </div>
            
            <div class="space-y-1">
              <div class="flex items-baseline gap-1">
                <span class="text-xs text-[#38BDF8] font-bold font-mono">$</span>
                <span class="text-3xl font-black text-white tracking-tight font-mono" id="wallet-balance-usd">0.00</span>
                <span class="text-xs text-slate-400 font-mono ml-1">USDT</span>
              </div>
              <p class="text-[11px] text-slate-500 font-mono">
                约合人民币: ¥<span id="wallet-balance-cny">0.00</span> CNY
              </p>
            </div>

            <button 
              type="button" 
              id="wallet-recharge-btn"
              class="w-full py-2.5 rounded-xl bg-[#0284C7]/25 hover:bg-[#0284C7]/40 border border-[#38BDF8]/40 text-[#38BDF8] hover:text-white font-bold text-xs uppercase tracking-wider transition-all duration-200 active:scale-95 cursor-pointer flex items-center justify-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
              <span>在线充值余额</span>
            </button>
          </div>

          <!-- Recharge Form Card (Hidden by default) -->
          <div id="wallet-recharge-form-card" class="hidden glass-card p-6 bg-[#0B0F1A]/95 border border-[#38BDF8]/40 rounded-3xl space-y-4 shadow-2xl animate-fadeIn">
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
              <h3 class="text-xs font-bold text-white uppercase tracking-wider">
                提交转账凭证
              </h3>
              <button type="button" id="close-recharge-btn" class="text-slate-400 hover:text-white text-xs">
                ✕
              </button>
            </div>

            <div class="p-3 bg-[#06080F] border border-white/10 rounded-xl space-y-1 text-left text-[11px]">
              <span class="text-slate-400 block font-mono text-[10px]">USDT (TRC-20) 官方收款地址:</span>
              <p class="font-mono text-[#38BDF8] select-all break-all text-[10px]">
                TPUxwhaa4szt1QswXvFVKtbYEHUwupRGZA
              </p>
            </div>

            <form id="recharge-form" class="space-y-3">
              <div>
                <label class="block text-[10px] uppercase text-slate-400 font-bold mb-1">充值金额 (USD)</label>
                <input 
                  type="number" 
                  step="any"
                  id="recharge-amount" 
                  placeholder="例如: 50.00"
                  required
                  class="w-full bg-[#06080F] border border-white/10 rounded-xl px-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-[#38BDF8]"
                />
              </div>

              <div>
                <label class="block text-[10px] uppercase text-slate-400 font-bold mb-1">转账交易哈希 / TxID</label>
                <input 
                  type="text" 
                  id="recharge-txid" 
                  placeholder="粘贴区块链转账哈希..."
                  required
                  class="w-full bg-[#06080F] border border-white/10 rounded-xl px-3 py-2 text-xs text-white placeholder-slate-500 font-mono focus:outline-none focus:border-[#38BDF8]"
                />
              </div>

              <button 
                type="submit" 
                id="submit-recharge-btn"
                class="w-full py-2.5 rounded-xl bg-gradient-to-r from-[#0284C7] to-[#38BDF8] text-white font-bold text-xs shadow-md active:scale-95 transition flex items-center justify-center gap-1.5"
              >
                <span>提交充值凭证</span>
              </button>
            </form>
          </div>

          <!-- Deposit History Card -->
          <div class="glass-card p-6 bg-[#0B0F1A]/90 border border-[#38BDF8]/20 rounded-3xl space-y-4 shadow-xl">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <svg class="w-4 h-4 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
              <span>充值记录明细</span>
            </h3>
            <div id="deposit-logs-container" class="space-y-2.5 max-h-[250px] overflow-y-auto pr-1">
              <p class="text-[11px] text-slate-500 text-center py-4">暂无充值申请记录</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { authInstance, onAuthStateChanged, collection, dbInstance, query, where, orderBy, getDocs, doc, getDoc, addDoc } from '../lib/firebase.js';

  let currentUserEmail = '';
  let currentUserUid = '';

  const loadingSec = document.getElementById('orders-loading');
  const emptySec = document.getElementById('orders-empty');
  const listSec = document.getElementById('orders-list');
  const userBadge = document.getElementById('orders-user-badge');

  const rechargeBtn = document.getElementById('wallet-recharge-btn');
  const closeRechargeBtn = document.getElementById('close-recharge-btn');
  const rechargeFormCard = document.getElementById('wallet-recharge-form-card');
  const rechargeForm = document.getElementById('recharge-form') as HTMLFormElement;
  const rechargeAmount = document.getElementById('recharge-amount') as HTMLInputElement;
  const rechargeTxid = document.getElementById('recharge-txid') as HTMLInputElement;
  const submitRechargeBtn = document.getElementById('submit-recharge-btn');
  const logsContainer = document.getElementById('deposit-logs-container');

  onAuthStateChanged(authInstance, (user) => {
    if (!user) {
      window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`;
      return;
    }

    currentUserEmail = user.email || '';
    currentUserUid = user.uid || '';
    
    if (userBadge) {
      userBadge.innerHTML = `<span class="text-slate-400">已登录账号:</span> <span class="text-[#38BDF8] font-bold">${currentUserEmail}</span>`;
    }

    loadOrders();
    loadUserBalance();
    loadDeposits();
  });

  async function loadUserBalance() {
    try {
      const userDocRef = doc(dbInstance, 'users', currentUserUid);
      const userDocSnap = await getDoc(userDocRef);
      let balanceUsd = 0;
      if (userDocSnap.exists()) {
        balanceUsd = userDocSnap.data()?.balance_usd || 0;
      }
      const balanceCny = (balanceUsd * 7.1).toFixed(2);
      
      const balUsdElem = document.getElementById('wallet-balance-usd');
      const balCnyElem = document.getElementById('wallet-balance-cny');
      if (balUsdElem) balUsdElem.textContent = balanceUsd.toFixed(2);
      if (balCnyElem) balCnyElem.textContent = balanceCny;
    } catch (e) {
      console.error(e);
    }
  }

  async function loadDeposits() {
    if (!logsContainer) return;
    try {
      const q = query(collection(dbInstance, 'deposits'), where('uid', '==', currentUserUid), orderBy('createdAt', 'desc'));
      const querySnapshot = await getDocs(q);
      const deposits: any[] = [];
      querySnapshot.docs.forEach((doc) => deposits.push({ id: doc.id, ...doc.data() }));
      renderDeposits(deposits);
    } catch {
      try {
        const qFall = query(collection(dbInstance, 'deposits'));
        const querySnapshot = await getDocs(qFall);
        const allDeposits: any[] = [];
        querySnapshot.docs.forEach((doc) => allDeposits.push({ id: doc.id, ...doc.data() }));
        const filtered = allDeposits.filter(d => d.uid === currentUserUid).sort((a,b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
        renderDeposits(filtered);
      } catch {
        logsContainer.innerHTML = `<p class="text-[11px] text-rose-400 text-center py-4">加载充值明细失败</p>`;
      }
    }
  }

  function renderDeposits(deposits: any[]) {
    if (!logsContainer) return;
    if (deposits.length === 0) {
      logsContainer.innerHTML = `<p class="text-[11px] text-slate-500 text-center py-4">暂无充值记录</p>`;
      return;
    }

    logsContainer.innerHTML = deposits.map(dep => {
      const date = new Date(dep.createdAt).toLocaleDateString('zh-CN', {
        month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'
      });

      let statusBadge = 'bg-amber-500/15 text-amber-400 border border-amber-500/30';
      let statusText = '审核中';
      if (dep.status === 'approved' || dep.status === 'completed') {
        statusBadge = 'bg-[#0284C7]/20 text-[#38BDF8] border border-[#38BDF8]/40';
        statusText = '已入账';
      } else if (dep.status === 'rejected') {
        statusBadge = 'bg-rose-500/15 text-rose-400 border border-rose-500/30';
        statusText = '未通过';
      }

      return `
        <div class="p-3 bg-[#06080F] border border-white/5 rounded-xl text-left space-y-1">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-white font-mono">+ $${Number(dep.amount).toFixed(2)} USDT</span>
            <span class="px-2 py-0.5 border rounded-full text-[9px] font-bold ${statusBadge}">
              ${statusText}
            </span>
          </div>
          <div class="text-[10px] text-slate-500 font-mono flex flex-col gap-0.5">
            <span class="truncate select-all">TxID: ${dep.txId}</span>
            <span>时间: ${date}</span>
          </div>
        </div>
      `;
    }).join('');
  }

  rechargeBtn?.addEventListener('click', () => rechargeFormCard?.classList.toggle('hidden'));
  closeRechargeBtn?.addEventListener('click', () => rechargeFormCard?.classList.add('hidden'));

  rechargeForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const amount = parseFloat(rechargeAmount.value);
    const txId = rechargeTxid.value.trim();

    if (isNaN(amount) || amount <= 0 || !txId) {
      alert("请输入有效的金额与转账 TxID 凭据！");
      return;
    }

    submitRechargeBtn?.setAttribute('disabled', 'true');
    try {
      await addDoc(collection(dbInstance, 'deposits'), {
        uid: currentUserUid,
        email: currentUserEmail,
        amount: amount,
        txId: txId,
        status: 'pending',
        createdAt: new Date().toISOString()
      });
      alert("充值申请已提交！审核完成后将自动为您入账。");
      rechargeForm.reset();
      rechargeFormCard?.classList.add('hidden');
      loadUserBalance();
      loadDeposits();
    } catch {
      alert("提交异常，请稍后重试。");
    } finally {
      submitRechargeBtn?.removeAttribute('disabled');
    }
  });

  async function loadOrders() {
    try {
      const q = query(collection(dbInstance, 'orders'), where('email', '==', currentUserEmail), orderBy('createdAt', 'desc'));
      const querySnapshot = await getDocs(q);
      const orders: any[] = [];
      querySnapshot.docs.forEach((doc) => orders.push({ id: doc.id, ...doc.data() }));

      if (orders.length === 0) {
        loadingSec?.classList.add('hidden');
        emptySec?.classList.remove('hidden');
        listSec?.classList.add('hidden');
        return;
      }
      renderOrders(orders);
    } catch {
      try {
        const qFall = query(collection(dbInstance, 'orders'));
        const querySnapshot = await getDocs(qFall);
        const allOrders: any[] = [];
        querySnapshot.docs.forEach((doc) => allOrders.push({ id: doc.id, ...doc.data() }));
        const filtered = allOrders.filter(o => o.email === currentUserEmail).sort((a,b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

        if (filtered.length === 0) {
          loadingSec?.classList.add('hidden');
          emptySec?.classList.remove('hidden');
          return;
        }
        renderOrders(filtered);
      } catch {
        if (loadingSec) loadingSec.innerHTML = `<p class="text-rose-400 text-xs">加载订单记录失败</p>`;
      }
    }
  }

  function renderOrders(orders: any[]) {
    if (!listSec) return;

    listSec.innerHTML = orders.map(order => {
      const date = new Date(order.createdAt).toLocaleDateString('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'
      });

      let statusColor = 'text-amber-400 bg-amber-500/15 border border-amber-500/30';
      let statusLabel = '配货审核中';
      if (order.status === 'completed' || order.status === 'paid') {
        statusColor = 'text-[#38BDF8] bg-[#0284C7]/20 border border-[#38BDF8]/40 shadow-[0_0_12px_rgba(56,189,248,0.25)]';
        statusLabel = '已交付完成';
      } else if (order.status === 'cancelled') {
        statusColor = 'text-slate-400 bg-white/5 border border-white/10';
        statusLabel = '已取消';
      }

      const cartItems = (order.items || []).map(item => `
        <div class="flex items-center justify-between py-3 border-b border-white/5 last:border-0">
          <div class="flex items-center gap-3">
            <img src="${item.image || '/favicon.ico'}" class="w-9 h-9 rounded-xl object-cover bg-black/40 border border-white/10" />
            <div class="text-left">
              <p class="text-xs font-bold text-white line-clamp-1">${item.name}</p>
              <div class="flex items-center gap-2 mt-0.5">
                <span class="px-1.5 py-0.2 rounded bg-[#0284C7]/20 text-[#38BDF8] text-[9px] font-mono">DIGITAL</span>
                <span class="text-[10px] text-slate-400">数量: ${item.quantity || 1}</span>
              </div>
            </div>
          </div>
          <span class="text-xs font-bold font-mono text-[#38BDF8]">$${Number(item.price * (item.quantity || 1)).toFixed(2)}</span>
        </div>
      `).join('');

      let credentialsBlock = '';
      if (order.status === 'completed' || order.status === 'paid') {
        const keyContent = order.dispatchContent || order.id;
        credentialsBlock = `
          <div class="p-3.5 bg-[#0284C7]/10 border border-[#38BDF8]/30 text-left space-y-2 rounded-2xl mt-3">
            <div class="flex items-center justify-between">
              <h4 class="text-xs font-bold text-[#38BDF8] uppercase tracking-wider flex items-center gap-1.5 font-mono">
                <svg class="w-3.5 h-3.5 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                </svg>
                <span>卡密凭证 (CREDENTIALS)</span>
              </h4>
              <button 
                type="button" 
                onclick="navigator.clipboard.writeText('${keyContent}'); alert('卡密已成功复制到剪贴板！');"
                class="px-2.5 py-1 bg-[#0284C7]/30 hover:bg-[#0284C7]/50 border border-[#38BDF8]/40 text-[#38BDF8] hover:text-white text-[10px] font-bold rounded-lg transition"
              >
                一键复制
              </button>
            </div>
            <div class="p-2.5 bg-[#06080F] border border-[#38BDF8]/40 rounded-xl font-mono text-xs text-[#38BDF8] break-all select-all shadow-inner leading-relaxed">
              ${order.dispatchContent || '凭证已自动核销完成，如有疑问可联系在线客服。'}
            </div>
          </div>
        `;
      }

      return `
        <div class="glass-card p-6 bg-[#0B0F1A]/90 border border-[#38BDF8]/20 rounded-3xl space-y-4 text-white shadow-xl">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3.5 border-b border-white/5">
            <div class="text-left">
              <span class="text-[10px] font-mono font-bold text-[#38BDF8]">单号: ${order.id}</span>
              <p class="text-[10px] text-slate-500 font-mono mt-0.5">下单时间: ${date}</p>
            </div>
            <span class="px-2.5 py-0.5 rounded-full border text-[10px] font-bold ${statusColor} w-fit">
              ${statusLabel}
            </span>
          </div>

          <div class="space-y-1">
            ${cartItems}
          </div>

          ${credentialsBlock}

          <div class="pt-3 border-t border-white/5 flex items-center justify-between">
            <span class="text-xs text-slate-400">实付总额</span>
            <span class="text-base font-black text-[#38BDF8] font-mono">$${Number(order.totalUsd || order.totalPrice || 0).toFixed(2)}</span>
          </div>
        </div>
      `;
    }).join('');

    loadingSec?.classList.add('hidden');
    emptySec?.classList.add('hidden');
    listSec?.classList.remove('hidden');
  }
</script>
