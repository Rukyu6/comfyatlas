---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="My Orders — Puppy Shop">
  <Header />

  <main class="flex-grow pt-32 pb-24 px-6 max-w-5xl mx-auto w-full relative z-10">
    <div class="space-y-8">
      
      <!-- Top header layout -->
      <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-white/5 pb-6">
        <div class="space-y-1">
          <span class="text-[#C5A880] uppercase tracking-widest text-[10px] font-bold font-outfit block">Customer Center</span>
          <h1 class="text-3xl font-extrabold font-outfit text-white">Order Vault</h1>
        </div>
        <p class="text-zinc-500 text-xs mt-2 md:mt-0" id="orders-user-badge">
          Retrieving credentials...
        </p>
      </div>

      <!-- Loading State -->
      <div id="orders-loading" class="text-center py-24 text-zinc-500">
        <div class="animate-spin inline-block w-8 h-8 border-4 border-[#C5A880] border-t-transparent rounded-full mb-4"></div>
        <p class="text-xs uppercase tracking-widest">Decrypting purchase records...</p>
      </div>

      <!-- Empty State -->
      <div id="orders-empty" class="hidden text-center py-20 glass-card rounded-3xl border border-white/5 p-8 max-w-md mx-auto">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-zinc-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <h3 class="text-white font-bold text-sm">No Orders Found</h3>
        <p class="text-xs text-zinc-500 mt-2">You haven't made any purchases yet. Your digital account dispatches will appear here once you check out.</p>
        <a href="/#digital" class="inline-block mt-6 px-6 py-2.5 bg-white text-black hover:bg-[#C5A880] font-bold text-xs uppercase tracking-wider rounded-xl transition-all">Browse Catalog</a>
      </div>

      <!-- Orders List Container -->
      <div id="orders-list" class="hidden space-y-6">
        <!-- Dyn list -->
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { authInstance, onAuthStateChanged, collection, dbInstance, query, where, orderBy, getDocs } from '../lib/firebase.js';

  let currentUserEmail = '';
  let currentUserUid = '';

  // DOM Elements
  const loadingSec = document.getElementById('orders-loading');
  const emptySec = document.getElementById('orders-empty');
  const listSec = document.getElementById('orders-list');
  const userBadge = document.getElementById('orders-user-badge');

  // Verify Auth on load
  onAuthStateChanged(authInstance, (user) => {
    if (!user) {
      // Not logged in -> redirect to login with query param
      window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`;
      return;
    }

    currentUserEmail = user.email || '';
    currentUserUid = user.uid || '';
    
    if (userBadge) {
      userBadge.textContent = `Logged in as: ${currentUserEmail}`;
    }

    loadOrders();
  });

  async function loadOrders() {
    try {
      const q = query(
        collection(dbInstance, 'orders'),
        where('email', '==', currentUserEmail),
        orderBy('createdAt', 'desc')
      );

      const querySnapshot = await getDocs(q);
      const orders: any[] = [];
      
      querySnapshot.docs.forEach((doc) => {
        orders.push({ id: doc.id, ...doc.data() });
      });

      if (orders.length === 0) {
        loadingSec?.classList.add('hidden');
        emptySec?.classList.remove('hidden');
        listSec?.classList.add('hidden');
        return;
      }

      renderOrders(orders);
    } catch (error) {
      console.error("Error loading customer orders:", error);
      // Fallback for firestore indexing errors: client-side filter
      try {
        const qFall = query(collection(dbInstance, 'orders'));
        const querySnapshot = await getDocs(qFall);
        const allOrders: any[] = [];
        querySnapshot.docs.forEach((doc) => {
          allOrders.push({ id: doc.id, ...doc.data() });
        });

        // Filter and sort client-side
        const filtered = allOrders
          .filter(o => o.email === currentUserEmail)
          .sort((a,b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

        if (filtered.length === 0) {
          loadingSec?.classList.add('hidden');
          emptySec?.classList.remove('hidden');
          return;
        }
        renderOrders(filtered);
      } catch (err) {
        if (loadingSec) {
          loadingSec.innerHTML = `<p class="text-red-400 text-xs">Failed to load order history. Real-time index configuring.</p>`;
        }
      }
    }
  }

  function renderOrders(orders: any[]) {
    if (!listSec) return;

    listSec.innerHTML = orders.map(order => {
      const date = new Date(order.createdAt).toLocaleDateString('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit'
      });

      // Status badge builder
      let statusColor = 'text-yellow-400 bg-yellow-500/10 border-yellow-500/20';
      let statusLabel = 'Pending Validation';

      if (order.status === 'completed' || order.status === 'paid') {
        statusColor = 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20';
        statusLabel = 'Completed';
      } else if (order.status === 'cancelled') {
        statusColor = 'text-red-400 bg-red-500/10 border-red-500/20';
        statusLabel = 'Cancelled';
      }

      // Check payment methods
      const methodLabel = order.paymentMethod === 'USDT' ? 'Cryptocurrency (USDT TRC20)' : 'Manual Bank Wire';
      const refLabel = order.paymentMethod === 'USDT' ? `TxID: ${order.txId}` : `Ref: ${order.txId}`;

      // Build cart list markup
      const cartItems = order.items.map(item => {
        const sizeTag = item.size ? `<span class="px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-400 text-[9px] uppercase font-bold">${item.size}</span>` : '';
        const isDigital = item.type === 'digital';
        const typeTag = isDigital 
          ? `<span class="px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[9px] uppercase font-bold">Digital</span>`
          : `<span class="px-1.5 py-0.5 rounded bg-[#C5A880]/10 text-[#C5A880] border border-[#C5A880]/20 text-[9px] uppercase font-bold">Physical</span>`;

        return `
          <div class="flex items-center justify-between py-3 border-b border-white/5 last:border-0">
            <div class="flex items-center gap-3">
              <img src="${item.image}" class="w-8 h-8 rounded object-cover border border-white/5" />
              <div class="text-left">
                <p class="text-xs font-bold text-white line-clamp-1">${item.name}</p>
                <div class="flex items-center gap-1.5 mt-1">
                  ${typeTag}
                  ${sizeTag}
                  <span class="text-[10px] text-zinc-500">Qty: ${item.quantity}</span>
                </div>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs font-bold text-white">$${(item.price * item.quantity).toFixed(2)}</span>
            </div>
          </div>
        `;
      }).join('');

      // Digital key display once completed
      let credentialsBlock = '';
      const hasDigitalItems = order.items.some(item => item.type === 'digital');
      if (hasDigitalItems && (order.status === 'completed' || order.status === 'paid')) {
        credentialsBlock = `
          <div class="mt-4 p-4 rounded-xl bg-emerald-950/20 border border-emerald-500/20 text-left space-y-2">
            <div class="flex items-center justify-between">
              <h4 class="text-xs font-bold text-emerald-400 uppercase tracking-wider flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 8a6 6 0 01-7.743 5.743L7.707 16.3a1 1 0 01-.707.293H5a1 1 0 01-1-1v-2a1 1 0 01.293-.707l2.557-2.557A6 6 0 1118 8zm-3.415-1.415a1 1 0 10-1.414 1.414 1 1 0 001.414-1.414z" clip-rule="evenodd" />
                </svg>
                KEY & DECRYPTION CREDENTIALS DISPATCH
              </h4>
              <span class="text-[9px] font-bold text-emerald-500 uppercase tracking-wider">Dispatched ✓</span>
            </div>
            <p class="text-[11px] text-zinc-300 font-light leading-relaxed">
              您的虚拟产品账号/API密钥已激活。请注意检查您的注册邮箱 <strong>${order.email}</strong> 获取卡密明细。如未收到，可直接联系右下角 Telegram 在线客服索取。
            </p>
            <div class="pt-1.5 flex gap-2">
              <button 
                type="button" 
                onclick="navigator.clipboard.writeText('${order.id}'); alert('Order ID copied to clipboard!');"
                class="px-3 py-1.5 rounded bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 text-[10px] font-bold transition uppercase"
              >
                Copy Order ID
              </button>
            </div>
          </div>
        `;
      }

      return `
        <div class="glass-card rounded-2xl border border-white/5 p-6 space-y-4">
          <!-- Top Row -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/5 pb-4">
            <div class="text-left space-y-0.5">
              <span class="text-[9px] font-bold text-zinc-500 uppercase tracking-widest font-mono">ORDER ID: ${order.id}</span>
              <p class="text-xs text-zinc-400">Purchased on ${date}</p>
            </div>
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-1 rounded border text-[10px] font-bold uppercase tracking-wider ${statusColor}">
                ${statusLabel}
              </span>
            </div>
          </div>

          <!-- Items Row -->
          <div class="divide-y divide-white/5">
            ${cartItems}
          </div>

          <!-- Credentials Block (If completed and has digital) -->
          ${credentialsBlock}

          <!-- Bottom Summary -->
          <div class="pt-4 border-t border-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="text-left">
              <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest block">Payment Details</span>
              <p class="text-xs text-zinc-400 mt-0.5">${methodLabel} — <span class="font-mono text-[11px] text-zinc-300">${refLabel}</span></p>
            </div>
            <div class="text-left sm:text-right">
              <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest block">Total Cost</span>
              <span class="text-lg font-black text-white">$${order.totalUsd.toFixed(2)} <span class="text-xs text-zinc-400 font-normal">(¥${order.totalCny} CNY)</span></span>
            </div>
          </div>

        </div>
      `;
    }).join('');

    loadingSec?.classList.add('hidden');
    emptySec?.classList.add('hidden');
    listSec?.classList.remove('hidden');
  }
</script>
