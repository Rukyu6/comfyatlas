---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="历史订单与会员资产 — Soul Society">
  <Header />

  <!-- 苍蓝灵压背景漫射冷焰 -->
  <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[750px] h-[350px] bg-gradient-to-b from-[#0284C7]/20 via-[#38BDF8]/10 to-transparent rounded-full filter blur-[140px] pointer-events-none z-0"></div>

  <main class="flex-grow pt-32 pb-24 px-6 max-w-5xl mx-auto w-full relative z-10 text-white animate-fadeIn font-outfit">
    <div class="space-y-8">
      
      <!-- Top header layout -->
      <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-white/10 pb-6">
        <div class="space-y-1">
          <span class="text-[#38BDF8] uppercase tracking-widest text-xs font-mono font-bold block">SOUL SOCIETY • USER VAULT</span>
          <h1 class="text-3xl font-black text-white tracking-tight">我的历史订单与资产</h1>
        </div>
        <p class="text-slate-400 text-xs mt-2 md:mt-0 font-mono flex items-center gap-2" id="orders-user-badge">
          <span class="w-2 h-2 rounded-full bg-[#38BDF8] animate-ping"></span>
          <span>正在检索当前账户权限...</span>
        </p>
      </div>

      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        
        <!-- Orders Column (lg:col-span-2) -->
        <div class="lg:col-span-2 space-y-6">
          <h2 class="text-lg font-bold text-white flex items-center gap-2.5">
            <svg class="w-5 h-5 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
            <span>我的历史订单</span>
          </h2>
          
          <!-- Loading State -->
          <div id="orders-loading" class="text-center py-20 text-slate-400">
            
            <p class="text-xs uppercase tracking-widest font-mono text-slate-300">RETRIEVING DISPATCH RECORDS...</p>
          </div>

          <!-- Empty State (彻底告别旧版土黄，纯净苍蓝高光) -->
          <div id="orders-empty" class="hidden text-center py-16 glass-card p-8 max-w-md mx-auto border border-[#38BDF8]/20 bg-[#0B0F1A]/90 rounded-3xl shadow-xl">
            <div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 mx-auto mb-3">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
            </div>
            <h3 class="text-white font-extrabold text-sm">暂无任何历史购买记录</h3>
            <p class="text-xs text-slate-400 mt-2 leading-relaxed">
              您当前账户尚未下单。下单后购买的卡密凭据与自动发货记录将永久留存于此。
            </p>
            <a 
              href="/#digital" 
              class="inline-block mt-6 px-6 py-2.5 bg-gradient-to-r from-[#0284C7] to-[#38BDF8] text-white hover:brightness-110 font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-[0_0_20px_rgba(56,189,248,0.35)] active:scale-95 cursor-pointer"
            >
              浏览数字商品库
            </a>
          </div>

          <!-- Orders List Container -->
          <div id="orders-list" class="hidden space-y-6">
          </div>

          <!-- SECTION 2: 充值记录明细 (放置在历史订单正下方，拥有宽屏精美展示) -->
          <div class="pt-8 space-y-4 border-t border-white/10">
            <div class="flex items-center justify-between">
              <h2 class="text-lg font-bold text-white flex items-center gap-2.5">
                <svg class="w-5 h-5 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <span>钱包充值申请明细</span>
              </h2>
              <span class="text-xs font-mono text-slate-400">实时链上对账存证</span>
            </div>

            <div class="glass-card p-6 bg-[#0B0F1A]/90 border border-[#38BDF8]/25 rounded-3xl shadow-xl">
              <div id="deposit-logs-container" class="space-y-3">
                <p class="text-xs text-slate-500 text-center py-6 font-mono">暂无充值申请记录</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Wallet Column (lg:col-span-1) -->
        <div class="lg:col-span-1 space-y-6">
          <h2 class="text-lg font-bold text-white flex items-center gap-2.5">
            <svg class="w-5 h-5 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
            <span>会员钱包资产</span>
          </h2>
          
          <!-- Balance Summary Card -->
          <div class="glass-card p-6 bg-[#0B0F1A]/90 border border-[#38BDF8]/30 rounded-3xl space-y-5 shadow-2xl relative overflow-hidden">
            <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-[#0284C7]/15 rounded-full filter blur-2xl pointer-events-none"></div>

            <div class="flex items-center justify-between border-b border-white/5 pb-3">
              <span class="text-xs font-bold text-slate-300 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>可用钱包余额</span>
              </span>
              <span class="text-[10px] text-emerald-400 bg-emerald-500/15 border border-emerald-500/30 px-2.5 py-0.5 rounded-full font-mono font-bold tracking-wider">
                ACTIVE 正常
              </span>
            </div>
            
            <div class="space-y-1.5 text-left">
              <div class="flex items-baseline gap-2">
                <span class="text-3xl font-black text-white tracking-tight font-mono" id="wallet-balance-usd">0.00</span>
                <span class="text-xs font-bold text-[#38BDF8] bg-[#0284C7]/20 border border-[#38BDF8]/40 px-2 py-0.5 rounded-lg font-mono">USDT</span>
              </div>
              <p class="text-xs text-slate-400 font-mono flex items-center gap-1">
                <span>≈ ¥</span>
                <span id="wallet-balance-cny" class="text-slate-200 font-bold">0.00</span>
                <span>CNY</span>
                <span class="text-[10px] text-slate-500 ml-1">(参考汇率 1:7.1)</span>
              </p>
            </div>

            <button 
              type="button" 
              id="wallet-recharge-btn"
              class="w-full py-3 rounded-2xl bg-gradient-to-r from-[#0284C7] to-[#38BDF8] hover:brightness-110 text-[#06080F] font-black text-xs uppercase tracking-wider transition-all duration-200 active:scale-95 shadow-[0_0_20px_rgba(56,189,248,0.35)] cursor-pointer flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
              <span>+ 在线充值 USDT 余额</span>
            </button>
          </div>

          <!-- Recharge Form Card (Synchronized Multi-Network Checkout Style) -->
          <div id="wallet-recharge-form-card" class="glass-card p-6 bg-[#0B0F1A]/95 border border-[#38BDF8]/40 rounded-3xl space-y-5 shadow-2xl animate-fadeIn">
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#38BDF8] animate-ping"></span>
                <h3 class="text-xs font-black text-white uppercase tracking-wider">
                  USDT 充值通道 / Multi-Network
                </h3>
              </div>
              <span class="text-[10px] text-emerald-400 font-mono font-bold bg-emerald-500/10 border border-emerald-500/30 px-2 py-0.5 rounded-full">
                ● 充值通道开启
              </span>
            </div>

            <!-- SECTION: 4 大网络选项卡（与收银台 1:1 同款） -->
            <div class="space-y-1.5 text-left">
              <label class="block text-[10px] uppercase text-slate-400 font-bold tracking-wider">选择充值支付网络</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="recharge-networks-grid">
                <!-- TRON (TRC20) -->
                <button type="button" class="recharge-network-btn flex flex-col items-center justify-center p-2.5 rounded-2xl border border-[#0284C7] bg-[#38BDF8] text-[#06080F] shadow-[0_0_15px_rgba(56,189,248,0.3)] transition active:scale-95 cursor-pointer relative" data-id="USDT_TRC20" data-address="TXLUKiCFzMsSxyAy6uR5WduCsnYXqXMJ1C" data-name="USDT (TRC-20)" data-badge="USDT TRON (TRC-20)" data-note="请向上述 TRON (TRC-20) 地址转入精确充值金额。转账成功后请复制 TxID 交易哈希进行凭据提交。">
                  <span class="text-[8px] font-black uppercase tracking-widest bg-black/20 px-1.5 py-0.5 rounded mb-1 font-mono">POPULAR</span>
                  <span class="text-xs font-black uppercase tracking-wider">TRC-20</span>
                  <span class="text-[9px] font-bold font-mono">Tron</span>
                </button>

                <!-- BSC (BEP20) -->
                <button type="button" class="recharge-network-btn flex flex-col items-center justify-center p-2.5 rounded-2xl border border-[#38BDF8]/20 bg-[#0B0F1A] text-white hover:border-[#38BDF8]/50 transition active:scale-95 cursor-pointer" data-id="USDT_BEP20" data-address="0x1d6aa81a17701932b09bd45e018af2be5efa53de" data-name="USDT (BEP-20)" data-badge="USDT BSC (BEP-20)" data-note="⚠️ 请勿使用 opBNB 链存入 USDT，否则资产不可找回。转账完成后请填写 TxID 交易哈希。">
                  <span class="text-[8px] font-black uppercase tracking-widest text-[#38BDF8] bg-[#0284C7]/20 px-1.5 py-0.5 rounded mb-1 font-mono">LOW GAS</span>
                  <span class="text-xs font-black uppercase tracking-wider">BEP-20</span>
                  <span class="text-[9px] font-bold font-mono text-slate-400">BSC</span>
                </button>

                <!-- Solana (SOL) -->
                <button type="button" class="recharge-network-btn flex flex-col items-center justify-center p-2.5 rounded-2xl border border-[#38BDF8]/20 bg-[#0B0F1A] text-white hover:border-[#38BDF8]/50 transition active:scale-95 cursor-pointer" data-id="USDT_SOL" data-address="925egwkSqvQkrGv9aCjJx5TAzcscCu9sAQMrt3VrwKXF" data-name="USDT (Solana)" data-badge="USDT Solana (SOL)" data-note="请向上述 Solana (SOL) 链地址转入精确充值金额。转账完成后填写交易哈希。">
                  <span class="text-[8px] font-black uppercase tracking-widest text-emerald-400 bg-emerald-950/40 px-1.5 py-0.5 rounded mb-1 font-mono">FAST</span>
                  <span class="text-xs font-black uppercase tracking-wider">Solana</span>
                  <span class="text-[9px] font-bold font-mono text-slate-400">SOL</span>
                </button>

                <!-- Ethereum (ERC20) -->
                <button type="button" class="recharge-network-btn flex flex-col items-center justify-center p-2.5 rounded-2xl border border-[#38BDF8]/20 bg-[#0B0F1A] text-white hover:border-[#38BDF8]/50 transition active:scale-95 cursor-pointer" data-id="USDT_ERC20" data-address="0x1d6aa81a17701932b09bd45e018af2be5efa53de" data-name="USDT (ERC-20)" data-badge="USDT Ethereum (ERC-20)" data-note="请向上述 Ethereum (ERC-20) 地址转入精确充值金额。适合大额结算。">
                  <span class="text-[8px] font-black uppercase tracking-widest text-indigo-300 bg-indigo-950/40 px-1.5 py-0.5 rounded mb-1 font-mono">ETH</span>
                  <span class="text-xs font-black uppercase tracking-wider">ERC-20</span>
                  <span class="text-[9px] font-bold font-mono text-slate-400">Mainnet</span>
                </button>
              </div>
            </div>

            <!-- Dynamic QR Code & Address Box -->
            <div class="p-4 bg-[#06080F]/90 border border-[#38BDF8]/25 rounded-2xl flex flex-col items-center gap-3 text-center">
              <div class="flex items-center justify-between w-full">
                <span id="recharge-badge-label" class="text-[10px] font-mono text-[#38BDF8] bg-[#0284C7]/20 px-2.5 py-0.5 rounded-full border border-[#38BDF8]/40 font-bold">
                  USDT TRON (TRC-20)
                </span>
                <span class="text-[10px] font-mono text-slate-400 flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  收款地址有效
                </span>
              </div>

              <div class="p-2 bg-white rounded-xl shadow-lg border border-white/20">
                <img id="recharge-qr-image" src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=TXLUKiCFzMsSxyAy6uR5WduCsnYXqXMJ1C" class="w-28 h-28 object-contain rounded" alt="USDT 收款二维码" />
              </div>

              <div class="w-full space-y-1.5">
                <div class="flex items-center gap-2 bg-[#0B0F1A] border border-white/15 rounded-xl px-3 py-2">
                  <span id="recharge-address-text" class="text-[11px] font-mono text-[#38BDF8] select-all truncate flex-1 text-left font-bold">TXLUKiCFzMsSxyAy6uR5WduCsnYXqXMJ1C</span>
                  <button type="button" id="btn-copy-address" class="px-2.5 py-1 bg-[#0284C7]/30 hover:bg-[#0284C7]/60 border border-[#38BDF8]/50 text-[#38BDF8] hover:text-white rounded-lg text-[10px] font-bold transition shrink-0 cursor-pointer flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                    <span id="btn-copy-address-text">复制地址</span>
                  </button>
                </div>
                <p id="recharge-note-text" class="text-[10px] text-slate-400 text-left leading-relaxed">
                  请向上述 TRON (TRC-20) 地址转入精确充值金额。转账成功后请复制 TxID 交易哈希进行凭据提交。
                </p>
              </div>
            </div>

            <!-- Quick Amount Pills -->
            <div class="space-y-1.5 text-left">
              <label class="block text-[10px] uppercase text-slate-400 font-bold tracking-wider">常用充值金额 (USDT)</label>
              <div class="grid grid-cols-4 gap-1.5">
                <button type="button" class="quick-amt-btn py-1.5 text-xs font-mono font-bold rounded-xl bg-white/5 border border-white/10 hover:border-[#38BDF8]/60 hover:bg-[#0284C7]/20 text-slate-200 transition active:scale-95 cursor-pointer" data-amt="20">20 U</button>
                <button type="button" class="quick-amt-btn py-1.5 text-xs font-mono font-bold rounded-xl bg-white/5 border border-white/10 hover:border-[#38BDF8]/60 hover:bg-[#0284C7]/20 text-slate-200 transition active:scale-95 cursor-pointer" data-amt="50">50 U</button>
                <button type="button" class="quick-amt-btn py-1.5 text-xs font-mono font-bold rounded-xl bg-white/5 border border-white/10 hover:border-[#38BDF8]/60 hover:bg-[#0284C7]/20 text-slate-200 transition active:scale-95 cursor-pointer" data-amt="100">100 U</button>
                <button type="button" class="quick-amt-btn py-1.5 text-xs font-mono font-bold rounded-xl bg-white/5 border border-white/10 hover:border-[#38BDF8]/60 hover:bg-[#0284C7]/20 text-slate-200 transition active:scale-95 cursor-pointer" data-amt="200">200 U</button>
              </div>
            </div>

            <!-- Recharge Form -->
            <form id="recharge-form" class="space-y-3.5">
              <input type="hidden" id="hidden-recharge-network" name="network" value="USDT (TRC-20)" />

              <div class="text-left">
                <label class="block text-[10px] uppercase text-slate-400 font-bold mb-1">充值金额 (USDT)</label>
                <div class="relative">
                  <input 
                    type="number" 
                    step="any"
                    id="recharge-amount" 
                    placeholder="输入转账的 USDT 金额"
                    required
                    class="w-full bg-[#06080F] border border-white/15 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-500 font-mono focus:outline-none focus:border-[#38BDF8] focus:ring-1 focus:ring-[#38BDF8]"
                  />
                  <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-mono font-bold text-slate-400">USDT</span>
                </div>
              </div>

              <div class="text-left">
                <label class="block text-[10px] uppercase text-slate-400 font-bold mb-1 flex items-center justify-between">
                  <span>转账交易哈希 / TxID</span>
                  <span class="text-[10px] text-slate-500 font-normal">必填，链上唯一凭据</span>
                </label>
                <input 
                  type="text" 
                  id="recharge-txid" 
                  placeholder="粘贴区块链转账成功的 64 位 TxID..."
                  required
                  class="w-full bg-[#06080F] border border-white/15 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-500 font-mono focus:outline-none focus:border-[#38BDF8] focus:ring-1 focus:ring-[#38BDF8]"
                />
              </div>

              <button 
                type="submit" 
                id="submit-recharge-btn"
                class="w-full py-3 rounded-xl bg-gradient-to-r from-[#0284C7] to-[#38BDF8] hover:brightness-110 text-[#06080F] font-black text-xs uppercase tracking-wider transition-all duration-200 active:scale-95 shadow-lg flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>确认提交转账凭证</span>
              </button>
            </form>

            <div class="p-3 rounded-xl bg-[#06080F]/60 border border-white/5 text-[10px] text-slate-400 space-y-1 text-left leading-relaxed">
              <div class="text-[#38BDF8] font-bold">充值说明：</div>
              <div>1. 向所选公链对应地址转账完成后，请务必填写实际转账金额与 TxID 凭据。</div>
              <div>2. 系统及客服审核确认链上到账后，将在 1-3 分钟内自动为您入账。</div>
            </div>
          </div>



        </div>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { authInstance, onAuthStateChanged, collection, dbInstance, query, where, orderBy, getDocs, doc, getDoc, addDoc } from '../lib/firebase.js';

  let currentUserEmail = '';
  let currentUserUid = '';

  const loadingSec = document.getElementById('orders-loading');
  const emptySec = document.getElementById('orders-empty');
  const listSec = document.getElementById('orders-list');
  const userBadge = document.getElementById('orders-user-badge');

  const rechargeBtn = document.getElementById('wallet-recharge-btn');
  const closeRechargeBtn = document.getElementById('close-recharge-btn');
  const rechargeFormCard = document.getElementById('wallet-recharge-form-card');
  const rechargeForm = document.getElementById('recharge-form') as HTMLFormElement;
  const rechargeAmount = document.getElementById('recharge-amount') as HTMLInputElement;
  const rechargeTxid = document.getElementById('recharge-txid') as HTMLInputElement;
  const submitRechargeBtn = document.getElementById('submit-recharge-btn');
  const logsContainer = document.getElementById('deposit-logs-container');

  onAuthStateChanged(authInstance, (user) => {
    if (!user) {
      window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`;
      return;
    }

    currentUserEmail = user.email || '';
    currentUserUid = user.uid || '';
    
    if (userBadge) {
      userBadge.innerHTML = `<span class="text-slate-400">已登录账号:</span> <span class="text-[#38BDF8] font-bold">${currentUserEmail}</span>`;
    }

    loadOrders();
    loadUserBalance();
    loadDeposits();
  });

  async function loadUserBalance() {
    try {
      const userDocRef = doc(dbInstance, 'users', currentUserUid);
      const userDocSnap = await getDoc(userDocRef);
      let balanceUsd = 0;
      if (userDocSnap.exists()) {
        balanceUsd = userDocSnap.data()?.balance_usd || 0;
      }
      const balanceCny = (balanceUsd * 7.1).toFixed(2);
      
      const balUsdElem = document.getElementById('wallet-balance-usd');
      const balCnyElem = document.getElementById('wallet-balance-cny');
      if (balUsdElem) balUsdElem.textContent = balanceUsd.toFixed(2);
      if (balCnyElem) balCnyElem.textContent = balanceCny;
    } catch (e) {
      console.error(e);
    }
  }

  async function loadDeposits() {
    if (!logsContainer) return;
    try {
      const q = query(collection(dbInstance, 'deposits'), where('uid', '==', currentUserUid), orderBy('createdAt', 'desc'));
      const querySnapshot = await getDocs(q);
      const deposits: any[] = [];
      querySnapshot.docs.forEach((doc) => deposits.push({ id: doc.id, ...doc.data() }));
      renderDeposits(deposits);
    } catch {
      try {
        const qFall = query(collection(dbInstance, 'deposits'));
        const querySnapshot = await getDocs(qFall);
        const allDeposits: any[] = [];
        querySnapshot.docs.forEach((doc) => allDeposits.push({ id: doc.id, ...doc.data() }));
        const filtered = allDeposits.filter(d => d.uid === currentUserUid).sort((a,b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
        renderDeposits(filtered);
      } catch {
        logsContainer.innerHTML = `<p class="text-[11px] text-rose-400 text-center py-4">加载充值明细失败</p>`;
      }
    }
  }

  function renderDeposits(deposits: any[]) {
    if (!logsContainer) return;
    if (deposits.length === 0) {
      logsContainer.innerHTML = `<p class="text-xs text-slate-500 text-center py-6 font-mono">暂无充值申请记录</p>`;
      return;
    }

    logsContainer.innerHTML = deposits.map(dep => {
      const date = new Date(dep.createdAt).toLocaleDateString('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'
      });

      let statusBadge = 'bg-amber-500/15 text-amber-400 border border-amber-500/30';
      let statusText = '审核中';
      if (dep.status === 'approved' || dep.status === 'completed') {
        statusBadge = 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 shadow-[0_0_12px_rgba(52,211,153,0.2)]';
        statusText = '已入账至余额';
      } else if (dep.status === 'rejected') {
        statusBadge = 'bg-rose-500/15 text-rose-400 border border-rose-500/30';
        statusText = '未通过';
      }

      const networkTag = dep.network || 'USDT (TRC-20)';

      return `
        <div class="p-4 bg-[#06080F] border border-white/10 rounded-2xl text-left space-y-2.5 transition hover:border-[#38BDF8]/40">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-white/5 pb-2.5">
            <div class="flex items-center gap-2.5">
              <span class="px-2.5 py-0.5 rounded-lg bg-[#0284C7]/20 border border-[#38BDF8]/40 text-[#38BDF8] text-[10px] font-mono font-bold">
                ${networkTag}
              </span>
              <span class="text-sm font-black text-white font-mono">+ $${Number(dep.amount).toFixed(2)} USDT</span>
            </div>
            <span class="px-2.5 py-0.5 border rounded-full text-[10px] font-bold self-start sm:self-auto ${statusBadge}">
              ${statusText}
            </span>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 text-[11px] text-slate-400 font-mono">
            <div class="flex items-center gap-1.5 truncate max-w-full sm:max-w-[70%]">
              <span class="text-slate-500 shrink-0">TxID:</span>
              <span class="truncate select-all text-slate-300 font-mono">${dep.txId}</span>
              <button type="button" onclick="navigator.clipboard.writeText('${dep.txId}'); alert('TxID 已复制！');" class="text-[#38BDF8] hover:underline shrink-0 text-[10px] ml-1 cursor-pointer">[复制]</button>
            </div>
            <span class="text-slate-500 shrink-0 text-[10px]">提交时间: ${date}</span>
          </div>
        </div>
      `;
    }).join('');
  }

  // 4 大多链切换与地址联动
  let currentRechargeAddress = 'TXLUKiCFzMsSxyAy6uR5WduCsnYXqXMJ1C';
  let currentRechargeNetwork = 'USDT (TRC-20)';

  const networkBtns = document.querySelectorAll('.recharge-network-btn');
  const rechargeQrImage = document.getElementById('recharge-qr-image') as HTMLImageElement;
  const rechargeAddressText = document.getElementById('recharge-address-text');
  const rechargeBadgeLabel = document.getElementById('recharge-badge-label');
  const rechargeNoteText = document.getElementById('recharge-note-text');
  const hiddenNetworkInput = document.getElementById('hidden-recharge-network') as HTMLInputElement;

  networkBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const address = btn.getAttribute('data-address') || '';
      const name = btn.getAttribute('data-name') || '';
      const badge = btn.getAttribute('data-badge') || '';
      const note = btn.getAttribute('data-note') || '';

      currentRechargeAddress = address;
      currentRechargeNetwork = name;

      if (rechargeAddressText) rechargeAddressText.textContent = address;
      if (rechargeBadgeLabel) rechargeBadgeLabel.textContent = badge;
      if (rechargeNoteText) rechargeNoteText.textContent = note;
      if (rechargeQrImage) rechargeQrImage.src = `https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=${address}`;
      if (hiddenNetworkInput) hiddenNetworkInput.value = name;

      // 切换按钮高亮样式（与收银台一致）
      networkBtns.forEach(b => {
        b.className = 'recharge-network-btn flex flex-col items-center justify-center p-2.5 rounded-2xl border border-[#38BDF8]/20 bg-[#0B0F1A] text-white hover:border-[#38BDF8]/50 transition active:scale-95 cursor-pointer';
      });
      btn.className = 'recharge-network-btn flex flex-col items-center justify-center p-2.5 rounded-2xl border border-[#0284C7] bg-[#38BDF8] text-[#06080F] shadow-[0_0_15px_rgba(56,189,248,0.3)] transition active:scale-95 cursor-pointer relative';
    });
  });

  // 一键复制动态地址
  const btnCopyAddress = document.getElementById('btn-copy-address');
  const btnCopyAddressText = document.getElementById('btn-copy-address-text');
  btnCopyAddress?.addEventListener('click', () => {
    navigator.clipboard.writeText(currentRechargeAddress);
    if (btnCopyAddressText) btnCopyAddressText.textContent = '✓ 已复制';
    setTimeout(() => {
      if (btnCopyAddressText) btnCopyAddressText.textContent = '复制地址';
    }, 2000);
  });

  // 快捷金额填充
  const quickAmtBtns = document.querySelectorAll('.quick-amt-btn');
  quickAmtBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const amt = btn.getAttribute('data-amt');
      if (rechargeAmount && amt) {
        rechargeAmount.value = amt;
      }
      quickAmtBtns.forEach(b => b.classList.remove('border-[#38BDF8]', 'text-[#38BDF8]', 'bg-[#0284C7]/20'));
      btn.classList.add('border-[#38BDF8]', 'text-[#38BDF8]', 'bg-[#0284C7]/20');
    });
  });

  rechargeBtn?.addEventListener('click', () => rechargeFormCard?.classList.toggle('hidden'));
  closeRechargeBtn?.addEventListener('click', () => rechargeFormCard?.classList.add('hidden'));

  rechargeForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const amount = parseFloat(rechargeAmount.value);
    const txId = rechargeTxid.value.trim();

    if (isNaN(amount) || amount <= 0 || !txId) {
      alert("请输入有效的金额与转账 TxID 凭据！");
      return;
    }

    submitRechargeBtn?.setAttribute('disabled', 'true');
    try {
      await addDoc(collection(dbInstance, 'deposits'), {
        uid: currentUserUid,
        email: currentUserEmail,
        amount: amount,
        network: currentRechargeNetwork,
        txId: txId,
        status: 'pending',
        createdAt: new Date().toISOString()
      });
      alert("充值申请已提交！审核完成后将自动为您入账。");
      rechargeForm.reset();
      rechargeFormCard?.classList.add('hidden');
      loadUserBalance();
      loadDeposits();
    } catch {
      alert("提交异常，请稍后重试。");
    } finally {
      submitRechargeBtn?.removeAttribute('disabled');
    }
  });

  async function loadOrders() {
    try {
      const q = query(collection(dbInstance, 'orders'), where('email', '==', currentUserEmail));
      const querySnapshot = await getDocs(q);
      const orders: any[] = [];
      const hiddenList = JSON.parse(localStorage.getItem('hidden_orders_' + currentUserEmail) || '[]');
      querySnapshot.docs.forEach((doc) => {
        const data = doc.data();
        if (!data.deletedByUser && !hiddenList.includes(doc.id)) {
          orders.push({ id: doc.id, ...data });
        }
      });

      orders.sort((a, b) => new Date(b.createdAt || 0).getTime() - new Date(a.createdAt || 0).getTime());

      if (orders.length === 0) {
        loadingSec?.classList.add('hidden');
        emptySec?.classList.remove('hidden');
        listSec?.classList.add('hidden');
        return;
      }
      renderOrders(orders);
    } catch (err) {
      console.warn('loadOrders fallback to empty state:', err);
      loadingSec?.classList.add('hidden');
      emptySec?.classList.remove('hidden');
      listSec?.classList.add('hidden');
    }
  }

  function renderOrders(orders: any[]) {
    if (!listSec) return;

    listSec.innerHTML = orders.map(order => {
      const date = new Date(order.createdAt).toLocaleDateString('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'
      });

      let statusColor = 'text-amber-400 bg-amber-500/15 border border-amber-500/30';
      let statusLabel = '配货审核中';
      if (order.status === 'completed' || order.status === 'paid') {
        statusColor = 'text-[#38BDF8] bg-[#0284C7]/20 border border-[#38BDF8]/40 shadow-[0_0_12px_rgba(56,189,248,0.25)]';
        statusLabel = '已交付完成';
      } else if (order.status === 'cancelled') {
        statusColor = 'text-slate-400 bg-white/5 border border-white/10';
        statusLabel = '已取消';
      }

      const cartItems = (order.items || []).map(item => `
        <div class="flex items-center justify-between py-3 border-b border-white/5 last:border-0">
          <div class="flex items-center gap-3">
            <img src="${item.image || '/images/soul_society_logo.jpg'}" onerror="this.onerror=null;this.src='/images/soul_society_logo.jpg';" class="w-9 h-9 rounded-xl object-cover bg-black/40 border border-white/10" />
            <div class="text-left">
              <p class="text-xs font-bold text-white line-clamp-1">${item.name}</p>
              <div class="flex items-center gap-2 mt-0.5">
                <span class="px-1.5 py-0.2 rounded bg-[#0284C7]/20 text-[#38BDF8] text-[9px] font-mono">DIGITAL</span>
                <span class="text-[10px] text-slate-400">数量: ${item.quantity || 1}</span>
              </div>
            </div>
          </div>
          <span class="text-xs font-bold font-mono text-[#38BDF8]">$${Math.ceil(Number(item.price * (item.quantity || 1)))}</span>
        </div>
      `).join('');

      let credentialsBlock = '';
      if (order.status === 'completed' || order.status === 'paid') {
        const keyContent = order.dispatchContent || order.id;
        credentialsBlock = `
          <div class="p-3.5 bg-[#0284C7]/10 border border-[#38BDF8]/30 text-left space-y-2 rounded-2xl mt-3">
            <div class="flex items-center justify-between">
              <h4 class="text-xs font-bold text-[#38BDF8] uppercase tracking-wider flex items-center gap-1.5 font-mono">
                <svg class="w-3.5 h-3.5 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                </svg>
                <span>卡密凭证 (CREDENTIALS)</span>
              </h4>
              <button 
                type="button" 
                onclick="navigator.clipboard.writeText('${keyContent}'); alert('卡密已成功复制到剪贴板！');"
                class="px-2.5 py-1 bg-[#0284C7]/30 hover:bg-[#0284C7]/50 border border-[#38BDF8]/40 text-[#38BDF8] hover:text-white text-[10px] font-bold rounded-lg transition"
              >
                一键复制
              </button>
            </div>
            <div class="p-2.5 bg-[#06080F] border border-[#38BDF8]/40 rounded-xl font-mono text-xs text-[#38BDF8] break-all select-all shadow-inner leading-relaxed">
              ${order.dispatchContent || '凭证已自动核销完成，如有疑问可联系在线客服。'}
            </div>
          </div>
        `;
      }

      return `
        <div id="order-card-${order.id}" class="glass-card p-6 bg-[#0B0F1A]/90 border border-[#38BDF8]/20 rounded-3xl space-y-4 text-white shadow-xl transition-all duration-300">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3.5 border-b border-white/5">
            <div class="text-left">
              <span class="text-[10px] font-mono font-bold text-[#38BDF8]">单号: ${order.id}</span>
              <p class="text-[10px] text-slate-500 font-mono mt-0.5">下单时间: ${date}</p>
            </div>
            <span class="px-2.5 py-0.5 rounded-full border text-[10px] font-bold ${statusColor} w-fit">
              ${statusLabel}
            </span>
          </div>

          <div class="space-y-1">
            ${cartItems}
          </div>

          ${credentialsBlock}

          <div class="pt-3.5 border-t border-white/5 flex items-center justify-between">
            <div class="flex items-baseline gap-2">
              <span class="text-xs text-slate-400">实付总额</span>
              <span class="text-base font-black text-[#38BDF8] font-mono">$${Number(order.totalUsd || order.totalPrice || 0).toFixed(2)}</span>
            </div>
            <button 
              type="button" 
              class="btn-delete-order flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-rose-500/15 border border-white/10 hover:border-rose-500/40 text-slate-400 hover:text-rose-400 text-xs font-bold transition-all duration-200 cursor-pointer active:scale-95 group" 
              data-order-id="${order.id}"
            >
              <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-rose-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
              <span>删除订单</span>
            </button>
          </div>
        </div>
      `;
    }).join('');

    loadingSec?.classList.add('hidden');
    emptySec?.classList.add('hidden');
    listSec?.classList.remove('hidden');
  }
</script>
