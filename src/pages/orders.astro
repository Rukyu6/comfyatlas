---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="My Orders — WorldClaw">
  <Header />

  <main class="flex-grow pt-32 pb-24 px-6 max-w-5xl mx-auto w-full relative z-10 text-white bg-black animate-fadeIn">
    <div class="space-y-8">
      
      <!-- Top header layout -->
      <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-[#292929] pb-6">
        <div class="space-y-1">
          <span class="text-[#E7AC08] uppercase tracking-widest text-[10px] font-bold font-sora block">Customer Center</span>
          <h1 class="text-3xl font-extrabold font-sora text-white">Order Vault</h1>
        </div>
        <p class="text-zinc-400 text-xs mt-2 md:mt-0 font-sora font-semibold" id="orders-user-badge">
          Retrieving credentials...
        </p>
      </div>

      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        
        <!-- Orders Column (lg:col-span-2) -->
        <div class="lg:col-span-2 space-y-6">
          <h2 class="text-lg font-bold font-sora text-white flex items-center gap-2">
            📦 我的历史订单 / Order History
          </h2>
          
          <!-- Loading State -->
          <div id="orders-loading" class="text-center py-24 text-zinc-500">
            <div class="animate-spin inline-block w-8 h-8 border-4 border-[#E7AC08] border-t-transparent rounded-full mb-4"></div>
            <p class="text-xs uppercase tracking-widest font-sora font-semibold">Retrieving purchase records...</p>
          </div>

          <!-- Empty State -->
          <div id="orders-empty" class="hidden text-center py-20 glass-card p-8 max-w-md mx-auto border border-[#292929] bg-[#1C1917]/50 backdrop-blur-xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-zinc-500 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <h3 class="text-white font-bold text-sm font-sora">No Orders Found</h3>
            <p class="text-xs text-zinc-400 mt-2 font-sora">You haven't made any purchases yet. Your digital account dispatches will appear here once you check out.</p>
            <a href="/#digital" class="inline-block mt-6 px-6 py-2.5 bg-[#E7AC08] text-[#080808] hover:bg-[#FAC514] border border-[#FAC514] font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-md active:scale-95 cursor-pointer">Browse Catalog</a>
          </div>

          <!-- Orders List Container -->
          <div id="orders-list" class="hidden space-y-6">
            <!-- Dyn list -->
          </div>
        </div>

        <!-- Wallet Column (lg:col-span-1) -->
        <div class="lg:col-span-1 space-y-6">
          <h2 class="text-lg font-bold font-sora text-white flex items-center gap-2">
            👛 会员钱包 / Member Wallet
          </h2>
          
          <!-- Balance Card -->
          <div class="glass-card p-6 bg-[#1C1917]/50 border border-[#292929] rounded-3xl space-y-4">
            <div>
              <span class="text-[9px] font-bold text-zinc-400 uppercase tracking-widest font-sora">Current Balance / 当前余额</span>
              <div class="text-3xl font-black text-white font-sora mt-1">
                $<span id="wallet-balance-usd">0.00</span> 
                <span class="text-xs text-zinc-400 font-normal font-sans block mt-1">≈ ¥<span id="wallet-balance-cny">0.00</span> CNY</span>
              </div>
            </div>
            
            <button 
              type="button" 
              id="wallet-recharge-btn"
              class="w-full py-2.5 rounded-xl bg-[#E7AC08] border border-[#FAC514] text-[#080808] hover:bg-[#FAC514] font-bold uppercase tracking-wider text-xs font-sora transition-all duration-300 shadow-md active:scale-95 cursor-pointer text-center"
            >
              USDT 充值余额 / Deposit 💰
            </button>
          </div>

          <!-- Recharge Form -->
          <div id="wallet-recharge-form-card" class="hidden glass-card p-6 bg-[#1C1917]/70 border border-[#292929] rounded-3xl space-y-4 backdrop-blur-xl">
            <div class="flex items-center justify-between">
              <h3 class="text-xs font-bold text-white uppercase tracking-wider font-sora">
                USDT (TRC20) 充值申请
              </h3>
              <button type="button" id="close-recharge-btn" class="text-zinc-400 hover:text-white font-bold text-sm">✕</button>
            </div>
            
            <div class="p-3 bg-sky-950/20 border border-sky-900 rounded-2xl text-[10px] text-sky-300 space-y-1 leading-relaxed font-semibold">
              <p>🔔 <strong>充值步骤：</strong></p>
              <p>1. 向下方 TRC20 地址转账需要的充值金额 (1 USDT = $1 USD)</p>
              <p class="bg-black p-2 rounded-lg font-mono text-center select-all border border-[#292929] text-white break-all text-[9px] my-1">TYB1m6qjYVNW83qQ4JqT636S7CKeJ8e1k2</p>
              <p class="text-[9px] text-sky-350">（充值使用 USDT 充值，可 0 手续费下单，转账完成后提交 TxID 凭证）</p>
              <p>2. 在下方表单中填入转账金额和 TxID 凭证提交审核。</p>
            </div>

            <form id="recharge-form" class="space-y-3">
              <div>
                <label class="block text-[9px] uppercase text-zinc-400 font-bold tracking-wider mb-1 font-sora">充值金额 / Amount (USDT)</label>
                <input 
                  type="number" 
                  id="recharge-amount" 
                  min="1" 
                  step="0.01" 
                  required 
                  placeholder="如: 10" 
                  class="w-full bg-black border border-[#292929] rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#E7AC08] focus:ring-1 focus:ring-[#E7AC08] transition font-sora font-semibold"
                />
              </div>
              
              <div>
                <label class="block text-[9px] uppercase text-zinc-400 font-bold tracking-wider mb-1 font-sora">交易哈希 / TxID (Transaction Hash)</label>
                <input 
                  type="text" 
                  id="recharge-txid" 
                  required 
                  placeholder="请输入转账交易哈希 TxID" 
                  class="w-full bg-black border border-[#292929] rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#E7AC08] focus:ring-1 focus:ring-[#E7AC08] transition font-sora font-semibold"
                />
              </div>

              <button 
                type="submit" 
                id="submit-recharge-btn"
                class="w-full py-2.5 rounded-xl bg-emerald-950/40 hover:bg-emerald-900/40 border border-emerald-850 text-emerald-300 font-bold uppercase tracking-wider text-xs font-sora transition-all duration-300 shadow-md active:scale-95 cursor-pointer text-center flex items-center justify-center gap-2"
              >
                <span>提交充值申请 / Submit Request</span>
              </button>
            </form>
          </div>

          <!-- Deposit History Card -->
          <div class="glass-card p-6 bg-[#1C1917]/50 border border-[#292929] rounded-3xl space-y-4">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider font-sora">
              📝 充值记录 / Deposit Log
            </h3>
            <div id="deposit-logs-container" class="space-y-3 max-h-[250px] overflow-y-auto pr-1">
              <p class="text-[10px] text-zinc-500 text-center py-4">暂无充值记录 / No logs yet</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { authInstance, onAuthStateChanged, collection, dbInstance, query, where, orderBy, getDocs, doc, getDoc, addDoc } from '../lib/firebase.js';

  let currentUserEmail = '';
  let currentUserUid = '';

  // DOM Elements
  const loadingSec = document.getElementById('orders-loading');
  const emptySec = document.getElementById('orders-empty');
  const listSec = document.getElementById('orders-list');
  const userBadge = document.getElementById('orders-user-badge');

  // Wallet DOM Elements
  const rechargeBtn = document.getElementById('wallet-recharge-btn');
  const closeRechargeBtn = document.getElementById('close-recharge-btn');
  const rechargeFormCard = document.getElementById('wallet-recharge-form-card');
  const rechargeForm = document.getElementById('recharge-form') as HTMLFormElement;
  const rechargeAmount = document.getElementById('recharge-amount') as HTMLInputElement;
  const rechargeTxid = document.getElementById('recharge-txid') as HTMLInputElement;
  const submitRechargeBtn = document.getElementById('submit-recharge-btn');
  const logsContainer = document.getElementById('deposit-logs-container');

  // Verify Auth on load
  onAuthStateChanged(authInstance, (user) => {
    if (!user) {
      // Not logged in -> redirect to login with query param
      window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`;
      return;
    }

    currentUserEmail = user.email || '';
    currentUserUid = user.uid || '';
    
    if (userBadge) {
      userBadge.textContent = `Logged in as: ${currentUserEmail}`;
    }

    loadOrders();
    loadUserBalance();
    loadDeposits();
  });

  async function loadUserBalance() {
    try {
      const userDocRef = doc(dbInstance, 'users', currentUserUid);
      const userDocSnap = await getDoc(userDocRef);
      let balanceUsd = 0;
      if (userDocSnap.exists()) {
        balanceUsd = userDocSnap.data()?.balance_usd || 0;
      }
      const balanceCny = (balanceUsd * 6.8).toFixed(2);
      
      const balUsdElem = document.getElementById('wallet-balance-usd');
      const balCnyElem = document.getElementById('wallet-balance-cny');
      if (balUsdElem) balUsdElem.textContent = balanceUsd.toFixed(2);
      if (balCnyElem) balCnyElem.textContent = balanceCny;
    } catch (e) {
      console.error("Failed to load user balance:", e);
    }
  }

  async function loadDeposits() {
    if (!logsContainer) return;

    try {
      const q = query(
        collection(dbInstance, 'deposits'),
        where('uid', '==', currentUserUid),
        orderBy('createdAt', 'desc')
      );

      const querySnapshot = await getDocs(q);
      const deposits: any[] = [];
      querySnapshot.docs.forEach((doc) => {
        deposits.push({ id: doc.id, ...doc.data() });
      });

      renderDeposits(deposits);
    } catch (error) {
      console.error("Error loading deposits:", error);
      // Fallback
      try {
        const qFall = query(collection(dbInstance, 'deposits'));
        const querySnapshot = await getDocs(qFall);
        const allDeposits: any[] = [];
        querySnapshot.docs.forEach((doc) => {
          allDeposits.push({ id: doc.id, ...doc.data() });
        });

        const filtered = allDeposits
          .filter(d => d.uid === currentUserUid)
          .sort((a,b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

        renderDeposits(filtered);
      } catch (err) {
        logsContainer.innerHTML = `<p class="text-[10px] text-red-500 text-center py-4">加载失败 / Failed to load</p>`;
      }
    }
  }

  function renderDeposits(deposits: any[]) {
    if (!logsContainer) return;
    
    if (deposits.length === 0) {
      logsContainer.innerHTML = `<p class="text-[10px] text-zinc-500 text-center py-4">暂无充值记录 / No logs yet</p>`;
      return;
    }

    logsContainer.innerHTML = deposits.map(dep => {
      const date = new Date(dep.createdAt).toLocaleDateString('zh-CN', {
        month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'
      });

      let statusBadge = 'bg-amber-950/20 text-amber-400 border border-amber-900';
      let statusText = '审核中 (Pending)';
      if (dep.status === 'approved') {
        statusBadge = 'bg-emerald-950/20 text-emerald-400 border border-emerald-900';
        statusText = '已到账 (Approved)';
      } else if (dep.status === 'rejected') {
        statusBadge = 'bg-rose-950/20 text-rose-400 border border-rose-900';
        statusText = '已拒绝 (Rejected)';
      }

      return `
        <div class="p-3 bg-black border border-[#292929] rounded-xl text-left space-y-1 shadow-md">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-extrabold text-white font-sora">+ $${Number(dep.amount).toFixed(2)} USDT</span>
            <span class="px-1.5 py-0.5 border rounded-lg text-[8px] font-bold ${statusBadge}">
              ${statusText}
            </span>
          </div>
          <div class="text-[8px] text-zinc-550 font-mono flex flex-col gap-0.5">
            <span class="truncate select-all">TxID: ${dep.txId}</span>
            <span>时间: ${date}</span>
          </div>
        </div>
      `;
    }).join('');
  }

  // Toggles recharge form
  rechargeBtn?.addEventListener('click', () => {
    rechargeFormCard?.classList.toggle('hidden');
  });

  closeRechargeBtn?.addEventListener('click', () => {
    rechargeFormCard?.classList.add('hidden');
  });

  // Submit recharge form
  rechargeForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const amount = parseFloat(rechargeAmount.value);
    const txId = rechargeTxid.value.trim();

    if (isNaN(amount) || amount <= 0 || !txId) {
      alert("请输入有效的金额和转账 TxID 凭证！");
      return;
    }

    if (submitRechargeBtn) {
      submitRechargeBtn.setAttribute('disabled', 'true');
      const span = submitRechargeBtn.querySelector('span');
      if (span) span.textContent = '提交中 / Submitting...';
    }

    try {
      const newDeposit = {
        uid: currentUserUid,
        email: currentUserEmail,
        amount: amount,
        txId: txId,
        status: 'pending',
        createdAt: new Date().toISOString()
      };

      await addDoc(collection(dbInstance, 'deposits'), newDeposit);

      // Support Bot Notify
      try {
        await fetch('/api/support-notify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: 'deposit',
            email: currentUserEmail,
            amount: amount,
            txId: txId
          })
        });
      } catch (err) {
        console.error("Support bot notify failed:", err);
      }

      alert("充值申请已提交！管理员将尽快审核入账，审核结果会在此页面显示。");
      rechargeForm.reset();
      rechargeFormCard?.classList.add('hidden');

      loadUserBalance();
      loadDeposits();
    } catch (err) {
      console.error("Recharge submission failed:", err);
      alert("提交失败，请重试。");
    } finally {
      if (submitRechargeBtn) {
        submitRechargeBtn.removeAttribute('disabled');
        const span = submitRechargeBtn.querySelector('span');
        if (span) span.textContent = '提交充值申请 / Submit Request';
      }
    }
  });

  async function loadOrders() {
    try {
      const q = query(
        collection(dbInstance, 'orders'),
        where('email', '==', currentUserEmail),
        orderBy('createdAt', 'desc')
      );

      const querySnapshot = await getDocs(q);
      const orders: any[] = [];
      
      querySnapshot.docs.forEach((doc) => {
        orders.push({ id: doc.id, ...doc.data() });
      });

      if (orders.length === 0) {
        loadingSec?.classList.add('hidden');
        emptySec?.classList.remove('hidden');
        listSec?.classList.add('hidden');
        return;
      }

      renderOrders(orders);
    } catch (error) {
      console.error("Error loading customer orders:", error);
      // Fallback for firestore indexing errors: client-side filter
      try {
        const qFall = query(collection(dbInstance, 'orders'));
        const querySnapshot = await getDocs(qFall);
        const allOrders: any[] = [];
        querySnapshot.docs.forEach((doc) => {
          allOrders.push({ id: doc.id, ...doc.data() });
        });

        // Filter and sort client-side
        const filtered = allOrders
          .filter(o => o.email === currentUserEmail)
          .sort((a,b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

        if (filtered.length === 0) {
          loadingSec?.classList.add('hidden');
          emptySec?.classList.remove('hidden');
          return;
        }
        renderOrders(filtered);
      } catch (err) {
        if (loadingSec) {
          loadingSec.innerHTML = `<p class="text-red-500 text-xs">Failed to load order history. Real-time index configuring.</p>`;
        }
      }
    }
  }

  function renderOrders(orders: any[]) {
    if (!listSec) return;

    listSec.innerHTML = orders.map(order => {
      const date = new Date(order.createdAt).toLocaleDateString('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit'
      });

      // Status badge builder
      let statusColor = 'text-amber-400 bg-amber-950/20 border-amber-900';
      let statusLabel = 'Pending Validation';

      if (order.status === 'completed' || order.status === 'paid') {
        statusColor = 'text-emerald-400 bg-emerald-950/20 border-emerald-900';
        statusLabel = 'Completed';
      } else if (order.status === 'cancelled') {
        statusColor = 'text-rose-400 bg-rose-950/20 border-rose-900';
        statusLabel = 'Cancelled';
      }

      // Check payment methods
      const methodLabel = order.paymentMethod || 'Cryptocurrency';
      const refLabel = `TxID: ${order.txId || ''}`;

      // Build cart list markup
      const cartItems = order.items.map(item => {
        const sizeTag = item.size ? `<span class="px-1.5 py-0.5 rounded bg-rose-950/40 text-rose-450 border border-rose-900 text-[9px] uppercase font-bold font-sora">${item.size}</span>` : '';
        const isDigital = item.type === 'digital';
        const typeTag = isDigital 
          ? `<span class="px-1.5 py-0.5 rounded bg-emerald-950/40 text-emerald-450 border border-emerald-900 text-[9px] uppercase font-bold font-sora">Digital</span>`
          : `<span class="px-1.5 py-0.5 rounded bg-amber-950/40 text-amber-450 border border-amber-900 text-[9px] uppercase font-bold font-sora">Physical</span>`;

        return `
          <div class="flex items-center justify-between py-3 border-b border-[#292929] last:border-0">
            <div class="flex items-center gap-3">
              <img src="${item.image}" class="w-8 h-8 rounded-lg object-cover border border-white/10" />
              <div class="text-left">
                <p class="text-xs font-bold text-white line-clamp-1">${item.name}</p>
                <div class="flex items-center gap-1.5 mt-1">
                  ${typeTag}
                  ${sizeTag}
                  <span class="text-[10px] text-zinc-500 font-sans">Qty: ${item.quantity}</span>
                </div>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs font-bold text-[#E7AC08] font-sora">$${(item.price * item.quantity).toFixed(2)}</span>
            </div>
          </div>
        `;
      }).join('');

      // Digital key display once completed
      let credentialsBlock = '';
      const hasDigitalItems = order.items.some(item => item.type === 'digital');
      if (hasDigitalItems) {
        if (order.status === 'completed' || order.status === 'paid') {
          const keyText = order.dispatchContent 
            ? `<div class="p-3 bg-black border border-[#292929] rounded-xl font-mono text-xs text-emerald-400 break-all select-all mt-1.5">${order.dispatchContent}</div>` 
            : `<p class="text-[11px] text-zinc-300 font-light leading-relaxed font-sora">卡密明细已激活，如邮箱 <strong>${order.email}</strong> 未收到，请联系右下角客服索取。</p>`;

          credentialsBlock = `
            <div class="mt-4 p-4 bg-emerald-950/20 border border-emerald-900 text-left space-y-2 rounded-2xl">
              <div class="flex items-center justify-between">
                <h4 class="text-xs font-bold text-emerald-400 uppercase tracking-wider flex items-center gap-2 font-sora">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 8a6 6 0 01-7.743 5.743L7.707 16.3a1 1 0 01-.707.293H5a1 1 0 01-1-1v-2a1 1 0 01.293-.707l2.557-2.557A6 6 0 1118 8zm-3.415-1.415a1 1 0 10-1.414 1.414 1 1 0 001.414-1.414z" clip-rule="evenodd" />
                  </svg>
                  卡密/账号提取
                </h4>
                <span class="text-[9px] font-bold text-emerald-500 uppercase tracking-wider font-sora">Dispatched ✓</span>
              </div>
              <p class="text-[11px] text-zinc-300 font-light leading-relaxed font-sora">
                您的虚拟产品账号/API密钥已激活。请保存您的发货明细：
              </p>
              ${keyText}
              <div class="pt-1.5 flex gap-2">
                <button 
                  type="button" 
                  onclick="navigator.clipboard.writeText('${order.dispatchContent || order.id}'); alert('Copied key details to clipboard!');"
                  class="px-3 py-1.5 bg-emerald-950/40 hover:bg-emerald-900/40 border border-emerald-800 text-emerald-300 text-[10px] font-bold rounded-xl transition-all uppercase font-sora"
                >
                  Copy Credentials
                </button>
              </div>
            </div>
          `;
        } else if (order.status === 'pending') {
          credentialsBlock = `
            <div class="mt-4 p-4 bg-amber-950/20 border border-amber-900 text-left space-y-2 rounded-2xl animate-pulse">
              <div class="flex items-center justify-between">
                <h4 class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-2 font-sora">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.8 2.8a1 1 0 101.414-1.414L11 9.586V6z" clip-rule="evenodd" />
                  </svg>
                  配货处理中 (Fulfilling manually)
                </h4>
                <span class="text-[9px] font-bold text-amber-500 uppercase tracking-wider font-sora">In Progress...</span>
              </div>
              <p class="text-[11px] text-zinc-300 leading-relaxed font-bold font-sora">
                管理员正在为您加急调配卡密，通常需要 5~15 分钟，发货后卡密将在此直接呈现。请稍后刷新本页查看，或联系右下角客服机器人咨询。
              </p>
            </div>
          `;
        }
      }

      return `
        <div class="glass-card p-6 bg-[#1C1917]/50 border border-[#292929] rounded-3xl space-y-4 text-white">
          <!-- Top Row -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#292929] pb-4">
            <div class="text-left space-y-0.5 font-sora">
              <span class="text-[9px] font-bold text-zinc-500 uppercase tracking-widest font-mono">ORDER ID: ${order.id}</span>
              <p class="text-xs text-zinc-500">Purchased on ${date}</p>
            </div>
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-1 rounded-full border text-[10px] font-bold uppercase tracking-wider font-sora ${statusColor}">
                ${statusLabel}
              </span>
            </div>
          </div>

          <!-- Items Row -->
          <div class="divide-y divide-[#292929]">
            ${cartItems}
          </div>

          <!-- Credentials Block (If completed and has digital) -->
          ${credentialsBlock}

          <!-- Bottom Summary -->
          <div class="pt-4 border-t border-[#292929] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="text-left font-sora">
              <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest block">Payment Details</span>
              <p class="text-xs text-zinc-350 mt-0.5">${methodLabel} — <span class="font-mono text-[11px] text-[#E7AC08] font-bold">${refLabel}</span></p>
            </div>
            <div class="text-left sm:text-right font-sora">
              <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest block">Total Cost</span>
              <span class="text-lg font-black text-[#E7AC08] font-sora">$${order.totalUsd.toFixed(2)} <span class="text-xs text-zinc-400 font-normal font-sans">(¥${order.totalCny} CNY)</span></span>
            </div>
          </div>

        </div>
      `;
    }).join('');

    loadingSec?.classList.add('hidden');
    emptySec?.classList.add('hidden');
    listSec?.classList.remove('hidden');
  }
</script>
