---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="My Orders — Puppy Shop">
  <Header />

  <main class="flex-grow pt-32 pb-24 px-6 max-w-5xl mx-auto w-full relative z-10">
    <div class="space-y-8">
      
      <!-- Top header layout -->
      <div class="flex flex-col md:flex-row md:items-end justify-between border-b-3 border-[#3E2A1E]/20 pb-6">
        <div class="space-y-1">
          <span class="text-[#FF9EAF] uppercase tracking-widest text-[10px] font-bold font-fredoka block">Customer Center</span>
          <h1 class="text-3xl font-extrabold font-fredoka text-[#3E2A1E]">Order Vault</h1>
        </div>
        <p class="text-zinc-600 text-xs mt-2 md:mt-0 font-fredoka" id="orders-user-badge">
          Retrieving credentials...
        </p>
      </div>

      <!-- Loading State -->
      <div id="orders-loading" class="text-center py-24 text-zinc-600">
        <div class="animate-spin inline-block w-8 h-8 border-4 border-[#FF9EAF] border-t-transparent rounded-full mb-4"></div>
        <p class="text-xs uppercase tracking-widest font-fredoka">Retrieving purchase records...</p>
      </div>

      <!-- Empty State -->
      <div id="orders-empty" class="hidden text-center py-20 glass-card p-8 max-w-md mx-auto">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[#3E2A1E]/40 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <h3 class="text-[#3E2A1E] font-bold text-sm font-fredoka">No Orders Found</h3>
        <p class="text-xs text-zinc-600 mt-2">You haven't made any purchases yet. Your digital account dispatches will appear here once you check out.</p>
        <a href="/#digital" class="inline-block mt-6 px-6 py-2.5 bg-[#FF9EAF] text-white hover:bg-[#FF6B8B] font-bold text-xs uppercase tracking-wider rounded-xl border-2 border-[#3E2A1E] shadow-[2px_2px_0px_#3E2A1E] transition-all hover:translate-y-[-2px] hover:shadow-[4px_4px_0px_#3E2A1E]">Browse Catalog</a>
      </div>

      <!-- Orders List Container -->
      <div id="orders-list" class="hidden space-y-6">
        <!-- Dyn list -->
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { authInstance, onAuthStateChanged, collection, dbInstance, query, where, orderBy, getDocs } from '../lib/firebase.js';

  let currentUserEmail = '';
  let currentUserUid = '';

  // DOM Elements
  const loadingSec = document.getElementById('orders-loading');
  const emptySec = document.getElementById('orders-empty');
  const listSec = document.getElementById('orders-list');
  const userBadge = document.getElementById('orders-user-badge');

  // Verify Auth on load
  onAuthStateChanged(authInstance, (user) => {
    if (!user) {
      // Not logged in -> redirect to login with query param
      window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`;
      return;
    }

    currentUserEmail = user.email || '';
    currentUserUid = user.uid || '';
    
    if (userBadge) {
      userBadge.textContent = `Logged in as: ${currentUserEmail}`;
    }

    loadOrders();
  });

  async function loadOrders() {
    try {
      const q = query(
        collection(dbInstance, 'orders'),
        where('email', '==', currentUserEmail),
        orderBy('createdAt', 'desc')
      );

      const querySnapshot = await getDocs(q);
      const orders: any[] = [];
      
      querySnapshot.docs.forEach((doc) => {
        orders.push({ id: doc.id, ...doc.data() });
      });

      if (orders.length === 0) {
        loadingSec?.classList.add('hidden');
        emptySec?.classList.remove('hidden');
        listSec?.classList.add('hidden');
        return;
      }

      renderOrders(orders);
    } catch (error) {
      console.error("Error loading customer orders:", error);
      // Fallback for firestore indexing errors: client-side filter
      try {
        const qFall = query(collection(dbInstance, 'orders'));
        const querySnapshot = await getDocs(qFall);
        const allOrders: any[] = [];
        querySnapshot.docs.forEach((doc) => {
          allOrders.push({ id: doc.id, ...doc.data() });
        });

        // Filter and sort client-side
        const filtered = allOrders
          .filter(o => o.email === currentUserEmail)
          .sort((a,b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

        if (filtered.length === 0) {
          loadingSec?.classList.add('hidden');
          emptySec?.classList.remove('hidden');
          return;
        }
        renderOrders(filtered);
      } catch (err) {
        if (loadingSec) {
          loadingSec.innerHTML = `<p class="text-red-500 text-xs">Failed to load order history. Real-time index configuring.</p>`;
        }
      }
    }
  }

  function renderOrders(orders: any[]) {
    if (!listSec) return;

    listSec.innerHTML = orders.map(order => {
      const date = new Date(order.createdAt).toLocaleDateString('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit'
      });

      // Status badge builder
      let statusColor = 'text-amber-700 bg-amber-50 border-amber-300';
      let statusLabel = 'Pending Validation';

      if (order.status === 'completed' || order.status === 'paid') {
        statusColor = 'text-emerald-700 bg-emerald-50 border-emerald-300';
        statusLabel = 'Completed';
      } else if (order.status === 'cancelled') {
        statusColor = 'text-rose-700 bg-rose-50 border-rose-300';
        statusLabel = 'Cancelled';
      }

      // Check payment methods
      const methodLabel = order.paymentMethod || 'Cryptocurrency';
      const refLabel = `TxID: ${order.txId || ''}`;

      // Build cart list markup
      const cartItems = order.items.map(item => {
        const sizeTag = item.size ? `<span class="px-1.5 py-0.5 rounded bg-[#FFF5F7] text-[#FF6B8B] border border-[#FFD6E0] text-[9px] uppercase font-bold font-fredoka">${item.size}</span>` : '';
        const isDigital = item.type === 'digital';
        const typeTag = isDigital 
          ? `<span class="px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200 text-[9px] uppercase font-bold font-fredoka">Digital</span>`
          : `<span class="px-1.5 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200 text-[9px] uppercase font-bold font-fredoka">Physical</span>`;

        return `
          <div class="flex items-center justify-between py-3 border-b border-[#3E2A1E]/10 last:border-0">
            <div class="flex items-center gap-3">
              <img src="${item.image}" class="w-8 h-8 rounded-lg object-cover border-2 border-[#3E2A1E]" />
              <div class="text-left">
                <p class="text-xs font-bold text-[#3E2A1E] line-clamp-1">${item.name}</p>
                <div class="flex items-center gap-1.5 mt-1">
                  ${typeTag}
                  ${sizeTag}
                  <span class="text-[10px] text-zinc-500">Qty: ${item.quantity}</span>
                </div>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs font-bold text-[#3E2A1E] font-fredoka">$${(item.price * item.quantity).toFixed(2)}</span>
            </div>
          </div>
        `;
      }).join('');

      // Digital key display once completed
      let credentialsBlock = '';
      const hasDigitalItems = order.items.some(item => item.type === 'digital');
      if (hasDigitalItems) {
        if (order.status === 'completed' || order.status === 'paid') {
          const keyText = order.dispatchContent 
            ? `<div class="p-3 bg-white border-2 border-[#3E2A1E] rounded-xl font-mono text-xs text-[#3E2A1E] break-all select-all shadow-[2px_2px_0px_#3E2A1E] mt-1.5">${order.dispatchContent}</div>` 
            : `<p class="text-[11px] text-[#3E2A1E] font-light leading-relaxed">卡密明细已激活，如邮箱 <strong>${order.email}</strong> 未收到，请联系右下角客服索取。</p>`;

          credentialsBlock = `
            <div class="mt-4 p-4 bg-emerald-50 border-2 border-emerald-500 text-left space-y-2 rounded-2xl">
              <div class="flex items-center justify-between">
                <h4 class="text-xs font-bold text-emerald-700 uppercase tracking-wider flex items-center gap-2 font-fredoka">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 8a6 6 0 01-7.743 5.743L7.707 16.3a1 1 0 01-.707.293H5a1 1 0 01-1-1v-2a1 1 0 01.293-.707l2.557-2.557A6 6 0 1118 8zm-3.415-1.415a1 1 0 10-1.414 1.414 1 1 0 001.414-1.414z" clip-rule="evenodd" />
                  </svg>
                  卡密/账号提取
                </h4>
                <span class="text-[9px] font-bold text-emerald-600 uppercase tracking-wider font-fredoka">Dispatched ✓</span>
              </div>
              <p class="text-[11px] text-[#3E2A1E] font-light leading-relaxed">
                您的虚拟产品账号/API密钥已激活。请保存您的发货明细：
              </p>
              ${keyText}
              <div class="pt-1.5 flex gap-2">
                <button 
                  type="button" 
                  onclick="navigator.clipboard.writeText('${order.dispatchContent || order.id}'); alert('Copied key details to clipboard!');"
                  class="px-3 py-1.5 bg-emerald-100 hover:bg-emerald-200 border-2 border-[#3E2A1E] text-[#3E2A1E] text-[10px] font-bold rounded-xl shadow-[2px_2px_0px_#3E2A1E] hover:translate-y-[-1px] hover:shadow-[3px_3px_0px_#3E2A1E] transition-all uppercase font-fredoka"
                >
                  Copy Credentials
                </button>
              </div>
            </div>
          `;
        } else if (order.status === 'pending') {
          credentialsBlock = `
            <div class="mt-4 p-4 bg-amber-50 border-2 border-amber-500 text-left space-y-2 rounded-2xl animate-pulse">
              <div class="flex items-center justify-between">
                <h4 class="text-xs font-bold text-amber-700 uppercase tracking-wider flex items-center gap-2 font-fredoka">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.8 2.8a1 1 0 101.414-1.414L11 9.586V6z" clip-rule="evenodd" />
                  </svg>
                  配货处理中 (Fulfilling manually)
                </h4>
                <span class="text-[9px] font-bold text-amber-600 uppercase tracking-wider font-fredoka">In Progress...</span>
              </div>
              <p class="text-[11px] text-[#3E2A1E] leading-relaxed font-bold font-fredoka">
                管理员正在为您加急调配卡密，通常需要 5~15 分钟，发货后卡密将在此直接呈现。请稍后刷新本页查看，或联系右下角客服机器人咨询。
              </p>
            </div>
          `;
        }
      }

      return `
        <div class="glass-card p-6 space-y-4">
          <!-- Top Row -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#3E2A1E]/10 pb-4">
            <div class="text-left space-y-0.5">
              <span class="text-[9px] font-bold text-zinc-500 uppercase tracking-widest font-mono">ORDER ID: ${order.id}</span>
              <p class="text-xs text-zinc-500">Purchased on ${date}</p>
            </div>
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-1 rounded-full border-2 text-[10px] font-bold uppercase tracking-wider font-fredoka ${statusColor}">
                ${statusLabel}
              </span>
            </div>
          </div>

          <!-- Items Row -->
          <div class="divide-y divide-[#3E2A1E]/10">
            ${cartItems}
          </div>

          <!-- Credentials Block (If completed and has digital) -->
          ${credentialsBlock}

          <!-- Bottom Summary -->
          <div class="pt-4 border-t border-[#3E2A1E]/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="text-left">
              <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest block font-fredoka">Payment Details</span>
              <p class="text-xs text-zinc-700 mt-0.5">${methodLabel} — <span class="font-mono text-[11px] text-[#3E2A1E] font-bold">${refLabel}</span></p>
            </div>
            <div class="text-left sm:text-right">
              <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest block font-fredoka">Total Cost</span>
              <span class="text-lg font-black text-[#3E2A1E] font-fredoka">$${order.totalUsd.toFixed(2)} <span class="text-xs text-zinc-500 font-normal font-sans">(¥${order.totalCny} CNY)</span></span>
            </div>
          </div>

        </div>
      `;
    }).join('');

    loadingSec?.classList.add('hidden');
    emptySec?.classList.add('hidden');
    listSec?.classList.remove('hidden');
  }
</script>
