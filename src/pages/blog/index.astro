---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { t, localizedPath } from '../../lib/i18n';
import { getCollection } from 'astro:content';

const locale = 'en';
const posts = (await getCollection('blog', ({ data, id }) => !data.draft && data.lang === locale && !id.startsWith('zh/')))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title={t(locale, 'blog.title')} locale={locale} pathname="/blog/">
  <Header locale={locale} pathname="/blog/" />
  <main class="flex-1 max-w-3xl mx-auto px-4 py-12 w-full">
    <Breadcrumbs locale={locale} trail={[{ label: t(locale, 'nav.guides') }]} />
    <h1 class="text-3xl font-semibold text-ink-900 mb-8">{t(locale, 'blog.title')}</h1>
    {posts.length === 0 ? (
      <p class="text-ink-500">{t(locale, 'blog.empty')}</p>
    ) : (
      <ul class="space-y-6">
        {posts.map((post) => (
          <li>
            <a href={localizedPath(locale, `/blog/${post.id}/`)} class="block group">
              <h2 class="text-xl font-semibold text-ink-900 group-hover:text-accent transition">{post.data.title}</h2>
              <p class="mt-1 text-ink-600">{post.data.description}</p>
              <p class="mt-2 text-xs text-ink-400">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
  <Footer locale={locale} />
</BaseLayout>
