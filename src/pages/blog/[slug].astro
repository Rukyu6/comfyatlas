---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { SITE, t, localizedPath } from '../../lib/i18n';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data, id }) => !data.draft && data.lang === 'en' && !id.startsWith('zh/'));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const locale = 'en';
const pathname = `/blog/${post.id}/`;
const allEn = await getCollection('blog', ({ data, id }) => !data.draft && data.lang === 'en' && !id.startsWith('zh/'));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: new URL(localizedPath(locale, pathname), SITE.url).toString(),
  inLanguage: 'en-US',
};
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  locale={locale}
  pathname={pathname}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  schema={schema}
>
  <Header locale={locale} pathname={pathname} />
  <main class="flex-1 max-w-3xl mx-auto px-4 py-10 w-full">
    <article class="prose-article" data-pagefind-body>
      <p class="text-xs uppercase tracking-wide text-ink-500 mb-2">
        {t(locale, 'post.published')} {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        {post.data.updatedDate && (
          <span class="ml-2">· {t(locale, 'post.updated')} {post.data.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        )}
      </p>
      <h1>{post.data.title}</h1>
      <p class="text-lg text-ink-600 not-prose mb-8">{post.data.description}</p>

      {headings.length > 2 && (
        <nav class="not-prose my-8 p-4 bg-ink-50 rounded-lg text-sm">
          <p class="font-semibold text-ink-700 mb-2">{t(locale, 'post.toc')}</p>
          <ul class="space-y-1">
            {headings.filter((h) => h.depth === 2).map((h) => (
              <li><a href={`#${h.slug}`} class="text-ink-600 hover:text-accent">{h.text}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <Content />

      <RelatedPosts current={post} all={allEn} locale={locale} />

      {post.data.tags.length > 0 && (
        <div class="not-prose mt-12 pt-6 border-t border-ink-100 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="text-xs px-2 py-1 bg-ink-50 text-ink-600 rounded">#{tag}</span>
          ))}
        </div>
      )}
    </article>
  </main>
  <Footer locale={locale} />
</BaseLayout>
