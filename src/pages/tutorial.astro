---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import tutorials from '../data/tutorials.json';

// Define the landing document ID (first category's dashboard or '教程导航')
const landingDocId = "019c146c-dda1-79a3-b6d8-d7dbecd3c21d";

// Group tutorials by parent_name
const categoriesMap = new Map();
tutorials.forEach(tut => {
  const parent = tut.parent_name || "ROOT";
  if (parent === "ROOT" && tut.id !== landingDocId) return; // skip other root categories
  if (!categoriesMap.has(parent)) {
    categoriesMap.set(parent, []);
  }
  categoriesMap.get(parent).push(tut);
});

// Convert map to list for ordered rendering
const orderedCategories = [
  { name: "💡 引导", items: categoriesMap.get("教程导航") || [] },
  { name: "📱 Telegram / 电报教程", items: categoriesMap.get("telegram/电报 登录教程") || [] },
  { name: "🐦 Twitter / 推特教程", items: categoriesMap.get("推特/ X 登录教程") || [] },
  { name: "📧 Google / 谷歌账号", items: categoriesMap.get("谷歌账号 - 登录方式") || [] },
  { name: "📸 Instagram 教程", items: categoriesMap.get("instagram账号 登录教程") || [] },
  { name: "👥 Facebook / 脸书教程", items: categoriesMap.get("Facebook 脸书登录教程") || [] },
  { name: "💬 Discord 教程", items: categoriesMap.get("Discord的登录以及修改密码") || [] },
  { name: "🍏 Apple ID / 苹果账号", items: categoriesMap.get("苹果id账号 登录教程") || [] },
  { name: "🌐 代理 / 代理子站设置", items: categoriesMap.get("网站代理设置教程") || [] },
  { name: "🏠 Residential IP / 住宅IP", items: categoriesMap.get("住宅ip 的使用教程") || [] },
  { name: "🤖 ChatGPT / 镜像GPT", items: categoriesMap.get("镜像GPT网站介绍+教程") || [] }
];
---

<BaseLayout title="帮助中心 & 登录教程" description="提供极简清晰的电报、推特、谷歌、代理及ChatGPT账号登录配置与常见问题自救指南。">
  <Header />

  <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-8 md:py-12 flex flex-col font-sans select-none">
    
    <!-- Header Summary Box -->
    <div class="text-center mb-8 md:mb-12">
      <h1 class="text-3xl md:text-5xl font-black font-fredoka text-[#3E2A1E] mb-3">帮助中心 & 登录教程 🐾</h1>
      <p class="text-[#6D5A50] font-quicksand font-bold max-w-2xl mx-auto text-xs md:text-sm leading-relaxed">
        如果您在使用购买的数字账号、镜像GPT或代理网络时遇到困难，请在下方选择对应的指南。大部分问题都能在此快速得到解决。
      </p>
    </div>

    <!-- Mobile Dropdown Selector (Hidden on large screens) -->
    <div class="lg:hidden w-full mb-6">
      <label for="mobile-tutorial-select" class="block text-xs font-bold uppercase text-[#6D5A50] tracking-wider mb-2 font-quicksand">
        Select Tutorial Section
      </label>
      <div class="relative">
        <select 
          id="mobile-tutorial-select"
          class="w-full bg-white border-2 border-[#3E2A1E] text-xs font-semibold text-[#3E2A1E] rounded-xl px-4 py-3 shadow-[2px_2px_0px_#3E2A1E] appearance-none focus:outline-none focus:border-[#FF6B8B]"
        >
          {orderedCategories.map(cat => (
            <optgroup label={cat.name}>
              {cat.items.map(tut => (
                <option value={tut.id} selected={tut.id === landingDocId}>{tut.name}</option>
              ))}
            </optgroup>
          ))}
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-[#3E2A1E]">
          <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Main Grid Content -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-start">
      
      <!-- Left Side navigation (Sidebar Menu) -->
      <aside class="hidden lg:block lg:col-span-1 space-y-6 select-none max-h-[80vh] overflow-y-auto pr-2 sticky top-24">
        {orderedCategories.map(cat => (
          <div class="bg-white border-2 border-[#3E2A1E] rounded-2xl p-4 shadow-[2px_2px_0px_#3E2A1E] space-y-2">
            <h4 class="text-[10px] font-bold uppercase tracking-wider text-[#6D5A50] font-quicksand border-b border-[#3E2A1E]/10 pb-1.5 mb-2">
              {cat.name}
            </h4>
            <div class="space-y-1">
              {cat.items.map(tut => (
                <button
                  type="button"
                  data-doc-id={tut.id}
                  class={`nav-item-btn block w-full text-left py-2 px-3 text-[11px] font-semibold rounded-xl transition duration-150 cursor-pointer ${
                    tut.id === landingDocId 
                      ? "bg-[#FFD6E0] text-[#3E2A1E] border-2 border-[#3E2A1E] shadow-[1px_1px_0px_#3E2A1E] font-bold" 
                      : "text-[#6D5A50] hover:bg-[#FFD6E0]/20 hover:text-[#3E2A1E]"
                  }`}
                >
                  {tut.emoji ? `${tut.emoji} ` : ""} {tut.name}
                </button>
              ))}
            </div>
          </div>
        ))}
      </aside>

      <!-- Right Side viewer (Main content panel) -->
      <section class="lg:col-span-3">
        <div class="glass-card p-6 md:p-10 rounded-[2.5rem] border-3 border-[#3E2A1E] shadow-[6px_6px_0px_#3E2A1E] bg-white min-h-[550px] relative">
          
          <!-- Cute Top Badge Design -->
          <div class="absolute -top-3 left-8 bg-[#FFD6E0] border-2 border-[#3E2A1E] text-xs font-fredoka font-bold text-[#3E2A1E] px-4 py-1.5 rounded-full shadow-[2px_2px_0px_#3E2A1E]">
            DOC VIEWER 🐾
          </div>

          <!-- Document Content Items -->
          <div id="tutorial-content-viewport" class="tutorial-viewer-content select-text pt-4">
            {tutorials.map(tut => (
              <div 
                id={`tutorial-pane-${tut.id}`} 
                class={`tutorial-pane ${tut.id === landingDocId ? "" : "hidden"} space-y-6`}
              >
                <!-- Inner Article Head -->
                <div class="border-b-2 border-[#E8E1D9] pb-4 mb-6">
                  <span class="text-xs font-bold uppercase tracking-wider text-[#FF6B8B] font-quicksand bg-[#FFD6E0]/45 px-2.5 py-0.5 rounded-full border border-[#FF6B8B]/30 mb-2 inline-block">
                    {tut.parent_name || "Help"}
                  </span>
                  <h2 class="text-2xl md:text-3xl font-black font-fredoka text-[#3E2A1E] mt-1">
                    {tut.emoji ? `${tut.emoji} ` : ""} {tut.name}
                  </h2>
                </div>
                
                <!-- Inner Article Body -->
                <div class="prose max-w-none text-[#3E2A1E] font-sans text-xs md:text-sm leading-relaxed" set:html={tut.content_html} />
              </div>
            ))}
          </div>

        </div>
      </section>

    </div>
  </main>

  <Footer />
</BaseLayout>

<!-- Custom Styles for Formatted Scraped Elements -->
<style is:global>
  .tutorial-viewer-content h1 {
    font-size: 1.5rem !important;
    font-weight: 800 !important;
    color: #3E2A1E !important;
    margin-top: 1.5rem !important;
    margin-bottom: 1rem !important;
    font-family: 'Fredoka', sans-serif !important;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 2px solid #E8E1D9;
    padding-bottom: 0.5rem;
  }
  .tutorial-viewer-content h2 {
    font-size: 1.25rem !important;
    font-weight: 800 !important;
    color: #3E2A1E !important;
    margin-top: 2rem !important;
    margin-bottom: 0.75rem !important;
    font-family: 'Fredoka', sans-serif !important;
  }
  .tutorial-viewer-content h3 {
    font-size: 1.05rem !important;
    font-weight: 700 !important;
    color: #3E2A1E !important;
    margin-top: 1.5rem !important;
    margin-bottom: 0.5rem !important;
    font-family: 'Fredoka', sans-serif !important;
  }
  .tutorial-viewer-content p {
    margin-bottom: 1rem !important;
    font-family: 'Quicksand', sans-serif;
    font-weight: 500;
    color: #6D5A50;
    line-height: 1.7;
  }
  .tutorial-viewer-content p strong {
    color: #3E2A1E;
  }
  .tutorial-viewer-content ul.bullet-list {
    list-style-type: disc !important;
    padding-left: 1.5rem !important;
    margin-bottom: 1.25rem !important;
    font-family: 'Quicksand', sans-serif;
    font-weight: 500;
    color: #6D5A50;
    space-y: 0.5rem;
  }
  .tutorial-viewer-content ol.ordered-list {
    list-style-type: decimal !important;
    padding-left: 1.5rem !important;
    margin-bottom: 1.25rem !important;
    font-family: 'Quicksand', sans-serif;
    font-weight: 500;
    color: #6D5A50;
    space-y: 0.5rem;
  }
  .tutorial-viewer-content li {
    margin-bottom: 0.5rem !important;
  }
  .tutorial-viewer-content li p {
    margin-bottom: 0px !important;
    display: inline;
  }
  .tutorial-viewer-content a {
    color: #FF6B8B !important;
    font-weight: 700;
    text-decoration: underline !important;
    transition: color 0.15s ease;
  }
  .tutorial-viewer-content a:hover {
    color: #FF8CA3 !important;
  }
  .tutorial-viewer-content code {
    background-color: #FFFDF9 !important;
    border: 1px solid rgba(62, 42, 30, 0.2) !important;
    color: #FF6B8B !important;
    font-family: monospace !important;
    padding: 0.15rem 0.4rem !important;
    border-radius: 0.375rem !important;
    font-size: 0.85em !important;
  }
  .tutorial-viewer-content img {
    border: 3px solid #3E2A1E !important;
    border-radius: 1.25rem !important;
    box-shadow: 4px 4px 0px rgba(62, 42, 30, 0.15) !important;
    max-width: 100% !important;
    height: auto !important;
    margin: 1.5rem auto !important;
    display: block !important;
  }
  .tutorial-viewer-content hr.custom-horizontal-rule {
    border: none !important;
    border-top: 2px dashed #3E2A1E/15 !important;
    margin: 2rem 0 !important;
  }
  /* Fix scrollbar layout for side menu */
  aside::-webkit-scrollbar {
    width: 6px;
  }
  aside::-webkit-scrollbar-track {
    background: transparent;
  }
  aside::-webkit-scrollbar-thumb {
    background-color: rgba(62, 42, 30, 0.15);
    border-radius: 20px;
  }
</style>

<script>
  const navButtons = document.querySelectorAll('.nav-item-btn');
  const panes = document.querySelectorAll('.tutorial-pane');
  const mobileSelect = document.getElementById('mobile-tutorial-select') as HTMLSelectElement;

  function switchTutorial(targetId) {
    // 1. Update Panes Visibility
    panes.forEach(pane => {
      if (pane.id === `tutorial-pane-${targetId}`) {
        pane.classList.remove('hidden');
      } else {
        pane.classList.add('hidden');
      }
    });

    // 2. Update Sidebar Buttons Styling
    navButtons.forEach(btn => {
      const docId = btn.getAttribute('data-doc-id');
      if (docId === targetId) {
        btn.className = "nav-item-btn block w-full text-left py-2 px-3 text-[11px] font-semibold rounded-xl transition duration-150 cursor-pointer bg-[#FFD6E0] text-[#3E2A1E] border-2 border-[#3E2A1E] shadow-[1px_1px_0px_#3E2A1E] font-bold";
      } else {
        btn.className = "nav-item-btn block w-full text-left py-2 px-3 text-[11px] font-semibold rounded-xl transition duration-150 cursor-pointer text-[#6D5A50] hover:bg-[#FFD6E0]/20 hover:text-[#3E2A1E]";
      }
    });

    // 3. Keep mobile select synced
    if (mobileSelect && mobileSelect.value !== targetId) {
      mobileSelect.value = targetId;
    }

    // Scroll to view on mobile
    if (window.innerWidth < 1024) {
      const viewport = document.getElementById('tutorial-content-viewport');
      viewport?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  // Bind sidebar click actions
  navButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const docId = btn.getAttribute('data-doc-id');
      if (docId) switchTutorial(docId);
    });
  });

  // Bind mobile dropdown actions
  mobileSelect?.addEventListener('change', (e) => {
    const docId = (e.target as HTMLSelectElement).value;
    if (docId) switchTutorial(docId);
  });
</script>
