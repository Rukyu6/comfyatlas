---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Sign In — Soul Society">
  <Header />

  <main class="flex-grow flex items-center justify-center pt-32 pb-20 px-6 relative overflow-hidden bg-[#06080F] text-white">
    <!-- Ambient backgrounds -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#38BDF8]/5 rounded-full filter blur-[120px] pointer-events-none"></div>
    
    <div class="w-full max-w-md relative z-10">
      
      <!-- Glass Card container -->
      <div class="glass-card p-8 relative overflow-hidden bg-[#1C1917]/50 border border-[#38BDF8]/20 backdrop-blur-xl">
        
        <!-- Auth Header -->
        <div class="text-center mb-8">
          <h1 class="text-2xl font-extrabold font-sora text-white tracking-tight">
            <span id="auth-title-signin">欢迎回来</span>
            <span id="auth-title-register" class="hidden">创建账户</span>
          </h1>
          <p class="text-xs text-zinc-400 mt-1 font-sora">
            <span id="auth-subtitle-signin">登录以管理您的数字商品库与订单追踪</span>
            <span id="auth-subtitle-register" class="hidden">注册以开通自动发货与订单追踪</span>
          </p>
        </div>

        <!-- Tabs toggle -->
        <div class="grid grid-cols-2 gap-1.5 bg-[#090909]/80 p-1.5 rounded-2xl border border-[#38BDF8]/20 mb-6">
          <button 
            id="tab-signin" 
            type="button" 
            class="py-2 text-xs font-bold uppercase tracking-wider rounded-xl transition-all duration-300 bg-[#38BDF8] text-[#080808] border border-[#0284C7] shadow-md font-sora"
          >
            登录
          </button>
          <button 
            id="tab-register" 
            type="button" 
            class="py-2 text-xs font-bold uppercase tracking-wider rounded-xl transition-all duration-300 text-zinc-500 hover:text-white font-sora"
          >
            注册
          </button>
        </div>

        <!-- Status/Error Banner -->
        <div id="auth-error-banner" class="hidden px-4 py-3 rounded-xl bg-red-950/20 border border-red-900 text-red-400 text-xs mb-6 text-left animate-pulse font-sora">
          <!-- Dynamically inserted error -->
        </div>

        <!-- Main Auth Form -->
        <form id="auth-form" class="space-y-4">
          <!-- Username Field (Only visible on Register tab) -->
          <div id="username-field" class="space-y-1 text-left hidden">
            <label for="username" class="text-[10px] font-bold uppercase tracking-wider text-zinc-400 font-sora">用户名 / 昵称</label>
            <input 
              type="text" 
              id="username" 
              placeholder="例如：我的昵称"
              class="w-full bg-[#06080F] border border-[#38BDF8]/20 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-[#38BDF8] focus:ring-1 focus:ring-[#38BDF8] transition-all duration-300"
            />
          </div>

          <!-- Email Field -->
          <div class="space-y-1 text-left">
            <label for="email" class="text-[10px] font-bold uppercase tracking-wider text-zinc-400 font-sora">电子邮箱</label>
            <input 
              type="email" 
              id="email" 
              required
              placeholder="name@example.com"
              class="w-full bg-[#06080F] border border-[#38BDF8]/20 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-[#38BDF8] focus:ring-1 focus:ring-[#38BDF8] transition-all duration-300"
            />
          </div>

          <!-- Password Field -->
          <div class="space-y-1 text-left">
            <label for="password" class="text-[10px] font-bold uppercase tracking-wider text-zinc-400 font-sora">密码</label>
            <input 
              type="password" 
              id="password" 
              required
              placeholder="••••••••"
              class="w-full bg-[#06080F] border border-[#38BDF8]/20 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-[#38BDF8] focus:ring-1 focus:ring-[#38BDF8] transition-all duration-300"
            />
          </div>

          <!-- Submit Button -->
          <button 
            type="submit" 
            id="submit-btn"
            class="w-full py-4 bg-[#38BDF8] text-[#080808] hover:bg-[#0284C7] border border-[#0284C7] font-bold uppercase tracking-wider rounded-xl shadow-lg transition-all text-xs font-sora flex items-center justify-center gap-2 active:scale-[0.98] cursor-pointer"
          >
            <span id="btn-text-signin">登录安全账户</span>
            <span id="btn-text-register" class="hidden">注册并登录</span>
            <span id="btn-text-submitting-signin" class="hidden">正在验证...</span>
            <span id="btn-text-submitting-register" class="hidden">正在创建...</span>
            <div id="btn-spinner" class="hidden w-4 h-4 border-2 border-[#080808] border-t-transparent rounded-full animate-spin"></div>
          </button>
        </form>

        <!-- Divider -->
        <div class="flex items-center my-6">
          <div class="flex-grow border-t border-[#38BDF8]/20"></div>
          <span class="px-3 text-[10px] font-bold text-zinc-500 uppercase tracking-widest font-sora">或者使用以下方式继续</span>
          <div class="flex-grow border-t border-[#38BDF8]/20"></div>
        </div>

        <!-- Google OAuth Button -->
        <button 
          id="google-btn" 
          type="button" 
          class="w-full py-3.5 bg-transparent border border-[#38BDF8]/20 text-white hover:bg-white/5 font-bold rounded-xl shadow-md transition-all text-xs font-sora flex items-center justify-center gap-3 group active:scale-[0.98] cursor-pointer"
        >
          <!-- Custom G Logo -->
          <svg class="h-4 w-4" viewBox="0 0 24 24" width="24" height="24" xmlns="http://www.w3.org/2000/svg">
            <g transform="matrix(1, 0, 0, 1, 0, 0)">
              <path d="M21.35,11.1H12v2.7h5.38C16.88,16.27,14.68,18,12,18c-3.31,0-6-2.69-6-6s2.69-6,6-6c1.66,0,3.14,0.67,4.24,1.76 L18.14,5.9C16.5,4.26,14.37,3.3,12,3.3c-4.8,0-8.7,3.9-8.7,8.7s3.9,8.7,8.7,8.7c4.6,0,8.3-3.3,8.7-7.7v-2H21.35z" fill="#FFF"/>
              <path d="M21.35,11.1H12v2.7h5.38C16.88,16.27,14.68,18,12,18c-3.31,0-6-2.69-6-6s2.69-6,6-6c1.66,0,3.14,0.67,4.24,1.76 L18.14,5.9C16.5,4.26,14.37,3.3,12,3.3c-4.8,0-8.7,3.9-8.7,8.7s3.9,8.7,8.7,8.7c4.6,0,8.3-3.3,8.7-7.7v-2H21.35z" fill="url(#google-gradient)" />
            </g>
            <defs>
              <linearGradient id="google-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#EA4335" />
                <stop offset="30%" stop-color="#FBBC05" />
                <stop offset="70%" stop-color="#34A853" />
                <stop offset="100%" stop-color="#4285F4" />
              </linearGradient>
            </defs>
          </svg>
          <span class="group-hover:text-[#0284C7] transition-colors">使用 Google 账号登录</span>
        </button>

      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { 
    authInstance,
    setDoc,
    doc,
    dbInstance, 
    signInWithEmailAndPassword, 
    createUserWithEmailAndPassword, 
    signInWithPopup, 
    GoogleAuthProvider,
    updateProfile
  } from '../lib/firebase.js';

  let currentTab = 'signin'; // 'signin' or 'register'
  const urlParams = new URLSearchParams(window.location.search);
  const redirectPath = urlParams.get('redirect') || '/';

  // DOM Elements
  const tabSignin = document.getElementById('tab-signin');
  const tabRegister = document.getElementById('tab-register');
  const authForm = document.getElementById('auth-form');
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const usernameField = document.getElementById('username-field');
  const usernameInput = document.getElementById('username') as HTMLInputElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnSpinner = document.getElementById('btn-spinner');
  const googleBtn = document.getElementById('google-btn');
  const errorBanner = document.getElementById('auth-error-banner');

  // Spans for localization stability
  const titleSignin = document.getElementById('auth-title-signin');
  const titleRegister = document.getElementById('auth-title-register');
  const subtitleSignin = document.getElementById('auth-subtitle-signin');
  const subtitleRegister = document.getElementById('auth-subtitle-register');
  const btnTextSignin = document.getElementById('btn-text-signin');
  const btnTextRegister = document.getElementById('btn-text-register');
  const btnTextSubmittingSignin = document.getElementById('btn-text-submitting-signin');
  const btnTextSubmittingRegister = document.getElementById('btn-text-submitting-register');

  let isSubmittingState = false;

  function updateButtonTextVisibility(submitting) {
    isSubmittingState = submitting;
    
    // Hide all first
    btnTextSignin?.classList.add('hidden');
    btnTextRegister?.classList.add('hidden');
    btnTextSubmittingSignin?.classList.add('hidden');
    btnTextSubmittingRegister?.classList.add('hidden');

    if (submitting) {
      if (currentTab === 'signin') {
        btnTextSubmittingSignin?.classList.remove('hidden');
      } else {
        btnTextSubmittingRegister?.classList.remove('hidden');
      }
    } else {
      if (currentTab === 'signin') {
        btnTextSignin?.classList.remove('hidden');
      } else {
        btnTextRegister?.classList.remove('hidden');
      }
    }
  }

  function toggleTab(tab) {
    currentTab = tab;
    if (tab === 'signin') {
      tabSignin?.classList.add('bg-[#38BDF8]', 'text-[#080808]', 'border', 'border-[#0284C7]', 'shadow-md');
      tabSignin?.classList.remove('text-zinc-500', 'hover:text-white');
      tabRegister?.classList.remove('bg-[#38BDF8]', 'text-[#080808]', 'border', 'border-[#0284C7]', 'shadow-md');
      tabRegister?.classList.add('text-zinc-500', 'hover:text-white');
      
      titleSignin?.classList.remove('hidden');
      titleRegister?.classList.add('hidden');
      subtitleSignin?.classList.remove('hidden');
      subtitleRegister?.classList.add('hidden');
      
      updateButtonTextVisibility(false);

      if (usernameField) usernameField.classList.add('hidden');
      if (usernameInput) usernameInput.required = false;
    } else {
      tabRegister?.classList.add('bg-[#38BDF8]', 'text-[#080808]', 'border', 'border-[#0284C7]', 'shadow-md');
      tabRegister?.classList.remove('text-zinc-500', 'hover:text-white');
      tabSignin?.classList.remove('bg-[#38BDF8]', 'text-[#080808]', 'border', 'border-[#0284C7]', 'shadow-md');
      tabSignin?.classList.add('text-zinc-500', 'hover:text-white');
      
      titleRegister?.classList.remove('hidden');
      titleSignin?.classList.add('hidden');
      subtitleRegister?.classList.remove('hidden');
      subtitleSignin?.classList.add('hidden');
      
      updateButtonTextVisibility(false);

      if (usernameField) usernameField.classList.remove('hidden');
      if (usernameInput) usernameInput.required = true;
    }
    hideError();
  }

  function showError(msg) {
    if (errorBanner) {
      errorBanner.textContent = msg;
      errorBanner.classList.remove('hidden');
    }
  }

  function hideError() {
    errorBanner?.classList.add('hidden');
  }

  function setSubmitting(submitting) {
    if (submitBtn) submitBtn.disabled = submitting;
    if (submitting) {
      btnSpinner?.classList.remove('hidden');
    } else {
      btnSpinner?.classList.add('hidden');
    }
    updateButtonTextVisibility(submitting);
  }

  // Bind Switch Tab clicks
  tabSignin?.addEventListener('click', () => toggleTab('signin'));
  tabRegister?.addEventListener('click', () => toggleTab('register'));

  // Form Submit Handler
  authForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();
    setSubmitting(true);

    const email = emailInput.value;
    const password = passwordInput.value;

    try {
      if (currentTab === 'signin') {
        const activeAuth = (typeof getAuthInstance === 'function' ? getAuthInstance() : authInstance);
      await signInWithEmailAndPassword(activeAuth, email, password);
      } else {
        const username = usernameInput.value.trim();
        const activeAuth = (typeof getAuthInstance === 'function' ? getAuthInstance() : authInstance);
      const cred = await createUserWithEmailAndPassword(activeAuth, email, password);
        if (cred && cred.user) {
          await updateProfile(cred.user, { displayName: username });
        }
      }
      // 立即写入 0ms 鉴权会话快照
      const finalName = (currentTab === 'signin') ? email.split('@')[0] : (usernameInput.value.trim() || email.split('@')[0]);
      localStorage.setItem('auth_session', JSON.stringify({ email: email.trim(), displayName: finalName }));

      // Successful Auth redirect
      const adminEmail = (import.meta.env.PUBLIC_ADMIN_EMAIL || 'rukyucrono@gmail.com').toLowerCase();
      if (email.trim().toLowerCase() === adminEmail && redirectPath === '/') {
        window.location.href = '/admin/dashboard';
      } else {
        window.location.href = redirectPath;
      }
    } catch (err: any) {
      console.error(err);
      let errorMsg = err.message || "身份验证失败。";
      
      // Clean up Firebase standard errors
      if (errorMsg.includes('auth/invalid-credential') || errorMsg.includes('auth/user-not-found') || errorMsg.includes('auth/wrong-password')) {
        errorMsg = "拒绝访问：邮箱或密码错误。";
      } else if (errorMsg.includes('auth/email-already-in-use')) {
        errorMsg = "拒绝访问：该邮箱已被注册。";
      } else if (errorMsg.includes('auth/weak-password')) {
        errorMsg = "拒绝访问：密码强度过弱（至少需要 6 位字符）。";
      } else if (errorMsg.includes('auth/invalid-email')) {
        errorMsg = "拒绝访问：请输入有效的邮箱地址。";
      }
      
      showError(errorMsg);
      setSubmitting(false);
    }
  });

  // Google OAuth click
  googleBtn?.addEventListener('click', async () => {
    hideError();
    try {
      const provider = new GoogleAuthProvider();
      await signInWithPopup(authInstance, provider);
      window.location.href = redirectPath;
    } catch (err: any) {
      console.error(err);
      if (err.message && !err.message.includes('auth/popup-closed-by-user')) {
        showError("Google 身份验证失败，请重试。");
      }
    }
  });
</script>
