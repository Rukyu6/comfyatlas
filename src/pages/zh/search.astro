---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { t } from '../../lib/i18n';
const locale = 'zh';
---
<BaseLayout title={t(locale, 'nav.search')} description="搜索 ComfyAtlas 教程。" locale={locale} pathname="/search/">
  <Header locale={locale} pathname="/search/" />
  <main class="flex-1 max-w-3xl mx-auto px-4 py-10 w-full">
    <h1 class="text-3xl font-semibold text-ink-900 mb-6">{t(locale, 'nav.search')}</h1>
    <div id="search"></div>
  </main>
  <Footer locale={locale} />
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        translations: { placeholder: '搜索教程...', clear_search: '清除', zero_results: '没有匹配 "[SEARCH_TERM]" 的结果' },
        baseUrl: '/',
      });
    });
  </script>
</BaseLayout>

<style is:global>
  .pagefind-ui__search-input {
    @apply w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-accent focus:outline-none text-base;
  }
  .pagefind-ui__result {
    @apply py-4 border-b border-ink-100;
  }
  .pagefind-ui__result-title a {
    @apply text-ink-900 hover:text-accent transition font-semibold no-underline border-0;
  }
  .pagefind-ui__result-excerpt {
    @apply text-sm text-ink-600 mt-1;
  }
  mark {
    @apply bg-accent/20 text-ink-900 px-0.5;
  }
</style>
