---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE, t, localizedPath } from '../../lib/i18n';
import { getCollection } from 'astro:content';

const locale = 'zh';
const posts = (await getCollection('blog', ({ data, id }) => !data.draft && data.lang === locale && id.startsWith('zh/')))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: t(locale, 'site.description'),
  inLanguage: 'zh-CN',
};
---
<BaseLayout title={SITE.name} locale={locale} pathname="/" schema={schema}>
  <Header locale={locale} pathname="/" />
  <main class="flex-1">
    <section class="max-w-5xl mx-auto px-4 pt-16 pb-12 sm:pt-24 sm:pb-16">
      <h1 class="text-4xl sm:text-5xl font-semibold text-ink-900 leading-tight max-w-3xl">{t(locale, 'home.hero.title')}</h1>
      <p class="mt-5 text-lg text-ink-600 max-w-2xl">{t(locale, 'home.hero.sub')}</p>
      <div class="mt-8">
        <a
          href={localizedPath(locale, '/blog/comfyui-installation-guide/')}
          class="inline-flex items-center gap-2 bg-accent text-white px-5 py-3 rounded-lg font-medium hover:bg-accent-dark transition"
        >
          {t(locale, 'home.hero.cta')} →
        </a>
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-4 py-10 border-t border-ink-100">
      <h2 class="text-sm font-semibold tracking-wide uppercase text-ink-500 mb-6">{t(locale, 'home.latest')}</h2>
      {posts.length === 0 ? (
        <p class="text-ink-500">{t(locale, 'blog.empty')}</p>
      ) : (
        <ul class="grid sm:grid-cols-2 gap-6">
          {posts.map((post) => {
            const slug = post.id.replace(/^zh\//, '');
            return (
              <li class="group">
                <a href={localizedPath(locale, `/blog/${slug}/`)} class="block p-5 rounded-lg border border-ink-100 hover:border-accent/40 hover:shadow-sm transition">
                  <h3 class="font-semibold text-ink-900 group-hover:text-accent transition">{post.data.title}</h3>
                  <p class="mt-2 text-sm text-ink-600 line-clamp-2">{post.data.description}</p>
                  <p class="mt-3 text-xs text-ink-400">
                    {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </p>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
