---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { localizedPath, t } from '../../lib/i18n';
import { getCollection } from 'astro:content';

const locale = 'zh';
const all = await getCollection('blog', ({ data, id }) => !data.draft && data.lang === 'zh' && id.startsWith('zh/') && !!data.workflow);

const workflows = all.map((post) => ({
  file: post.data.workflow!.file,
  title: post.data.workflow!.title ?? post.data.title,
  note: post.data.workflow!.note,
  postSlug: post.id.replace(/^zh\//, ''),
  postTitle: post.data.title,
}));
---
<BaseLayout
  title="免费 ComfyUI 工作流"
  description="可以直接拖进 ComfyUI 的工作流 JSON 文件,涵盖文生图、LoRA、ControlNet、Hires Fix、img2img、Inpainting、IP-Adapter。CC0 公共领域,任意修改使用。"
  locale={locale}
  pathname="/workflows/"
>
  <Header locale={locale} pathname="/workflows/" />
  <main class="flex-1 max-w-3xl mx-auto px-4 py-12 w-full">
    <Breadcrumbs locale={locale} trail={[{ label: '工作流' }]} />
    <h1 class="text-3xl font-semibold text-ink-900 mb-3">免费 ComfyUI 工作流</h1>
    <p class="text-ink-600 mb-8">
      ComfyUI 常见模式的现成 <code class="bg-ink-50 px-1.5 py-0.5 rounded text-sm">.json</code> 文件。
      拖到 ComfyUI 画布上即可加载。全部 <strong>CC0 公共领域</strong> — 随便改、随便传、商用都行。
    </p>

    <ul class="space-y-3">
      {workflows.map((w) => (
        <li class="p-5 rounded-lg border border-ink-100 hover:border-accent/40 transition">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
            <div class="flex-1 min-w-0">
              <h2 class="font-semibold text-ink-900">{w.title}</h2>
              {w.note && <p class="mt-1 text-sm text-ink-600">{w.note}</p>}
              <p class="mt-2 text-xs text-ink-500">
                教程:
                <a href={localizedPath(locale, `/blog/${w.postSlug}/`)} class="text-accent hover:underline ml-1">
                  {w.postTitle}
                </a>
              </p>
            </div>
            <a
              href={`/workflows/${w.file}`}
              download
              class="shrink-0 inline-flex items-center gap-2 bg-accent text-white px-4 py-2 rounded-lg font-medium hover:bg-accent-dark transition text-sm"
            >
              下载 {w.file}
            </a>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-12 p-5 rounded-lg bg-ink-50 text-sm text-ink-700">
      <p class="font-semibold text-ink-900 mb-2">怎么用</p>
      <ol class="list-decimal pl-5 space-y-1">
        <li>点下载,会存一个 <code class="bg-white px-1 rounded">.json</code> 文件</li>
        <li>浏览器打开 ComfyUI</li>
        <li>把 <code class="bg-white px-1 rounded">.json</code> 文件拖到画布上</li>
        <li>在 Load Checkpoint 里选你的模型,Manager 会提示装缺失的自定义节点,点 Queue Prompt</li>
      </ol>
    </div>
  </main>
  <Footer locale={locale} />
</BaseLayout>
