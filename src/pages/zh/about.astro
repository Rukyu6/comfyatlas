---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../lib/i18n';
const locale = 'zh';
---
<BaseLayout title="关于" description={`${SITE.name} 是什么,不是什么。`} locale={locale} pathname="/about/">
  <Header locale={locale} pathname="/about/" />
  <main class="flex-1 max-w-3xl mx-auto px-4 py-12 w-full prose-article">
    <h1>关于 {SITE.name}</h1>
    <p>
      {SITE.name} 是一个独立的知识库,专注于 <strong>ComfyUI</strong> — Stable Diffusion 等扩散模型的节点式界面。
    </p>
    <p>
      这个项目存在的原因只有一个:ComfyUI 官方文档太稀疏,大多数第三方教程零散、过时或浮于表面。本站把分步教程、节点详解、完整工作流集中在一处。
    </p>
    <h2>编辑原则</h2>
    <ul>
      <li><strong>准确优先。</strong>每篇教程在发布前都对照 ComfyUI 最新版本核对一遍。</li>
      <li><strong>真实工作流。</strong>不发空白节点图截图。在合适的地方提供工作流 JSON 文件下载。</li>
      <li><strong>不灌水。</strong>短段落,不填充,不搞"终极指南"那一套。</li>
    </ul>
    <h2>与 ComfyUI 官方无关联</h2>
    <p>
      {SITE.name} 是独立项目,与 ComfyUI 团队和 Comfy Org 无附属、背书或维护关系。ComfyUI 是基于 GPL-3.0 协议开源的软件。
    </p>
    <h2>联系</h2>
    <p>纠错、建议、工作流投稿,请在项目仓库提 issue(链接稍后补充)。</p>
  </main>
  <Footer locale={locale} />
</BaseLayout>
