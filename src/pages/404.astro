---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="The page you are looking for doesn't exist.">
  <main class="flex-grow flex flex-col items-center justify-center text-center px-6 py-24 min-h-[70vh]">
    <div class="space-y-6 max-w-md">
      <div class="text-8xl font-black font-outfit text-gradient-gold select-none">404</div>
      <h1 class="text-3xl font-bold font-outfit text-white tracking-tight">Protocol Error</h1>
      <p class="text-zinc-500 text-sm leading-relaxed">
        The coordinates you requested do not exist or have been removed from the vault.
      </p>
      <div class="pt-6">
        <a 
          href="/" 
          class="inline-block px-8 py-3.5 bg-white text-black hover:bg-[#C5A880] hover:text-black font-bold uppercase tracking-wider text-xs font-outfit rounded-xl transition-all duration-300 shadow-lg active:scale-95"
        >
          Return to Boutique
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
