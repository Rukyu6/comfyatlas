---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="The page you are looking for doesn't exist.">
  <main class="flex-grow flex flex-col items-center justify-center text-center px-6 py-24 min-h-[70vh] bg-black text-white">
    <div class="space-y-6 max-w-md">
      <div class="text-8xl font-black font-sora text-gradient-gold select-none">404</div>
      <h1 class="text-3xl font-bold font-sora text-white tracking-tight">Protocol Error</h1>
      <p class="text-zinc-550 text-sm leading-relaxed font-sora">
        The coordinates you requested do not exist or have been removed from the vault.
      </p>
      <div class="pt-6">
        <a 
          href="/" 
          class="inline-block px-8 py-3.5 bg-[#E7AC08] border border-[#FAC514] text-[#080808] hover:bg-[#FAC514] font-bold uppercase tracking-wider text-xs font-sora rounded-xl transition-all duration-300 shadow-lg active:scale-95"
        >
          Return to Boutique
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
