---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localizedPath } from '../lib/i18n';
const locale = 'en';
---
<BaseLayout title="Page not found" description="The page you're looking for doesn't exist." locale={locale} pathname="/404/">
  <Header locale={locale} pathname="/" />
  <main class="flex-1 max-w-3xl mx-auto px-4 py-20 w-full text-center">
    <p class="text-7xl font-semibold text-ink-300">404</p>
    <h1 class="mt-4 text-3xl font-semibold text-ink-900">Page not found</h1>
    <p class="mt-3 text-ink-600">The page you tried to reach doesn't exist or has been moved.</p>
    <div class="mt-8 flex justify-center gap-3 flex-wrap">
      <a href={localizedPath(locale, '/')} class="bg-accent text-white px-5 py-2.5 rounded-lg font-medium hover:bg-accent-dark transition">Go home</a>
      <a href={localizedPath(locale, '/blog/')} class="border border-ink-200 text-ink-700 px-5 py-2.5 rounded-lg font-medium hover:bg-ink-50 transition">Browse guides</a>
      <a href={localizedPath(locale, '/search/')} class="border border-ink-200 text-ink-700 px-5 py-2.5 rounded-lg font-medium hover:bg-ink-50 transition">Search</a>
    </div>
  </main>
  <Footer locale={locale} />
</BaseLayout>
