---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="页面未找到 — Soul Society" description="请求的资源不存在或已被转移。">
  <main class="flex-grow flex flex-col items-center justify-center text-center px-6 py-24 min-h-[70vh] bg-[#06080F] text-white font-outfit">
    <div class="space-y-6 max-w-md">
      <div class="text-8xl font-black text-[#38BDF8] font-mono select-none drop-shadow-[0_0_20px_rgba(56,189,248,0.4)]">404</div>
      <h1 class="text-2xl font-bold text-white tracking-tight">目标坐标不存在</h1>
      <p class="text-slate-400 text-xs leading-relaxed">
        您访问的资源已被转移或不存在，请返回主城重新检索。
      </p>
      <div class="pt-4">
        <a 
          href="/" 
          class="inline-block px-6 py-3 bg-gradient-to-r from-[#0284C7] to-[#38BDF8] text-white font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-[0_0_20px_rgba(56,189,248,0.4)] active:scale-95"
        >
          返回商城主页
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
