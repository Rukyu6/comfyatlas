---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import CRTPreloader from '../components/CRTPreloader.astro';
import FilmStripSlider from '../components/FilmStripSlider.astro';
---
<BaseLayout title="Puppy Shop — Cozy Chibi Account Vault">
  
  <!-- Cozy puppy preloader -->
  <CRTPreloader />

  <Header />

  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center pt-28 pb-16 overflow-hidden bg-[#FFFDF9]">
    <!-- Ambient Background Glows -->
    <div class="absolute top-1/4 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-[#FFD6E0]/20 rounded-full filter blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 translate-x-1/2 translate-y-1/2 w-[400px] h-[400px] bg-indigo-200/20 rounded-full filter blur-[100px] pointer-events-none"></div>
    
    <div class="relative max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center z-10 w-full">
      <!-- Left side: Text & Buttons -->
      <div class="lg:col-span-7 text-left space-y-8">
        <span class="inline-block px-4 py-1.5 rounded-full bg-[#FFD6E0]/40 border-2 border-[#3E2A1E] text-xs font-bold uppercase tracking-widest text-[#3E2A1E] animate-bounce">
          🐾 Cozy Drop 01 🐾
        </span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold font-fredoka text-[#3E2A1E] tracking-tight leading-tight">
          Welcome to the <br />
          <span class="text-gradient-gold">Cozy Chibi Vault</span>
        </h1>
        <p class="text-base sm:text-lg text-[#6D5A50] font-quicksand font-bold leading-relaxed max-w-xl">
          Explore our massive collection of instant premium digital accounts and services. Fully automated 24/7 delivery, secure blockchain vault, and zero transaction fees!
        </p>
        
        <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
          <a 
            href="#digital" 
            class="w-full sm:w-auto px-8 py-4 bg-[#FFD6E0] border-3 border-[#3E2A1E] text-[#3E2A1E] hover:bg-[#FFB3C6] font-bold uppercase tracking-wider rounded-full shadow-[4px_4px_0px_#3E2A1E] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_#3E2A1E] active:scale-95 transition-all duration-300 text-sm font-fredoka text-center"
          >
            Explore Digital Vault 🐾
          </a>
        </div>
      </div>

      <!-- Right side: Cute Chibi Mascot -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div 
          id="hero-art-container"
          class="relative w-full max-w-[400px] aspect-square rounded-[2rem] overflow-hidden border-4 border-[#3E2A1E] shadow-[8px_8px_0px_#3E2A1E] transition-all duration-300 ease-out cursor-pointer group bg-white"
        >
          <!-- Glowing border indicator on hover -->
          <div class="absolute inset-0 bg-gradient-to-tr from-[#FFD6E0]/20 to-indigo-200/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
          
          <!-- Image -->
          <img 
            src="/images/chibi_puppy_hero.png" 
            alt="Puppy Shop Cute Mascot" 
            class="w-full h-full object-cover scale-105 group-hover:scale-110 transition-transform duration-500 ease-out select-none animate-cute-bounce"
            draggable="false"
          />

          <!-- Overlay Glass Plate -->
          <div class="absolute bottom-6 left-6 right-6 p-4 rounded-2xl bg-white/90 backdrop-blur-md border-3 border-[#3E2A1E] shadow-[4px_4px_0px_#3E2A1E] z-20 text-left space-y-1 transform translate-y-2 group-hover:translate-y-0 transition-all duration-500">
            <span class="text-[9px] font-black uppercase tracking-widest text-[#FF6B8B]">OFFICIAL MASCOT</span>
            <h3 class="text-sm font-bold text-[#3E2A1E] font-fredoka">Cozy Chibi Assistant</h3>
          </div>
        </div>
      </div>
    </div>

    <!-- Subtle Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-[#6D5A50] text-xs uppercase tracking-widest font-bold font-quicksand">
      Scroll Down
      <div class="w-2 h-6 bg-[#E8E1D9] border border-[#3E2A1E] rounded-full overflow-hidden">
        <div class="w-full h-1/2 bg-[#FF6B8B] animate-bounce"></div>
      </div>
    </div>
  </section>

  <!-- Film Strip Department Carousel Selector replaced by Scrolling Ribbon -->
  <FilmStripSlider />

  <!-- Digital Vault Section (Crawled from chuhai91.cc) -->
  <section id="digital" class="py-24 border-t-3 border-[#3E2A1E] relative min-h-[800px] bg-[#FFFDF9]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-[#FF6B8B] uppercase tracking-widest text-xs font-bold font-fredoka block mb-2">🐾 Automated Dispatch</span>
          <h2 class="text-3xl md:text-5xl font-bold font-fredoka text-[#3E2A1E]">Digital Account Vault</h2>
        </div>
        <!-- Search Input -->
        <div class="mt-6 md:mt-0 w-full max-w-sm">
          <div class="relative">
            <input 
              type="text" 
              id="search-bar" 
              placeholder="Search 700+ digital accounts..." 
              class="w-full bg-white border-3 border-[#3E2A1E] rounded-2xl pl-11 pr-4 py-3 text-sm text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] shadow-[4px_4px_0px_#3E2A1E] focus:shadow-[6px_6px_0px_#3E2A1E] transition-all duration-300 font-quicksand font-bold"
            />
            <div class="absolute left-4 top-4 text-[#6D5A50]">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Categories Navigation for Mobile (Horizontal scroll) -->
      <div class="flex md:hidden overflow-x-auto gap-2 pb-4 mb-8 -mx-6 px-6 no-scrollbar" id="mobile-categories-bar">
        <!-- JS generates chips here -->
      </div>

      <!-- Layout with Sidebar (Desktop) -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        
        <!-- Sidebar Categories (Desktop) -->
        <div class="hidden md:block col-span-1 space-y-2 max-h-[700px] overflow-y-auto pr-3 scrollbar sticky top-28" id="desktop-categories-sidebar">
          <!-- JS generates sidebar lists here -->
        </div>

        <!-- Product Grid (Desktop / Mobile combined) -->
        <div class="md:col-span-3">
          <div id="digital-products-grid" class="flex flex-col gap-4">
            <!-- Loading state -->
            <div class="col-span-full text-center py-20 text-[#6D5A50] font-quicksand font-bold">
              <div class="animate-spin inline-block w-8 h-8 border-4 border-[#FF6B8B] border-t-transparent rounded-full mb-4"></div>
              <p>Decrypting Digital Vault...</p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" class="py-24 border-t-3 border-[#3E2A1E] bg-[#FDFBF7]">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16">
        <span class="text-[#FF6B8B] uppercase tracking-widest text-xs font-bold font-fredoka block mb-2">🍰 Transaction Protocol</span>
        <h2 class="text-3xl md:text-4xl font-bold font-fredoka text-[#3E2A1E]">How Purchases Work</h2>
        <p class="text-[#6D5A50] mt-4 text-sm font-quicksand font-bold">
          We operate on a zero-middleman payment processing model to bypass high transaction fees.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Step 1 -->
        <div class="glass-card p-8 rounded-[2rem] relative bg-white">
          <div class="w-12 h-12 rounded-xl bg-[#FFD6E0] border-2 border-[#3E2A1E] flex items-center justify-center font-fredoka font-bold text-xl text-[#3E2A1E] mb-6 shadow-[2px_2px_0px_#3E2A1E]">
            01
          </div>
          <h3 class="text-lg font-bold text-[#3E2A1E] font-fredoka mb-2">Assemble Your Bag</h3>
          <p class="text-[#6D5A50] text-sm leading-relaxed font-quicksand font-medium">
            Load up your desired digital accounts and service options in the active bag.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="glass-card p-8 rounded-[2rem] relative bg-white">
          <div class="w-12 h-12 rounded-xl bg-[#D6E4FF] border-2 border-[#3E2A1E] flex items-center justify-center font-fredoka font-bold text-xl text-[#3E2A1E] mb-6 shadow-[2px_2px_0px_#3E2A1E]">
            02
          </div>
          <h3 class="text-lg font-bold text-[#3E2A1E] font-fredoka mb-2">Transfer Payment</h3>
          <p class="text-[#6D5A50] text-sm leading-relaxed font-quicksand font-medium">
            Send the exact total using Cryptocurrency (USDT / BTC / ETH) using our provided instructions.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="glass-card p-8 rounded-[2rem] relative bg-white">
          <div class="w-12 h-12 rounded-xl bg-[#E8DBFC] border-2 border-[#3E2A1E] flex items-center justify-center font-fredoka font-bold text-xl text-[#3E2A1E] mb-6 shadow-[2px_2px_0px_#3E2A1E]">
            03
          </div>
          <h3 class="text-lg font-bold text-[#3E2A1E] font-fredoka mb-2">Instant Validation</h3>
          <p class="text-[#6D5A50] text-sm leading-relaxed font-quicksand font-medium">
            Submit your TxID or bank reference. We inspect the ledger, email your digital products, and deliver them to your orders vault instantly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />

</BaseLayout>

<script>
  // Dynamic Digital Store Script with search & filter functionality
  import database from '../data/products.json';

  let activeCategoryId = '';
  let searchQuery = '';

  // Returns 'cny' for CJK languages, 'usd' for everything else
  function getCurrencyMode(): 'cny' | 'usd' {
    const lang = localStorage.getItem('active_language') || 'en';
    return ['zh-CN', 'zh-TW', 'ja', 'ko'].includes(lang) ? 'cny' : 'usd';
  }

  // Vault DOM Elements
  const desktopSidebar = document.getElementById('desktop-categories-sidebar');
  const mobileBar = document.getElementById('mobile-categories-bar');
  const productsGrid = document.getElementById('digital-products-grid');
  const searchInput = document.getElementById('search-bar') as HTMLInputElement;

  // Initialize
  function init() {
    if (database.categories && database.categories.length > 0) {
      activeCategoryId = database.categories[0].cid;
      renderCategories();
      renderDigitalProducts();
    }
    // Mouse tilt interactive concept art card parallax
    setupHeroParallax();
  }

  function setupHeroParallax() {
    const container = document.getElementById('hero-art-container');
    if (!container) return;

    container.addEventListener('mousemove', (e) => {
      const rect = container.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const deltaX = (x - centerX) / centerX;
      const deltaY = (y - centerY) / centerY;

      // Tilts up to 15 degrees in Y axis, 15 degrees in X axis
      const rotateY = deltaX * 15;
      const rotateX = -deltaY * 15;

      container.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    });

    container.addEventListener('mouseleave', () => {
      container.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
    });
  }

  // General add to cart logic using HTML attributes
  function addToCartFromAttributes(element, size = '') {
    const id = element.getAttribute('data-product-id');
    const name = element.getAttribute('data-product-name');
    const price = parseFloat(element.getAttribute('data-product-price') || '0');
    const image = element.getAttribute('data-product-image');
    const type = element.getAttribute('data-product-type');

    if (!size && type === 'physical') {
      const activeSizeBtn = element.querySelector('.size-btn.bg-white');
      size = activeSizeBtn ? activeSizeBtn.getAttribute('data-size') || '' : '';
    }

    const cartItemId = type === 'physical' ? `${id}_${size}` : id;

    window.dispatchEvent(new CustomEvent('cart:add', {
      detail: {
        cartItemId,
        id,
        name,
        price,
        image,
        type,
        size,
        quantity: 1
      }
    }));
  }

  // Render Categories in Sidebar & Mobile Scroller
  function renderCategories() {
    if (!desktopSidebar || !mobileBar) return;

    const countMap = {};
    database.products.forEach(p => {
      countMap[p.cid] = (countMap[p.cid] || 0) + 1;
    });

    // 1. Render Desktop Sidebar
    desktopSidebar.innerHTML = database.categories.map(cat => {
      const count = countMap[cat.cid] || 0;
      const isActive = cat.cid === activeCategoryId;
      return `
        <button 
          type="button"
          class="w-full text-left px-4 py-3 rounded-xl text-sm font-semibold transition-all duration-300 flex items-center justify-between group ${
            isActive 
              ? 'bg-[#FFD6E0] text-[#3E2A1E] border-2 border-[#3E2A1E] shadow-[2px_2px_0px_#3E2A1E] font-fredoka font-bold' 
              : 'text-[#6D5A50] hover:text-[#3E2A1E] hover:bg-[#FFD6E0]/15 border-2 border-transparent font-quicksand font-bold'
          }"
          data-category-id="${cat.cid}"
        >
          <span class="truncate pr-2">${cat.name}</span>
          <span class="px-2 py-0.5 rounded-full text-[10px] bg-[#F0E6DF] text-[#6D5A50] group-hover:bg-[#FFD6E0]/30 group-hover:text-[#3E2A1E] font-mono transition">
            ${count}
          </span>
        </button>
      `;
    }).join('');

    // 2. Render Mobile Bar
    mobileBar.innerHTML = database.categories.map(cat => {
      const count = countMap[cat.cid] || 0;
      const isActive = cat.cid === activeCategoryId;
      return `
        <button 
          type="button"
          class="shrink-0 px-4 py-2.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-all duration-300 ${
            isActive 
              ? 'bg-[#FF6B8B] text-white border-2 border-[#3E2A1E] shadow-[2px_2px_0px_#3E2A1E] font-fredoka font-bold' 
              : 'bg-white text-[#6D5A50] border-2 border-[#3E2A1E] font-quicksand font-bold hover:bg-[#FFD6E0]/20'
          }"
          data-category-id="${cat.cid}"
        >
          ${cat.name} (${count})
        </button>
      `;
    }).join('');

    // Category click triggers
    const catButtons = document.querySelectorAll('[data-category-id]');
    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        activeCategoryId = btn.getAttribute('data-category-id') || '';
        searchQuery = '';
        if (searchInput) searchInput.value = '';
        renderCategories();
        renderDigitalProducts();
        
        if (window.innerWidth < 768) {
          productsGrid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }

  // Render Digital Products Grid
  function renderDigitalProducts() {
    if (!productsGrid) return;

    let filtered = database.products;
    
    if (searchQuery.trim() !== '') {
      const q = searchQuery.toLowerCase();
      filtered = filtered.filter(p => 
        p.name.toLowerCase().includes(q) || 
        p.category.toLowerCase().includes(q)
      );
    } else {
      filtered = filtered.filter(p => p.cid === activeCategoryId);
    }

    if (filtered.length === 0) {
      productsGrid.innerHTML = `
        <div class="col-span-full text-center py-24 text-[#6D5A50] font-quicksand font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[#6D5A50] mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p>No products found matching your criteria.</p>
        </div>
      `;
      return;
    }

    const currencyMode = getCurrencyMode();

    productsGrid.innerHTML = filtered.map(p => {
      // Find lowest SKU price or default product price
      let displayPriceUsd = p.price_usd;
      let displayPriceCny = p.price_cny;
      if (p.skus && p.skus.length > 0) {
        const pricesUsd = p.skus.map(s => s.price_usd);
        const pricesCny = p.skus.map(s => s.price_cny);
        displayPriceUsd = Math.min(...pricesUsd);
        displayPriceCny = Math.min(...pricesCny);
      }

      const isOutOfStock = p.stock === '0' || p.stock === '缺货';
      const cleanStock = isOutOfStock ? 'OUT OF STOCK' : `STOCK: ${p.stock}`;
      const isMultiOption = p.skus && p.skus.length > 1;
      const cleanId = p.id.replace('pid_', '');
      const prefix = isMultiOption ? 'From ' : '';

      // Build primary & secondary price strings based on language
      const primaryPrice = currencyMode === 'cny'
        ? `${prefix}¥${displayPriceCny} CNY`
        : `${prefix}$${displayPriceUsd.toFixed(2)}`;
      const secondaryPrice = currencyMode === 'cny'
        ? `$${displayPriceUsd.toFixed(2)} USD`
        : `¥${displayPriceCny} CNY`;

      return `
        <a 
          href="/item/${cleanId}/"
          class="glass-card hover-lift rounded-2xl p-4 flex flex-row items-center justify-between border-3 border-[#3E2A1E] shadow-[4px_4px_0px_#3E2A1E] cursor-pointer block text-left decoration-none bg-white gap-4 group transition-all duration-300"
        >
          <!-- Left side: Product Icon & Info -->
          <div class="flex items-center gap-4 min-w-0 flex-1">
            <!-- Icon -->
            <img 
              src="${p.image || '/favicon.ico'}" 
              class="w-10 h-10 md:w-12 md:h-12 rounded-2xl border-2 border-[#3E2A1E] shrink-0 object-cover bg-[#FDFBF7] shadow-[2px_2px_0px_#3E2A1E]" 
              alt="${p.name}"
              onerror="this.src='/favicon.ico'"
            />
            
            <!-- Details -->
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                <!-- Category Badge -->
                <span class="px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider rounded-full bg-[#D6E4FF] text-indigo-600 border border-indigo-200 font-quicksand select-none">
                  ${p.category.split(' ')[0]}
                </span>
                <!-- Stock Badge -->
                <span class="px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider rounded-full ${isOutOfStock ? 'bg-red-100 text-red-600 border border-red-200' : 'bg-[#F0E6DF] text-[#6D5A50] border border-[#3E2A1E]/10'} font-mono select-none">
                  ${cleanStock}
                </span>
              </div>
              
              <!-- Title -->
              <h4 class="text-xs md:text-sm font-bold text-[#3E2A1E] leading-snug font-fredoka group-hover:text-[#FF6B8B] transition-colors line-clamp-2 pr-2">
                ${p.name}
              </h4>
            </div>
          </div>

          <!-- Right side: Price & Action -->
          <div class="flex items-center gap-3 md:gap-4 shrink-0">
            <!-- Price -->
            <div class="flex flex-col items-end text-right min-w-[70px]">
              <span class="text-sm md:text-lg font-black text-[#3E2A1E] font-fredoka">
                ${primaryPrice}
              </span>
              <span class="text-[9px] text-[#6D5A50] font-quicksand font-bold">
                ${secondaryPrice}
              </span>
            </div>

            <!-- Action Button -->
            <span 
              class="px-3 py-1.5 md:px-4 md:py-2.5 rounded-xl bg-white border-2 border-[#3E2A1E] text-[#3E2A1E] group-hover:bg-[#FFD6E0] font-fredoka font-bold text-[10px] md:text-xs uppercase tracking-wider transition-all duration-300 inline-block text-center shadow-[2px_2px_0px_#3E2A1E]"
            >
              ${isMultiOption ? 'Select' : 'Buy'}
            </span>
          </div>
        </a>
      `;
    }).join('');
  }

  // Hook Search Input
  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    renderDigitalProducts();
  });

  // Run initial loads
  init();
</script>
