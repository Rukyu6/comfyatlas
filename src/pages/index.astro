---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CategorySection from '../components/CategorySection.astro';
import { SITE, t, localizedPath } from '../lib/i18n';
import { getCollection } from 'astro:content';

const locale = 'en';
const all = (await getCollection('blog', ({ data, id }) => !data.draft && data.lang === locale && !id.startsWith('zh/')))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const byCategory = (cat: string) => all.filter((p) => p.data.category === cat);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: t(locale, 'site.description'),
  inLanguage: 'en-US',
};
---
<BaseLayout title={SITE.name} locale={locale} pathname="/" schema={schema}>
  <Header locale={locale} pathname="/" />
  <main class="flex-1">
    <section class="max-w-5xl mx-auto px-4 pt-16 pb-12 sm:pt-24 sm:pb-16">
      <h1 class="text-4xl sm:text-5xl font-semibold text-ink-900 leading-tight max-w-3xl">{t(locale, 'home.hero.title')}</h1>
      <p class="mt-5 text-lg text-ink-600 max-w-2xl">{t(locale, 'home.hero.sub')}</p>
      <div class="mt-8">
        <a
          href={localizedPath(locale, '/blog/comfyui-installation-guide/')}
          class="inline-flex items-center gap-2 bg-accent text-white px-5 py-3 rounded-lg font-medium hover:bg-accent-dark transition"
        >
          {t(locale, 'home.hero.cta')} →
        </a>
      </div>
    </section>

    <CategorySection category="getting-started" posts={byCategory('getting-started')} locale={locale} />
    <CategorySection category="workflow-extensions" posts={byCategory('workflow-extensions')} locale={locale} />
    <CategorySection category="models" posts={byCategory('models')} locale={locale} />
    <CategorySection category="troubleshooting" posts={byCategory('troubleshooting')} locale={locale} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
