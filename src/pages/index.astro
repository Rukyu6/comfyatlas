---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
---
<BaseLayout title="WorldMarket — The Operating System for AI agents">

  <Header />

  <!-- Ambient Background Glows -->
  <div class="fixed top-20 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-[#E7AC08]/5 rounded-full filter blur-[150px] pointer-events-none z-0"></div>

  <!-- Digital Vault Section (Direct Start) -->
  <section id="digital" class="pt-24 md:pt-28 pb-20 relative min-h-[800px] bg-black text-white z-10 animate-fadeIn">
    <div class="max-w-7xl mx-auto px-6">
      
      <!-- Announcement Board -->
      <div class="glass-card p-6 md:p-8 bg-[#12100F]/65 border border-white/5 rounded-2xl mb-12 text-left relative overflow-hidden">
        <div class="absolute top-0 right-0 p-4 font-mono text-[9px] text-zinc-700 select-none uppercase">
          Status: Online
        </div>
        <h3 class="text-sm font-bold font-sora text-[#FAC514] flex items-center gap-2 select-none uppercase tracking-widest mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-[#E7AC08] animate-pulse"></span>
          系统通知 / Announcement Board
        </h3>
        
        <div class="space-y-4 font-sora text-xs md:text-sm text-zinc-400 leading-relaxed border-t border-white/5 pt-5">
          <div class="flex items-start gap-4">
            <span class="font-mono text-[10px] text-[#E7AC08] bg-[#E7AC08]/10 px-2 py-0.5 rounded border border-[#E7AC08]/20 select-none shrink-0 min-w-[75px] text-center">TERMS</span>
            <p>本站商品仅供学习测试使用，请勿用于非法用途，否则后果自负。</p>
          </div>
          <div class="flex items-start gap-4">
            <span class="font-mono text-[10px] text-[#E7AC08] bg-[#E7AC08]/10 px-2 py-0.5 rounded border border-[#E7AC08]/20 select-none shrink-0 min-w-[75px] text-center">DELIVERY</span>
            <p>付款完成后请在浏览器自动跳转或前台“订单查询”自行提取卡密凭证。</p>
          </div>
          <div class="flex items-start gap-4">
            <span class="font-mono text-[10px] text-[#E7AC08] bg-[#E7AC08]/10 px-2 py-0.5 rounded border border-[#E7AC08]/20 select-none shrink-0 min-w-[75px] text-center">PRIVACY</span>
            <p>账号均为独享发售，售出后自动删档。平台不留存任何卡密备份，请妥善保存。</p>
          </div>
          <div class="flex items-start gap-4">
            <span class="font-mono text-[10px] text-[#E7AC08] bg-[#E7AC08]/10 px-2 py-0.5 rounded border border-[#E7AC08]/20 select-none shrink-0 min-w-[75px] text-center">PAYMENT</span>
            <p>支持支付宝、微信及 USDT 付款。充值余额可享受 0 手续费便捷下单。</p>
          </div>
          <div class="flex items-start gap-4">
            <span class="font-mono text-[10px] text-[#E7AC08] bg-[#E7AC08]/10 px-2 py-0.5 rounded border border-[#E7AC08]/20 select-none shrink-0 min-w-[75px] text-center">SUPPORT</span>
            <p>如遇异常请参考使用教程。售后请于前台发起的对话附带订单号与截图，我们将尽快处理。</p>
          </div>
        </div>
      </div>

      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <h2 class="text-3xl md:text-5xl font-bold font-sora text-white">数字商品库</h2>
        </div>
        <!-- Search Input -->
        <div class="mt-6 md:mt-0 w-full max-w-sm">
          <div class="relative">
            <input 
              type="text" 
              id="search-bar" 
              placeholder="搜索 700+ 高级账号..." 
              class="w-full bg-[#12100F]/70 border border-white/10 rounded-xl pl-11 pr-4 py-3 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-[#E7AC08] focus:ring-1 focus:ring-[#E7AC08] transition-all duration-300 font-sora font-semibold"
            />
            <div class="absolute left-4 top-4 text-zinc-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Categories Navigation for Mobile -->
      <div class="flex md:hidden overflow-x-auto gap-2 pb-4 mb-8 -mx-6 px-6 no-scrollbar" id="mobile-categories-bar">
        <!-- JS generates chips here -->
      </div>

      <!-- Layout with Sidebar -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        
        <!-- Sidebar Categories -->
        <div class="hidden md:block col-span-1 space-y-2 max-h-[700px] overflow-y-auto pr-3 scrollbar sticky top-28" id="desktop-categories-sidebar">
          <!-- JS generates sidebar lists here -->
        </div>

        <!-- Product Grid -->
        <div class="md:col-span-3">
          <div id="digital-products-grid" class="flex flex-col gap-4">
            <!-- Loading state -->
            <div class="col-span-full text-center py-20 text-zinc-500 font-sans">
              <div class="animate-spin inline-block w-8 h-8 border-4 border-[#E7AC08] border-t-transparent rounded-full mb-4"></div>
              <p>正在解析数字商品库...</p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" class="py-24 border-t border-[#1C1917] bg-[#090909]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <!-- Left Side: Title and Value Prop -->
        <div class="lg:col-span-4 space-y-4">
          <h2 class="text-3xl md:text-4xl font-bold font-sora text-white tracking-tight">
            极简激活协议
          </h2>
          <p class="text-zinc-400 text-sm leading-relaxed max-w-sm">
            我们采用无中间商的直连支付模式，规避传统平台高昂的手续费，保障交易秒级交付。
          </p>
        </div>

        <!-- Right Side: Timeline Steps -->
        <div class="lg:col-span-8 relative pl-8 border-l border-white/5 space-y-12">
          <!-- Step 1 -->
          <div class="relative group">
            <!-- Timeline dot -->
            <div class="absolute -left-[41px] top-1.5 w-5 h-5 rounded-full bg-black border-2 border-zinc-700 group-hover:border-[#FAC514] group-hover:bg-[#E7AC08]/20 transition-all duration-300 flex items-center justify-center">
              <div class="w-1.5 h-1.5 rounded-full bg-zinc-500 group-hover:bg-[#FAC514]"></div>
            </div>
            
            <div class="glass-card p-6 bg-[#12100F]/45 border border-white/5 backdrop-blur-md rounded-2xl group-hover:border-zinc-700 transition-all">
              <span class="text-[10px] font-mono text-[#E7AC08] uppercase tracking-widest block mb-1">01 / SELECT</span>
              <h3 class="text-base font-bold text-white font-sora mb-2">选择账号方案</h3>
              <p class="text-zinc-400 text-sm leading-relaxed">
                在您的活动结账购物车中选择所需的数字账号和对应服务选项。
              </p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="relative group">
            <!-- Timeline dot -->
            <div class="absolute -left-[41px] top-1.5 w-5 h-5 rounded-full bg-black border-2 border-zinc-700 group-hover:border-[#FAC514] group-hover:bg-[#E7AC08]/20 transition-all duration-300 flex items-center justify-center">
              <div class="w-1.5 h-1.5 rounded-full bg-zinc-500 group-hover:bg-[#FAC514]"></div>
            </div>
            
            <div class="glass-card p-6 bg-[#12100F]/45 border border-white/5 backdrop-blur-md rounded-2xl group-hover:border-zinc-700 transition-all">
              <span class="text-[10px] font-mono text-[#E7AC08] uppercase tracking-widest block mb-1">02 / DEPOSIT</span>
              <h3 class="text-base font-bold text-white font-sora mb-2">USDT 账本转账</h3>
              <p class="text-zinc-400 text-sm leading-relaxed">
                使用我们提供的网络地址，转入准确的加密货币金额（USDT / BTC / ETH）。
              </p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="relative group">
            <!-- Timeline dot -->
            <div class="absolute -left-[41px] top-1.5 w-5 h-5 rounded-full bg-black border-2 border-zinc-700 group-hover:border-[#FAC514] group-hover:bg-[#E7AC08]/20 transition-all duration-300 flex items-center justify-center">
              <div class="w-1.5 h-1.5 rounded-full bg-zinc-500 group-hover:bg-[#FAC514]"></div>
            </div>
            
            <div class="glass-card p-6 bg-[#12100F]/45 border border-white/5 backdrop-blur-md rounded-2xl group-hover:border-zinc-700 transition-all">
              <span class="text-[10px] font-mono text-[#E7AC08] uppercase tracking-widest block mb-1">03 / VERIFY</span>
              <h3 class="text-base font-bold text-white font-sora mb-2">即时验证交付</h3>
              <p class="text-zinc-400 text-sm leading-relaxed">
                提交您的交易哈希（TxID）。我们核对账本后，立即发放您的数字商品，并交付至您的订单库。
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CartDrawer />

  <Footer />

</BaseLayout>

<script>
  // Dynamic Store Script
  import database from '../data/products.json';

  let activeCategoryId = '';
  let searchQuery = '';

  function getCurrencyMode(): 'cny' | 'usd' {
    const lang = localStorage.getItem('active_language') || 'en';
    return ['zh-CN', 'zh-TW', 'ja', 'ko'].includes(lang) ? 'cny' : 'usd';
  }

  const desktopSidebar = document.getElementById('desktop-categories-sidebar');
  const mobileBar = document.getElementById('mobile-categories-bar');
  const productsGrid = document.getElementById('digital-products-grid');
  const searchInput = document.getElementById('search-bar') as HTMLInputElement;

  function init() {
    if (database.categories && database.categories.length > 0) {
      activeCategoryId = database.categories[0].cid;
      renderCategories();
      renderDigitalProducts();
    }
  }

  function renderCategories() {
    if (!desktopSidebar || !mobileBar) return;

    const countMap = {};
    database.products.forEach(p => {
      countMap[p.cid] = (countMap[p.cid] || 0) + 1;
    });

    desktopSidebar.innerHTML = database.categories.map(cat => {
      const count = countMap[cat.cid] || 0;
      const isActive = cat.cid === activeCategoryId;
      return `
        <button 
          type="button"
          class="w-full text-left px-4 py-3 rounded-lg text-xs font-semibold transition-all duration-300 flex items-center justify-between group border ${
            isActive 
              ? 'bg-[#E7AC08]/15 text-[#FAC514] border-[#E7AC08]/40 shadow-sm font-sora font-bold' 
              : 'text-zinc-400 hover:text-white hover:bg-white/5 border-transparent font-sora font-semibold'
          }"
          data-category-id="${cat.cid}"
        >
          <span class="truncate pr-2">${cat.name}</span>
          <span class="px-2 py-0.5 rounded text-[9px] bg-stone-900 text-zinc-500 group-hover:bg-white/10 group-hover:text-white font-mono transition">
            ${count}
          </span>
        </button>
      `;
    }).join('');

    mobileBar.innerHTML = database.categories.map(cat => {
      const count = countMap[cat.cid] || 0;
      const isActive = cat.cid === activeCategoryId;
      return `
        <button 
          type="button"
          class="shrink-0 px-4 py-2 rounded-full text-[10px] font-semibold uppercase tracking-wider transition-all duration-300 border ${
            isActive 
              ? 'bg-[#E7AC08]/15 text-[#FAC514] border-[#E7AC08]/40 shadow-sm font-sora font-bold' 
              : 'bg-[#12100F]/70 text-zinc-400 border-white/5 font-sora font-semibold hover:bg-white/5'
          }"
          data-category-id="${cat.cid}"
        >
          ${cat.name} (${count})
        </button>
      `;
    }).join('');

    const catButtons = document.querySelectorAll('[data-category-id]');
    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        activeCategoryId = btn.getAttribute('data-category-id') || '';
        searchQuery = '';
        if (searchInput) searchInput.value = '';
        renderCategories();
        renderDigitalProducts();
        
        if (window.innerWidth < 768) {
          productsGrid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }

  function renderDigitalProducts() {
    if (!productsGrid) return;

    let filtered = database.products;
    
    if (searchQuery.trim() !== '') {
      const q = searchQuery.toLowerCase();
      filtered = filtered.filter(p => 
        p.name.toLowerCase().includes(q) || 
        p.category.toLowerCase().includes(q)
      );
    } else {
      filtered = filtered.filter(p => p.cid === activeCategoryId);
    }

    if (filtered.length === 0) {
      productsGrid.innerHTML = `
        <div class="col-span-full text-center py-24 text-zinc-500 font-sans">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-zinc-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p>No products found matching your criteria.</p>
        </div>
      `;
      return;
    }

    const currencyMode = getCurrencyMode();

    productsGrid.innerHTML = filtered.map(p => {
      let displayPriceUsd = p.price_usd;
      let displayPriceCny = p.price_cny;
      if (p.skus && p.skus.length > 0) {
        const pricesUsd = p.skus.map(s => s.price_usd);
        const pricesCny = p.skus.map(s => s.price_cny);
        displayPriceUsd = Math.min(...pricesUsd);
        displayPriceCny = Math.min(...pricesCny);
      }

      const isOutOfStock = p.stock === '0' || p.stock === '缺货';
      const cleanStock = isOutOfStock ? 'OUT OF STOCK' : `STOCK: ${p.stock}`;
      const isMultiOption = p.skus && p.skus.length > 1;
      const cleanId = p.id.replace('pid_', '');
      const prefix = isMultiOption ? 'From ' : '';

      const primaryPrice = currencyMode === 'cny'
        ? `${prefix}¥${displayPriceCny} CNY`
        : `${prefix}$${displayPriceUsd.toFixed(2)}`;
      const secondaryPrice = currencyMode === 'cny'
        ? `$${displayPriceUsd.toFixed(2)} USD`
        : `¥${displayPriceCny} CNY`;

      const statusLight = isOutOfStock
        ? '<span class="w-1.5 h-1.5 rounded-full bg-red-500 shrink-0"></span>'
        : '<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0 animate-pulse"></span>';

      return `
        <a 
          href="/item/${cleanId}/"
          class="glass-card hover-lift rounded-xl p-4 sm:p-5 flex flex-row items-center justify-between border cursor-pointer block text-left decoration-none bg-[#12100F]/65 gap-4 group transition-all duration-300 active:scale-[0.99]"
        >
          <div class="flex items-center gap-4 min-w-0 flex-1">
            <img 
              src="${p.image || '/favicon.ico'}" 
              class="w-10 h-10 md:w-11 md:h-11 rounded-lg border border-white/5 shrink-0 object-cover bg-stone-950 shadow-md" 
              alt="${p.name}"
              onerror="this.src='/favicon.ico'"
            />
            
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                <span class="px-2 py-0.5 text-[8px] font-bold uppercase tracking-wider rounded bg-indigo-950/30 text-indigo-400 border border-indigo-900/40 font-sora select-none">
                  ${p.category.split(' ')[0]}
                </span>
                <span class="px-2 py-0.5 text-[8px] font-bold uppercase tracking-wider rounded flex items-center gap-1.5 ${isOutOfStock ? 'bg-red-950/30 text-red-400 border border-red-900/40' : 'bg-stone-900 text-stone-400 border border-stone-800'} font-mono select-none">
                  ${statusLight}
                  ${cleanStock}
                </span>
              </div>
              
              <h4 class="text-xs md:text-sm font-bold text-white leading-snug font-sora group-hover:text-[#FAC514] transition-colors line-clamp-2 pr-2">
                ${p.name}
              </h4>
            </div>
          </div>

          <div class="flex items-center gap-3 md:gap-4 shrink-0">
            <div class="flex flex-col items-end text-right min-w-[70px]">
              <span class="text-sm md:text-base font-black text-[#E7AC08] font-sora">
                ${primaryPrice}
              </span>
              <span class="text-[9px] text-zinc-400 font-sora font-semibold">
                ${secondaryPrice}
              </span>
            </div>

            <span 
              class="px-4 py-2 rounded-lg bg-transparent border border-white/10 text-white group-hover:bg-[#E7AC08] group-hover:text-[#080808] group-hover:border-[#FAC514] font-sora font-bold text-[10px] md:text-xs uppercase tracking-wider transition-all duration-300 inline-block text-center active:scale-95 shrink-0"
            >
              ${isMultiOption ? 'Select' : 'Buy'}
            </span>
          </div>
        </a>
      `;
    }).join('');
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    renderDigitalProducts();
  });

  init();
</script>
