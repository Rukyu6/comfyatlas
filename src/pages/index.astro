---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';

// Hardcoded physical apparel products
const physicalProducts = [
  {
    id: 'prod_hoodie_01',
    name: 'Metamorphic Hoodie',
    price: 79.00,
    image: '/images/hoodie.png',
    type: 'physical' as const,
    description: 'Ultra-heavyweight 450GSM organic cotton hoodie. Features an exclusive holographic geometric line emblem embroidered on the chest. Relaxed drop-shoulder fit.',
    sizes: ['S', 'M', 'L', 'XL']
  },
  {
    id: 'prod_tee_01',
    name: 'Cyber-Luminescent Tee',
    price: 39.00,
    image: '/images/tshirt.png',
    type: 'physical' as const,
    description: 'Premium combed cotton tee in absolute matte black. Screen-printed with specialized photoluminescent neon-emerald ink that glows under blacklight.',
    sizes: ['M', 'L', 'XL']
  }
];
---
<BaseLayout title="ComfyAtlas Store — Premium Apparel & Digital Account Vault">
  
  <!-- Navigation Header -->
  <header class="glass-nav fixed top-0 left-0 w-full z-40 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <!-- Logo -->
      <a href="#" class="font-outfit text-2xl font-black tracking-widest text-white hover:text-[#C5A880] transition-colors">
        COMFYATLAS<span class="text-[#C5A880]">.</span>
      </a>

      <!-- Menu Links -->
      <nav class="hidden md:flex items-center gap-8 font-outfit text-sm uppercase tracking-wider font-semibold text-zinc-400">
        <a href="#apparel" class="hover:text-white transition-colors">Apparel</a>
        <a href="#digital" class="hover:text-white transition-colors">Digital Vault</a>
        <a href="#how-it-works" class="hover:text-white transition-colors">How It Works</a>
      </nav>

      <!-- Cart Trigger -->
      <button 
        id="cart-trigger" 
        type="button" 
        class="relative p-2.5 rounded-full border border-white/10 hover:border-[#C5A880]/30 hover:bg-[#C5A880]/5 text-white transition-all duration-300"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <span 
          id="cart-badge" 
          class="absolute -top-1 -right-1 w-5 h-5 bg-[#C5A880] text-black font-bold font-outfit text-xs rounded-full flex items-center justify-center opacity-0 scale-50 transition-all duration-300"
        >
          0
        </span>
      </button>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center pt-24 pb-16 overflow-hidden">
    <!-- Ambient Background Glows -->
    <div class="absolute top-1/4 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-[#C5A880]/5 rounded-full filter blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 translate-x-1/2 translate-y-1/2 w-[400px] h-[400px] bg-emerald-500/5 rounded-full filter blur-[100px] pointer-events-none"></div>
    
    <div class="relative max-w-5xl mx-auto px-6 text-center z-10">
      <span class="inline-block px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-semibold uppercase tracking-widest text-[#C5A880] mb-6 animate-pulse">
        New Cyber Drop 01
      </span>
      <h1 class="text-5xl md:text-7xl font-extrabold font-outfit text-white tracking-tight leading-tight mb-8">
        Elevate Your Digital & <br />
        <span class="text-gradient-gold">Physical Wardrobe</span>
      </h1>
      <p class="max-w-2xl mx-auto text-lg text-zinc-400 font-light mb-12 leading-relaxed">
        High-grade tactical apparel designed for the modern creator, coupled with a massive instant digital accounts and service vault. Fully automated digital delivery, global shipping, zero middleman fees.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="#apparel" 
          class="w-full sm:w-auto px-8 py-4 bg-white text-black hover:bg-[#C5A880] hover:text-black font-bold uppercase tracking-wider rounded-full shadow-lg transition-all duration-300 text-sm font-outfit hover:scale-105"
        >
          Shop Physical
        </a>
        <a 
          href="#digital" 
          class="w-full sm:w-auto px-8 py-4 bg-zinc-900 text-white hover:border-emerald-500/40 hover:bg-emerald-500/5 border border-zinc-800 font-bold uppercase tracking-wider rounded-full shadow-lg transition-all duration-300 text-sm font-outfit hover:scale-105"
        >
          Explore Digital Vault
        </a>
      </div>
    </div>

    <!-- Subtle Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-zinc-600 text-xs uppercase tracking-widest font-bold">
      Scroll Down
      <div class="w-1.5 h-6 bg-zinc-800 rounded-full overflow-hidden">
        <div class="w-full h-1/2 bg-[#C5A880] animate-bounce"></div>
      </div>
    </div>
  </section>

  <!-- Physical Apparel Section -->
  <section id="apparel" class="py-24 border-t border-white/5 relative bg-[#0E0E10]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16">
        <div>
          <span class="text-[#C5A880] uppercase tracking-widest text-xs font-bold font-outfit block mb-2">Boutique Drops</span>
          <h2 class="text-3xl md:text-5xl font-bold font-outfit text-white">Physical Apparel</h2>
        </div>
        <p class="text-zinc-500 text-sm max-w-xs mt-4 md:mt-0">
          Made-to-order premium streetwear using ethically sourced high-grade fibers. Worldwide tracking available.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {physicalProducts.map(product => (
          <ProductCard {...product} />
        ))}
      </div>
    </div>
  </section>

  <!-- Digital Vault Section (Crawled from chuhai91.cc) -->
  <section id="digital" class="py-24 border-t border-white/5 relative min-h-[800px]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-emerald-400 uppercase tracking-widest text-xs font-bold font-outfit block mb-2">Automated Dispatch</span>
          <h2 class="text-3xl md:text-5xl font-bold font-outfit text-white">Digital Account Vault</h2>
        </div>
        <!-- Search Input -->
        <div class="mt-6 md:mt-0 w-full max-w-sm">
          <div class="relative">
            <input 
              type="text" 
              id="search-bar" 
              placeholder="Search 700+ digital accounts..." 
              class="w-full bg-zinc-900 border border-zinc-800 rounded-xl pl-11 pr-4 py-3 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-emerald-400/50 transition-all duration-300"
            />
            <div class="absolute left-4 top-3.5 text-zinc-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Categories Navigation for Mobile (Horizontal scroll) -->
      <div class="flex md:hidden overflow-x-auto gap-2 pb-4 mb-8 -mx-6 px-6 no-scrollbar" id="mobile-categories-bar">
        <!-- JS generates chips here -->
      </div>

      <!-- Layout with Sidebar (Desktop) -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        
        <!-- Sidebar Categories (Desktop) -->
        <div class="hidden md:block col-span-1 space-y-2 max-h-[700px] overflow-y-auto pr-3 sticky top-28" id="desktop-categories-sidebar">
          <!-- JS generates sidebar lists here -->
        </div>

        <!-- Product Grid (Desktop / Mobile combined) -->
        <div class="md:col-span-3">
          <div id="digital-products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Loading state -->
            <div class="col-span-full text-center py-20 text-zinc-500">
              <div class="animate-spin inline-block w-8 h-8 border-4 border-[#C5A880] border-t-transparent rounded-full mb-4"></div>
              <p>Decrypting Digital Vault...</p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" class="py-24 border-t border-white/5 bg-[#0E0E10]">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16">
        <span class="text-[#C5A880] uppercase tracking-widest text-xs font-bold block mb-2">Transaction Protocol</span>
        <h2 class="text-3xl md:text-4xl font-bold font-outfit text-white">How Purchases Work</h2>
        <p class="text-zinc-400 mt-4 text-sm">
          We operate on a zero-middleman payment processing model to bypass high transaction fees.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Step 1 -->
        <div class="glass-card p-8 rounded-2xl border border-white/5 relative">
          <div class="w-12 h-12 rounded-xl bg-[#C5A880]/10 flex items-center justify-center font-outfit font-black text-xl text-[#C5A880] mb-6">
            01
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Assemble Your Bag</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Select physical gear sizes and load up your digital vault products in the active bag.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="glass-card p-8 rounded-2xl border border-white/5 relative">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center font-outfit font-black text-xl text-emerald-400 mb-6">
            02
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Transfer Payment</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Send the exact total using Cryptocurrency (USDT / BTC / ETH) or Bank Wire Transfer using our provided instructions.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="glass-card p-8 rounded-2xl border border-white/5 relative">
          <div class="w-12 h-12 rounded-xl bg-zinc-100/10 flex items-center justify-center font-outfit font-black text-xl text-white mb-6">
            03
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Instant Validation</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Submit your TxID or bank reference. We inspect the ledger, email your digital products, and ship physical items with active tracking.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer Section -->
  <footer class="py-16 border-t border-white/5 bg-[#0B0B0C]">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6 text-zinc-500 text-xs">
      <div>
        &copy; {new Date().getFullYear()} ComfyAtlas Boutique. All rights reserved.
      </div>
      <div class="flex gap-8">
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-white transition-colors">Terms of Protocol</a>
        <a href="mailto:rukyucrono@gmail.com" class="hover:text-white transition-colors">Support (rukyucrono@gmail.com)</a>
      </div>
    </div>
  </footer>

  <!-- Shopping Cart Drawer Overlay -->
  <div id="cart-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300">
    <div 
      id="cart-drawer" 
      class="absolute right-0 top-0 h-full w-full max-w-md bg-[#121214] border-l border-white/5 shadow-2xl p-8 flex flex-col translate-x-full transition-transform duration-300 ease-out"
    >
      <!-- Header -->
      <div class="flex items-center justify-between pb-6 border-b border-white/5 mb-6">
        <h3 class="font-outfit text-2xl font-bold text-white">Your Bag</h3>
        <button 
          id="cart-close" 
          type="button" 
          class="p-1 rounded-full border border-white/10 hover:border-white/30 text-zinc-400 hover:text-white transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>

      <!-- Scrollable Products List -->
      <div id="cart-items-container" class="flex-grow overflow-y-auto space-y-4 pr-2">
        <!-- JS inserts items here -->
        <p class="text-zinc-500 text-center py-12 font-light">Your bag is currently empty.</p>
      </div>

      <!-- Checkout / Pricing Footer -->
      <div class="pt-6 border-t border-white/5 mt-6">
        <div class="flex items-center justify-between text-zinc-400 text-sm mb-2">
          <span>Shipping</span>
          <span class="text-emerald-400 font-bold uppercase tracking-wider text-xs">FREE</span>
        </div>
        <div class="flex items-center justify-between text-white text-lg font-bold font-outfit mb-8">
          <span>Est. Total</span>
          <span id="cart-total">$0.00</span>
        </div>
        
        <button 
          id="checkout-btn" 
          type="button" 
          disabled
          class="w-full py-4 rounded-xl bg-white hover:bg-[#C5A880] text-black font-bold uppercase tracking-wider text-sm font-outfit transition-all duration-300 disabled:opacity-30 disabled:pointer-events-none hover:scale-[1.01] active:scale-[0.99] text-center block"
        >
          Proceed to Verification
        </button>
      </div>
    </div>
  </div>

</BaseLayout>

<script>
  // Shopping Cart & Dynamic Digital Store Script
  import database from '../data/products.json';

  let cart = [];
  let activeCategoryId = '';
  let searchQuery = '';

  // DOM Elements
  const cartTrigger = document.getElementById('cart-trigger');
  const cartClose = document.getElementById('cart-close');
  const cartOverlay = document.getElementById('cart-overlay');
  const cartDrawer = document.getElementById('cart-drawer');
  const cartBadge = document.getElementById('cart-badge');
  const cartItemsContainer = document.getElementById('cart-items-container');
  const cartTotal = document.getElementById('cart-total');
  const checkoutBtn = document.getElementById('checkout-btn');

  // Vault DOM Elements
  const desktopSidebar = document.getElementById('desktop-categories-sidebar');
  const mobileBar = document.getElementById('mobile-categories-bar');
  const productsGrid = document.getElementById('digital-products-grid');
  const searchInput = document.getElementById('search-bar') as HTMLInputElement;

  // Initialize
  function init() {
    // 1. Initialize Cart
    const savedCart = localStorage.getItem('boutique_cart');
    if (savedCart) {
      try {
        cart = JSON.parse(savedCart);
      } catch (e) {
        cart = [];
      }
    }
    renderCart();

    // 2. Initialize Digital Vault
    if (database.categories && database.categories.length > 0) {
      activeCategoryId = database.categories[0].cid;
      renderCategories();
      renderDigitalProducts();
    }
    
    // Size button interactivity on index static cards
    setupSizeSelectors();
  }

  // Toggle Cart Drawer
  function toggleCart(isOpen) {
    if (isOpen) {
      cartOverlay.classList.remove('opacity-0', 'pointer-events-none');
      cartDrawer.classList.remove('translate-x-full');
      document.body.style.overflow = 'hidden';
    } else {
      cartOverlay.classList.add('opacity-0', 'pointer-events-none');
      cartDrawer.classList.add('translate-x-full');
      document.body.style.overflow = '';
    }
  }

  cartTrigger?.addEventListener('click', () => toggleCart(true));
  cartClose?.addEventListener('click', () => toggleCart(false));
  cartOverlay?.addEventListener('click', (e) => {
    if (e.target === cartOverlay) toggleCart(false);
  });

  // Save Cart to LocalStorage
  function saveCart() {
    localStorage.setItem('boutique_cart', JSON.stringify(cart));
  }

  // Handle Cart Quantity Change
  function changeQuantity(cartItemId, amount) {
    const itemIndex = cart.findIndex(item => item.cartItemId === cartItemId);
    if (itemIndex > -1) {
      cart[itemIndex].quantity += amount;
      if (cart[itemIndex].quantity <= 0) {
        cart.splice(itemIndex, 1);
      }
      saveCart();
      renderCart();
    }
  }

  // Render Cart DOM
  function renderCart() {
    if (!cartItemsContainer || !cartBadge || !cartTotal || !checkoutBtn) return;

    if (cart.length === 0) {
      cartItemsContainer.innerHTML = `
        <div class="flex flex-col items-center justify-center py-16 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-zinc-700 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <p class="text-zinc-500 font-light text-sm">Your bag is currently empty.</p>
        </div>
      `;
      cartBadge.classList.add('opacity-0', 'scale-50');
      cartBadge.textContent = '0';
      cartTotal.textContent = '$0.00';
      checkoutBtn.setAttribute('disabled', 'true');
      return;
    }

    cartItemsContainer.innerHTML = cart.map(item => `
      <div class="flex items-center gap-4 bg-zinc-900/50 border border-white/5 p-4 rounded-xl">
        <img src="${item.image}" alt="${item.name}" class="w-16 h-16 object-cover rounded-lg bg-black/20" />
        <div class="flex-grow min-w-0">
          <h4 class="text-sm font-bold text-white truncate font-outfit">${item.name}</h4>
          <p class="text-xs text-zinc-500 mt-0.5">
            ${item.type === 'physical' ? `Size: <span class="text-white">${item.size}</span>` : 'Digital Account'}
          </p>
          <div class="flex items-center justify-between mt-2">
            <span class="text-sm font-bold text-[#C5A880]">$${(item.price * item.quantity).toFixed(2)}</span>
            <div class="flex items-center border border-white/10 rounded-lg overflow-hidden bg-black/20 text-xs">
              <button type="button" class="qty-minus px-2 py-1 hover:bg-white/5 text-zinc-400 hover:text-white" data-id="${item.cartItemId}">-</button>
              <span class="px-2 text-white font-outfit">${item.quantity}</span>
              <button type="button" class="qty-plus px-2 py-1 hover:bg-white/5 text-zinc-400 hover:text-white" data-id="${item.cartItemId}">+</button>
            </div>
          </div>
        </div>
      </div>
    `).join('');

    // Quantity click handlers
    cartItemsContainer.querySelectorAll('.qty-minus').forEach(btn => {
      btn.addEventListener('click', () => changeQuantity(btn.getAttribute('data-id') || '', -1));
    });
    cartItemsContainer.querySelectorAll('.qty-plus').forEach(btn => {
      btn.addEventListener('click', () => changeQuantity(btn.getAttribute('data-id') || '', 1));
    });

    // Badge Update
    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    cartBadge.classList.remove('opacity-0', 'scale-50');
    cartBadge.classList.add('opacity-100', 'scale-100');
    cartBadge.textContent = totalItems.toString();

    // Total Cost Update
    const totalCost = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    cartTotal.textContent = `$${totalCost.toFixed(2)}`;

    checkoutBtn.removeAttribute('disabled');
  }

  // Redirect to Checkout
  checkoutBtn?.addEventListener('click', () => {
    window.location.href = '/checkout';
  });

  // Size Button Switching for Apparel (static markup)
  function setupSizeSelectors() {
    const cards = document.querySelectorAll('[data-product-id]');
    cards.forEach(card => {
      const sizeButtons = card.querySelectorAll('.size-btn');
      sizeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          sizeButtons.forEach(b => {
            b.classList.remove('bg-white', 'text-black', 'border-white');
            b.classList.add('bg-zinc-900', 'text-zinc-400', 'border-zinc-800');
          });
          btn.classList.remove('bg-zinc-900', 'text-zinc-400', 'border-zinc-800');
          btn.classList.add('bg-white', 'text-black', 'border-white');
        });
      });
    });

    // Apparel加购点击事件
    document.querySelectorAll('#apparel .add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('[data-product-id]');
        if (!card) return;
        addToCartFromAttributes(card);
      });
    });
  }

  // General add to cart logic using HTML attributes
  function addToCartFromAttributes(element, size = '') {
    const id = element.getAttribute('data-product-id');
    const name = element.getAttribute('data-product-name');
    const price = parseFloat(element.getAttribute('data-product-price') || '0');
    const image = element.getAttribute('data-product-image');
    const type = element.getAttribute('data-product-type');

    if (!size && type === 'physical') {
      const activeSizeBtn = element.querySelector('.size-btn.bg-white');
      size = activeSizeBtn ? activeSizeBtn.getAttribute('data-size') || '' : '';
    }

    const cartItemId = type === 'physical' ? `${id}_${size}` : id;

    const existingIndex = cart.findIndex(item => item.cartItemId === cartItemId);
    if (existingIndex > -1) {
      cart[existingIndex].quantity += 1;
    } else {
      cart.push({
        cartItemId,
        id,
        name,
        price,
        image,
        type,
        size,
        quantity: 1
      });
    }

    saveCart();
    renderCart();
    toggleCart(true);

    cartTrigger?.classList.add('scale-110');
    setTimeout(() => cartTrigger?.classList.remove('scale-110'), 200);
  }

  // --- Dynamic Store Rendering ---
  
  // Render Categories in Sidebar & Mobile Scroller
  function renderCategories() {
    if (!desktopSidebar || !mobileBar) return;

    // Build categories count mapping
    const countMap = {};
    database.products.forEach(p => {
      countMap[p.cid] = (countMap[p.cid] || 0) + 1;
    });

    // 1. Render Desktop Sidebar
    desktopSidebar.innerHTML = database.categories.map(cat => {
      const count = countMap[cat.cid] || 0;
      const isActive = cat.cid === activeCategoryId;
      return `
        <button 
          type="button"
          class="w-full text-left px-4 py-3 rounded-xl text-sm font-semibold transition-all duration-300 font-outfit flex items-center justify-between group ${
            isActive 
              ? 'bg-[#C5A880]/15 text-[#C5A880] border border-[#C5A880]/30 glow-gold' 
              : 'text-zinc-400 hover:text-white hover:bg-white/5 border border-transparent'
          }"
          data-category-id="${cat.cid}"
        >
          <span class="truncate pr-2">${cat.name}</span>
          <span class="px-2 py-0.5 rounded-full text-[10px] bg-zinc-800 group-hover:bg-zinc-700 text-zinc-500 group-hover:text-zinc-300 font-mono transition">
            ${count}
          </span>
        </button>
      `;
    }).join('');

    // 2. Render Mobile Bar
    mobileBar.innerHTML = database.categories.map(cat => {
      const count = countMap[cat.cid] || 0;
      const isActive = cat.cid === activeCategoryId;
      return `
        <button 
          type="button"
          class="shrink-0 px-4 py-2.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-all duration-300 ${
            isActive 
              ? 'bg-[#C5A880] text-black font-bold' 
              : 'bg-zinc-900 text-zinc-400 border border-zinc-800'
          }"
          data-category-id="${cat.cid}"
        >
          ${cat.name} (${count})
        </button>
      `;
    }).join('');

    // Click listeners
    const catButtons = document.querySelectorAll('[data-category-id]');
    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        activeCategoryId = btn.getAttribute('data-category-id') || '';
        searchQuery = ''; // Clear search when switching categories
        if (searchInput) searchInput.value = '';
        renderCategories();
        renderDigitalProducts();
        
        // Scroll grid into view on mobile
        if (window.innerWidth < 768) {
          productsGrid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }

  // Render Digital Products Grid
  function renderDigitalProducts() {
    if (!productsGrid) return;

    // Filter products
    let filtered = database.products;
    
    if (searchQuery.trim() !== '') {
      const q = searchQuery.toLowerCase();
      filtered = filtered.filter(p => 
        p.name.toLowerCase().includes(q) || 
        p.category.toLowerCase().includes(q)
      );
    } else {
      filtered = filtered.filter(p => p.cid === activeCategoryId);
    }

    if (filtered.length === 0) {
      productsGrid.innerHTML = `
        <div class="col-span-full text-center py-24 text-zinc-500 font-light">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-zinc-700 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p>No products found matching your criteria.</p>
        </div>
      `;
      return;
    }

    productsGrid.innerHTML = filtered.map(p => {
      const isOutOfStock = p.stock === '0' || p.stock === '缺货';
      const cleanStock = isOutOfStock ? 'OUT OF STOCK' : `STOCK: ${p.stock}`;
      return `
        <div 
          class="glass-card hover-lift rounded-2xl p-6 flex flex-col justify-between border border-white/5 shadow-xl transition-all duration-300 group hover:border-[#C5A880]/30"
          data-product-id="${p.id}"
          data-product-name="${p.name}"
          data-product-price="${p.price_usd}"
          data-product-image="${p.image}"
          data-product-type="digital"
        >
          <div>
            <!-- Header Tag -->
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-0.5 text-[9px] font-bold uppercase tracking-wider rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                Digital Account
              </span>
              <span class="text-[9px] font-bold uppercase tracking-wider text-zinc-500 ${isOutOfStock ? 'text-red-400 bg-red-400/10 px-2 py-0.5 rounded border border-red-400/20' : ''}">
                ${cleanStock}
              </span>
            </div>
            
            <!-- Title -->
            <h4 class="text-sm font-bold text-white mb-2 leading-snug font-outfit group-hover:text-[#C5A880] transition-colors line-clamp-3">
              ${p.name}
            </h4>
            
            <p class="text-[10px] text-zinc-500 mt-1 leading-relaxed">
              Category: ${p.category}
            </p>
          </div>

          <!-- Bottom Actions -->
          <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between">
            <div class="font-outfit flex flex-col">
              <span class="text-lg font-black text-white">$${p.price_usd.toFixed(2)}</span>
              <span class="text-[10px] text-zinc-500">¥${p.price_cny} CNY</span>
            </div>
            <button 
              type="button" 
              ${isOutOfStock ? 'disabled' : ''}
              class="add-digital-btn px-4 py-2 rounded-lg bg-white hover:bg-[#C5A880] hover:text-black text-black font-bold text-xs uppercase tracking-wider transition-all duration-300 active:scale-95 disabled:opacity-20 disabled:pointer-events-none"
            >
              Add
            </button>
          </div>
        </div>
      `;
    }).join('');

    // Attach click listeners to Add buttons in the dynamic grid
    productsGrid.querySelectorAll('.add-digital-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('[data-product-id]');
        if (!card) return;
        addToCartFromAttributes(card);
      });
    });
  }

  // Hook Search Bar
  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    renderDigitalProducts();
  });

  // Run initial loads
  init();
</script>
