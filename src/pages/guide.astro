---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import tutorials from '../data/tutorials.json';
import TutorialSidebar from '../components/TutorialSidebar.astro';
import TutorialContent from '../components/TutorialContent.astro';

// Default active guide document
const landingDocId = "019c078f-75f3-769b-b6d1-0842f7b5fcc8";

// Group tutorials by parent_name
const categoriesMap = new Map();
tutorials.forEach((tut) => {
  const parent = tut.parent_name || "ROOT";
  if (!categoriesMap.has(parent)) {
    categoriesMap.set(parent, []);
  }
  categoriesMap.get(parent).push(tut);
});

// Category display mapping
const orderedCategories = [
  { name: "📱 Telegram / 电报教程", key: "telegram/电报 登录教程", items: categoriesMap.get("telegram/电报 登录教程") || [] },
  { name: "🐦 Twitter / 推特教程", key: "推特/ X 登录教程", items: categoriesMap.get("推特/ X 登录教程") || [] },
  { name: "📧 Google / 谷歌账号", key: "谷歌账号 - 登录方式", items: categoriesMap.get("谷歌账号 - 登录方式") || [] },
  { name: "📸 Instagram 教程", key: "instagram账号 登录教程", items: categoriesMap.get("instagram账号 登录教程") || [] },
  { name: "👥 Facebook / 脸书教程", key: "Facebook 脸书登录教程", items: categoriesMap.get("Facebook 脸书登录教程") || [] },
  { name: "💬 Discord 教程", key: "Discord的登录以及修改密码", items: categoriesMap.get("Discord的登录以及修改密码") || [] },
  { name: "🍏 Apple ID / 苹果账号", key: "苹果id账号 登录教程", items: categoriesMap.get("苹果id账号 登录教程") || [] },
  { name: "🌐 代理 / 代理子站设置", key: "网站代理设置教程", items: categoriesMap.get("网站代理设置教程") || [] },
  { name: "🏠 Residential IP / 住宅IP", key: "住宅ip 的使用教程", items: categoriesMap.get("住宅ip 的使用教程") || [] },
  { name: "🤖 ChatGPT / 镜像GPT", key: "镜像GPT网站介绍+教程", items: categoriesMap.get("镜像GPT网站介绍+教程") || [] }
].filter(cat => cat.items.length > 0);
---

<BaseLayout 
  title="AI Tutorial Hub & Account Guide" 
  description="Clear step-by-step account login walkthroughs and network configurations for Telegram, Twitter, Google, and ChatGPT at Puppy Shop."
>
  <Header />

  <!-- Main Background Container with Gradients -->
  <div class="relative min-h-screen flex flex-col pt-24 md:pt-28 pb-16 bg-gradient-to-b from-[#FFF3F5] via-[#FFFDF9] to-[#FFFDF9] overflow-hidden">
    <!-- Radial mesh pattern overlay -->
    <div class="absolute inset-0 bg-[radial-gradient(#ffccd5_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none"></div>

    <!-- Soft ambient background glows -->
    <div class="absolute top-40 left-[-10%] w-[35rem] h-[35rem] bg-[#FFD6E0]/25 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-40 right-[-10%] w-[35rem] h-[35rem] bg-[#FFEEDD]/30 rounded-full blur-3xl pointer-events-none"></div>

    <main class="flex-grow max-w-7xl w-full mx-auto px-6 flex flex-col font-sans relative z-10 select-none">
      
      <!-- Top Title section -->
      <div class="text-center mb-8 md:mb-12 mt-6">
        <h1 class="text-3xl md:text-5xl font-black font-fredoka text-[#3E2A1E] mb-3 tracking-wide">
          帮助中心 & 登录教程 🐾
        </h1>
        <p class="text-[#6D5A50] font-quicksand font-bold max-w-2xl mx-auto text-xs md:text-sm leading-relaxed">
          点击左侧分类以查看各类账号的极简登录配置指南、代理网络设置及常见问题自救。
        </p>
      </div>

      <!-- Mobile Selector for smaller viewports (collapses categories) -->
      <div class="lg:hidden w-full mb-6 relative">
        <label for="mobile-guide-select" class="block text-xs font-bold uppercase text-[#6D5A50] tracking-wider mb-2 font-quicksand">
          选择教程目录
        </label>
        <div class="relative">
          <select 
            id="mobile-guide-select"
            class="w-full bg-white/70 backdrop-blur-md border border-[#3E2A1E]/15 text-xs font-semibold text-[#3E2A1E] rounded-2xl px-4 py-3.5 shadow-sm appearance-none focus:outline-none focus:ring-2 focus:ring-[#FF6B8B]/40 focus:border-[#FF6B8B]"
          >
            {orderedCategories.map(cat => (
              <optgroup label={cat.name}>
                {cat.items.map(tut => (
                  <option value={tut.id} selected={tut.id === landingDocId}>
                    {tut.emoji ? `${tut.emoji} ` : ""} {tut.name}
                  </option>
                ))}
              </optgroup>
            ))}
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-[#3E2A1E]/70">
            <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
              <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- Dual Column Layout for Sidebar and Viewer -->
      <div class="flex flex-col lg:flex-row gap-8 items-start">
        <!-- Sidebar Menu -->
        <TutorialSidebar categories={orderedCategories} activeId={landingDocId} />

        <!-- Viewer Pane -->
        <TutorialContent tutorials={tutorials} activeId={landingDocId} />
      </div>

    </main>
  </div>

  <Footer />
</BaseLayout>

<script>
  console.log("Guide script initialized");
  const navButtons = document.querySelectorAll('.nav-item-btn');
  const panes = document.querySelectorAll('.tutorial-pane');
  const mobileSelect = document.getElementById('mobile-guide-select') as HTMLSelectElement;

  console.log(`Found ${navButtons.length} nav buttons and ${panes.length} panes.`);

  function switchTutorial(targetId: string) {
    console.log("Switching to tutorial ID:", targetId);
    let matchedPane = false;
    
    // 1. Toggle pane active state and classes
    panes.forEach(pane => {
      if (pane.id === `tutorial-pane-${targetId}`) {
        console.log("Showing pane:", pane.id);
        pane.classList.remove('hidden');
        pane.classList.add('active-pane', 'animate-fade-in');
        matchedPane = true;
      } else {
        pane.classList.add('hidden');
        pane.classList.remove('active-pane', 'animate-fade-in');
      }
    });

    if (!matchedPane) {
      console.warn("No matching pane found for ID:", targetId);
    }

    // 2. Synchronize navigation buttons styling
    navButtons.forEach(btn => {
      const docId = btn.getAttribute('data-doc-id');
      if (docId === targetId) {
        btn.className = "nav-item-btn w-full text-left py-2.5 px-4 text-xs font-semibold rounded-xl transition-all duration-300 flex items-center gap-2 cursor-pointer transform active:scale-[0.98] bg-gradient-to-r from-[#FFD6E0] to-[#FFB3C6] text-[#3E2A1E] font-bold border border-[#FF6B8B]/40 shadow-sm translate-x-1";
      } else {
        btn.className = "nav-item-btn w-full text-left py-2.5 px-4 text-xs font-semibold rounded-xl transition-all duration-300 flex items-center gap-2 cursor-pointer transform active:scale-[0.98] text-[#6D5A50] hover:bg-white/60 hover:text-[#3E2A1E] hover:translate-x-1 border border-transparent";
      }
    });

    // 3. Update mobile select index
    if (mobileSelect && mobileSelect.value !== targetId) {
      mobileSelect.value = targetId;
    }

    // 4. Smooth scroll viewport on mobile screens
    if (window.innerWidth < 1024) {
      const contentViewport = document.getElementById('tutorial-content-viewport');
      if (contentViewport) {
        const topOffset = contentViewport.getBoundingClientRect().top + window.scrollY - 100;
        window.scrollTo({ top: topOffset, behavior: 'smooth' });
      }
    }
  }

  // Hook button event listeners
  navButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const docId = btn.getAttribute('data-doc-id');
      console.log("Nav button clicked, docId:", docId);
      if (docId) switchTutorial(docId);
    });
  });

  // Hook mobile selection event listener
  mobileSelect?.addEventListener('change', (e) => {
    const docId = (e.target as HTMLSelectElement).value;
    console.log("Mobile select changed, docId:", docId);
    if (docId) switchTutorial(docId);
  });
</script>
