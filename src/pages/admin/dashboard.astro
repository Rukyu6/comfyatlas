---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="商家管理后台 — Puppy Shop">
  <!-- Security Error Overlay (Hidden initially) -->
  <div 
    id="admin-security-overlay" 
    class="hidden fixed inset-0 z-50 bg-black flex flex-col items-center justify-center p-6 text-center select-none"
  >
    <div class="glass-card p-8 max-w-md w-full text-center space-y-6 bg-[#1C1917]/80 border border-[#292929] backdrop-blur-xl text-white">
      <div class="w-16 h-16 rounded-full bg-rose-950/20 border border-rose-500/30 flex items-center justify-center mx-auto text-rose-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m0-6v2m0-8h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div class="space-y-2">
        <h2 class="text-xl font-extrabold text-white font-fredoka">拒绝访问</h2>
        <p class="text-xs text-zinc-400 leading-relaxed" id="admin-security-msg">
          您无权查看商家后台。请使用管理员账户登录。
        </p>
      </div>
      <div class="pt-4 flex gap-3 justify-center">
        <a 
          href="/login?redirect=/admin/dashboard" 
          class="px-5 py-2.5 bg-[#E7AC08] text-black hover:bg-[#FAC514] font-bold text-xs uppercase tracking-wider rounded-xl border border-[#FAC514] transition active:scale-95 font-fredoka"
        >
          登录账户
        </a>
        <a 
          href="/" 
          class="px-5 py-2.5 bg-transparent border border-[#292929] text-white hover:bg-white/5 font-bold text-xs uppercase tracking-wider rounded-xl transition active:scale-95 font-fredoka"
        >
          返回商城
        </a>
      </div>
    </div>
  </div>

  <!-- Main Dashboard View -->
  <div class="min-h-screen pt-28 pb-20 px-6 max-w-7xl mx-auto w-full relative z-10" id="admin-main-view">
    <div class="space-y-8">
      
      <!-- Top header layout -->
      <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-[#292929] pb-6">
        <div class="space-y-1">
          <span class="text-[#E7AC08] uppercase tracking-widest text-[10px] font-bold font-fredoka block">运营管理室</span>
          <h1 class="text-3xl font-extrabold font-fredoka text-white">商家后台管理</h1>
        </div>
        <div class="flex gap-3 mt-4 md:mt-0">
          <a 
            href="/" 
            class="px-4 py-2 bg-transparent border border-[#292929] text-white hover:bg-white/5 text-xs font-bold font-fredoka uppercase tracking-wider rounded-xl transition flex items-center gap-2 active:scale-95"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            商城首页
          </a>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div class="flex border-b border-[#292929] gap-6">
        <button 
          id="tab-btn-orders" 
          type="button" 
          class="pb-3 border-b-2 border-[#E7AC08] text-[#E7AC08] font-bold text-sm font-fredoka transition-all cursor-pointer"
        >
          📦 订单队列
        </button>
        <button 
          id="tab-btn-deposits" 
          type="button" 
          class="pb-3 border-b-2 border-transparent text-zinc-500 hover:text-white font-bold text-sm font-fredoka transition-all cursor-pointer"
        >
          💰 充值审核
        </button>
        <button 
          id="tab-btn-customers" 
          type="button" 
          class="pb-3 border-b-2 border-transparent text-zinc-500 hover:text-white font-bold text-sm font-fredoka transition-all cursor-pointer"
        >
          👥 客户管理
        </button>
      </div>

      <!-- Tab View: Orders -->
      <div id="view-orders" class="space-y-8">
        <!-- ANALYTICS HIGHLIGHTS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- Total Revenue USD -->
          <div class="glass-card p-6 space-y-2 bg-[#1C1917]/50 border border-[#292929] backdrop-blur-xl text-white">
            <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest block font-fredoka">总营收 (USD)</span>
            <p class="text-2xl font-black text-[#E7AC08] font-fredoka" id="stat-revenue-usd">$0.00</p>
            <span class="text-[10px] text-emerald-400 flex items-center gap-1 font-fredoka font-bold">● 实时同步</span>
          </div>

          <!-- Total Revenue CNY -->
          <div class="glass-card p-6 space-y-2 bg-[#1C1917]/50 border border-[#292929] backdrop-blur-xl text-white">
            <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest block font-fredoka">总营收 (CNY)</span>
            <p class="text-2xl font-black text-white font-fredoka" id="stat-revenue-cny">¥0 CNY</p>
            <span class="text-[10px] text-zinc-500 font-fredoka">按约 6.8 汇率换算</span>
          </div>

          <!-- Completed Orders -->
          <div class="glass-card p-6 space-y-2 bg-[#1C1917]/50 border border-[#292929] backdrop-blur-xl text-white">
            <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest block font-fredoka">已完成订单</span>
            <p class="text-2xl font-black text-[#E7AC08] font-fredoka" id="stat-orders-completed">0</p>
            <span class="text-[10px] text-zinc-500 font-fredoka" id="stat-orders-total">订单总数: 0</span>
          </div>

          <!-- Pending Verification -->
          <div class="glass-card p-6 space-y-2 bg-[#1C1917]/50 border border-[#292929] backdrop-blur-xl text-white">
            <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest block font-fredoka">待审核订单</span>
            <p class="text-2xl font-black text-amber-500 font-fredoka" id="stat-orders-pending">0</p>
            <span class="text-[10px] text-zinc-500 font-fredoka">等待支付凭证核对</span>
          </div>

        </div>

        <!-- ANALYTICS SPLIT CHART & ORDERS HEADER -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          
          <!-- Category Sales Mix -->
          <div class="lg:col-span-1 glass-card p-6 space-y-6 flex flex-col justify-between bg-[#1C1917]/50 border border-[#292929] backdrop-blur-xl text-white">
            <div class="space-y-1">
              <h3 class="text-sm font-bold text-white uppercase tracking-wider font-fredoka">销售占比分析</h3>
              <p class="text-xs text-zinc-400 font-fredoka">各个商品分类的营收分布占比</p>
            </div>

            <div class="space-y-4">
              <!-- Digital accounts split bar -->
              <div class="space-y-1.5 text-left">
                <div class="flex justify-between text-xs font-semibold">
                  <span class="text-emerald-400 font-fredoka">数字商品库</span>
                  <span class="text-white font-fredoka" id="stat-mix-digital-pct">0%</span>
                </div>
                <div class="w-full h-3.5 bg-black border border-[#292929] rounded-full overflow-hidden">
                  <div id="stat-mix-digital-fill" class="h-full bg-emerald-500 transition-all duration-500 w-0"></div>
                </div>
                <span class="text-[10px] text-zinc-400 block" id="stat-mix-digital-val">销售额 $0.00</span>
              </div>

              <!-- Apparel/Physical accounts split bar -->
              <div class="space-y-1.5 text-left">
                <div class="flex justify-between text-xs font-semibold">
                  <span class="text-[#E7AC08] font-fredoka">潮流服饰</span>
                  <span class="text-white font-fredoka" id="stat-mix-apparel-pct">0%</span>
                </div>
                <div class="w-full h-3.5 bg-black border border-[#292929] rounded-full overflow-hidden">
                  <div id="stat-mix-apparel-fill" class="h-full bg-[#E7AC08] transition-all duration-500 w-0"></div>
                </div>
                <span class="text-[10px] text-zinc-400 block" id="stat-mix-apparel-val">销售额 $0.00</span>
              </div>

            </div>

            <div class="text-[10px] text-zinc-500 border-t border-[#292929] pt-4 font-fredoka">
              提示：调整商品价格会更新未来的订单统计。
            </div>
          </div>

          <!-- Ledger logs table container -->
          <div class="lg:col-span-2 glass-card p-6 space-y-6 bg-[#1C1917]/50 border border-[#292929] backdrop-blur-xl text-white">
            <div class="flex items-center justify-between border-b border-[#292929] pb-4">
              <h3 class="text-sm font-bold text-white uppercase tracking-wider font-fredoka">交易账目明细</h3>
              <span class="text-[10px] font-bold text-zinc-400 font-mono" id="stat-ledger-count">总行数: 0</span>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse text-xs">
                <thead>
                  <tr class="border-b border-[#292929] text-zinc-400 uppercase tracking-widest text-[9px] font-bold font-fredoka">
                    <th class="pb-3 pr-2">订单 ID</th>
                    <th class="pb-3 px-2">客户</th>
                    <th class="pb-3 px-2">总计 (USD)</th>
                    <th class="pb-3 px-2">支付方式</th>
                    <th class="pb-3 px-2">状态</th>
                    <th class="pb-3 pl-2 text-right">操作</th>
                  </tr>
                </thead>
                <tbody id="ledger-rows" class="divide-y divide-[#292929] text-zinc-300 font-fredoka">
                  <tr>
                    <td colspan="6" class="py-12 text-center text-zinc-500">Initializing transaction log...</td>
                  </tr>
                </tbody>
              </table>
            </div>

          </div>

        </div>
      </div>

      <!-- Tab View: Deposits -->
      <div id="view-deposits" class="hidden space-y-6">
        <div class="glass-card p-6 space-y-6 bg-[#1C1917]/50 border border-[#292929] backdrop-blur-xl text-white">
          <div class="flex items-center justify-between border-b border-[#292929] pb-4">
            <h3 class="text-sm font-bold text-white uppercase tracking-wider font-fredoka">充值审核管理</h3>
            <span class="text-[10px] font-bold text-zinc-400 font-mono" id="stat-deposits-count">充值申请总数: 0</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr class="border-b border-[#292929] text-zinc-400 uppercase tracking-widest text-[9px] font-bold font-fredoka">
                  <th class="pb-3 pr-2">申请 ID</th>
                  <th class="pb-3 px-2">客户邮箱</th>
                  <th class="pb-3 px-2">充值金额</th>
                  <th class="pb-3 px-2">转账凭证</th>
                  <th class="pb-3 px-2">状态</th>
                  <th class="pb-3 pl-2 text-right">操作</th>
                </tr>
              </thead>
              <tbody id="deposit-ledger-rows" class="divide-y divide-[#292929] text-zinc-300 font-fredoka">
                <tr>
                  <td colspan="6" class="py-12 text-center text-zinc-500">正在加载充值申请列表中...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Tab View: Customers -->
      <div id="view-customers" class="hidden space-y-6">
        <div class="glass-card p-6 space-y-6 bg-[#1C1917]/50 border border-[#292929] backdrop-blur-xl text-white">
          <div class="flex items-center justify-between border-b border-[#292929] pb-4">
            <h3 class="text-sm font-bold text-white uppercase tracking-wider font-fredoka">客户/会员管理</h3>
            <span class="text-[10px] font-bold text-zinc-400 font-mono" id="stat-customers-count">客户总数: 0</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr class="border-b border-[#292929] text-zinc-400 uppercase tracking-widest text-[9px] font-bold font-fredoka">
                  <th class="pb-3 pr-2">用户 ID (UID)</th>
                  <th class="pb-3 px-2">客户邮箱</th>
                  <th class="pb-3 px-2">会员余额</th>
                  <th class="pb-3 pl-2 text-right">操作</th>
                </tr>
              </thead>
              <tbody id="customer-ledger-rows" class="divide-y divide-[#292929] text-zinc-300 font-fredoka">
                <tr>
                  <td colspan="4" class="py-12 text-center text-zinc-500">正在加载客户列表中...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- ORDER REVIEW DETAIL MODAL (Hidden initially) -->
  <div id="order-details-modal" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-6">
    <div class="glass-card max-w-xl w-full p-8 relative space-y-6 bg-[#1C1917] border border-[#292929] backdrop-blur-xl text-white">
      
      <!-- Close button -->
      <button 
        id="modal-close-btn" 
        type="button" 
        class="absolute top-4 right-4 p-2 text-zinc-400 hover:text-white rounded-full hover:bg-white/5 transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>

      <div class="space-y-1 text-left border-b border-[#292929] pb-4">
        <span class="text-[9px] font-bold text-zinc-400 uppercase tracking-widest font-mono" id="modal-order-id">订单参考信息</span>
        <h3 class="text-lg font-bold text-white font-fredoka" id="modal-order-email">客户明细</h3>
      </div>

      <div class="space-y-3 text-left">
        <h4 class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest font-fredoka">已购商品</h4>
        <div id="modal-order-items" class="max-h-[160px] overflow-y-auto space-y-2 pr-2 border-y border-[#292929] py-3 font-fredoka">
          <!-- Dyn injected -->
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 text-left">
        <div>
          <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest block font-fredoka">支付通道</span>
          <p class="text-xs text-white font-semibold mt-0.5" id="modal-payment-method">-</p>
        </div>
        <div>
          <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest block font-fredoka">交易单号 / 哈希</span>
          <p class="text-xs text-white font-mono font-semibold mt-0.5 select-all break-all" id="modal-payment-hash">-</p>
        </div>
      </div>

      <!-- Card Key Input / Dispatch Content Section -->
      <div id="modal-dispatch-section" class="space-y-1.5 text-left hidden">
        <label for="modal-dispatch-input" class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest block font-fredoka">发货卡密内容 (Card Credentials)</label>
        <textarea 
          id="modal-dispatch-input" 
          rows="2"
          placeholder="输入您代购的卡密或账号信息 (例如: GGG-F4PK1Q3IWZ704T4L)..."
          class="w-full bg-black border border-[#292929] rounded-xl px-4 py-2 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-[#E7AC08] focus:ring-1 focus:ring-[#E7AC08]"
        ></textarea>
      </div>

      <!-- Actions -->
      <div class="pt-4 border-t border-[#292929] flex gap-3 justify-end" id="modal-actions-container">
        <!-- Dyn actions based on status -->
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  import { authInstance, onAuthStateChanged, collection, dbInstance, onSnapshot, doc, updateDoc, getDoc, setDoc } from '../../lib/firebase.js';

  // Configured admin email address
  const adminEmail = import.meta.env.PUBLIC_ADMIN_EMAIL || 'rukyucrono@gmail.com';

  // DOM Elements
  const securityOverlay = document.getElementById('admin-security-overlay');
  const mainView = document.getElementById('admin-main-view');

  // Stats Elements
  const statRevUsd = document.getElementById('stat-revenue-usd');
  const statRevCny = document.getElementById('stat-revenue-cny');
  const statOrdCompleted = document.getElementById('stat-orders-completed');
  const statOrdTotal = document.getElementById('stat-orders-total');
  const statOrdPending = document.getElementById('stat-orders-pending');

  const mixDigitalPct = document.getElementById('stat-mix-digital-pct');
  const mixDigitalVal = document.getElementById('stat-mix-digital-val');
  const mixDigitalFill = document.getElementById('stat-mix-digital-fill');

  const mixApparelPct = document.getElementById('stat-mix-apparel-pct');
  const mixApparelVal = document.getElementById('stat-mix-apparel-val');
  const mixApparelFill = document.getElementById('stat-mix-apparel-fill');

  const ledgerCount = document.getElementById('stat-ledger-count');
  const ledgerRows = document.getElementById('ledger-rows');

  // Modal Elements
  const detailsModal = document.getElementById('order-details-modal');
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const modalOrderId = document.getElementById('modal-order-id');
  const modalOrderEmail = document.getElementById('modal-order-email');
  const modalOrderItems = document.getElementById('modal-order-items');
  const modalPaymentMethod = document.getElementById('modal-payment-method');
  const modalPaymentHash = document.getElementById('modal-payment-hash');
  const modalActionsContainer = document.getElementById('modal-actions-container');
  const modalDispatchSection = document.getElementById('modal-dispatch-section');
  const modalDispatchInput = document.getElementById('modal-dispatch-input') as HTMLTextAreaElement;

  // Customers Elements
  const tabBtnCustomers = document.getElementById('tab-btn-customers');
  const viewCustomers = document.getElementById('view-customers');
  const customerLedgerRows = document.getElementById('customer-ledger-rows');
  const customersCount = document.getElementById('stat-customers-count');

  let activeOrders: any[] = [];
  let selectedOrder: any = null;
  let activeCustomers: any[] = [];

  // Protect Admin Route client-side
  onAuthStateChanged(authInstance, (user) => {
    if (!user) {
      // Redirect to signin
      window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`;
      return;
    }

    if (user.email !== adminEmail) {
      // Display Security overlay
      securityOverlay?.classList.remove('hidden');
      mainView?.classList.add('hidden');
      return;
    }

    // Success -> Hide overlay and listen to database updates in real-time
    securityOverlay?.classList.add('hidden');
    mainView?.classList.remove('hidden');
    
    syncLedger();
    syncDeposits();
    syncCustomers();
  });

  // Listen to orders updates in real-time
  function syncLedger() {
    const collRef = collection(dbInstance, 'orders');
    
    // Setup listener
    onSnapshot(collRef, (snapshot) => {
      const orders: any[] = [];
      snapshot.docs.forEach((doc) => {
        orders.push({ id: doc.id, ...doc.data() });
      });

      // Sort desc by timestamp
      activeOrders = orders.sort((a,b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

      renderAnalytics(activeOrders);
      renderTable(activeOrders);

      // Refresh modal details if currently open
      if (selectedOrder && detailsModal && !detailsModal.classList.contains('hidden')) {
        const refreshed = activeOrders.find(o => o.id === selectedOrder.id);
        if (refreshed) {
          openOrderDetails(refreshed);
        }
      }
    });
  }

  function renderAnalytics(orders: any[]) {
    // 1. Calculate general figures (only count completed or paid orders)
    const approvedOrders = orders.filter(o => o.status === 'completed' || o.status === 'paid');
    const totalRevUsd = approvedOrders.reduce((sum, o) => sum + o.totalUsd, 0);
    const totalRevCny = approvedOrders.reduce((sum, o) => sum + o.totalCny, 0);
    
    const completedCount = approvedOrders.length;
    const pendingCount = orders.filter(o => o.status === 'pending').length;

    if (statRevUsd) statRevUsd.textContent = `$${totalRevUsd.toFixed(2)}`;
    if (statRevCny) statRevCny.textContent = `¥${totalRevCny} CNY`;
    if (statOrdCompleted) statOrdCompleted.textContent = completedCount.toString();
    if (statOrdTotal) statOrdTotal.textContent = `订单总数: ${orders.length}`;
    if (statOrdPending) statOrdPending.textContent = pendingCount.toString();

    // 2. Calculate mix distribution
    let digitalRevenue = 0;
    let apparelRevenue = 0;

    approvedOrders.forEach(o => {
      o.items.forEach((item: any) => {
        const itemTotal = item.price * item.quantity;
        if (item.type === 'digital') {
          digitalRevenue += itemTotal;
        } else {
          apparelRevenue += itemTotal;
        }
      });
    });

    const mixTotal = digitalRevenue + apparelRevenue;
    const digitalPct = mixTotal > 0 ? Math.round((digitalRevenue / mixTotal) * 100) : 0;
    const apparelPct = mixTotal > 0 ? Math.round((apparelRevenue / mixTotal) * 100) : 0;

    if (mixDigitalPct) mixDigitalPct.textContent = `${digitalPct}%`;
    if (mixDigitalVal) mixDigitalVal.textContent = `销售额 $${digitalRevenue.toFixed(2)}`;
    if (mixDigitalFill) mixDigitalFill.style.width = `${digitalPct}%`;

    if (mixApparelPct) mixApparelPct.textContent = `${apparelPct}%`;
    if (mixApparelVal) mixApparelVal.textContent = `销售额 $${apparelRevenue.toFixed(2)}`;
    if (mixApparelFill) mixApparelFill.style.width = `${apparelPct}%`;
  }

  function renderTable(orders: any[]) {
    if (!ledgerRows) return;

    const statusMap: Record<string, string> = {
      'pending': '待审核',
      'completed': '已完成',
      'paid': '已支付',
      'cancelled': '已取消'
    };

    if (ledgerCount) ledgerCount.textContent = `总行数: ${orders.length}`;

    if (orders.length === 0) {
      ledgerRows.innerHTML = `
        <tr>
          <td colspan="6" class="py-12 text-center text-zinc-500">当前订单队列中暂无任何订单。</td>
        </tr>
      `;
      return;
    }

    ledgerRows.innerHTML = orders.map(order => {
      let statusClass = 'text-amber-400 bg-amber-500/10 border border-amber-500/20';
      if (order.status === 'completed' || order.status === 'paid') {
        statusClass = 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/20';
      } else if (order.status === 'cancelled') {
        statusClass = 'text-rose-400 bg-rose-500/10 border border-rose-500/20';
      }

      const cleanId = order.id.substring(0, 10) + '...';
      const displayStatus = statusMap[order.status] || order.status;

      return `
        <tr class="hover:bg-white/5 border-b border-[#292929] transition-colors cursor-pointer" onclick="window.viewOrderDetails('${order.id}')">
          <td class="py-3.5 pr-2 font-mono text-[10px] text-zinc-500 font-bold">${cleanId}</td>
          <td class="py-3.5 px-2 truncate max-w-[150px]">
            <span class="font-semibold block text-white">${order.username || '游客'}</span>
            <span class="text-[10px] text-zinc-500 font-normal block">${order.email}</span>
          </td>
          <td class="py-3.5 px-2 font-bold font-mono text-white">$${order.totalUsd.toFixed(2)}</td>
          <td class="py-3.5 px-2 uppercase text-[10px] text-zinc-400">${order.paymentMethod}</td>
          <td class="py-3.5 px-2">
            <span class="px-2 py-0.5 rounded-full border text-[9px] font-bold ${statusClass}">
              ${displayStatus}
            </span>
          </td>
          <td class="py-3.5 pl-2 text-right">
            <button 
              type="button" 
              class="px-2.5 py-1 bg-transparent border border-[#292929] hover:bg-white/5 text-[10px] font-bold uppercase rounded-lg text-white transition hover:border-white"
              onclick="event.stopPropagation(); window.viewOrderDetails('${order.id}')"
            >
              审核
            </button>
          </td>
        </tr>
      `;
    }).join('');
  }

  // Handle detailed modal opening
  window.viewOrderDetails = function(id) {
    const order = activeOrders.find(o => o.id === id);
    if (!order) return;
    openOrderDetails(order);
  };

  function openOrderDetails(order) {
    selectedOrder = order;

    if (modalOrderId) modalOrderId.textContent = `订单 ID: ${order.id}`;
    if (modalOrderEmail) {
      modalOrderEmail.innerHTML = order.username ? `${order.username} <span class="text-xs text-zinc-500 font-normal">(${order.email})</span>` : order.email;
    }
    if (modalPaymentMethod) modalPaymentMethod.textContent = order.paymentMethod || '加密货币';
    if (modalPaymentHash) modalPaymentHash.textContent = order.txId;

    const statusMap: Record<string, string> = {
      'pending': '待审核',
      'completed': '已完成',
      'paid': '已支付',
      'cancelled': '已取消'
    };

    // Items compilation
    if (modalOrderItems) {
      modalOrderItems.innerHTML = order.items.map((item: any) => `
        <div class="flex justify-between items-center text-xs py-1.5 border-b border-[#292929] last:border-0">
          <div>
            <p class="font-bold text-white">${item.name}</p>
            <p class="text-[10px] text-zinc-400 mt-0.5">
              ${item.type === 'digital' ? '卡密商品' : `服饰尺码: ${item.size || 'M'}`} × ${item.quantity}
            </p>
          </div>
          <span class="font-mono text-[#E7AC08] font-bold">$${(item.price * item.quantity).toFixed(2)}</span>
        </div>
      `).join('');
    }

    // Modal Operations Action Buttons
    if (modalActionsContainer) {
      if (order.status === 'pending') {
        modalActionsContainer.innerHTML = `
          <button 
            type="button"
            onclick="window.updateOrderStatus('${order.id}', 'cancelled')"
            class="px-4 py-2 rounded-xl bg-transparent border border-rose-500/30 text-rose-400 text-xs font-bold font-fredoka transition active:scale-95 uppercase hover:bg-rose-500/10"
          >
            取消订单
          </button>
          <button 
            type="button"
            onclick="window.updateOrderStatus('${order.id}', 'completed')"
            class="px-5 py-2.5 rounded-xl bg-[#E7AC08] hover:bg-[#FAC514] border border-[#FAC514] text-black font-bold text-xs font-fredoka transition active:scale-95 uppercase"
          >
            审核通过并完成发货
          </button>
        `;
      } else {
        const displayStatus = statusMap[order.status] || order.status;
        modalActionsContainer.innerHTML = `
          <span class="text-zinc-400 text-xs font-bold uppercase tracking-wider font-fredoka">最终状态: ${displayStatus}</span>
        `;
      }
    }

    // Toggle dispatch credentials input based on items type and status
    const hasDigital = order.items.some((i: any) => i.type === 'digital');
    if (modalDispatchSection && modalDispatchInput) {
      if (hasDigital && order.status === 'pending') {
        modalDispatchSection.classList.remove('hidden');
        modalDispatchInput.value = '';
        modalDispatchInput.disabled = false;
        modalDispatchInput.placeholder = "输入您代购的卡密或账号信息 (例如: GGG-F4PK1Q3IWZ704T4L)...";
      } else if (hasDigital && (order.status === 'completed' || order.status === 'paid')) {
        modalDispatchSection.classList.remove('hidden');
        modalDispatchInput.value = order.dispatchContent || '无卡密明细';
        modalDispatchInput.disabled = true;
      } else {
        modalDispatchSection.classList.add('hidden');
      }
    }

    detailsModal?.classList.remove('hidden');
  }

  // Update Status handler
  window.updateOrderStatus = async function(id, status) {
    const actionLabel = status === 'completed' ? '已完成' : '已取消';
    if (!confirm(`确定要将订单状态更改为 ${actionLabel} 吗？`)) return;
    
    try {
      const docRef = doc(dbInstance, 'orders', id);
      const updateData: any = { status };
      
      let dispatchVal = '';
      if (status === 'completed' && selectedOrder) {
        const hasDigital = selectedOrder.items.some((i: any) => i.type === 'digital');
        if (hasDigital && modalDispatchInput) {
          dispatchVal = modalDispatchInput.value.trim();
          if (!dispatchVal) {
            if (!confirm('提示：发货卡密内容为空。确定直接发货吗？')) {
              return;
            }
          }
          updateData.dispatchContent = dispatchVal;
        }
      }

      await updateDoc(docRef, updateData);
      
      // Update selected order cached state
      if (selectedOrder && selectedOrder.id === id) {
        selectedOrder.status = status;
        if (dispatchVal) {
          selectedOrder.dispatchContent = dispatchVal;
        }
      }
      
      alert(`订单状态更新成功。`);

      // If completed, trigger Bot 1 dispatch webhook
      if (status === 'completed' && selectedOrder) {
        try {
          await fetch('/api/dispatch-notify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              orderId: id,
              email: selectedOrder.email,
              createdAt: selectedOrder.createdAt || new Date().toISOString(),
              items: selectedOrder.items,
              dispatchContent: dispatchVal,
              username: selectedOrder.username || ''
            })
          });
        } catch (webhookErr) {
          console.error("Failed to trigger Telegram dispatch notification:", webhookErr);
        }
      }

      // Close modal on success
      if (detailsModal) detailsModal.classList.add('hidden');
      selectedOrder = null;

    } catch (err) {
      console.error("Failed to update status:", err);
      alert("更新状态失败，请检查数据库。");
    }
  };

  // Close Modal triggers
  modalCloseBtn?.addEventListener('click', () => {
    detailsModal?.classList.add('hidden');
    selectedOrder = null;
  });

  detailsModal?.addEventListener('click', (e) => {
    if (e.target === detailsModal) {
      detailsModal?.classList.add('hidden');
      selectedOrder = null;
    }
  });

  // Tab navigation bindings
  const tabBtnOrders = document.getElementById('tab-btn-orders');
  const tabBtnDeposits = document.getElementById('tab-btn-deposits');
  const viewOrders = document.getElementById('view-orders');
  const viewDeposits = document.getElementById('view-deposits');

  tabBtnOrders?.addEventListener('click', () => {
    tabBtnOrders.classList.add('border-[#E7AC08]', 'text-[#E7AC08]');
    tabBtnOrders.classList.remove('border-transparent', 'text-zinc-500');
    tabBtnDeposits?.classList.remove('border-[#E7AC08]', 'text-[#E7AC08]');
    tabBtnDeposits?.classList.add('border-transparent', 'text-zinc-500');
    tabBtnCustomers?.classList.remove('border-[#E7AC08]', 'text-[#E7AC08]');
    tabBtnCustomers?.classList.add('border-transparent', 'text-zinc-500');

    viewOrders?.classList.remove('hidden');
    viewDeposits?.classList.add('hidden');
    viewCustomers?.classList.add('hidden');
  });

  tabBtnDeposits?.addEventListener('click', () => {
    tabBtnDeposits.classList.add('border-[#E7AC08]', 'text-[#E7AC08]');
    tabBtnDeposits.classList.remove('border-transparent', 'text-zinc-500');
    tabBtnOrders?.classList.remove('border-[#E7AC08]', 'text-[#E7AC08]');
    tabBtnOrders?.classList.add('border-transparent', 'text-zinc-500');
    tabBtnCustomers?.classList.remove('border-[#E7AC08]', 'text-[#E7AC08]');
    tabBtnCustomers?.classList.add('border-transparent', 'text-zinc-500');

    viewOrders?.classList.add('hidden');
    viewDeposits?.classList.remove('hidden');
    viewCustomers?.classList.add('hidden');
  });

  tabBtnCustomers?.addEventListener('click', () => {
    tabBtnCustomers.classList.add('border-[#E7AC08]', 'text-[#E7AC08]');
    tabBtnCustomers.classList.remove('border-transparent', 'text-zinc-500');
    tabBtnOrders?.classList.remove('border-[#E7AC08]', 'text-[#E7AC08]');
    tabBtnOrders?.classList.add('border-transparent', 'text-zinc-500');
    tabBtnDeposits?.classList.remove('border-[#E7AC08]', 'text-[#E7AC08]');
    tabBtnDeposits?.classList.add('border-transparent', 'text-zinc-500');

    viewOrders?.classList.add('hidden');
    viewDeposits?.classList.add('hidden');
    viewCustomers?.classList.remove('hidden');
  });

  // Deposits sync logic
  let activeDeposits: any[] = [];
  const depositLedgerRows = document.getElementById('deposit-ledger-rows');
  const depositsCount = document.getElementById('stat-deposits-count');

  function syncDeposits() {
    const collRef = collection(dbInstance, 'deposits');
    
    onSnapshot(collRef, (snapshot) => {
      const deposits: any[] = [];
      snapshot.docs.forEach((doc) => {
        deposits.push({ id: doc.id, ...doc.data() });
      });

      activeDeposits = deposits.sort((a,b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
      renderDepositsTable(activeDeposits);
    });
  }

  function renderDepositsTable(deposits: any[]) {
    if (!depositLedgerRows) return;
    if (depositsCount) depositsCount.textContent = `充值申请总数: ${deposits.length}`;

    if (deposits.length === 0) {
      depositLedgerRows.innerHTML = `
        <tr>
          <td colspan="6" class="py-12 text-center text-zinc-500">暂无充值申请记录。</td>
        </tr>
      `;
      return;
    }

    const depositStatusMap: Record<string, string> = {
      'pending': '待审核',
      'approved': '已通过',
      'rejected': '已拒绝'
    };

    depositLedgerRows.innerHTML = deposits.map(dep => {
      let statusClass = 'text-amber-400 bg-amber-500/10 border border-amber-500/20';
      if (dep.status === 'approved') {
        statusClass = 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/20';
      } else if (dep.status === 'rejected') {
        statusClass = 'text-rose-400 bg-rose-500/10 border border-rose-500/20';
      }

      const actionsHtml = dep.status === 'pending' ? `
        <button 
          type="button" 
          class="px-2.5 py-1 bg-emerald-500/10 border border-emerald-500/30 hover:bg-emerald-500/20 text-emerald-400 text-[10px] font-bold rounded-lg transition"
          onclick="window.approveDeposit('${dep.id}', '${dep.uid}', ${dep.amount})"
        >
          审核通过
        </button>
        <button 
          type="button" 
          class="px-2.5 py-1 bg-rose-500/10 border border-rose-500/30 hover:bg-rose-500/20 text-rose-400 text-[10px] font-bold rounded-lg transition"
          onclick="window.rejectDeposit('${dep.id}')"
        >
          拒绝申请
        </button>
      ` : `<span class="text-zinc-500 font-bold uppercase tracking-wider text-[9px]">${depositStatusMap[dep.status] || dep.status}</span>`;

      return `
        <tr class="hover:bg-white/5 border-b border-[#292929] transition-colors">
          <td class="py-3.5 pr-2 font-mono text-[10px] text-zinc-500 font-bold">${dep.id.substring(0, 10)}...</td>
          <td class="py-3.5 px-2 font-semibold">
            <span class="block truncate text-white">${dep.email}</span>
            <span class="text-[10px] text-zinc-500 font-normal block">${dep.uid}</span>
          </td>
          <td class="py-3.5 px-2 font-bold font-mono text-[#E7AC08] font-sora">+$${Number(dep.amount).toFixed(2)} USDT</td>
          <td class="py-3.5 px-2 font-mono text-[10px] max-w-[200px] truncate select-all text-zinc-300" title="${dep.txId}">${dep.txId}</td>
          <td class="py-3.5 px-2">
            <span class="px-2 py-0.5 rounded-full border text-[9px] font-bold ${statusClass}">
              ${depositStatusMap[dep.status] || dep.status}
            </span>
          </td>
          <td class="py-3.5 pl-2 text-right space-x-1 whitespace-nowrap">
            ${actionsHtml}
          </td>
        </tr>
      `;
    }).join('');
  }

  // Bind approval/rejection operations to window context
  (window as any).approveDeposit = async function(depId: string, uid: string, amount: number) {
    if (!confirm(`确定通过该充值申请，为该会员账户充值 $${amount} USDT 吗？`)) return;

    try {
      // 1. Fetch current balance
      const userDocRef = doc(dbInstance, 'users', uid);
      const userDocSnap = await getDoc(userDocRef);
      let currentBalanceUsd = 0;
      let email = '';
      if (userDocSnap.exists()) {
        currentBalanceUsd = userDocSnap.data()?.balance_usd || 0;
        email = userDocSnap.data()?.email || '';
      }

      // 2. Increment user balance
      const newBalanceUsd = currentBalanceUsd + Number(amount);
      await setDoc(userDocRef, {
        balance_usd: newBalanceUsd,
        email: email
      });

      // 3. Mark deposit as approved
      const depDocRef = doc(dbInstance, 'deposits', depId);
      await updateDoc(depDocRef, { status: 'approved' });

      alert(`充值申请已通过！会员账户已成功入账 $${amount.toFixed(2)} USD (USDT)。`);
    } catch (err) {
      console.error("Failed to approve deposit:", err);
      alert("通过审核失败，请检查网络连接或数据库。");
    }
  };

  (window as any).rejectDeposit = async function(depId: string) {
    if (!confirm("确定要拒绝该充值申请吗？")) return;

    try {
      const depDocRef = doc(dbInstance, 'deposits', depId);
      await updateDoc(depDocRef, { status: 'rejected' });
      alert("充值申请已被拒绝。");
    } catch (err) {
      console.error("Failed to reject deposit:", err);
      alert("拒绝审核失败。");
    }
  };

  // Customers sync and balance adjustment logic
  function syncCustomers() {
    const collRef = collection(dbInstance, 'users');
    
    onSnapshot(collRef, (snapshot) => {
      const customers: any[] = [];
      snapshot.docs.forEach((doc) => {
        customers.push({ id: doc.id, ...doc.data() });
      });

      // Sort by email or balance or default
      activeCustomers = customers.sort((a, b) => (a.email || '').localeCompare(b.email || ''));
      renderCustomersTable(activeCustomers);
    }, (err) => {
      console.error("Failed to sync customers:", err);
      if (customerLedgerRows) {
        customerLedgerRows.innerHTML = `
          <tr>
            <td colspan="4" class="py-12 text-center text-rose-400 bg-rose-500/5 font-bold">
              加载客户列表失败，请在 Firebase 控制台检查安全规则配置！<br/>
              <span class="text-[10px] font-normal text-zinc-550">错误信息: ${err.message}</span>
            </td>
          </tr>
        `;
      }
    });
  }

  function renderCustomersTable(customers: any[]) {
    if (!customerLedgerRows) return;
    if (customersCount) customersCount.textContent = `客户总数: ${customers.length}`;

    if (customers.length === 0) {
      customerLedgerRows.innerHTML = `
        <tr>
          <td colspan="4" class="py-12 text-center text-zinc-500">暂无注册客户记录。</td>
        </tr>
      `;
      return;
    }

    customerLedgerRows.innerHTML = customers.map(cust => {
      const balance = typeof cust.balance_usd === 'number' ? cust.balance_usd : parseFloat(cust.balance_usd || 0);
      return `
        <tr class="hover:bg-white/5 border-b border-[#292929] transition-colors">
          <td class="py-3.5 pr-2 font-mono text-[10px] text-zinc-500 font-bold select-all">${cust.id}</td>
          <td class="py-3.5 px-2 font-semibold">
            <span class="block text-white truncate max-w-[250px]">${cust.email || '无邮箱'}</span>
          </td>
          <td class="py-3.5 px-2 font-bold font-mono text-[#E7AC08]">$${balance.toFixed(2)} USDT</td>
          <td class="py-3.5 pl-2 text-right space-x-1 whitespace-nowrap">
            <button 
              type="button" 
              class="px-2.5 py-1 bg-[#E7AC08]/10 border border-[#E7AC08]/30 hover:bg-[#E7AC08]/20 text-[#E7AC08] text-[10px] font-bold rounded-lg transition active:scale-95"
              onclick="window.adjustCustomerBalance('${cust.id}', ${balance})"
            >
              调整余额
            </button>
          </td>
        </tr>
      `;
    }).join('');
  }

  (window as any).adjustCustomerBalance = async function(uid: string, currentBalance: number) {
    const newBalanceStr = prompt(`当前余额为: $${currentBalance.toFixed(2)} USDT\n请输入新的账户余额 (USDT 纯数字，如 100):`, currentBalance.toString());
    if (newBalanceStr === null) return;

    const newBalance = parseFloat(newBalanceStr);
    if (isNaN(newBalance) || newBalance < 0) {
      alert("请输入有效的账户余额！");
      return;
    }

    if (!confirm(`确定要将该客户 (UID: ${uid}) 的余额调整为 $${newBalance.toFixed(2)} USDT 吗？`)) return;

    try {
      const userDocRef = doc(dbInstance, 'users', uid);
      await updateDoc(userDocRef, {
        balance_usd: newBalance
      });
      alert("账户余额调整成功！");
    } catch (err) {
      console.error("Failed to update user balance:", err);
      alert("更新余额失败，请检查网络连接或权限规则。");
    }
  };

  // --- Translation client-side integration ---
  function isoToTranslateJs(iso: string) {
    const map: Record<string, string> = {
      'en': 'english',
      'zh-CN': 'chinese_simplified',
      'zh-TW': 'chinese_traditional',
      'fr': 'french',
      'de': 'german',
      'es': 'spanish',
      'ja': 'japanese',
      'ru': 'russian',
      'ko': 'korean',
      'it': 'italian',
      'hi': 'hindi',
      'pt': 'portuguese'
    };
    return map[iso] || iso;
  }

  // Inject translate.js script dynamically in background (works inside China!)
  if (!document.getElementById('translate_js_script') && typeof window !== 'undefined') {
    const script = document.createElement('script');
    script.id = 'translate_js_script';
    script.src = 'https://cdn.staticfile.net/translate.js/3.18.66/translate.js';
    script.onload = () => {
      const translate = (window as any).translate;
      if (translate) {
        translate.language.setLocal('chinese_simplified');
        translate.service.use('client.edge');
        translate.selectLanguageTag.show = false;
        translate.listener.start();
        translate.execute();
        
        // Auto translate on load if a language was previously saved
        const currentLang = localStorage.getItem('active_language') || 'zh-CN';
        if (currentLang) {
          const translateJsLang = isoToTranslateJs(currentLang);
          setTimeout(() => {
            translate.changeLanguage(translateJsLang);
          }, 150);
        }
      }
    };
    document.body.appendChild(script);
  }
</script>
