---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Merchant Backoffice — Puppy Shop">
  <!-- Security Error Overlay (Hidden initially) -->
  <div 
    id="admin-security-overlay" 
    class="hidden fixed inset-0 z-50 bg-[#FFFDF9] flex flex-col items-center justify-center p-6 text-center select-none"
  >
    <div class="glass-card p-8 max-w-md w-full text-center space-y-6">
      <div class="w-16 h-16 rounded-full bg-rose-50 border-2 border-[#3E2A1E] flex items-center justify-center mx-auto text-rose-500 shadow-[2px_2px_0px_#3E2A1E]">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m0-6v2m0-8h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div class="space-y-2">
        <h2 class="text-xl font-extrabold text-[#3E2A1E] font-fredoka">Access Denied</h2>
        <p class="text-xs text-zinc-600 leading-relaxed" id="admin-security-msg">
          You are not authorized to view the merchant dashboard. Please sign in with an administrator account.
        </p>
      </div>
      <div class="pt-4 flex gap-3 justify-center">
        <a 
          href="/login?redirect=/admin/dashboard" 
          class="px-5 py-2.5 bg-[#FF9EAF] text-white hover:bg-[#FF6B8B] font-bold text-xs uppercase tracking-wider rounded-xl border-2 border-[#3E2A1E] shadow-[2px_2px_0px_#3E2A1E] transition hover:translate-y-[-2px] hover:shadow-[4px_4px_0px_#3E2A1E] font-fredoka"
        >
          Sign In
        </a>
        <a 
          href="/" 
          class="px-5 py-2.5 bg-white border-2 border-[#3E2A1E] text-[#3E2A1E] hover:bg-[#FFF5F7] font-bold text-xs uppercase tracking-wider rounded-xl transition hover:translate-y-[-2px] hover:shadow-[4px_4px_0px_#3E2A1E] font-fredoka"
        >
          Back to Shop
        </a>
      </div>
    </div>
  </div>

  <!-- Main Dashboard View -->
  <div class="min-h-screen pt-28 pb-20 px-6 max-w-7xl mx-auto w-full relative z-10" id="admin-main-view">
    <div class="space-y-8">
      
      <!-- Top header layout -->
      <div class="flex flex-col md:flex-row md:items-end justify-between border-b-3 border-[#3E2A1E]/20 pb-6">
        <div class="space-y-1">
          <span class="text-[#FF9EAF] uppercase tracking-widest text-[10px] font-bold font-fredoka block">Operations Room</span>
          <h1 class="text-3xl font-extrabold font-fredoka text-[#3E2A1E]">Merchant Dashboard</h1>
        </div>
        <div class="flex gap-3 mt-4 md:mt-0">
          <a 
            href="/" 
            class="px-4 py-2 bg-white border-2 border-[#3E2A1E] text-[#3E2A1E] hover:bg-[#FFF5F7] text-xs font-bold font-fredoka uppercase tracking-wider rounded-xl shadow-[2px_2px_0px_#3E2A1E] hover:translate-y-[-1px] hover:shadow-[3px_3px_0px_#3E2A1E] transition flex items-center gap-2 active:scale-95"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Boutique Front
          </a>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div class="flex border-b-2 border-[#3E2A1E]/10 gap-6">
        <button 
          id="tab-btn-orders" 
          type="button" 
          class="pb-3 border-b-3 border-[#FF9EAF] text-[#FF9EAF] font-bold text-sm font-fredoka transition-all cursor-pointer"
        >
          📦 Orders Queue
        </button>
        <button 
          id="tab-btn-deposits" 
          type="button" 
          class="pb-3 border-b-3 border-transparent text-zinc-500 hover:text-[#3E2A1E] font-bold text-sm font-fredoka transition-all cursor-pointer"
        >
          💰 Deposit Reviews
        </button>
      </div>

      <!-- Tab View: Orders -->
      <div id="view-orders" class="space-y-8">
        <!-- ANALYTICS HIGHLIGHTS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- Total Revenue USD -->
          <div class="glass-card p-6 space-y-2">
            <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest block font-fredoka">Revenue (USD)</span>
            <p class="text-2xl font-black text-[#3E2A1E] font-fredoka" id="stat-revenue-usd">$0.00</p>
            <span class="text-[10px] text-emerald-600 flex items-center gap-1 font-fredoka font-bold">● Real-time synced</span>
          </div>

          <!-- Total Revenue CNY -->
          <div class="glass-card p-6 space-y-2">
            <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest block font-fredoka">Revenue (CNY)</span>
            <p class="text-2xl font-black text-[#3E2A1E] font-fredoka" id="stat-revenue-cny">¥0 CNY</p>
            <span class="text-[10px] text-zinc-500 font-fredoka">Approx. 6.8x conversion</span>
          </div>

          <!-- Completed Orders -->
          <div class="glass-card p-6 space-y-2">
            <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest block font-fredoka">Completed Orders</span>
            <p class="text-2xl font-black text-[#FF9EAF] font-fredoka" id="stat-orders-completed">0</p>
            <span class="text-[10px] text-zinc-500 font-fredoka" id="stat-orders-total">Total Orders: 0</span>
          </div>

          <!-- Pending Verification -->
          <div class="glass-card p-6 space-y-2">
            <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest block font-fredoka">Pending Review</span>
            <p class="text-2xl font-black text-amber-600 font-fredoka" id="stat-orders-pending">0</p>
            <span class="text-[10px] text-zinc-500 font-fredoka">Awaiting payment verification</span>
          </div>

        </div>

        <!-- ANALYTICS SPLIT CHART & ORDERS HEADER -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          
          <!-- Category Sales Mix -->
          <div class="lg:col-span-1 glass-card p-6 space-y-6 flex flex-col justify-between">
            <div class="space-y-1">
              <h3 class="text-sm font-bold text-[#3E2A1E] uppercase tracking-wider font-fredoka">Sales Mix breakdown</h3>
              <p class="text-xs text-zinc-500 font-fredoka">Distribution of revenue between product departments</p>
            </div>

            <div class="space-y-4">
              <!-- Digital accounts split bar -->
              <div class="space-y-1.5 text-left">
                <div class="flex justify-between text-xs font-semibold">
                  <span class="text-emerald-700 font-fredoka">Digital Vault</span>
                  <span class="text-[#3E2A1E] font-fredoka" id="stat-mix-digital-pct">0%</span>
                </div>
                <div class="w-full h-3.5 bg-[#3E2A1E]/5 border-2 border-[#3E2A1E] rounded-full overflow-hidden">
                  <div id="stat-mix-digital-fill" class="h-full bg-emerald-400 transition-all duration-500 w-0"></div>
                </div>
                <span class="text-[10px] text-zinc-500 block" id="stat-mix-digital-val">$0.00 sales</span>
              </div>

              <!-- Apparel/Physical accounts split bar -->
              <div class="space-y-1.5 text-left">
                <div class="flex justify-between text-xs font-semibold">
                  <span class="text-[#FF9EAF] font-fredoka">Streetwear Drop</span>
                  <span class="text-[#3E2A1E] font-fredoka" id="stat-mix-apparel-pct">0%</span>
                </div>
                <div class="w-full h-3.5 bg-[#3E2A1E]/5 border-2 border-[#3E2A1E] rounded-full overflow-hidden">
                  <div id="stat-mix-apparel-fill" class="h-full bg-[#FF9EAF] transition-all duration-500 w-0"></div>
                </div>
                <span class="text-[10px] text-zinc-500 block" id="stat-mix-apparel-val">$0.00 sales</span>
              </div>

            </div>

            <div class="text-[10px] text-zinc-600 border-t border-[#3E2A1E]/10 pt-4 font-fredoka">
              Tip: Revamping catalog prices updates future calculations.
            </div>
          </div>

          <!-- Ledger logs table container -->
          <div class="lg:col-span-2 glass-card p-6 space-y-6">
            <div class="flex items-center justify-between border-b border-[#3E2A1E]/10 pb-4">
              <h3 class="text-sm font-bold text-[#3E2A1E] uppercase tracking-wider font-fredoka">Transaction Ledger</h3>
              <span class="text-[10px] font-bold text-zinc-500 font-mono" id="stat-ledger-count">Total Rows: 0</span>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse text-xs">
                <thead>
                  <tr class="border-b border-[#3E2A1E]/20 text-[#3E2A1E]/70 uppercase tracking-widest text-[9px] font-bold font-fredoka">
                    <th class="pb-3 pr-2">Order ID</th>
                    <th class="pb-3 px-2">Customer</th>
                    <th class="pb-3 px-2">Total (USD)</th>
                    <th class="pb-3 px-2">Method</th>
                    <th class="pb-3 px-2">Status</th>
                    <th class="pb-3 pl-2 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="ledger-rows" class="divide-y divide-[#3E2A1E]/10 text-zinc-700 font-fredoka">
                  <tr>
                    <td colspan="6" class="py-12 text-center text-zinc-500">Initializing transaction log...</td>
                  </tr>
                </tbody>
              </table>
            </div>

          </div>

        </div>
      </div>

      <!-- Tab View: Deposits -->
      <div id="view-deposits" class="hidden space-y-6">
        <div class="glass-card p-6 space-y-6">
          <div class="flex items-center justify-between border-b border-[#3E2A1E]/10 pb-4">
            <h3 class="text-sm font-bold text-[#3E2A1E] uppercase tracking-wider font-fredoka">Deposit Request reviews</h3>
            <span class="text-[10px] font-bold text-zinc-500 font-mono" id="stat-deposits-count">Total Requests: 0</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr class="border-b border-[#3E2A1E]/20 text-[#3E2A1E]/70 uppercase tracking-widest text-[9px] font-bold font-fredoka">
                  <th class="pb-3 pr-2">申请ID / ID</th>
                  <th class="pb-3 px-2">客户邮箱 / Customer Email</th>
                  <th class="pb-3 px-2">充值金额 / Amount</th>
                  <th class="pb-3 px-2">转账凭证 / TxID</th>
                  <th class="pb-3 px-2">状态 / Status</th>
                  <th class="pb-3 pl-2 text-right">操作 / Actions</th>
                </tr>
              </thead>
              <tbody id="deposit-ledger-rows" class="divide-y divide-[#3E2A1E]/10 text-zinc-700 font-fredoka">
                <tr>
                  <td colspan="6" class="py-12 text-center text-zinc-500">加载充值申请列表中... / Loading deposit requests...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- ORDER REVIEW DETAIL MODAL (Hidden initially) -->
  <div id="order-details-modal" class="hidden fixed inset-0 z-50 bg-[#3E2A1E]/40 backdrop-blur-sm flex items-center justify-center p-6">
    <div class="glass-card max-w-xl w-full p-8 relative space-y-6">
      
      <!-- Close button -->
      <button 
        id="modal-close-btn" 
        type="button" 
        class="absolute top-4 right-4 p-2 text-zinc-500 hover:text-[#3E2A1E] rounded-full hover:bg-[#3E2A1E]/5 transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>

      <div class="space-y-1 text-left border-b border-[#3E2A1E]/10 pb-4">
        <span class="text-[9px] font-bold text-zinc-500 uppercase tracking-widest font-mono" id="modal-order-id">ORDER REFERENCE</span>
        <h3 class="text-lg font-bold text-[#3E2A1E] font-fredoka" id="modal-order-email">Customer Details</h3>
      </div>

      <div class="space-y-3 text-left">
        <h4 class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest font-fredoka">Ordered Items</h4>
        <div id="modal-order-items" class="max-h-[160px] overflow-y-auto space-y-2 pr-2 border-y border-[#3E2A1E]/10 py-3 font-fredoka">
          <!-- Dyn injected -->
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 text-left">
        <div>
          <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest block font-fredoka">Payment Channel</span>
          <p class="text-xs text-[#3E2A1E] font-semibold mt-0.5" id="modal-payment-method">-</p>
        </div>
        <div>
          <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest block font-fredoka">Reference / Hash</span>
          <p class="text-xs text-[#3E2A1E] font-mono font-semibold mt-0.5 select-all break-all" id="modal-payment-hash">-</p>
        </div>
      </div>

      <!-- Card Key Input / Dispatch Content Section -->
      <div id="modal-dispatch-section" class="space-y-1.5 text-left hidden">
        <label for="modal-dispatch-input" class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest block font-fredoka">发货卡密内容 (Card Credentials)</label>
        <textarea 
          id="modal-dispatch-input" 
          rows="2"
          placeholder="输入您代购的卡密或账号信息 (例如: GGG-F4PK1Q3IWZ704T4L)..."
          class="w-full bg-white border-2 border-[#3E2A1E] rounded-xl px-4 py-2 text-xs text-[#3E2A1E] placeholder-zinc-400 focus:outline-none focus:border-[#FF9EAF] shadow-[2px_2px_0px_#3E2A1E]"
        ></textarea>
      </div>

      <!-- Actions -->
      <div class="pt-4 border-t border-[#3E2A1E]/10 flex gap-3 justify-end" id="modal-actions-container">
        <!-- Dyn actions based on status -->
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  import { authInstance, onAuthStateChanged, collection, dbInstance, onSnapshot, doc, updateDoc, getDoc, setDoc } from '../../lib/firebase.js';

  // Configured admin email address
  const adminEmail = import.meta.env.PUBLIC_ADMIN_EMAIL || 'rukyucrono@gmail.com';

  // DOM Elements
  const securityOverlay = document.getElementById('admin-security-overlay');
  const mainView = document.getElementById('admin-main-view');

  // Stats Elements
  const statRevUsd = document.getElementById('stat-revenue-usd');
  const statRevCny = document.getElementById('stat-revenue-cny');
  const statOrdCompleted = document.getElementById('stat-orders-completed');
  const statOrdTotal = document.getElementById('stat-orders-total');
  const statOrdPending = document.getElementById('stat-orders-pending');

  const mixDigitalPct = document.getElementById('stat-mix-digital-pct');
  const mixDigitalVal = document.getElementById('stat-mix-digital-val');
  const mixDigitalFill = document.getElementById('stat-mix-digital-fill');

  const mixApparelPct = document.getElementById('stat-mix-apparel-pct');
  const mixApparelVal = document.getElementById('stat-mix-apparel-val');
  const mixApparelFill = document.getElementById('stat-mix-apparel-fill');

  const ledgerCount = document.getElementById('stat-ledger-count');
  const ledgerRows = document.getElementById('ledger-rows');

  // Modal Elements
  const detailsModal = document.getElementById('order-details-modal');
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const modalOrderId = document.getElementById('modal-order-id');
  const modalOrderEmail = document.getElementById('modal-order-email');
  const modalOrderItems = document.getElementById('modal-order-items');
  const modalPaymentMethod = document.getElementById('modal-payment-method');
  const modalPaymentHash = document.getElementById('modal-payment-hash');
  const modalActionsContainer = document.getElementById('modal-actions-container');
  const modalDispatchSection = document.getElementById('modal-dispatch-section');
  const modalDispatchInput = document.getElementById('modal-dispatch-input') as HTMLTextAreaElement;

  let activeOrders: any[] = [];
  let selectedOrder: any = null;

  // Protect Admin Route client-side
  onAuthStateChanged(authInstance, (user) => {
    if (!user) {
      // Redirect to signin
      window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`;
      return;
    }

    if (user.email !== adminEmail) {
      // Display Security overlay
      securityOverlay?.classList.remove('hidden');
      mainView?.classList.add('hidden');
      return;
    }

    // Success -> Hide overlay and listen to database updates in real-time
    securityOverlay?.classList.add('hidden');
    mainView?.classList.remove('hidden');
    
    syncLedger();
    syncDeposits();
  });

  // Listen to orders updates in real-time
  function syncLedger() {
    const collRef = collection(dbInstance, 'orders');
    
    // Setup listener
    onSnapshot(collRef, (snapshot) => {
      const orders: any[] = [];
      snapshot.docs.forEach((doc) => {
        orders.push({ id: doc.id, ...doc.data() });
      });

      // Sort desc by timestamp
      activeOrders = orders.sort((a,b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

      renderAnalytics(activeOrders);
      renderTable(activeOrders);

      // Refresh modal details if currently open
      if (selectedOrder && detailsModal && !detailsModal.classList.contains('hidden')) {
        const refreshed = activeOrders.find(o => o.id === selectedOrder.id);
        if (refreshed) {
          openOrderDetails(refreshed);
        }
      }
    });
  }

  function renderAnalytics(orders: any[]) {
    // 1. Calculate general figures (only count completed or paid orders)
    const approvedOrders = orders.filter(o => o.status === 'completed' || o.status === 'paid');
    const totalRevUsd = approvedOrders.reduce((sum, o) => sum + o.totalUsd, 0);
    const totalRevCny = approvedOrders.reduce((sum, o) => sum + o.totalCny, 0);
    
    const completedCount = approvedOrders.length;
    const pendingCount = orders.filter(o => o.status === 'pending').length;

    if (statRevUsd) statRevUsd.textContent = `$${totalRevUsd.toFixed(2)}`;
    if (statRevCny) statRevCny.textContent = `¥${totalRevCny} CNY`;
    if (statOrdCompleted) statOrdCompleted.textContent = completedCount.toString();
    if (statOrdTotal) statOrdTotal.textContent = `Total Orders: ${orders.length}`;
    if (statOrdPending) statOrdPending.textContent = pendingCount.toString();

    // 2. Calculate mix distribution
    let digitalRevenue = 0;
    let apparelRevenue = 0;

    approvedOrders.forEach(o => {
      o.items.forEach((item: any) => {
        const itemTotal = item.price * item.quantity;
        if (item.type === 'digital') {
          digitalRevenue += itemTotal;
        } else {
          apparelRevenue += itemTotal;
        }
      });
    });

    const mixTotal = digitalRevenue + apparelRevenue;
    const digitalPct = mixTotal > 0 ? Math.round((digitalRevenue / mixTotal) * 100) : 0;
    const apparelPct = mixTotal > 0 ? Math.round((apparelRevenue / mixTotal) * 100) : 0;

    if (mixDigitalPct) mixDigitalPct.textContent = `${digitalPct}%`;
    if (mixDigitalVal) mixDigitalVal.textContent = `$${digitalRevenue.toFixed(2)} sales`;
    if (mixDigitalFill) mixDigitalFill.style.width = `${digitalPct}%`;

    if (mixApparelPct) mixApparelPct.textContent = `${apparelPct}%`;
    if (mixApparelVal) mixApparelVal.textContent = `$${apparelRevenue.toFixed(2)} sales`;
    if (mixApparelFill) mixApparelFill.style.width = `${apparelPct}%`;
  }

  function renderTable(orders: any[]) {
    if (!ledgerRows) return;

    if (ledgerCount) ledgerCount.textContent = `Total Rows: ${orders.length}`;

    if (orders.length === 0) {
      ledgerRows.innerHTML = `
        <tr>
          <td colspan="6" class="py-12 text-center text-zinc-500">No orders registered in queue yet.</td>
        </tr>
      `;
      return;
    }

    ledgerRows.innerHTML = orders.map(order => {
      let statusClass = 'text-amber-700 bg-amber-50 border border-amber-300';
      if (order.status === 'completed' || order.status === 'paid') {
        statusClass = 'text-emerald-700 bg-emerald-50 border border-emerald-300';
      } else if (order.status === 'cancelled') {
        statusClass = 'text-rose-700 bg-rose-50 border border-rose-300';
      }

      const cleanId = order.id.substring(0, 10) + '...';

      return `
        <tr class="hover:bg-[#FFF5F7]/30 border-b border-[#3E2A1E]/5 transition-colors cursor-pointer" onclick="window.viewOrderDetails('${order.id}')">
          <td class="py-3.5 pr-2 font-mono text-[10px] text-[#3E2A1E]/70 font-bold">${cleanId}</td>
          <td class="py-3.5 px-2 truncate max-w-[150px]">
            <span class="font-semibold block">${order.username || '游客'}</span>
            <span class="text-[10px] text-zinc-500 font-normal block">${order.email}</span>
          </td>
          <td class="py-3.5 px-2 font-bold font-mono">$${order.totalUsd.toFixed(2)}</td>
          <td class="py-3.5 px-2 uppercase text-[10px] text-[#3E2A1E]/80">${order.paymentMethod}</td>
          <td class="py-3.5 px-2">
            <span class="px-2 py-0.5 rounded-full border text-[9px] font-bold ${statusClass}">
              ${order.status}
            </span>
          </td>
          <td class="py-3.5 pl-2 text-right">
            <button 
              type="button" 
              class="px-2.5 py-1 bg-white border-2 border-[#3E2A1E] hover:bg-[#FFF5F7] text-[10px] font-bold uppercase rounded-lg shadow-[2px_2px_0px_#3E2A1E] text-[#3E2A1E] transition font-fredoka hover:translate-y-[-1px] hover:shadow-[3px_3px_0px_#3E2A1E]"
              onclick="event.stopPropagation(); window.viewOrderDetails('${order.id}')"
            >
              Review
            </button>
          </td>
        </tr>
      `;
    }).join('');
  }

  // Handle detailed modal opening
  window.viewOrderDetails = function(id) {
    const order = activeOrders.find(o => o.id === id);
    if (!order) return;
    openOrderDetails(order);
  };

  function openOrderDetails(order) {
    selectedOrder = order;

    if (modalOrderId) modalOrderId.textContent = `ORDER ID: ${order.id}`;
    if (modalOrderEmail) {
      modalOrderEmail.innerHTML = order.username ? `${order.username} <span class="text-xs text-zinc-500 font-normal">(${order.email})</span>` : order.email;
    }
    if (modalPaymentMethod) modalPaymentMethod.textContent = order.paymentMethod || 'Cryptocurrency';
    if (modalPaymentHash) modalPaymentHash.textContent = order.txId;

    // Items compilation
    if (modalOrderItems) {
      modalOrderItems.innerHTML = order.items.map((item: any) => `
        <div class="flex justify-between items-center text-xs py-1.5 border-b border-[#3E2A1E]/10 last:border-0">
          <div>
            <p class="font-bold text-[#3E2A1E]">${item.name}</p>
            <p class="text-[10px] text-zinc-500 mt-0.5">
              ${item.type === 'digital' ? 'Digital Key' : `Clothing Size: ${item.size || 'M'}`} × ${item.quantity}
            </p>
          </div>
          <span class="font-mono text-[#3E2A1E] font-bold">$${(item.price * item.quantity).toFixed(2)}</span>
        </div>
      `).join('');
    }

    // Modal Operations Action Buttons
    if (modalActionsContainer) {
      if (order.status === 'pending') {
        modalActionsContainer.innerHTML = `
          <button 
            type="button"
            onclick="window.updateOrderStatus('${order.id}', 'cancelled')"
            class="px-4 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 border-2 border-[#3E2A1E] text-rose-700 text-xs font-bold font-fredoka transition active:scale-95 uppercase shadow-[2px_2px_0px_#3E2A1E] hover:translate-y-[-1px] hover:shadow-[3px_3px_0px_#3E2A1E]"
          >
            Cancel Order
          </button>
          <button 
            type="button"
            onclick="window.updateOrderStatus('${order.id}', 'completed')"
            class="px-5 py-2.5 rounded-xl bg-[#FF9EAF] hover:bg-[#FF6B8B] border-2 border-[#3E2A1E] text-white font-bold text-xs font-fredoka transition active:scale-95 uppercase shadow-[2px_2px_0px_#3E2A1E] hover:translate-y-[-1px] hover:shadow-[3px_3px_0px_#3E2A1E]"
          >
            Approve & Mark Completed
          </button>
        `;
      } else {
        modalActionsContainer.innerHTML = `
          <span class="text-zinc-600 text-xs font-bold uppercase tracking-wider font-fredoka">Final State: ${order.status}</span>
        `;
      }
    }

    // Toggle dispatch credentials input based on items type and status
    const hasDigital = order.items.some((i: any) => i.type === 'digital');
    if (modalDispatchSection && modalDispatchInput) {
      if (hasDigital && order.status === 'pending') {
        modalDispatchSection.classList.remove('hidden');
        modalDispatchInput.value = '';
        modalDispatchInput.disabled = false;
        modalDispatchInput.placeholder = "输入您代购的卡密或账号信息 (例如: GGG-F4PK1Q3IWZ704T4L)...";
      } else if (hasDigital && (order.status === 'completed' || order.status === 'paid')) {
        modalDispatchSection.classList.remove('hidden');
        modalDispatchInput.value = order.dispatchContent || '无卡密明细';
        modalDispatchInput.disabled = true;
      } else {
        modalDispatchSection.classList.add('hidden');
      }
    }

    detailsModal?.classList.remove('hidden');
  }

  // Update Status handler
  window.updateOrderStatus = async function(id, status) {
    if (!confirm(`Are you sure you want to change order status to ${status.toUpperCase()}?`)) return;
    
    try {
      const docRef = doc(dbInstance, 'orders', id);
      const updateData: any = { status };
      
      let dispatchVal = '';
      if (status === 'completed' && selectedOrder) {
        const hasDigital = selectedOrder.items.some((i: any) => i.type === 'digital');
        if (hasDigital && modalDispatchInput) {
          dispatchVal = modalDispatchInput.value.trim();
          if (!dispatchVal) {
            if (!confirm('提示：发货卡密内容为空。确定直接发货吗？')) {
              return;
            }
          }
          updateData.dispatchContent = dispatchVal;
        }
      }

      await updateDoc(docRef, updateData);
      
      // Update selected order cached state
      if (selectedOrder && selectedOrder.id === id) {
        selectedOrder.status = status;
        if (dispatchVal) {
          selectedOrder.dispatchContent = dispatchVal;
        }
      }
      
      alert(`Order status updated successfully.`);

      // If completed, trigger Bot 1 dispatch webhook
      if (status === 'completed' && selectedOrder) {
        try {
          await fetch('/api/dispatch-notify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              orderId: id,
              email: selectedOrder.email,
              createdAt: selectedOrder.createdAt || new Date().toISOString(),
              items: selectedOrder.items,
              dispatchContent: dispatchVal,
              username: selectedOrder.username || ''
            })
          });
        } catch (webhookErr) {
          console.error("Failed to trigger Telegram dispatch notification:", webhookErr);
        }
      }

      // Close modal on success
      if (detailsModal) detailsModal.classList.add('hidden');
      selectedOrder = null;

    } catch (err) {
      console.error("Failed to update status:", err);
      alert("Failed to update status in database.");
    }
  };

  // Close Modal triggers
  modalCloseBtn?.addEventListener('click', () => {
    detailsModal?.classList.add('hidden');
    selectedOrder = null;
  });

  detailsModal?.addEventListener('click', (e) => {
    if (e.target === detailsModal) {
      detailsModal?.classList.add('hidden');
      selectedOrder = null;
    }
  });

  // Tab navigation bindings
  const tabBtnOrders = document.getElementById('tab-btn-orders');
  const tabBtnDeposits = document.getElementById('tab-btn-deposits');
  const viewOrders = document.getElementById('view-orders');
  const viewDeposits = document.getElementById('view-deposits');

  tabBtnOrders?.addEventListener('click', () => {
    tabBtnOrders.classList.add('border-[#FF9EAF]', 'text-[#FF9EAF]');
    tabBtnOrders.classList.remove('border-transparent', 'text-zinc-500');
    tabBtnDeposits?.classList.remove('border-[#FF9EAF]', 'text-[#FF9EAF]');
    tabBtnDeposits?.classList.add('border-transparent', 'text-zinc-500');

    viewOrders?.classList.remove('hidden');
    viewDeposits?.classList.add('hidden');
  });

  tabBtnDeposits?.addEventListener('click', () => {
    tabBtnDeposits.classList.add('border-[#FF9EAF]', 'text-[#FF9EAF]');
    tabBtnDeposits.classList.remove('border-transparent', 'text-zinc-500');
    tabBtnOrders?.classList.remove('border-[#FF9EAF]', 'text-[#FF9EAF]');
    tabBtnOrders?.classList.add('border-transparent', 'text-zinc-500');

    viewOrders?.classList.add('hidden');
    viewDeposits?.classList.remove('hidden');
  });

  // Deposits sync logic
  let activeDeposits: any[] = [];
  const depositLedgerRows = document.getElementById('deposit-ledger-rows');
  const depositsCount = document.getElementById('stat-deposits-count');

  function syncDeposits() {
    const collRef = collection(dbInstance, 'deposits');
    
    onSnapshot(collRef, (snapshot) => {
      const deposits: any[] = [];
      snapshot.docs.forEach((doc) => {
        deposits.push({ id: doc.id, ...doc.data() });
      });

      activeDeposits = deposits.sort((a,b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
      renderDepositsTable(activeDeposits);
    });
  }

  function renderDepositsTable(deposits: any[]) {
    if (!depositLedgerRows) return;
    if (depositsCount) depositsCount.textContent = `Total Requests: ${deposits.length}`;

    if (deposits.length === 0) {
      depositLedgerRows.innerHTML = `
        <tr>
          <td colspan="6" class="py-12 text-center text-zinc-500">暂无充值申请记录 / No deposit requests.</td>
        </tr>
      `;
      return;
    }

    depositLedgerRows.innerHTML = deposits.map(dep => {
      let statusClass = 'text-amber-700 bg-amber-50 border border-amber-300';
      if (dep.status === 'approved') {
        statusClass = 'text-emerald-700 bg-emerald-50 border border-emerald-300';
      } else if (dep.status === 'rejected') {
        statusClass = 'text-rose-700 bg-rose-50 border border-rose-300';
      }

      const actionsHtml = dep.status === 'pending' ? `
        <button 
          type="button" 
          class="px-2.5 py-1 bg-emerald-100 hover:bg-emerald-200 border-2 border-[#3E2A1E] text-emerald-800 text-[10px] font-bold rounded-lg shadow-[2px_2px_0px_#3E2A1E] transition hover:translate-y-[-1px] cursor-pointer font-fredoka"
          onclick="window.approveDeposit('${dep.id}', '${dep.uid}', ${dep.amount})"
        >
          Approve
        </button>
        <button 
          type="button" 
          class="px-2.5 py-1 bg-rose-100 hover:bg-rose-200 border-2 border-[#3E2A1E] text-rose-800 text-[10px] font-bold rounded-lg shadow-[2px_2px_0px_#3E2A1E] transition hover:translate-y-[-1px] cursor-pointer font-fredoka"
          onclick="window.rejectDeposit('${dep.id}')"
        >
          Reject
        </button>
      ` : `<span class="text-zinc-500 font-bold uppercase tracking-wider text-[9px]">${dep.status}</span>`;

      return `
        <tr class="hover:bg-[#FFF5F7]/30 border-b border-[#3E2A1E]/5 transition-colors">
          <td class="py-3.5 pr-2 font-mono text-[10px] text-[#3E2A1E]/70 font-bold">${dep.id.substring(0, 10)}...</td>
          <td class="py-3.5 px-2 font-semibold">
            <span class="block truncate">${dep.email}</span>
            <span class="text-[10px] text-zinc-500 font-normal block">${dep.uid}</span>
          </td>
          <td class="py-3.5 px-2 font-bold font-mono text-emerald-600">+$${Number(dep.amount).toFixed(2)} USDT</td>
          <td class="py-3.5 px-2 font-mono text-[10px] max-w-[200px] truncate select-all" title="${dep.txId}">${dep.txId}</td>
          <td class="py-3.5 px-2">
            <span class="px-2 py-0.5 rounded-full border text-[9px] font-bold ${statusClass}">
              ${dep.status}
            </span>
          </td>
          <td class="py-3.5 pl-2 text-right space-x-1 whitespace-nowrap">
            ${actionsHtml}
          </td>
        </tr>
      `;
    }).join('');
  }

  // Bind approval/rejection operations to window context
  (window as any).approveDeposit = async function(depId: string, uid: string, amount: number) {
    if (!confirm(`确定通过该充值申请，为该会员账户充值 $${amount} USDT 吗？`)) return;

    try {
      // 1. Fetch current balance
      const userDocRef = doc(dbInstance, 'users', uid);
      const userDocSnap = await getDoc(userDocRef);
      let currentBalanceUsd = 0;
      let email = '';
      if (userDocSnap.exists()) {
        currentBalanceUsd = userDocSnap.data()?.balance_usd || 0;
        email = userDocSnap.data()?.email || '';
      }

      // 2. Increment user balance
      const newBalanceUsd = currentBalanceUsd + Number(amount);
      await setDoc(userDocRef, {
        balance_usd: newBalanceUsd,
        email: email
      });

      // 3. Mark deposit as approved
      const depDocRef = doc(dbInstance, 'deposits', depId);
      await updateDoc(depDocRef, { status: 'approved' });

      alert(`充值申请已通过！会员账户已成功入账 $${amount.toFixed(2)} USD (USDT)。`);
    } catch (err) {
      console.error("Failed to approve deposit:", err);
      alert("通过审核失败，请检查网络连接或数据库。");
    }
  };

  (window as any).rejectDeposit = async function(depId: string) {
    if (!confirm("确定要拒绝该充值申请吗？")) return;

    try {
      const depDocRef = doc(dbInstance, 'deposits', depId);
      await updateDoc(depDocRef, { status: 'rejected' });
      alert("充值申请已被拒绝。");
    } catch (err) {
      console.error("Failed to reject deposit:", err);
      alert("拒绝审核失败。");
    }
  };

  // --- Translation client-side integration ---
  function isoToTranslateJs(iso: string) {
    const map: Record<string, string> = {
      'en': 'english',
      'zh-CN': 'chinese_simplified',
      'zh-TW': 'chinese_traditional',
      'fr': 'french',
      'de': 'german',
      'es': 'spanish',
      'ja': 'japanese',
      'ru': 'russian',
      'ko': 'korean',
      'it': 'italian',
      'hi': 'hindi',
      'pt': 'portuguese'
    };
    return map[iso] || iso;
  }

  // Inject translate.js script dynamically in background (works inside China!)
  if (!document.getElementById('translate_js_script') && typeof window !== 'undefined') {
    const script = document.createElement('script');
    script.id = 'translate_js_script';
    script.src = 'https://cdn.staticfile.net/translate.js/3.18.66/translate.js';
    script.onload = () => {
      const translate = (window as any).translate;
      if (translate) {
        translate.language.setLocal('chinese_simplified');
        translate.service.use('client.edge');
        translate.selectLanguageTag.show = false;
        translate.listener.start();
        translate.execute();
        
        // Auto translate on load if a language was previously saved
        const currentLang = localStorage.getItem('active_language') || 'zh-CN';
        if (currentLang) {
          const translateJsLang = isoToTranslateJs(currentLang);
          setTimeout(() => {
            translate.changeLanguage(translateJsLang);
          }, 150);
        }
      }
    };
    document.body.appendChild(script);
  }
</script>
