---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Checkout | Puppy Shop">
  
  <div class="min-h-screen py-12 px-6 md:py-20 bg-[#FFFDF9] text-[#3E2A1E]">
    <div class="max-w-6xl mx-auto">
      
      <!-- Back Header -->
      <div class="mb-12">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 text-[#6D5A50] hover:text-[#FF6B8B] font-quicksand text-sm font-bold transition-colors group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to boutique
        </a>
      </div>

      <!-- Checkout Container -->
      <div id="checkout-main-grid" class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left Side: Order Verification Form -->
        <div class="lg:col-span-7">
          <h2 class="text-3xl font-bold font-fredoka text-[#3E2A1E] mb-8">收银台 / Checkout 🐾</h2>
          
          <form id="checkout-form" class="space-y-8">
            <!-- Web3Forms Configuration -->
            <input type="hidden" name="access_key" value="cae136d3-193a-4a59-bd40-6e4fa22afac9" />
            <input type="hidden" name="subject" value="New Order Placed on Puppy Shop" />
            <input type="hidden" name="from_name" value="Puppy Shop Checkout" />
            
            <!-- Hidden Order Details for Email Payload -->
            <input type="hidden" id="hidden-cart-data" name="cart_items" value="" />
            <input type="hidden" id="hidden-total-price" name="total_price" value="" />

            <!-- SECTION 1: Contact & Shipping (Dynamic) -->
            <div class="glass-card p-8 rounded-[2rem] border-3 border-[#3E2A1E] shadow-[4px_4px_0px_#3E2A1E] bg-white space-y-6">
              <h3 class="text-lg font-bold font-fredoka text-[#3E2A1E] border-b-2 border-[#E8E1D9] pb-3">01. 接收邮箱 / Delivery Email</h3>
              
              <div class="space-y-4">
                <div>
                  <label for="email" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand">电子邮箱地址 / Email Address</label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required 
                    placeholder="name@domain.com"
                    class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                  />
                  <p class="text-[10px] text-[#6D5A50] font-quicksand font-semibold mt-1">购买的账号卡密及发货更新将自动发送至此邮箱，请确保填写正确。</p>
                </div>

                <!-- Shipping Address wrapper: Permanently Hidden -->
                <div id="shipping-address-section" class="space-y-4 pt-2 hidden">
                  <div>
                    <label for="name" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand">Full Name</label>
                    <input 
                      type="text" 
                      id="name" 
                      name="name" 
                      placeholder="John Doe"
                      class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                    />
                  </div>
                  
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="address" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand">Street Address</label>
                      <input 
                        type="text" 
                        id="address" 
                        name="address" 
                        placeholder="123 Cyber Ave"
                        class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                      />
                    </div>
                    <div>
                      <label for="city" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand">City</label>
                      <input 
                        type="text" 
                        id="city" 
                        name="city" 
                        placeholder="New York"
                        class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                      />
                    </div>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                      <label for="state" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand">State/Region</label>
                      <input 
                        type="text" 
                        id="state" 
                        name="state" 
                        placeholder="NY"
                        class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                      />
                    </div>
                    <div>
                      <label for="country" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand">Country</label>
                      <input 
                        type="text" 
                        id="country" 
                        name="country" 
                        placeholder="United States"
                        class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                      />
                    </div>
                    <div>
                      <label for="zip" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand">ZIP/Postal Code</label>
                      <input 
                        type="text" 
                        id="zip" 
                        name="zip" 
                        placeholder="10001"
                        class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- SECTION 2: Payment Selection -->
            <div class="glass-card p-8 rounded-[2rem] border-3 border-[#3E2A1E] shadow-[4px_4px_0px_#3E2A1E] bg-white space-y-6">
              <h3 class="text-lg font-bold font-fredoka text-[#3E2A1E] border-b-2 border-[#E8E1D9] pb-3">02. 转账支付 / Transfer Payment</h3>

              <!-- Payment Method Selection Grid -->
              <div class="space-y-3">
                <label class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider font-quicksand">选择付款网络 / Select Payment Network</label>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-3" id="payment-networks-grid">
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3.5 rounded-2xl border-2 border-[#3E2A1E] bg-[#FFD6E0] text-[#3E2A1E] font-fredoka shadow-[4px_4px_0px_#3E2A1E] transition hover:translate-y-[-2px] active:scale-95 cursor-pointer" data-id="USDT_TRC20" data-address="TPUxwhaa4szt1QswXvFVKtbYEHUwupRGZA" data-name="USDT (TRC-20)" data-badge="USDT TRC-20 Address" data-note="请向上述 TRC-20 地址转入精确的订单金额（USDT）。转账完成后，系统将自动在区块链上进行验证。<br/>Please transfer the exact order amount in USDT to the TRC-20 address above.">
                    <span class="text-xs uppercase font-extrabold tracking-widest text-[#FF6B8B]">USDT</span>
                    <span class="text-[9px] font-bold text-[#6D5A50] mt-0.5 font-quicksand">Tron (TRC-20)</span>
                  </button>
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3.5 rounded-2xl border-2 border-[#3E2A1E] bg-[#FFFDF9] text-[#3E2A1E] font-fredoka shadow-[2px_2px_0px_#3E2A1E] transition hover:translate-y-[-2px] active:scale-95 cursor-pointer" data-id="USDT_BEP20" data-address="0xfd28A01945BDeF96e66Da9435184395204Aa287" data-name="USDT (BEP-20)" data-badge="USDT BEP-20 Address" data-note="请向上述 BEP-20 地址转入精确的订单金额（USDT）。转账完成后，系统将自动在区块链上进行验证。<br/>Please transfer the exact order amount in USDT to the BEP-20 address above.">
                    <span class="text-xs uppercase font-extrabold tracking-widest text-[#FF6B8B]">USDT</span>
                    <span class="text-[9px] font-bold text-[#6D5A50] mt-0.5 font-quicksand">BNB Chain (BEP-20)</span>
                  </button>
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3.5 rounded-2xl border-2 border-[#3E2A1E] bg-[#FFFDF9] text-[#3E2A1E] font-fredoka shadow-[2px_2px_0px_#3E2A1E] transition hover:translate-y-[-2px] active:scale-95 cursor-pointer" data-id="USDT_ERC20" data-address="0xfd28A01945BDeF96e66Da9435184395204Aa287" data-name="USDT (ERC-20)" data-badge="USDT ERC-20 Address" data-note="请向上述 ERC-20 地址转入精确的订单金额（USDT）。转账完成后，系统将自动在区块链上进行验证。<br/>Please transfer the exact order amount in USDT to the ERC-20 address above.">
                    <span class="text-xs uppercase font-extrabold tracking-widest text-[#FF6B8B]">USDT</span>
                    <span class="text-[9px] font-bold text-[#6D5A50] mt-0.5 font-quicksand">Ethereum (ERC-20)</span>
                  </button>
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3.5 rounded-2xl border-2 border-[#3E2A1E] bg-[#FFFDF9] text-[#3E2A1E] font-fredoka shadow-[2px_2px_0px_#3E2A1E] transition hover:translate-y-[-2px] active:scale-95 cursor-pointer" data-id="USDC_BEP20" data-address="0xfd28A01945BDeF96e66Da9435184395204Aa287" data-name="USDC (BEP-20)" data-badge="USDC BEP-20 Address" data-note="请向上述 BEP-20 地址转入精确的订单金额（USDC）。转账完成后，系统将自动在区块链上进行验证。<br/>Please transfer the exact order amount in USDC to the BEP-20 address above.">
                    <span class="text-xs uppercase font-extrabold tracking-widest text-[#FF6B8B]">USDC</span>
                    <span class="text-[9px] font-bold text-[#6D5A50] mt-0.5 font-quicksand">BNB Chain (BEP-20)</span>
                  </button>
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3.5 rounded-2xl border-2 border-[#3E2A1E] bg-[#FFFDF9] text-[#3E2A1E] font-fredoka shadow-[2px_2px_0px_#3E2A1E] transition hover:translate-y-[-2px] active:scale-95 cursor-pointer" data-id="USDC_ERC20" data-address="0xfd28A01945BDeF96e66Da9435184395204Aa287" data-name="USDC (ERC-20)" data-badge="USDC ERC-20 Address" data-note="请向上述 ERC-20 地址转入精确的订单金额（USDC）。转账完成后，系统将自动在区块链上进行验证。<br/>Please transfer the exact order amount in USDC to the ERC-20 address above.">
                    <span class="text-xs uppercase font-extrabold tracking-widest text-[#FF6B8B]">USDC</span>
                    <span class="text-[9px] font-bold text-[#6D5A50] mt-0.5 font-quicksand">Ethereum (ERC-20)</span>
                  </button>
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3.5 rounded-2xl border-2 border-[#3E2A1E] bg-[#FFFDF9] text-[#3E2A1E] font-fredoka shadow-[2px_2px_0px_#3E2A1E] transition hover:translate-y-[-2px] active:scale-95 cursor-pointer" data-id="TRX" data-address="TPUxwhaa4szt1QswXvFVKtbYEHUwupRGZA" data-name="TRX (Tron)" data-badge="TRX Tron Address" data-note="请向上述 Tron 地址转入精确的订单金额（TRX）。转账完成后，系统将自动在区块链上进行验证。<br/>Please transfer the exact order amount in TRX to the Tron address above.">
                    <span class="text-xs uppercase font-extrabold tracking-widest text-[#FF6B8B]">TRX</span>
                    <span class="text-[9px] font-bold text-[#6D5A50] mt-0.5 font-quicksand">Tron Network</span>
                  </button>
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3.5 rounded-2xl border-2 border-[#3E2A1E] bg-[#FFFDF9] text-[#3E2A1E] font-fredoka shadow-[2px_2px_0px_#3E2A1E] transition hover:translate-y-[-2px] active:scale-95 cursor-pointer col-span-2 md:col-span-1" data-id="STRIPE" data-address="STRIPE_DIRECT" data-name="Stripe (Credit Card)" data-badge="Stripe Payment Gateway" data-note="支持 Visa / Mastercard / 银联等信用卡及借记卡支付。点击提交订单后，您将被自动重定向至 Stripe 官方收银台完成付款。<br/>We support Visa, Mastercard, UnionPay and more. You will be redirected to Stripe to securely complete your payment.">
                    <span class="text-xs uppercase font-extrabold tracking-widest text-[#FF6B8B]">Stripe</span>
                    <span class="text-[9px] font-bold text-[#6D5A50] mt-0.5 font-quicksand">Credit Card / 信用卡</span>
                  </button>
                </div>
              </div>

              <!-- Payment Method Selection Storage -->
              <input type="hidden" id="hidden-payment-method" name="payment_method" value="USDT (TRC-20)" />

              <!-- CRYPTO DETAILS -->
              <div id="payment-crypto-container" class="space-y-6">
                <div class="bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-2xl p-6 space-y-6 shadow-[2px_2px_0px_#3E2A1E] flex flex-col items-center text-center">
                  
                  <span id="payment-badge-label" class="text-[10px] uppercase font-bold text-[#FF6B8B] bg-[#FFD6E0]/45 px-3.5 py-1 rounded-full border border-[#FF6B8B]/30 font-fredoka">
                    USDT TRC-20 Address
                  </span>

                  <!-- Dynamic QR Code -->
                  <div class="w-36 h-36 bg-white p-2 rounded-2xl flex items-center justify-center border-2 border-[#3E2A1E] shadow-[3px_3px_0px_#3E2A1E] hover:scale-105 transition-transform duration-300">
                    <img 
                      id="payment-qr-image"
                      src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=TPUxwhaa4szt1QswXvFVKtbYEHUwupRGZA" 
                      alt="Payment QR Code" 
                      class="w-32 h-32 rounded-lg"
                    />
                  </div>

                  <div class="w-full space-y-3">
                    <div class="text-xs font-bold text-[#6D5A50] font-quicksand">点击下方地址即可自动复制 / Click to copy address:</div>
                    <p id="crypto-address-text" class="text-xs md:text-sm font-mono text-[#3E2A1E] break-all bg-[#FDFBF7] py-3 px-4 rounded-xl border-2 border-[#3E2A1E] select-all cursor-pointer hover:bg-[#FFD6E0]/10 transition-colors font-bold shadow-[2px_2px_0px_rgba(62,42,30,0.15)]">
                      TPUxwhaa4szt1QswXvFVKtbYEHUwupRGZA
                    </p>
                    <button 
                      type="button"
                      id="copy-crypto-btn"
                      class="px-6 py-2.5 rounded-xl bg-[#FFD6E0] border-2 border-[#3E2A1E] text-xs font-bold text-[#3E2A1E] hover:bg-[#FFB3C6] active:scale-95 transition font-fredoka shadow-[2px_2px_0px_#3E2A1E] cursor-pointer"
                    >
                      Copy Wallet Address
                    </button>
                  </div>

                  <p id="payment-note-paragraph" class="text-xs text-[#6D5A50] font-quicksand font-bold leading-relaxed border-t border-[#E8E1D9] pt-4 w-full">
                    请向上述 TRC-20 地址转入精确的订单金额（USDT）。转账完成后，系统将自动在区块链上进行验证。<br/>
                    Please transfer the exact order amount in USDT to the TRC-20 address above.
                  </p>
                </div>

                <!-- Proof input -->
                <div id="txid-input-container">
                  <label for="txid" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand">
                    转账交易哈希 / Transaction Hash (TxID)
                  </label>
                  <input 
                    type="text" 
                    id="txid" 
                    name="txid" 
                    required 
                    placeholder="请输入区块链交易哈希值 (TxID) / Enter TxID"
                    class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                  />
                  <p class="text-[10px] text-[#6D5A50] font-quicksand font-semibold mt-1">
                    请填写您转账的交易哈希，以便我们自动匹配和确认您的订单。<br/>
                    Provide the TxID hash so we can automatically match this ledger action with your order.
                  </p>
                </div>
              </div>
            </div>

            <!-- Validation Error Alert (Hidden by default) -->
            <div id="error-message" class="hidden p-4 rounded-xl border border-red-200 bg-red-100 text-red-700 text-sm font-semibold font-quicksand">
              Something went wrong. Please verify the required inputs.
            </div>

            <!-- Submit Button -->
            <button 
              type="submit"
              id="submit-order-btn"
              class="w-full py-4 rounded-xl bg-[#FFD6E0] border-3 border-[#3E2A1E] text-[#3E2A1E] hover:bg-[#FFB3C6] font-bold uppercase tracking-wider text-sm font-fredoka transition-all duration-300 shadow-[4px_4px_0px_#3E2A1E] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_#3E2A1E] active:scale-[0.99] cursor-pointer"
            >
              确认并提交订单 / Verify & Submit Order 🐾
            </button>
          </form>
        </div>
 
        <!-- Right Side: Order Summary -->
        <div class="lg:col-span-5">
          <div class="glass-card p-8 rounded-[2rem] border-3 border-[#3E2A1E] shadow-[4px_4px_0px_#3E2A1E] bg-white space-y-6 sticky top-28">
            <h3 class="text-lg font-bold font-fredoka text-[#3E2A1E] border-b-2 border-[#E8E1D9] pb-3">订单汇总 / Order Summary 🧁</h3>
            
            <!-- Items list -->
            <div id="checkout-summary-list" class="space-y-4 max-h-[300px] overflow-y-auto pr-2">
              <!-- JS renders list items here -->
            </div>
 
            <!-- Price Breakdown -->
            <div class="pt-6 border-t-2 border-[#E8E1D9] space-y-2 text-sm text-[#6D5A50] font-quicksand font-bold">
              <div class="flex justify-between">
                <span>商品小计 / Subtotal</span>
                <span id="checkout-subtotal" class="text-[#3E2A1E] font-fredoka">$0.00</span>
              </div>
              <div class="flex justify-between">
                <span>配送方式 / Delivery</span>
                <span class="text-[#FF6B8B] font-bold uppercase tracking-widest text-xs">自动发货 / Auto Delivery 🧁</span>
              </div>
              <div class="flex justify-between text-[#FF6B8B] font-bold font-fredoka text-xl pt-4 border-t-2 border-[#3E2A1E]">
                <span>实付总额 / Grand Total</span>
                <span id="checkout-grand-total">$0.00</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- SUCCESS SCREEN (Hidden initially) -->
      <div id="checkout-success-view" class="hidden max-w-xl mx-auto text-center py-20 px-6 space-y-8 glass-card border-3 border-[#3E2A1E] shadow-[8px_8px_0px_#3E2A1E] rounded-[2rem] bg-white">
        <div class="w-20 h-20 rounded-full bg-green-100 border-2 border-[#3E2A1E] flex items-center justify-center mx-auto text-green-600 shadow-[2px_2px_0px_#3E2A1E]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="space-y-4">
          <h2 class="text-3xl font-bold font-fredoka text-[#3E2A1E] tracking-tight">Order Submitted Successfully! 🎉</h2>
          <p class="text-[#6D5A50] text-xs leading-relaxed max-w-md mx-auto font-quicksand font-bold">
            We are preparing your keys manually (usually takes 5-15 mins). Once shipped, card keys will display instantly in your <strong>Order Vault</strong> history page.<br/><br/>
            系统已收到您的订单，正为您人工配货（通常需 5~15 分钟）。发货后卡密将自动呈现于您的“订单保险库”（Order Vault）中，请稍后刷新查看。
          </p>
        </div>
        <div class="border-t-2 border-[#E8E1D9] pt-6 text-[#6D5A50] text-xs font-quicksand font-bold">
          Order reference: <span id="checkout-reference-id" class="font-mono text-[#3E2A1E] font-bold">CA-837492</span>
        </div>
        <a 
          href="/" 
          class="inline-block px-8 py-3 rounded-xl bg-[#FFD6E0] border-2 border-[#3E2A1E] text-[#3E2A1E] hover:bg-[#FFB3C6] font-bold uppercase tracking-wider text-xs font-fredoka transition-all duration-300 shadow-[2px_2px_0px_#3E2A1E]"
        >
          Return to Boutique 🐶
        </a>
      </div>

      <!-- STRIPE VERIFICATION SCREEN (Hidden initially) -->
      <div id="checkout-verifying-view" class="hidden max-w-xl mx-auto text-center py-20 px-6 space-y-8 glass-card border-3 border-[#3E2A1E] shadow-[8px_8px_0px_#3E2A1E] rounded-[2rem] bg-white">
        <div class="flex items-center justify-center mx-auto mb-4">
          <div class="animate-spin inline-block w-12 h-12 border-4 border-[#FF6B8B] border-t-transparent rounded-full"></div>
        </div>
        <div class="space-y-4">
          <h2 class="text-2xl font-bold font-fredoka text-[#3E2A1E]">Verifying Stripe Payment...</h2>
          <p class="text-[#6D5A50] text-xs leading-relaxed max-w-md mx-auto font-quicksand font-bold">
            Please wait while we verify your credit card payment with Stripe. Do not close or refresh this page.<br/><br/>
            正在确认您的 Stripe 支付结果，请勿关闭或刷新此页面。
          </p>
        </div>
      </div>

      <!-- STRIPE ERROR SCREEN (Hidden initially) -->
      <div id="checkout-error-view" class="hidden max-w-xl mx-auto text-center py-20 px-6 space-y-8 glass-card border-3 border-[#3E2A1E] shadow-[8px_8px_0px_#3E2A1E] rounded-[2rem] bg-white">
        <div class="w-20 h-20 rounded-full bg-red-100 border-2 border-[#3E2A1E] flex items-center justify-center mx-auto text-red-600 shadow-[2px_2px_0px_#3E2A1E]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div class="space-y-4">
          <h2 class="text-2xl font-bold font-fredoka text-red-600">Verification Failed!</h2>
          <p id="stripe-error-message" class="text-[#6D5A50] text-xs leading-relaxed max-w-md mx-auto font-quicksand font-bold">
            We could not verify your payment. If you have been charged, please contact customer support with your Order ID.<br/><br/>
            无法确认您的付款状态。如果您已扣款，请携带订单号联系右下角客服。
          </p>
        </div>
        <div class="border-t-2 border-[#E8E1D9] pt-6 text-[#6D5A50] text-xs font-quicksand font-bold">
          Order reference: <span id="checkout-error-reference-id" class="font-mono text-[#3E2A1E] font-bold">Unknown</span>
        </div>
        <a 
          href="/" 
          class="inline-block px-8 py-3 rounded-xl bg-[#FFD6E0] border-2 border-[#3E2A1E] text-[#3E2A1E] hover:bg-[#FFB3C6] font-bold uppercase tracking-wider text-xs font-fredoka transition-all duration-300 shadow-[2px_2px_0px_#3E2A1E]"
        >
          Return to Boutique 🐶
        </a>
      </div>

    </div>
  </div>

</BaseLayout>

<script>
  import { 
    authInstance, 
    dbInstance, 
    collection, 
    addDoc, 
    onAuthStateChanged 
  } from '../lib/firebase.js';

  // Checkout flow Logic
  let cart = [];
  let currentUserUid = 'guest';
  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-message');
  const submitBtn = document.getElementById('submit-order-btn') as HTMLButtonElement;

  // Payment Selection Selector Elements
  const hiddenPaymentMethod = document.getElementById('hidden-payment-method') as HTMLInputElement;
  const paymentButtons = document.querySelectorAll('.payment-method-btn');
  const badgeLabel = document.getElementById('payment-badge-label');
  const qrImage = document.getElementById('payment-qr-image') as HTMLImageElement;
  const noteParagraph = document.getElementById('payment-note-paragraph');
  const txidInputContainer = document.getElementById('txid-input-container');
  const paymentCryptoContainer = document.getElementById('payment-crypto-container');

  // Form Fields
  const inputTxID = document.getElementById('txid') as HTMLInputElement;

  let currentUserDisplayName = '';

  // Watch Authentication State to auto-fill
  onAuthStateChanged(authInstance, (user) => {
    if (user) {
      currentUserUid = user.uid;
      currentUserDisplayName = user.displayName || '';
      const emailField = document.getElementById('email') as HTMLInputElement;
      if (emailField && !emailField.value) {
        emailField.value = user.email || '';
      }
    }
  });

  // Load and check cart
  function checkCart() {
    const urlParams = new URLSearchParams(window.location.search);
    const statusParam = urlParams.get('status');
    if (statusParam) {
      // In Stripe redirect phase, skip empty cart checks and verify payment status
      handleStripeRedirect(urlParams);
      return;
    }

    const savedCart = localStorage.getItem('boutique_cart');
    if (savedCart) {
      try {
        cart = JSON.parse(savedCart);
      } catch (e) {
        cart = [];
      }
    }

    if (cart.length === 0) {
      // Redirect empty cart
      window.location.href = '/';
      return;
    }

    renderCheckout();
  }

  // Handle Stripe Redirection Outcomes
  async function handleStripeRedirect(urlParams) {
    const status = urlParams.get('status');
    const orderId = urlParams.get('order_id');
    const sessionId = urlParams.get('session_id');

    const mainGrid = document.getElementById('checkout-main-grid');
    const verifyingView = document.getElementById('checkout-verifying-view');
    const successView = document.getElementById('checkout-success-view');
    const errorView = document.getElementById('checkout-error-view');
    const stripeErrorMsg = document.getElementById('stripe-error-message');
    const errorRefId = document.getElementById('checkout-error-reference-id');
    const successRefId = document.getElementById('checkout-reference-id');

    if (status === 'success' && orderId && sessionId) {
      if (mainGrid) mainGrid.classList.add('hidden');
      if (verifyingView) verifyingView.classList.remove('hidden');

      try {
        const res = await fetch('/api/verify-stripe-payment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderId, sessionId })
        });
        const data = await res.json();

        if (data.success) {
          // Empty client cart
          localStorage.removeItem('boutique_cart');

          // Local storage mock DB update fallback (if Firestore not active)
          const savedOrders = localStorage.getItem('mock_orders');
          if (savedOrders) {
            const orders = JSON.parse(savedOrders);
            const idx = orders.findIndex(o => o.id === orderId);
            if (idx !== -1) {
              orders[idx].status = 'paid';
              orders[idx].stripeSessionId = sessionId;
              localStorage.setItem('mock_orders', JSON.stringify(orders));
            }
          }

          if (successRefId) successRefId.textContent = orderId;
          if (verifyingView) verifyingView.classList.add('hidden');
          if (successView) successView.classList.remove('hidden');
        } else {
          throw new Error(data.error || 'Payment verification failed.');
        }
      } catch (err) {
        console.error("Stripe verification failed:", err);
        if (stripeErrorMsg) {
          stripeErrorMsg.innerHTML = `无法确认您的付款状态：${err.message || '未知错误'}<br/><br/>We could not verify your payment: ${err.message || 'Unknown error'}`;
        }
        if (errorRefId) errorRefId.textContent = orderId || 'Unknown';
        if (verifyingView) verifyingView.classList.add('hidden');
        if (errorView) errorView.classList.remove('hidden');
      }
    } else if (status === 'cancel') {
      if (mainGrid) mainGrid.classList.add('hidden');
      if (stripeErrorMsg) {
        stripeErrorMsg.innerHTML = `您已取消支付。如果您需要重新支付，请返回商店首页重新下单。<br/><br/>You have cancelled the Stripe checkout process. If you want to pay, return to the store and try again.`;
      }
      if (errorRefId) errorRefId.textContent = orderId || 'Unknown';
      if (errorView) errorView.classList.remove('hidden');
    }
  }

  // Render Page Content
  function renderCheckout() {
    const listContainer = document.getElementById('checkout-summary-list');
    const subtotalText = document.getElementById('checkout-subtotal');
    const grandtotalText = document.getElementById('checkout-grand-total');
    const shippingSection = document.getElementById('shipping-address-section');

    const addressInputs = shippingSection?.querySelectorAll('input');

    if (!listContainer || !subtotalText || !grandtotalText) return;

    // Force hide shipping section & remove required attributes under all conditions
    if (shippingSection) shippingSection.style.display = 'none';
    addressInputs?.forEach(input => {
      input.removeAttribute('required');
    });

    // Render list
    listContainer.innerHTML = cart.map(item => `
      <div class="flex items-center justify-between text-sm py-2 border-b border-[#E8E1D9]/50">
        <div class="min-w-0 pr-4">
          <span class="text-[#3E2A1E] font-bold block truncate font-fredoka">${item.name}</span>
          <span class="text-[#6D5A50] text-xs font-quicksand">${item.type === 'physical' ? `Size: ${item.size} × ${item.quantity}` : `Digital × ${item.quantity}`}</span>
        </div>
        <span class="text-[#FF6B8B] font-fredoka font-bold shrink-0">$${(item.price * item.quantity).toFixed(2)}</span>
      </div>
    `).join('');

    const totalCost = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    subtotalText.textContent = `$${totalCost.toFixed(2)}`;
    grandtotalText.textContent = `$${totalCost.toFixed(2)}`;

    // Set hidden inputs for form payload
    const cartSummaryString = cart.map(item => `${item.quantity}x ${item.name}${item.size ? ` (${item.size})` : ''}`).join(', ');
    const hiddenCartData = document.getElementById('hidden-cart-data') as HTMLInputElement;
    const hiddenTotalPrice = document.getElementById('hidden-total-price') as HTMLInputElement;

    if (hiddenCartData) hiddenCartData.value = cartSummaryString;
    if (hiddenTotalPrice) hiddenTotalPrice.value = `$${totalCost.toFixed(2)}`;
  }

  // Click-to-copy utility
  function setupCopyToClipboard(triggerId, textId) {
    const trigger = document.getElementById(triggerId);
    const element = document.getElementById(textId);
    if (!trigger || !element) return;

    trigger.addEventListener('click', () => {
      const textToCopy = element.textContent?.trim() || '';
      navigator.clipboard.writeText(textToCopy).then(() => {
        const originalText = trigger.textContent;
        trigger.textContent = 'Copied!';
        trigger.classList.add('bg-emerald-500/20', 'text-[#137333]');
        setTimeout(() => {
          trigger.textContent = originalText;
          trigger.classList.remove('bg-emerald-500/20', 'text-[#137333]');
        }, 1500);
      });
    });
  }

  setupCopyToClipboard('copy-crypto-btn', 'crypto-address-text');

  // Direct Click-to-copy for the crypto address text block
  const cryptoAddressText = document.getElementById('crypto-address-text');
  cryptoAddressText?.addEventListener('click', () => {
    const text = cryptoAddressText.textContent?.trim() || '';
    navigator.clipboard.writeText(text).then(() => {
      const originalText = cryptoAddressText.innerText;
      cryptoAddressText.innerText = "COPIED / 地址已复制 ✓";
      cryptoAddressText.style.color = "#FF6B8B";
      setTimeout(() => {
        cryptoAddressText.innerText = text;
        cryptoAddressText.style.color = "";
      }, 1000);
    });
  });

  // Handle switching payment networks
  paymentButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Remove active classes from all buttons
      paymentButtons.forEach(b => {
        b.classList.remove('bg-[#FFD6E0]', 'shadow-[4px_4px_0px_#3E2A1E]');
        b.classList.add('bg-[#FFFDF9]', 'shadow-[2px_2px_0px_#3E2A1E]');
      });

      // Add active classes to selected button
      btn.classList.remove('bg-[#FFFDF9]', 'shadow-[2px_2px_0px_#3E2A1E]');
      btn.classList.add('bg-[#FFD6E0]', 'shadow-[4px_4px_0px_#3E2A1E]');

      // Fetch network attributes
      const name = btn.getAttribute('data-name') || '';
      const address = btn.getAttribute('data-address') || '';
      const badge = btn.getAttribute('data-badge') || '';
      const note = btn.getAttribute('data-note') || '';
      const id = btn.getAttribute('data-id') || '';

      // Update inputs & display text
      if (hiddenPaymentMethod) hiddenPaymentMethod.value = name;
      if (badgeLabel) badgeLabel.textContent = badge;
      if (cryptoAddressText) cryptoAddressText.textContent = address;
      if (qrImage) {
        qrImage.src = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(address)}`;
      }
      if (noteParagraph) {
        noteParagraph.innerHTML = note;
      }

      // Hide or show layout elements depending on Stripe selection
      if (id === 'STRIPE') {
        const addressBlock = cryptoAddressText?.parentElement;
        if (addressBlock) addressBlock.style.display = 'none';
        const qrWrapper = qrImage?.parentElement;
        if (qrWrapper) qrWrapper.style.display = 'none';
        
        if (txidInputContainer) {
          txidInputContainer.style.display = 'none';
          inputTxID.removeAttribute('required');
        }
      } else {
        const addressBlock = cryptoAddressText?.parentElement;
        if (addressBlock) addressBlock.style.display = 'block';
        const qrWrapper = qrImage?.parentElement;
        if (qrWrapper) qrWrapper.style.display = 'flex'; // it is a flex wrapper in html
        
        if (txidInputContainer) {
          txidInputContainer.style.display = 'block';
          inputTxID.setAttribute('required', 'required');
        }
      }
    });
  });

  // Submit flow
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg?.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting Verification...';

    const formData = new FormData(form);

    try {
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const paymentMethod = hiddenPaymentMethod.value;
      
      // All methods are cryptocurrency networks, so we always read the TxID hash
      const txIdVal = inputTxID.value;
      
      const totalUsd = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      const totalCny = Math.round(totalUsd * 6.8);

      const orderData = {
        uid: currentUserUid,
        username: currentUserDisplayName || email.split('@')[0],
        email,
        items: cart.map(item => ({
          id: item.id,
          name: item.name,
          price: item.price,
          type: item.type,
          size: item.size || null,
          quantity: item.quantity,
          image: item.image
        })),
        paymentMethod: paymentMethod,
        txId: txIdVal,
        totalUsd,
        totalCny,
        status: 'pending',
        createdAt: new Date().toISOString()
      };

      // 1. Create order document in database (Firebase or Mock fallback)
      const orderRef = await addDoc(collection(dbInstance, 'orders'), orderData);
      const orderId = orderRef.id;

      // 1.2 If payment method is Stripe, redirect to Stripe Checkout Session
      if (paymentMethod === "Stripe (Credit Card)") {
        submitBtn.textContent = 'Redirecting to Stripe...';
        const stripeRes = await fetch('/api/create-checkout-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            orderId: orderId,
            email: email,
            items: orderData.items
          })
        });
        const stripeData = await stripeRes.json();
        if (stripeData.url) {
          window.location.href = stripeData.url;
          return;
        } else {
          throw new Error(stripeData.error || 'Failed to initialize Stripe checkout session.');
        }
      }

      // 1.5 Push order alert to Telegram Bot 1 (Puppy Shop Order Bot)
      try {
        await fetch('/api/order-notify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            orderId: orderId,
            totalUsd: totalUsd,
            totalCny: totalCny,
            paymentMethod: orderData.paymentMethod,
            createdAt: orderData.createdAt,
            username: orderData.username
          })
        });
      } catch (err) {
        console.error("Failed to trigger Telegram order alert:", err);
      }

      // 2. Append database Order ID to the Web3Forms payload for email indexing
      formData.append('database_order_id', orderId);

      // 3. Submit notification via Web3Forms API
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });

      const result = await response.json();

      if (result.success) {
        // Clear cart
        localStorage.removeItem('boutique_cart');
        
        // Show success screen
        const refId = document.getElementById('checkout-reference-id');
        if (refId) refId.textContent = orderId;
        
        document.getElementById('checkout-main-grid')?.classList.add('hidden');
        document.getElementById('checkout-success-view')?.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        throw new Error(result.message || 'Form submission failed');
      }
    } catch (err) {
      console.error(err);
      if (errorMsg) {
        errorMsg.classList.remove('hidden');
        errorMsg.textContent = 'Submission error. Please verify database connection or checkout keys.';
      }
      submitBtn.disabled = false;
      submitBtn.textContent = 'Verify & Complete Order';
    }
  });

  // Run on load
  checkCart();
</script>
