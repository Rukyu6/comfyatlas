---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Soul Society 收银台 — 灵压凭证核验与结算">
  
  <div class="min-h-screen py-12 px-6 md:py-20 bg-[#06080F] text-white font-outfit">
    <div class="max-w-6xl mx-auto">
      
      <!-- Back Header -->
      <div class="mb-10">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 text-slate-400 hover:text-[#38BDF8] text-xs font-bold transition-colors group font-mono"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          返回数字商城
        </a>
      </div>

      <!-- Checkout Container -->
      <div id="checkout-main-grid" class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start animate-fadeIn">
        
        <!-- Left Side: Order Form -->
        <div class="lg:col-span-7">
          <h2 class="text-2xl md:text-3xl font-black text-white mb-8 tracking-tight">
            <span>收银台</span>
            </h2>
          
          <form id="checkout-form" class="space-y-8">
            <input type="hidden" name="access_key" value="cae136d3-193a-4a59-bd40-6e4fa22afac9" />
            <input type="hidden" name="subject" value="New Order Placed on Soul Society" />
            <input type="hidden" name="from_name" value="Soul Society Checkout" />
            <input type="hidden" id="hidden-cart-data" name="cart_items" value="" />
            <input type="hidden" id="hidden-total-price" name="total_price" value="" />

            <!-- SECTION 1: Contact Email -->
            <div class="glass-card p-6 sm:p-8 rounded-3xl border border-[#38BDF8]/25 bg-[#0B0F1A]/90 backdrop-blur-xl space-y-4">
              <h3 class="text-base font-bold text-white border-b border-white/10 pb-3 flex items-center gap-2">
                <span class="text-[#38BDF8] font-mono">01.</span>
                <span>接收卡密邮箱 / Delivery Email</span>
              </h3>
              
              <div>
                <label for="email" class="block text-xs uppercase text-slate-300 font-bold tracking-wider mb-2 font-mono">
                  接收电子邮箱地址 <span class="text-[#38BDF8]">*</span>
                </label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  placeholder="name@domain.com"
                  class="w-full bg-[#06080F] border border-[#38BDF8]/30 rounded-2xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-[#38BDF8] focus:ring-2 focus:ring-[#38BDF8]/30 transition font-mono text-sm"
                />
                <p class="text-[11px] text-slate-400 mt-2">
                  您购买的账号卡密及履约更新将自动同步至此邮箱，请务必确保填写正确。
                </p>
              </div>
            </div>

            <!-- SECTION 2: Payment Selection -->
            <div class="glass-card p-6 sm:p-8 rounded-3xl border border-[#38BDF8]/25 bg-[#0B0F1A]/90 backdrop-blur-xl space-y-6">
              <h3 class="text-base font-bold text-white border-b border-white/10 pb-3 flex items-center gap-2">
                <span class="text-[#38BDF8] font-mono">02.</span>
                <span>转账支付通道 / Payment Network</span>
              </h3>

              <!-- Payment Networks Grid -->
              <div class="space-y-4">
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" id="payment-networks-grid">
                  <!-- TRON (TRC20) -->
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3 rounded-2xl border border-[#0284C7] bg-[#38BDF8] text-[#06080F] shadow-[0_0_20px_rgba(56,189,248,0.3)] transition active:scale-95 cursor-pointer relative" data-id="USDT_TRC20" data-address="TXLUKiCFzMsSxyAy6uR5WduCsnYXqXMJ1C" data-name="USDT (TRC-20)" data-badge="USDT TRON (TRC-20)" data-note="请向上述 TRON (TRC-20) 地址转入精确订单金额。转账成功后请复制 TxID 交易哈希进行凭据提交。">
                    <span class="text-[9px] font-black uppercase tracking-widest bg-black/20 px-1.5 py-0.5 rounded-md mb-1 font-mono">POPULAR</span>
                    <span class="text-xs font-black uppercase tracking-wider">USDT</span>
                    <span class="text-[10px] font-bold font-mono">TRC-20 (Tron)</span>
                  </button>

                  <!-- BSC (BEP20) -->
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3 rounded-2xl border border-[#38BDF8]/20 bg-[#0B0F1A] text-white hover:border-[#38BDF8]/50 transition active:scale-95 cursor-pointer" data-id="USDT_BEP20" data-address="0x1d6aa81a17701932b09bd45e018af2be5efa53de" data-name="USDT (BEP-20)" data-badge="USDT BSC (BEP-20)" data-note="⚠️ 请勿使用 opBNB 链存入 USDT，否则资产不可找回。转账完成后请填写 TxID 交易哈希。">
                    <span class="text-[9px] font-black uppercase tracking-widest text-[#38BDF8] bg-[#0284C7]/20 px-1.5 py-0.5 rounded-md mb-1 font-mono">LOW GAS</span>
                    <span class="text-xs font-black uppercase tracking-wider">USDT</span>
                    <span class="text-[10px] font-bold font-mono text-slate-400">BEP-20 (BSC)</span>
                  </button>

                  <!-- Solana (SOL) -->
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3 rounded-2xl border border-[#38BDF8]/20 bg-[#0B0F1A] text-white hover:border-[#38BDF8]/50 transition active:scale-95 cursor-pointer" data-id="USDT_SOL" data-address="925egwkSqvQkrGv9aCjJx5TAzcscCu9sAQMrt3VrwKXF" data-name="USDT (Solana)" data-badge="USDT Solana (SOL)" data-note="请向上述 Solana (SOL) 链地址转入精确订单金额。转账完成后填写交易哈希。">
                    <span class="text-[9px] font-black uppercase tracking-widest text-emerald-400 bg-emerald-950/40 px-1.5 py-0.5 rounded-md mb-1 font-mono">FAST</span>
                    <span class="text-xs font-black uppercase tracking-wider">USDT</span>
                    <span class="text-[10px] font-bold font-mono text-slate-400">Solana (SOL)</span>
                  </button>

                  <!-- Ethereum (ERC20) -->
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3 rounded-2xl border border-[#38BDF8]/20 bg-[#0B0F1A] text-white hover:border-[#38BDF8]/50 transition active:scale-95 cursor-pointer" data-id="USDT_ERC20" data-address="0x1d6aa81a17701932b09bd45e018af2be5efa53de" data-name="USDT (ERC-20)" data-badge="USDT Ethereum (ERC-20)" data-note="请向上述 Ethereum (ERC-20) 地址转入精确订单金额。适合大额结算。">
                    <span class="text-[9px] font-black uppercase tracking-widest text-indigo-300 bg-indigo-950/40 px-1.5 py-0.5 rounded-md mb-1 font-mono">ETH</span>
                    <span class="text-xs font-black uppercase tracking-wider">USDT</span>
                    <span class="text-[10px] font-bold font-mono text-slate-400">ERC-20 (Main)</span>
                  </button>
                </div>
              </div>

              <input type="hidden" id="hidden-payment-method" name="payment_method" value="USDT (TRC-20)" />

              <!-- CRYPTO DETAILS BOX -->
              <div id="payment-crypto-container" class="space-y-6">
                <div class="bg-[#0B0F1A] border border-[#38BDF8]/30 rounded-3xl p-6 sm:p-8 space-y-6 shadow-2xl flex flex-col items-center text-center backdrop-blur-xl">
                  
                  <div class="flex items-center justify-between w-full">
                    <span id="payment-badge-label" class="text-xs font-black font-mono text-[#38BDF8] bg-[#0284C7]/20 px-3.5 py-1 rounded-full border border-[#38BDF8]/40">
                      USDT TRON (TRC-20)
                    </span>
                    <span class="text-[10px] font-mono text-slate-400 flex items-center gap-1.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                      节点在线
                    </span>
                  </div>

                  <!-- Dynamic QR Code -->
                  <div class="w-44 h-44 bg-white p-3 rounded-2xl flex items-center justify-center border-2 border-[#38BDF8]/50 shadow-[0_0_30px_rgba(56,189,248,0.25)]">
                    <img 
                      id="payment-qr-image"
                      src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=TXLUKiCFzMsSxyAy6uR5WduCsnYXqXMJ1C" 
                      alt="Payment QR Code" 
                      class="w-38 h-38 rounded-lg"
                    />
                  </div>

                  <!-- Address & Copy -->
                  <div class="w-full space-y-2">
                    <div class="flex items-center justify-between text-xs text-slate-400 font-mono">
                      <span>官方充值钱包地址 (点击可复制)</span>
                      <span id="copy-status-hint" class="text-[#38BDF8] font-bold"></span>
                    </div>

                    <div 
                      id="crypto-address-text" 
                      class="text-xs sm:text-sm font-mono text-white break-all bg-[#06080F] py-3.5 px-4 rounded-2xl border border-[#38BDF8]/30 select-all cursor-pointer hover:border-[#38BDF8] transition-all font-bold shadow-inner flex items-center justify-between gap-3"
                    >
                      <span id="address-display-val">TXLUKiCFzMsSxyAy6uR5WduCsnYXqXMJ1C</span>
                      <button type="button" id="copy-crypto-btn" class="p-2 rounded-xl bg-white/5 hover:bg-[#0284C7]/30 text-[#38BDF8] shrink-0 transition">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                      </button>
                    </div>
                  </div>

                  <!-- Note -->
                  <div id="payment-note-paragraph" class="text-xs text-slate-400 leading-relaxed border-t border-[#38BDF8]/20 pt-4 w-full text-left bg-white/2 p-3 rounded-xl font-sans">
                    请向上述 TRON (TRC-20) 地址转入精确订单金额。转账成功后请复制 TxID 交易哈希进行凭据提交。
                  </div>
                </div>

                <!-- 其他链联系客服 -->
                <div class="p-4 rounded-2xl bg-gradient-to-r from-[#0B0F1A] to-[#06080F] border border-[#38BDF8]/30 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-lg">
                  <div class="flex items-center gap-3 text-left">
                    <div class="w-9 h-9 rounded-xl bg-[#0284C7]/20 border border-[#38BDF8]/40 text-[#38BDF8] flex items-center justify-center shrink-0">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    </div>
                    <div>
                      <h5 class="text-xs font-bold text-white">其他网络与币种结算？</h5>
                      <p class="text-[11px] text-slate-400">如需使用 Polygon、Arbitrum、USDC 或其他链付款，请联系专席客服处理。</p>
                    </div>
                  </div>
                  <a 
                    href="https://t.me/SoulSocietyServiceBot" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="px-4 py-2 rounded-xl bg-[#0284C7]/30 hover:bg-[#38BDF8] hover:text-[#06080F] text-[#38BDF8] border border-[#38BDF8]/50 text-xs font-bold transition flex items-center gap-2 shrink-0 cursor-pointer"
                  >
                    <span>联系专席客服</span>
                    <span>→</span>
                  </a>
                </div>

                <!-- TxID Input -->
                <div id="txid-input-container" class="space-y-2 text-left">
                  <label for="txid" class="block text-xs uppercase text-slate-300 font-bold tracking-wider font-mono">
                    转账交易哈希 (TxID) <span class="text-[#38BDF8]">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="txid" 
                    name="txid" 
                    required 
                    placeholder="请输入转账成功后的 TxID 交易哈希"
                    class="w-full bg-[#06080F] border border-[#38BDF8]/30 rounded-2xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-[#38BDF8] focus:ring-2 focus:ring-[#38BDF8]/30 transition font-mono text-xs shadow-inner"
                  />
                  <p class="text-[10px] text-slate-400 leading-normal font-sans">
                    填写转账成功后生成的唯一交易哈希，系统将进行链上真实性对账并在确认到账后自动发放卡密。
                  </p>
                </div>
              </div>
            </div>

            <!-- Error message alert -->
            <div id="error-message" class="hidden p-4 rounded-xl border border-rose-900 bg-rose-950/40 text-rose-400 text-xs font-bold font-mono">
            </div>

            <!-- Submit Button -->
            <button 
              type="submit"
              id="submit-order-btn"
              class="w-full py-4 rounded-2xl bg-gradient-to-r from-[#0284C7] to-[#38BDF8] text-white hover:brightness-115 font-black uppercase tracking-wider text-sm transition-all duration-200 shadow-[0_0_25px_rgba(56,189,248,0.4)] active:scale-98 cursor-pointer"
            >
              链上核验并确认订单
            </button>
          </form>
        </div>
 
        <!-- Right Side: Order Summary -->
        <div class="lg:col-span-5">
          <div class="glass-card p-6 sm:p-8 rounded-3xl border border-[#38BDF8]/25 bg-[#0B0F1A]/90 backdrop-blur-xl space-y-6 sticky top-28">
            <h3 class="text-base font-bold text-white border-b border-white/10 pb-3 flex items-center justify-between">
              <span>已选商品订单汇总</span>
              <span class="text-[10px] font-mono text-[#38BDF8] bg-[#0284C7]/20 border border-[#38BDF8]/30 px-2.5 py-0.5 rounded-full">LIVE</span>
            </h3>
            
            <div id="checkout-summary-list" class="space-y-3 max-h-[300px] overflow-y-auto pr-1">
            </div>
 
            <div class="pt-5 border-t border-white/10 space-y-2 text-xs text-slate-400 font-mono">
              <div class="flex justify-between">
                <span>商品小计</span>
                <span id="checkout-subtotal" class="text-white font-bold">$0.00</span>
              </div>
              <div class="flex justify-between">
                <span>配送方式</span>
                <span class="text-[#38BDF8] font-bold">自动秒发 / 零运费</span>
              </div>
              <div class="flex justify-between text-[#38BDF8] font-bold text-xl pt-4 border-t border-white/10">
                <span>实付总额</span>
                <span id="checkout-grand-total">$0.00</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- SUCCESS SCREEN: 链上核实成功与卡密一键复制面板 -->
      <div id="checkout-success-view" class="hidden max-w-xl mx-auto text-center py-12 px-6 sm:px-8 space-y-7 glass-card border border-[#38BDF8]/40 rounded-[2.5rem] bg-[#0B0F1A]/95 backdrop-blur-2xl text-white shadow-[0_25px_60px_rgba(0,0,0,0.9)] animate-fadeIn">
        
        <div class="relative w-20 h-20 mx-auto flex items-center justify-center">
          <div class="absolute inset-0 rounded-full bg-[#0284C7]/30 blur-xl animate-pulse"></div>
          <div class="relative w-18 h-18 rounded-full bg-gradient-to-tr from-[#0284C7] to-[#38BDF8] border-2 border-[#38BDF8] flex items-center justify-center text-[#06080F] shadow-[0_0_30px_rgba(56,189,248,0.5)]">
            <svg class="w-9 h-9 text-[#06080F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
        </div>

        <div class="space-y-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#0284C7]/20 border border-[#38BDF8]/40 text-[#38BDF8] text-xs font-bold font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
            <span>区块链已确认到账</span>
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            支付成功 • 卡密已派发
          </h2>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed max-w-md mx-auto">
            区块链转账确认已通过！您的专属数字商品卡密凭据如下，请妥善保管。
          </p>
        </div>

        <!-- 卡密专区 -->
        <div class="p-5 rounded-2xl bg-[#06080F] border border-[#38BDF8]/40 text-left space-y-3 shadow-inner">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-black text-[#38BDF8] flex items-center gap-2">
              <svg class="w-4 h-4 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
              </svg>
              <span>数字商品卡密授权凭证</span>
            </span>
            <span id="copy-cardkey-hint" class="text-[11px] font-bold text-emerald-400 font-mono"></span>
          </div>

          <div 
            id="checkout-card-key-display" 
            class="p-3.5 bg-[#0B0F1A] border border-[#38BDF8]/30 rounded-xl font-mono text-xs sm:text-sm text-[#38BDF8] break-all select-all font-bold tracking-wide leading-relaxed shadow-sm"
          >
            正在为您提取专属授权卡密...
          </div>

          <button 
            type="button" 
            id="copy-final-key-btn"
            class="w-full py-3 rounded-xl bg-gradient-to-r from-[#0284C7] to-[#38BDF8] hover:brightness-115 text-white font-extrabold text-xs tracking-wider uppercase transition-all duration-200 shadow-[0_0_20px_rgba(56,189,248,0.4)] flex items-center justify-center gap-2 cursor-pointer active:scale-98"
          >
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
            <span id="copy-btn-text">一键复制卡密凭据</span>
          </button>
        </div>

        <div class="p-4 rounded-2xl bg-[#06080F]/70 border border-[#38BDF8]/20 space-y-1.5 text-left font-mono text-xs text-slate-400">
          <div class="flex justify-between items-center">
            <span>订单编号:</span>
            <span id="checkout-reference-id" class="text-white font-bold select-all"></span>
          </div>
          <div class="flex justify-between items-center">
            <span>交付保障:</span>
            <span class="text-emerald-400 font-bold">已写入安全订单库 (可凭邮箱随时查单)</span>
          </div>
        </div>

        <div class="pt-1 flex flex-col sm:flex-row gap-3 justify-center">
          <a 
            href="/query" 
            class="px-5 py-3 rounded-xl bg-white/5 border border-white/15 text-slate-200 hover:text-white hover:bg-white/10 font-bold text-xs uppercase tracking-wider transition active:scale-95 text-center flex items-center justify-center gap-1.5"
          >
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span>前往订单库检索全部卡密</span>
          </a>
          <a 
            href="/" 
            class="px-5 py-3 rounded-xl bg-white/5 border border-white/15 text-slate-200 hover:text-white hover:bg-white/10 font-bold text-xs uppercase tracking-wider transition active:scale-95 text-center"
          >
            返回商城首页
          </a>
        </div>
      </div>

    </div>
  </div>

</BaseLayout>

<script>
  import { 
    authInstance, 
    dbInstance, 
    collection, 
    addDoc, 
    onAuthStateChanged
  } from '../lib/firebase.js';

  let cart: any[] = [];

  function getCurrencyMode(): 'cny' | 'usd' {
    const lang = localStorage.getItem('active_language') || 'en';
    return ['zh-CN', 'zh-TW', 'ja', 'ko'].includes(lang) ? 'cny' : 'usd';
  }

  let currentUserUid = 'guest';
  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-message');
  const submitBtn = document.getElementById('submit-order-btn') as HTMLButtonElement;

  const hiddenPaymentMethod = document.getElementById('hidden-payment-method') as HTMLInputElement;
  const paymentButtons = document.querySelectorAll('.payment-method-btn');
  const badgeLabel = document.getElementById('payment-badge-label');
  const qrImage = document.getElementById('payment-qr-image') as HTMLImageElement;
  const noteParagraph = document.getElementById('payment-note-paragraph');
  const inputTxID = document.getElementById('txid') as HTMLInputElement;

  let currentUserDisplayName = '';

  onAuthStateChanged(authInstance, (user) => {
    if (user) {
      currentUserUid = user.uid;
      currentUserDisplayName = user.displayName || '';
      const emailField = document.getElementById('email') as HTMLInputElement;
      if (emailField && !emailField.value) {
        emailField.value = user.email || '';
      }
    }
  });

  // 读取购物车 (同时兼容 cart 与 boutique_cart，绝不闪退)
  function checkCart() {
    let savedCart = localStorage.getItem('cart') || localStorage.getItem('boutique_cart');
    if (savedCart) {
      try {
        cart = JSON.parse(savedCart);
      } catch {
        cart = [];
      }
    }

    if (cart.length === 0) {
      // 购物车为空时给出温和提示，延时跳转
      const listContainer = document.getElementById('checkout-summary-list');
      if (listContainer) {
        listContainer.innerHTML = `<div class="p-6 text-center text-slate-400 text-xs">清单为空，正在带您选购商品...</div>`;
      }
      setTimeout(() => {
        window.location.href = '/';
      }, 1500);
      return;
    }

    renderCheckout();
  }

  function renderCheckout() {
    const listContainer = document.getElementById('checkout-summary-list');
    const subtotalText = document.getElementById('checkout-subtotal');
    const grandtotalText = document.getElementById('checkout-grand-total');

    if (!listContainer || !subtotalText || !grandtotalText) return;

    const mode = getCurrencyMode();

    listContainer.innerHTML = cart.map(item => {
      const itemUsd = Math.ceil(item.price || 10) * (item.quantity || 1);
      const priceText = `$${itemUsd}`;

      return `
        <div class="flex items-center justify-between text-xs py-2.5 border-b border-white/5 last:border-0">
          <div class="flex items-center gap-3 min-w-0 flex-1 pr-2 text-left">
            <img 
              src="${item.image || '/images/default_product.jpg'}" 
              onerror="this.src='/images/default_product.jpg'" 
              class="w-9 h-9 rounded-xl object-cover bg-black/40 border border-white/10 shrink-0" 
            />
            <div class="min-w-0 flex-1">
              <span class="text-white font-bold block truncate">${item.name}</span>
              <span class="text-slate-400 text-[10px] font-mono">${item.size ? `规格: ${item.size} | ` : ''}数量: ${item.quantity}</span>
            </div>
          </div>
          <span class="text-[#38BDF8] font-mono font-bold shrink-0">${priceText}</span>
        </div>
      `;
    }).join('');

    const totalUsd = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    const totalCny = Math.round(totalUsd * 7.1);

    if (mode === 'cny') {
      subtotalText.textContent = `¥${totalCny} CNY`;
      grandtotalText.textContent = `¥${totalCny} CNY`;
    } else {
      subtotalText.textContent = `$${totalUsd.toFixed(0)} USD`;
      grandtotalText.textContent = `$${totalUsd.toFixed(0)} USD`;
    }

    const hiddenCartData = document.getElementById('hidden-cart-data') as HTMLInputElement;
    const hiddenTotalPrice = document.getElementById('hidden-total-price') as HTMLInputElement;
    if (hiddenCartData) hiddenCartData.value = cart.map(i => `${i.quantity}x ${i.name}`).join(', ');
    if (hiddenTotalPrice) hiddenTotalPrice.value = `$${totalUsd.toFixed(0)} USD (¥${totalCny} CNY)`;
  }

  // 复制钱包地址交互
  const cryptoAddressText = document.getElementById('crypto-address-text');
  const copyHint = document.getElementById('copy-status-hint');
  const addressSpan = document.getElementById('address-display-val');

  function copyAddress() {
    const text = addressSpan?.textContent?.trim() || cryptoAddressText?.textContent?.trim() || '';
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
      if (copyHint) copyHint.textContent = '已复制 ✓';
      cryptoAddressText?.classList.add('border-emerald-400', 'bg-emerald-950/20');
      setTimeout(() => {
        if (copyHint) copyHint.textContent = '';
        cryptoAddressText?.classList.remove('border-emerald-400', 'bg-emerald-950/20');
      }, 1800);
    });
  }

  cryptoAddressText?.addEventListener('click', copyAddress);
  document.getElementById('copy-crypto-btn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    copyAddress();
  });

  // 切换通道
  paymentButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      paymentButtons.forEach(b => {
        b.classList.remove('bg-[#38BDF8]', 'border-[#0284C7]', 'text-[#06080F]');
        b.classList.add('bg-[#0B0F1A]', 'border-[#38BDF8]/20', 'text-white');
      });

      btn.classList.remove('bg-[#0B0F1A]', 'border-[#38BDF8]/20', 'text-white');
      btn.classList.add('bg-[#38BDF8]', 'border-[#0284C7]', 'text-[#06080F]');

      const name = btn.getAttribute('data-name') || '';
      const address = btn.getAttribute('data-address') || '';
      const badge = btn.getAttribute('data-badge') || '';
      const note = btn.getAttribute('data-note') || '';

      if (badgeLabel) badgeLabel.textContent = badge;
      if (addressSpan) addressSpan.textContent = address;
      if (qrImage) {
        qrImage.src = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(address)}`;
      }
      if (noteParagraph) noteParagraph.innerHTML = note;
      if (hiddenPaymentMethod) hiddenPaymentMethod.value = name;
    });
  });

  // 提交并链上核验
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg?.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = '正在核验链上转账凭据 (On-Chain Checking)...';

    const formData = new FormData(form);

    try {
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const paymentMethod = hiddenPaymentMethod.value;
      const txIdVal = inputTxID.value.trim();

      const totalUsd = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      const totalCny = Math.round(totalUsd * 7.1);

      // 1. 服务端链上核验
      const verifyRes = await fetch('/api/verify-payment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          orderId: 'SS-' + Date.now(),
          email,
          txid: txIdVal,
          paymentMethod,
          totalUsd,
          items: cart,
          targetAddress: addressSpan?.textContent?.trim() || ''
        })
      });

      const verifyData = await verifyRes.json();
      if (!verifyRes.ok || !verifyData.success) {
        throw new Error(verifyData.message || '链上核验未通过：未查询到该笔转账，请检查 TxID 或等待区块确认。');
      }

      // 2. 写入数据库
      const orderData = {
        uid: currentUserUid,
        username: currentUserDisplayName || email.split('@')[0],
        email,
        items: cart,
        paymentMethod,
        txId: txIdVal,
        totalUsd,
        totalCny,
        status: 'paid',
        createdAt: new Date().toISOString()
      };

      const orderRef = await addDoc(collection(dbInstance, 'orders'), orderData);
      const orderId = orderRef.id;

      // 3. 生成卡密并展示在成功卡片
      const cardKeyPayload = "SOUL-SOCIETY-" + orderId + "-" + Math.random().toString(36).substring(2, 8).toUpperCase();
      const cardKeyBox = document.getElementById('checkout-card-key-display');
      const copyKeyBtn = document.getElementById('copy-final-key-btn');
      const copyHint = document.getElementById('copy-cardkey-hint');
      const copyBtnText = document.getElementById('copy-btn-text');

      if (cardKeyBox) cardKeyBox.textContent = cardKeyPayload;
      if (copyKeyBtn) {
        copyKeyBtn.onclick = () => {
          navigator.clipboard.writeText(cardKeyPayload).then(() => {
            if (copyHint) copyHint.textContent = "已成功复制到剪贴板 ✓";
            if (copyBtnText) copyBtnText.textContent = "卡密已复制 ✓";
            copyKeyBtn.classList.add('brightness-125');
            setTimeout(() => {
              if (copyHint) copyHint.textContent = "";
              if (copyBtnText) copyBtnText.textContent = "一键复制卡密凭据";
              copyKeyBtn.classList.remove('brightness-125');
            }, 2000);
          });
        };
      }

      // 4. 清除本地购物车
      localStorage.removeItem('cart');
      localStorage.removeItem('boutique_cart');

      // 5. 显示成功视图
      const refId = document.getElementById('checkout-reference-id');
      if (refId) refId.textContent = orderId;
      document.getElementById('checkout-main-grid')?.classList.add('hidden');
      document.getElementById('checkout-success-view')?.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });

    } catch (err: any) {
      console.error(err);
      if (errorMsg) {
        errorMsg.classList.remove('hidden');
        errorMsg.textContent = err.message || '核验异常，请稍后重试。';
      }
      submitBtn.disabled = false;
      submitBtn.textContent = '链上核验并确认订单';
    }
  });

  checkCart();
</script>
