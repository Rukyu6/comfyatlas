---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Checkout | Puppy Shop">
  
  <div class="min-h-screen py-12 px-6 md:py-20 bg-[#FFFDF9] text-[#3E2A1E]">
    <div class="max-w-6xl mx-auto">
      
      <!-- Back Header -->
      <div class="mb-12">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 text-[#6D5A50] hover:text-[#FF6B8B] font-quicksand text-sm font-bold transition-colors group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to boutique
        </a>
      </div>

      <!-- Checkout Container -->
      <div id="checkout-main-grid" class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left Side: Order Verification Form -->
        <div class="lg:col-span-7">
          <h2 class="text-3xl font-bold font-fredoka text-[#3E2A1E] mb-8">Verification Protocol 🐾</h2>
          
          <form id="checkout-form" class="space-y-8">
            <!-- Web3Forms Configuration -->
            <input type="hidden" name="access_key" value="cae136d3-193a-4a59-bd40-6e4fa22afac9" />
            <input type="hidden" name="subject" value="New Order Placed on Puppy Shop" />
            <input type="hidden" name="from_name" value="Puppy Shop Checkout" />
            
            <!-- Hidden Order Details for Email Payload -->
            <input type="hidden" id="hidden-cart-data" name="cart_items" value="" />
            <input type="hidden" id="hidden-total-price" name="total_price" value="" />

            <!-- SECTION 1: Contact & Shipping (Dynamic) -->
            <div class="glass-card p-8 rounded-[2rem] border-3 border-[#3E2A1E] shadow-[4px_4px_0px_#3E2A1E] bg-white space-y-6">
              <h3 class="text-lg font-bold font-fredoka text-[#3E2A1E] border-b-2 border-[#E8E1D9] pb-3">01. Delivery Details</h3>
              
              <div class="space-y-4">
                <div>
                  <label for="email" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand">Email Address</label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required 
                    placeholder="name@domain.com"
                    class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                  />
                  <p class="text-[10px] text-[#6D5A50] font-quicksand font-semibold mt-1">We will send your digital goods and tracking updates here.</p>
                </div>

                <!-- Shipping Address wrapper: Shown only if physical items exist -->
                <div id="shipping-address-section" class="space-y-4 pt-2">
                  <div>
                    <label for="name" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand">Full Name</label>
                    <input 
                      type="text" 
                      id="name" 
                      name="name" 
                      placeholder="John Doe"
                      class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                    />
                  </div>
                  
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="address" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand">Street Address</label>
                      <input 
                        type="text" 
                        id="address" 
                        name="address" 
                        placeholder="123 Cyber Ave"
                        class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                      />
                    </div>
                    <div>
                      <label for="city" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand">City</label>
                      <input 
                        type="text" 
                        id="city" 
                        name="city" 
                        placeholder="New York"
                        class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                      />
                    </div>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                      <label for="state" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand">State/Region</label>
                      <input 
                        type="text" 
                        id="state" 
                        name="state" 
                        placeholder="NY"
                        class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                      />
                    </div>
                    <div>
                      <label for="country" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand">Country</label>
                      <input 
                        type="text" 
                        id="country" 
                        name="country" 
                        placeholder="United States"
                        class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                      />
                    </div>
                    <div>
                      <label for="zip" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand">ZIP/Postal Code</label>
                      <input 
                        type="text" 
                        id="zip" 
                        name="zip" 
                        placeholder="10001"
                        class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- SECTION 2: Payment Selection -->
            <div class="glass-card p-8 rounded-[2rem] border-3 border-[#3E2A1E] shadow-[4px_4px_0px_#3E2A1E] bg-white space-y-6">
              <h3 class="text-lg font-bold font-fredoka text-[#3E2A1E] border-b-2 border-[#E8E1D9] pb-3">02. Transfer Payment</h3>
              
              <!-- Tab Switcher -->
              <div class="flex border-2 border-[#3E2A1E] rounded-xl overflow-hidden bg-[#F7F2EB] p-1 shadow-[2px_2px_0px_#3E2A1E]">
                <button 
                  type="button"
                  id="tab-crypto"
                  class="flex-1 py-3 text-sm font-fredoka font-bold uppercase tracking-wider rounded-lg transition bg-[#FFD6E0] border-r-2 border-[#3E2A1E] text-[#3E2A1E] shadow-[1px_1px_0px_#3E2A1E]"
                >
                  Cryptocurrency
                </button>
                <button 
                  type="button"
                  id="tab-wire"
                  class="flex-1 py-3 text-sm font-quicksand font-bold uppercase tracking-wider rounded-lg transition text-[#6D5A50] hover:text-[#3E2A1E]"
                >
                  Bank Wire
                </button>
              </div>

              <!-- Payment Method Selection Storage -->
              <input type="hidden" id="hidden-payment-method" name="payment_method" value="USDT (TRC-20)" />

              <!-- CRYPTO DETAILS -->
              <div id="payment-crypto-container" class="space-y-6">
                <div class="bg-[#D6E4FF]/45 border-2 border-[#3E2A1E] rounded-2xl p-6 space-y-4 shadow-[2px_2px_0px_#3E2A1E]">
                  <div class="flex items-start gap-4">
                    <!-- Dynamic QR from API -->
                    <div class="w-24 h-24 bg-white p-1 rounded-xl flex items-center justify-center shrink-0 border-2 border-[#3E2A1E] shadow-md">
                      <img 
                        src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=THqSQXPyAvyxiH8EjVLsHf6YNa7XR31B3u" 
                        alt="Tron USDT QR Code" 
                        class="w-22 h-22"
                      />
                    </div>
                    <div class="space-y-2 min-w-0">
                      <span class="text-[10px] uppercase font-bold text-indigo-700 bg-indigo-100 px-2.5 py-0.5 rounded-full border border-indigo-200 font-quicksand">USDT TRC-20 Address</span>
                      <p id="crypto-address-text" class="text-sm font-mono text-[#3E2A1E] break-all bg-[#FFFDF9] p-2.5 rounded-lg border-2 border-[#3E2A1E] select-all">
                        THqSQXPyAvyxiH8EjVLsHf6YNa7XR31B3u
                      </p>
                      <button 
                        type="button"
                        id="copy-crypto-btn"
                        class="px-3 py-1.5 rounded-lg bg-white border-2 border-[#3E2A1E] text-xs font-bold text-[#3E2A1E] hover:bg-[#FFD6E0]/20 active:scale-95 transition font-fredoka shadow-[1px_1px_0px_#3E2A1E]"
                      >
                        Copy Wallet Address
                      </button>
                    </div>
                  </div>
                  <p class="text-xs text-[#6D5A50] font-quicksand font-bold leading-relaxed">
                    Please transfer the exact order amount in USDT to the TRC-20 address above. Transactions will be validated via the blockchain.
                  </p>
                </div>

                <!-- Proof input -->
                <div>
                  <label for="txid" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand">Transaction Hash (TxID)</label>
                  <input 
                    type="text" 
                    id="txid" 
                    name="txid" 
                    required 
                    placeholder="Enter blockchain transaction ID"
                    class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                  />
                  <p class="text-[10px] text-[#6D5A50] font-quicksand font-semibold mt-1">Provide the TxID hash so we can automatically match this ledger action with your order.</p>
                </div>
              </div>

              <!-- WIRE DETAILS (Hidden initially) -->
              <div id="payment-wire-container" class="space-y-6 hidden">
                <div class="bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-2xl p-6 space-y-4 shadow-[2px_2px_0px_#3E2A1E]">
                  <div class="space-y-3 font-quicksand font-bold text-sm text-[#3E2A1E]">
                    <span class="inline-block text-[10px] uppercase font-bold text-[#FF6B8B] bg-[#FFD6E0]/40 px-2.5 py-0.5 rounded-full border border-[#FF6B8B]/40 mb-1 font-fredoka">Kraken Wire Instructions</span>
                    
                    <!-- Reference / Memo is Critical -->
                    <div class="grid grid-cols-3 gap-2 border-b-2 border-red-200 pb-2 bg-red-50 p-2 rounded-lg">
                      <span class="text-red-600 font-bold text-xs flex items-center">Reference / Memo<br/>(REQUIRED)</span>
                      <span id="bank-memo-text" class="col-span-2 text-red-600 font-mono font-bold text-base flex items-center select-all">AA40 N84G W5VH 3FHQ</span>
                    </div>

                    <div class="grid grid-cols-3 gap-2 border-b-2 border-[#E8E1D9] pb-2">
                      <span class="text-[#6D5A50]">Account Holder</span>
                      <span class="col-span-2 text-[#3E2A1E] font-semibold">Payward Trading Ltd.</span>
                    </div>
                    <div class="grid grid-cols-3 gap-2 border-b-2 border-[#E8E1D9] pb-2">
                      <span class="text-[#6D5A50]">IBAN Number</span>
                      <span id="bank-iban-text" class="col-span-2 text-[#3E2A1E] font-mono font-semibold break-all select-all">LI82 0881 1010 4623 K003 U</span>
                    </div>
                    <div class="grid grid-cols-3 gap-2 border-b-2 border-[#E8E1D9] pb-2">
                      <span class="text-[#6D5A50]">Account Number</span>
                      <span id="bank-acct-text" class="col-span-2 text-[#3E2A1E] font-mono font-semibold select-all">0104623001003840</span>
                    </div>
                    <div class="grid grid-cols-3 gap-2 border-b-2 border-[#E8E1D9] pb-2">
                      <span class="text-[#6D5A50]">SWIFT/BIC Code</span>
                      <span id="swift-code-text" class="col-span-2 text-[#3E2A1E] font-mono font-semibold select-all">BFRILI22XXX</span>
                    </div>
                    <div class="grid grid-cols-3 gap-2 border-b-2 border-[#E8E1D9] pb-2">
                      <span class="text-[#6D5A50]">Receiving Bank</span>
                      <span class="col-span-2 text-[#3E2A1E] font-semibold">Bank Frick</span>
                    </div>
                    <div class="grid grid-cols-3 gap-2">
                      <span class="text-[#6D5A50]">Bank Address</span>
                      <span class="col-span-2 text-[#6D5A50] text-xs">Landstrasse 14, 9496 Balzers, Liechtenstein</span>
                    </div>
                  </div>

                  <div class="flex gap-2 flex-wrap">
                    <button 
                      type="button"
                      id="copy-memo-btn"
                      class="px-3 py-1.5 rounded-lg bg-red-100 border border-red-300 text-xs font-bold text-red-700 hover:bg-red-200 active:scale-95 transition font-fredoka shadow-[1px_1px_0px_#3E2A1E]"
                    >
                      Copy Reference / Memo
                    </button>
                    <button 
                      type="button"
                      id="copy-iban-btn"
                      class="px-3 py-1.5 rounded-lg bg-white border-2 border-[#3E2A1E] text-xs font-bold text-[#3E2A1E] hover:bg-[#FFD6E0]/20 active:scale-95 transition font-fredoka shadow-[1px_1px_0px_#3E2A1E]"
                    >
                      Copy IBAN
                    </button>
                    <button 
                      type="button"
                      id="copy-swift-btn"
                      class="px-3 py-1.5 rounded-lg bg-white border-2 border-[#3E2A1E] text-xs font-bold text-[#3E2A1E] hover:bg-[#FFD6E0]/20 active:scale-95 transition font-fredoka shadow-[1px_1px_0px_#3E2A1E]"
                    >
                      Copy SWIFT
                    </button>
                  </div>
                </div>

                <!-- Proof inputs -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label for="remitter" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand font-bold">Remitter's Full Name</label>
                    <input 
                      type="text" 
                      id="remitter" 
                      name="remitter_name" 
                      placeholder="Your name on the bank account"
                      class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                    />
                  </div>
                  <div>
                    <label for="sending-bank" class="block text-xs uppercase text-[#6D5A50] font-bold tracking-wider mb-2 font-quicksand font-bold">Paying Bank Name</label>
                    <input 
                      type="text" 
                      id="sending-bank" 
                      name="sending_bank" 
                      placeholder="e.g. HSBC, Barclays"
                      class="w-full bg-[#FFFDF9] border-2 border-[#3E2A1E] rounded-xl px-4 py-3 text-[#3E2A1E] placeholder-[#6D5A50] focus:outline-none focus:border-[#FF6B8B] transition font-quicksand font-semibold shadow-[2px_2px_0px_#3E2A1E]"
                    />
                  </div>
                </div>
              </div>
            </div>

            <!-- Validation Error Alert (Hidden by default) -->
            <div id="error-message" class="hidden p-4 rounded-xl border border-red-200 bg-red-100 text-red-700 text-sm font-semibold font-quicksand">
              Something went wrong. Please verify the required inputs.
            </div>

            <!-- Submit Button -->
            <button 
              type="submit"
              id="submit-order-btn"
              class="w-full py-4 rounded-xl bg-[#FFD6E0] border-3 border-[#3E2A1E] text-[#3E2A1E] hover:bg-[#FFB3C6] font-bold uppercase tracking-wider text-sm font-fredoka transition-all duration-300 shadow-[4px_4px_0px_#3E2A1E] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_#3E2A1E] active:scale-[0.99] cursor-pointer"
            >
              Verify & Complete Order 🐾
            </button>
          </form>
        </div>

        <!-- Right Side: Order Summary -->
        <div class="lg:col-span-5">
          <div class="glass-card p-8 rounded-[2rem] border-3 border-[#3E2A1E] shadow-[4px_4px_0px_#3E2A1E] bg-white space-y-6 sticky top-28">
            <h3 class="text-lg font-bold font-fredoka text-[#3E2A1E] border-b-2 border-[#E8E1D9] pb-3">Bag Summary 🧁</h3>
            
            <!-- Items list -->
            <div id="checkout-summary-list" class="space-y-4 max-h-[300px] overflow-y-auto pr-2">
              <!-- JS renders list items here -->
            </div>

            <!-- Price Breakdown -->
            <div class="pt-6 border-t-2 border-[#E8E1D9] space-y-2 text-sm text-[#6D5A50] font-quicksand font-bold">
              <div class="flex justify-between">
                <span>Subtotal</span>
                <span id="checkout-subtotal" class="text-[#3E2A1E] font-fredoka">$0.00</span>
              </div>
              <div class="flex justify-between">
                <span>Shipping Logistics</span>
                <span class="text-indigo-600 font-bold uppercase tracking-widest text-xs">Free Courier 🧁</span>
              </div>
              <div class="flex justify-between text-[#FF6B8B] font-bold font-fredoka text-xl pt-4 border-t-2 border-[#3E2A1E]">
                <span>Grand Total</span>
                <span id="checkout-grand-total">$0.00</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- SUCCESS SCREEN (Hidden initially) -->
      <div id="checkout-success-view" class="hidden max-w-xl mx-auto text-center py-20 px-6 space-y-8 glass-card border-3 border-[#3E2A1E] shadow-[8px_8px_0px_#3E2A1E] rounded-[2rem] bg-white">
        <div class="w-20 h-20 rounded-full bg-green-100 border-2 border-[#3E2A1E] flex items-center justify-center mx-auto text-green-600 shadow-[2px_2px_0px_#3E2A1E]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="space-y-4">
          <h2 class="text-3xl font-bold font-fredoka text-[#3E2A1E] tracking-tight">Order Logged Successfully 🎉</h2>
          <p class="text-[#6D5A50] text-sm leading-relaxed max-w-sm mx-auto font-quicksand font-bold">
            Your verification request is registered in our queue. We will check the ledger/transfer and dispatch your tracking coordinates & digital items to your email.
          </p>
        </div>
        <div class="border-t-2 border-[#E8E1D9] pt-6 text-[#6D5A50] text-xs font-quicksand font-bold">
          Order reference: <span id="checkout-reference-id" class="font-mono text-[#3E2A1E] font-bold">CA-837492</span>
        </div>
        <a 
          href="/" 
          class="inline-block px-8 py-3 rounded-xl bg-[#FFD6E0] border-2 border-[#3E2A1E] text-[#3E2A1E] hover:bg-[#FFB3C6] font-bold uppercase tracking-wider text-xs font-fredoka transition-all duration-300 shadow-[2px_2px_0px_#3E2A1E]"
        >
          Return to Boutique 🐶
        </a>
      </div>

    </div>
  </div>

</BaseLayout>

<script>
  import { 
    authInstance, 
    dbInstance, 
    collection, 
    addDoc, 
    onAuthStateChanged 
  } from '../lib/firebase.js';

  // Checkout flow Logic
  let cart = [];
  let currentUserUid = 'guest';
  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-message');
  const submitBtn = document.getElementById('submit-order-btn') as HTMLButtonElement;

  // Tabs
  const tabCrypto = document.getElementById('tab-crypto');
  const tabWire = document.getElementById('tab-wire');
  const cryptoContainer = document.getElementById('payment-crypto-container');
  const wireContainer = document.getElementById('payment-wire-container');
  const hiddenPaymentMethod = document.getElementById('hidden-payment-method') as HTMLInputElement;

  // Form Fields
  const inputTxID = document.getElementById('txid') as HTMLInputElement;
  const inputRemitter = document.getElementById('remitter') as HTMLInputElement;
  const inputSendingBank = document.getElementById('sending-bank') as HTMLInputElement;

  // Watch Authentication State to auto-fill
  onAuthStateChanged(authInstance, (user) => {
    if (user) {
      currentUserUid = user.uid;
      const emailField = document.getElementById('email') as HTMLInputElement;
      if (emailField && !emailField.value) {
        emailField.value = user.email || '';
      }
    }
  });

  // Load and check cart
  function checkCart() {
    const savedCart = localStorage.getItem('boutique_cart');
    if (savedCart) {
      try {
        cart = JSON.parse(savedCart);
      } catch (e) {
        cart = [];
      }
    }

    if (cart.length === 0) {
      // Redirect empty cart
      window.location.href = '/';
      return;
    }

    renderCheckout();
  }

  // Render Page Content
  function renderCheckout() {
    const listContainer = document.getElementById('checkout-summary-list');
    const subtotalText = document.getElementById('checkout-subtotal');
    const grandtotalText = document.getElementById('checkout-grand-total');
    const shippingSection = document.getElementById('shipping-address-section');

    const addressInputs = shippingSection?.querySelectorAll('input');

    if (!listContainer || !subtotalText || !grandtotalText) return;

    // Check if any physical items are present
    const hasPhysicalItems = cart.some(item => item.type === 'physical');
    if (!hasPhysicalItems) {
      // Hide shipping section & remove required attributes
      if (shippingSection) shippingSection.style.display = 'none';
      addressInputs?.forEach(input => {
        input.removeAttribute('required');
      });
    } else {
      if (shippingSection) shippingSection.style.display = 'block';
      addressInputs?.forEach(input => {
        input.setAttribute('required', 'true');
      });
    }

    // Render list
    listContainer.innerHTML = cart.map(item => `
      <div class="flex items-center justify-between text-sm py-2 border-b border-white/5">
        <div class="min-w-0 pr-4">
          <span class="text-white font-bold block truncate font-outfit">${item.name}</span>
          <span class="text-zinc-500 text-xs">${item.type === 'physical' ? `Size: ${item.size} × ${item.quantity}` : `Digital × ${item.quantity}`}</span>
        </div>
        <span class="text-white font-mono font-semibold shrink-0">$${(item.price * item.quantity).toFixed(2)}</span>
      </div>
    `).join('');

    const totalCost = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    subtotalText.textContent = `$${totalCost.toFixed(2)}`;
    grandtotalText.textContent = `$${totalCost.toFixed(2)}`;

    // Set hidden inputs for form payload
    const cartSummaryString = cart.map(item => `${item.quantity}x ${item.name}${item.size ? ` (${item.size})` : ''}`).join(', ');
    const hiddenCartData = document.getElementById('hidden-cart-data') as HTMLInputElement;
    const hiddenTotalPrice = document.getElementById('hidden-total-price') as HTMLInputElement;

    if (hiddenCartData) hiddenCartData.value = cartSummaryString;
    if (hiddenTotalPrice) hiddenTotalPrice.value = `$${totalCost.toFixed(2)}`;
  }

  // Payment Tab Switching
  tabCrypto?.addEventListener('click', () => {
    tabCrypto.className = "flex-1 py-3 text-sm font-outfit font-bold uppercase tracking-wider rounded-lg transition bg-white text-black";
    tabWire!.className = "flex-1 py-3 text-sm font-outfit font-bold uppercase tracking-wider rounded-lg transition text-zinc-400 hover:text-white";
    cryptoContainer?.classList.remove('hidden');
    wireContainer?.classList.add('hidden');
    hiddenPaymentMethod.value = "USDT (TRC-20)";
    
    // Set required states
    inputTxID.setAttribute('required', 'true');
    inputRemitter.removeAttribute('required');
    inputSendingBank.removeAttribute('required');
  });

  tabWire?.addEventListener('click', () => {
    tabWire.className = "flex-1 py-3 text-sm font-outfit font-bold uppercase tracking-wider rounded-lg transition bg-white text-black";
    tabCrypto!.className = "flex-1 py-3 text-sm font-outfit font-bold uppercase tracking-wider rounded-lg transition text-zinc-400 hover:text-white";
    wireContainer?.classList.remove('hidden');
    cryptoContainer?.classList.add('hidden');
    hiddenPaymentMethod.value = "Bank Wire Transfer";

    // Set required states
    inputTxID.removeAttribute('required');
    inputRemitter.setAttribute('required', 'true');
    inputSendingBank.setAttribute('required', 'true');
  });

  // Click-to-copy utility
  function setupCopyToClipboard(triggerId, textId) {
    const trigger = document.getElementById(triggerId);
    const element = document.getElementById(textId);
    if (!trigger || !element) return;

    trigger.addEventListener('click', () => {
      const textToCopy = element.textContent?.trim() || '';
      navigator.clipboard.writeText(textToCopy).then(() => {
        const originalText = trigger.textContent;
        trigger.textContent = 'Copied!';
        trigger.classList.add('bg-emerald-500/20', 'text-emerald-400');
        setTimeout(() => {
          trigger.textContent = originalText;
          trigger.classList.remove('bg-emerald-500/20', 'text-emerald-400');
        }, 1500);
      });
    });
  }

  setupCopyToClipboard('copy-crypto-btn', 'crypto-address-text');
  setupCopyToClipboard('copy-memo-btn', 'bank-memo-text');
  setupCopyToClipboard('copy-iban-btn', 'bank-iban-text');
  setupCopyToClipboard('copy-swift-btn', 'swift-code-text');

  // Submit flow
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg?.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting Verification...';

    const formData = new FormData(form);

    try {
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const paymentMethod = hiddenPaymentMethod.value;
      
      let txIdVal = '';
      if (paymentMethod === "USDT (TRC-20)") {
        txIdVal = inputTxID.value;
      } else {
        txIdVal = `${inputRemitter.value} (${inputSendingBank.value})`;
      }
      
      const totalUsd = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      const totalCny = Math.round(totalUsd * 6.8);

      const orderData = {
        uid: currentUserUid,
        email,
        items: cart.map(item => ({
          id: item.id,
          name: item.name,
          price: item.price,
          type: item.type,
          size: item.size || null,
          quantity: item.quantity,
          image: item.image
        })),
        paymentMethod: paymentMethod === "USDT (TRC-20)" ? 'USDT' : 'Bank',
        txId: txIdVal,
        totalUsd,
        totalCny,
        status: 'pending'
      };

      // 1. Create order document in database (Firebase or Mock fallback)
      const orderRef = await addDoc(collection(dbInstance, 'orders'), orderData);
      const orderId = orderRef.id;

      // 2. Append database Order ID to the Web3Forms payload for email indexing
      formData.append('database_order_id', orderId);

      // 3. Submit notification via Web3Forms API
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });

      const result = await response.json();

      if (result.success) {
        // Clear cart
        localStorage.removeItem('boutique_cart');
        
        // Show success screen
        const refId = document.getElementById('checkout-reference-id');
        if (refId) refId.textContent = orderId;
        
        document.getElementById('checkout-main-grid')?.classList.add('hidden');
        document.getElementById('checkout-success-view')?.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        throw new Error(result.message || 'Form submission failed');
      }
    } catch (err) {
      console.error(err);
      if (errorMsg) {
        errorMsg.classList.remove('hidden');
        errorMsg.textContent = 'Submission error. Please verify database connection or checkout keys.';
      }
      submitBtn.disabled = false;
      submitBtn.textContent = 'Verify & Complete Order';
    }
  });

  // Run on load
  checkCart();
</script>
