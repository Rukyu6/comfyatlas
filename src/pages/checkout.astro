---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Checkout | Puppy Shop">
  
  <div class="min-h-screen py-12 px-6 md:py-20 bg-black text-white font-sora">
    <div class="max-w-6xl mx-auto">
      
      <!-- Back Header -->
      <div class="mb-12">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 text-zinc-400 hover:text-[#E7AC08] font-sora text-sm font-semibold transition-colors group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to boutique
        </a>
      </div>

      <!-- Checkout Container -->
      <div id="checkout-main-grid" class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start animate-fadeIn">
        
        <!-- Left Side: Order Verification Form -->
        <div class="lg:col-span-7">
          <h2 class="text-3xl font-bold font-sora text-white mb-8">收银台 / Checkout 🐾</h2>
          
          <form id="checkout-form" class="space-y-8">
            <!-- Web3Forms Configuration -->
            <input type="hidden" name="access_key" value="cae136d3-193a-4a59-bd40-6e4fa22afac9" />
            <input type="hidden" name="subject" value="New Order Placed on Puppy Shop" />
            <input type="hidden" name="from_name" value="Puppy Shop Checkout" />
            
            <!-- Hidden Order Details for Email Payload -->
            <input type="hidden" id="hidden-cart-data" name="cart_items" value="" />
            <input type="hidden" id="hidden-total-price" name="total_price" value="" />

            <!-- SECTION 1: Contact & Shipping (Dynamic) -->
            <div class="glass-card p-8 rounded-[2rem] border border-[#292929] bg-[#1C1917]/50 backdrop-blur-xl space-y-6">
              <h3 class="text-lg font-bold font-sora text-white border-b border-[#292929] pb-3">01. 接收邮箱 / Delivery Email</h3>
              
              <div class="space-y-4">
                <div>
                  <label for="email" class="block text-xs uppercase text-zinc-400 font-bold tracking-wider mb-2 font-sora">电子邮箱地址 / Email Address</label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required 
                    placeholder="name@domain.com"
                    class="w-full bg-black border border-[#292929] rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:border-[#E7AC08] focus:ring-1 focus:ring-[#E7AC08] transition font-sora font-semibold"
                  />
                  <p class="text-[10px] text-zinc-500 font-sora font-semibold mt-1">购买的账号卡密及发货更新将自动发送至此邮箱，请确保填写正确。</p>
                </div>

                <!-- Shipping Address wrapper: Permanently Hidden -->
                <div id="shipping-address-section" class="space-y-4 pt-2 hidden">
                  <div>
                    <label for="name" class="block text-xs uppercase text-zinc-400 font-bold tracking-wider mb-2 font-sora">Full Name</label>
                    <input 
                      type="text" 
                      id="name" 
                      name="name" 
                      placeholder="John Doe"
                      class="w-full bg-black border border-[#292929] rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:border-[#E7AC08] transition font-sora font-semibold"
                    />
                  </div>
                  
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="address" class="block text-xs uppercase text-zinc-400 font-bold tracking-wider mb-2 font-sora">Street Address</label>
                      <input 
                        type="text" 
                        id="address" 
                        name="address" 
                        placeholder="123 Cyber Ave"
                        class="w-full bg-black border border-[#292929] rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:border-[#E7AC08] transition font-sora font-semibold"
                      />
                    </div>
                    <div>
                      <label for="city" class="block text-xs uppercase text-zinc-400 font-bold tracking-wider mb-2 font-sora">City</label>
                      <input 
                        type="text" 
                        id="city" 
                        name="city" 
                        placeholder="New York"
                        class="w-full bg-black border border-[#292929] rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:border-[#E7AC08] transition font-sora font-semibold"
                      />
                    </div>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                      <label for="state" class="block text-xs uppercase text-zinc-400 font-bold tracking-wider mb-2 font-sora">State/Region</label>
                      <input 
                        type="text" 
                        id="state" 
                        name="state" 
                        placeholder="NY"
                        class="w-full bg-black border border-[#292929] rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:border-[#E7AC08] transition font-sora font-semibold"
                      />
                    </div>
                    <div>
                      <label for="country" class="block text-xs uppercase text-zinc-400 font-bold tracking-wider mb-2 font-sora">Country</label>
                      <input 
                        type="text" 
                        id="country" 
                        name="country" 
                        placeholder="United States"
                        class="w-full bg-black border border-[#292929] rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:border-[#E7AC08] transition font-sora font-semibold"
                      />
                    </div>
                    <div>
                      <label for="zip" class="block text-xs uppercase text-zinc-400 font-bold tracking-wider mb-2 font-sora">ZIP/Postal Code</label>
                      <input 
                        type="text" 
                        id="zip" 
                        name="zip" 
                        placeholder="10001"
                        class="w-full bg-black border border-[#292929] rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:border-[#E7AC08] transition font-sora font-semibold"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- SECTION 2: Payment Selection -->
            <div class="glass-card p-8 rounded-[2rem] border border-[#292929] bg-[#1C1917]/50 backdrop-blur-xl space-y-6">
              <h3 class="text-lg font-bold font-sora text-white border-b border-[#292929] pb-3">02. 转账支付 / Transfer Payment</h3>

              <!-- Payment Method Selection Grid -->
              <div class="space-y-3">
                <label class="block text-xs uppercase text-zinc-400 font-bold tracking-wider font-sora">选择付款网络 / Select Payment Network</label>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-3" id="payment-networks-grid">
                  <!-- Wallet Balance Payment Button (Initially Hidden) -->
                  <button type="button" id="pay-method-balance" class="hidden payment-method-btn flex flex-col items-center justify-center p-3.5 rounded-2xl border border-[#292929] bg-transparent text-white font-sora shadow-md transition hover:translate-y-[-2px] active:scale-95 cursor-pointer hover:bg-white/5" data-id="BALANCE" data-name="余额支付 (Wallet Balance)" data-badge="Wallet Balance Payment">
                    <span class="text-xs uppercase font-extrabold tracking-widest text-[#E7AC08]">余额支付</span>
                    <span class="text-[9px] font-bold text-zinc-400 mt-0.5 font-sans">Balance: $<span id="checkout-wallet-balance">0.00</span></span>
                  </button>

                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3.5 rounded-2xl border border-[#FAC514] bg-[#E7AC08] text-[#080808] font-sora shadow-md transition hover:translate-y-[-2px] active:scale-95 cursor-pointer" data-id="USDT_TRC20" data-address="TPUxwhaa4szt1QswXvFVKtbYEHUwupRGZA" data-name="USDT (TRC-20)" data-badge="USDT TRC-20 Address" data-note="请向上述 TRC-20 地址转入精确的订单金额（USDT）。转账完成后，系统将自动在区块链上进行验证。<br/>Please transfer the exact order amount in USDT to the TRC-20 address above.">
                    <span class="text-xs uppercase font-extrabold tracking-widest">USDT</span>
                    <span class="text-[9px] font-bold mt-0.5 font-sans text-[#080808]/90">Tron (TRC-20)</span>
                  </button>
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3.5 rounded-2xl border border-[#292929] bg-transparent text-white font-sora shadow-md transition hover:translate-y-[-2px] active:scale-95 cursor-pointer hover:bg-white/5" data-id="USDT_BEP20" data-address="0xfd28A01945BDeF96e66Da9435184395204Aa287" data-name="USDT (BEP-20)" data-badge="USDT BEP-20 Address" data-note="请向上述 BEP-20 地址转入精确的订单金额（USDT）。转账完成后，系统将自动在区块链上进行验证。<br/>Please transfer the exact order amount in USDT to the BEP-20 address above.">
                    <span class="text-xs uppercase font-extrabold tracking-widest text-[#E7AC08]">USDT</span>
                    <span class="text-[9px] font-bold text-zinc-400 mt-0.5 font-sans">BNB Chain (BEP-20)</span>
                  </button>
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3.5 rounded-2xl border border-[#292929] bg-transparent text-white font-sora shadow-md transition hover:translate-y-[-2px] active:scale-95 cursor-pointer hover:bg-white/5" data-id="USDT_ERC20" data-address="0xfd28A01945BDeF96e66Da9435184395204Aa287" data-name="USDT (ERC-20)" data-badge="USDT ERC-20 Address" data-note="请向上述 ERC-20 地址转入精确的订单金额（USDT）。转账完成后，系统将自动在区块链上进行验证。<br/>Please transfer the exact order amount in USDT to the ERC-20 address above.">
                    <span class="text-xs uppercase font-extrabold tracking-widest text-[#E7AC08]">USDT</span>
                    <span class="text-[9px] font-bold text-zinc-400 mt-0.5 font-sans">Ethereum (ERC-20)</span>
                  </button>
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3.5 rounded-2xl border border-[#292929] bg-transparent text-white font-sora shadow-md transition hover:translate-y-[-2px] active:scale-95 cursor-pointer hover:bg-white/5" data-id="USDC_BEP20" data-address="0xfd28A01945BDeF96e66Da9435184395204Aa287" data-name="USDC (BEP-20)" data-badge="USDC BEP-20 Address" data-note="请向上述 BEP-20 地址转入精确的订单金额（USDC）。转账完成后，系统将自动在区块链上进行验证。<br/>Please transfer the exact order amount in USDC to the BEP-20 address above.">
                    <span class="text-xs uppercase font-extrabold tracking-widest text-[#E7AC08]">USDC</span>
                    <span class="text-[9px] font-bold text-zinc-400 mt-0.5 font-sans">BNB Chain (BEP-20)</span>
                  </button>
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3.5 rounded-2xl border border-[#292929] bg-transparent text-white font-sora shadow-md transition hover:translate-y-[-2px] active:scale-95 cursor-pointer hover:bg-white/5" data-id="USDC_ERC20" data-address="0xfd28A01945BDeF96e66Da9435184395204Aa287" data-name="USDC (ERC-20)" data-badge="USDC ERC-20 Address" data-note="请向上述 ERC-20 地址转入精确的订单金额（USDC）。转账完成后，系统将自动在区块链上进行验证。<br/>Please transfer the exact order amount in USDC to the ERC-20 address above.">
                    <span class="text-xs uppercase font-extrabold tracking-widest text-[#E7AC08]">USDC</span>
                    <span class="text-[9px] font-bold text-zinc-400 mt-0.5 font-sans">Ethereum (ERC-20)</span>
                  </button>
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3.5 rounded-2xl border border-[#292929] bg-transparent text-white font-sora shadow-md transition hover:translate-y-[-2px] active:scale-95 cursor-pointer hover:bg-white/5" data-id="TRX" data-address="TPUxwhaa4szt1QswXvFVKtbYEHUwupRGZA" data-name="TRX (Tron)" data-badge="TRX Tron Address" data-note="请向上述 Tron 地址转入精确的订单金额（TRX）。转账完成后，系统将自动在区块链上进行验证。<br/>Please transfer the exact order amount in TRX to the Tron address above.">
                    <span class="text-xs uppercase font-extrabold tracking-widest text-[#E7AC08]">TRX</span>
                    <span class="text-[9px] font-bold text-zinc-400 mt-0.5 font-sans">Tron Network</span>
                  </button>
                </div>
              </div>

              <!-- Payment Method Selection Storage -->
              <input type="hidden" id="hidden-payment-method" name="payment_method" value="USDT (TRC-20)" />

              <!-- CRYPTO DETAILS -->
              <div id="payment-crypto-container" class="space-y-6 animate-fadeIn">
                <div class="bg-[#090909] border border-[#292929] rounded-2xl p-6 space-y-6 shadow-md flex flex-col items-center text-center">
                  
                  <span id="payment-badge-label" class="text-[10px] uppercase font-bold text-[#E7AC08] bg-[#E7AC08]/10 px-3.5 py-1 rounded-full border border-[#E7AC08]/30 font-sora">
                    USDT TRC-20 Address
                  </span>

                  <!-- Dynamic QR Code -->
                  <div class="w-36 h-36 bg-white p-2 rounded-2xl flex items-center justify-center border border-[#292929] hover:scale-105 transition-transform duration-300">
                    <img 
                      id="payment-qr-image"
                      src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=TPUxwhaa4szt1QswXvFVKtbYEHUwupRGZA" 
                      alt="Payment QR Code" 
                      class="w-32 h-32 rounded-lg"
                    />
                  </div>

                  <div class="w-full space-y-3">
                    <div class="text-xs font-bold text-zinc-400 font-sora">点击下方地址即可自动复制 / Click to copy address:</div>
                    <p id="crypto-address-text" class="text-xs md:text-sm font-mono text-white break-all bg-black py-3 px-4 rounded-xl border border-[#292929] select-all cursor-pointer hover:bg-white/5 transition-colors font-bold shadow-sm">
                      TPUxwhaa4szt1QswXvFVKtbYEHUwupRGZA
                    </p>
                    <button 
                      type="button"
                      id="copy-crypto-btn"
                      class="px-6 py-2.5 rounded-xl bg-transparent border border-[#292929] text-xs font-bold text-white hover:bg-white/5 active:scale-95 transition font-sora shadow-sm cursor-pointer"
                    >
                      Copy Wallet Address
                    </button>
                  </div>

                  <p id="payment-note-paragraph" class="text-xs text-zinc-500 font-sora font-semibold leading-relaxed border-t border-[#292929] pt-4 w-full">
                    请向上述 TRC-20 地址转入精确的订单金额（USDT）。转账完成后，系统将自动在区块链上进行验证。<br/>
                    Please transfer the exact order amount in USDT to the TRC-20 address above.
                  </p>
                </div>

                <!-- Proof input -->
                <div id="txid-input-container" class="space-y-2">
                  <label for="txid" class="block text-xs uppercase text-zinc-400 font-bold tracking-wider font-sora">
                    转账交易哈希 / Transaction Hash (TxID)
                  </label>
                  <input 
                    type="text" 
                    id="txid" 
                    name="txid" 
                    required 
                    placeholder="请输入区块链交易哈希值 (TxID) / Enter TxID"
                    class="w-full bg-black border border-[#292929] rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:border-[#E7AC08] focus:ring-1 focus:ring-[#E7AC08] transition font-sora font-semibold"
                  />
                  <p class="text-[10px] text-zinc-550 font-sora font-semibold">
                    请填写您转账的交易哈希，以便我们自动匹配和确认您的订单。<br/>
                    Provide the TxID hash so we can automatically match this ledger action with your order.
                  </p>
                </div>
              </div>
            </div>

            <!-- Validation Error Alert (Hidden by default) -->
            <div id="error-message" class="hidden p-4 rounded-xl border border-red-900 bg-red-950/20 text-red-400 text-sm font-semibold font-sora">
              Something went wrong. Please verify the required inputs.
            </div>

            <!-- Submit Button -->
            <button 
              type="submit"
              id="submit-order-btn"
              class="w-full py-4 rounded-xl bg-[#E7AC08] border border-[#FAC514] text-[#080808] hover:bg-[#FAC514] font-bold uppercase tracking-wider text-sm font-sora transition-all duration-300 shadow-lg active:scale-[0.99] cursor-pointer"
            >
              确认并提交订单 / Verify & Submit Order 🐾
            </button>
          </form>
        </div>
 
        <!-- Right Side: Order Summary -->
        <div class="lg:col-span-5">
          <div class="glass-card p-8 rounded-[2rem] border border-[#292929] bg-[#1C1917]/50 backdrop-blur-xl space-y-6 sticky top-28">
            <h3 class="text-lg font-bold font-sora text-white border-b border-[#292929] pb-3">订单汇总 / Order Summary 🧁</h3>
            
            <!-- Items list -->
            <div id="checkout-summary-list" class="space-y-4 max-h-[300px] overflow-y-auto pr-2">
              <!-- JS renders list items here -->
            </div>
 
            <!-- Price Breakdown -->
            <div class="pt-6 border-t border-[#292929] space-y-2 text-sm text-zinc-400 font-sora font-semibold">
              <div class="flex justify-between">
                <span>商品小计 / Subtotal</span>
                <span id="checkout-subtotal" class="text-white font-sora">$0.00</span>
              </div>
              <div class="flex justify-between">
                <span>配送方式 / Delivery</span>
                <span class="text-[#E7AC08] font-bold uppercase tracking-wider text-xs">自动发货 / Auto Delivery 🧁</span>
              </div>
              <div class="flex justify-between text-[#E7AC08] font-bold font-sora text-xl pt-4 border-t border-[#292929]">
                <span>实付总额 / Grand Total</span>
                <span id="checkout-grand-total">$0.00</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- SUCCESS SCREEN (Hidden initially) -->
      <div id="checkout-success-view" class="hidden max-w-xl mx-auto text-center py-20 px-6 space-y-8 glass-card border border-[#292929] rounded-[2rem] bg-[#1C1917]/50 backdrop-blur-xl text-white">
        <div class="w-20 h-20 rounded-full bg-green-950/20 border border-green-800 flex items-center justify-center mx-auto text-green-400 shadow-md">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="space-y-4">
          <h2 class="text-3xl font-bold font-sora text-white tracking-tight">Order Submitted Successfully! 🎉</h2>
          <p class="text-zinc-400 text-xs leading-relaxed max-w-md mx-auto font-sans">
            We are preparing your keys manually (usually takes 5-15 mins). Once shipped, card keys will display instantly in your <strong>Order Vault</strong> history page.<br/><br/>
            系统已收到您的订单，正为您人工配货（通常需 5~15 分钟）。发货后卡密将自动呈现于您的“订单保险库”（Order Vault）中，请稍后刷新查看。
          </p>
        </div>
        <div class="border-t border-[#292929] pt-6 text-zinc-400 text-xs font-sora">
          Order reference: <span id="checkout-reference-id" class="font-mono text-white font-bold">CA-837492</span>
        </div>
        <a 
          href="/" 
          class="inline-block px-8 py-3 rounded-xl bg-[#E7AC08] border border-[#FAC514] text-[#080808] hover:bg-[#FAC514] font-bold uppercase tracking-wider text-xs font-sora transition-all duration-300 shadow-md"
        >
          Return to Boutique 🐶
        </a>
      </div>

    </div>
  </div>

</BaseLayout>

<script>
  import { 
    authInstance, 
    dbInstance, 
    collection, 
    addDoc, 
    onAuthStateChanged,
    doc,
    getDoc,
    setDoc
  } from '../lib/firebase.js';

  // Checkout flow Logic
  let cart = [];
  let userBalanceUsd = 0;

  // Returns 'cny' for CJK languages, 'usd' for everything else
  function getCurrencyMode(): 'cny' | 'usd' {
    const lang = localStorage.getItem('active_language') || 'en';
    return ['zh-CN', 'zh-TW', 'ja', 'ko'].includes(lang) ? 'cny' : 'usd';
  }

  let currentUserUid = 'guest';
  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-message');
  const submitBtn = document.getElementById('submit-order-btn') as HTMLButtonElement;

  // Payment Selection Selector Elements
  const hiddenPaymentMethod = document.getElementById('hidden-payment-method') as HTMLInputElement;
  const paymentButtons = document.querySelectorAll('.payment-method-btn');
  const badgeLabel = document.getElementById('payment-badge-label');
  const qrImage = document.getElementById('payment-qr-image') as HTMLImageElement;
  const noteParagraph = document.getElementById('payment-note-paragraph');
  const txidInputContainer = document.getElementById('txid-input-container');
  const paymentCryptoContainer = document.getElementById('payment-crypto-container');

  // Form Fields
  const inputTxID = document.getElementById('txid') as HTMLInputElement;

  let currentUserDisplayName = '';

  // Watch Authentication State to auto-fill
  onAuthStateChanged(authInstance, async (user) => {
    if (user) {
      currentUserUid = user.uid;
      currentUserDisplayName = user.displayName || '';
      const emailField = document.getElementById('email') as HTMLInputElement;
      if (emailField && !emailField.value) {
        emailField.value = user.email || '';
      }

      // Fetch user wallet balance
      try {
        const userDocRef = doc(dbInstance, 'users', user.uid);
        const userDocSnap = await getDoc(userDocRef);
        if (userDocSnap.exists()) {
          userBalanceUsd = userDocSnap.data()?.balance_usd || 0;
        }
        updateBalancePaymentOption();
      } catch (err) {
      }
    }
  });

  // Load and check cart
  function checkCart() {
    const savedCart = localStorage.getItem('boutique_cart');
    if (savedCart) {
      try {
        cart = JSON.parse(savedCart);
      } catch (e) {
        cart = [];
      }
    }

    if (cart.length === 0) {
      // Redirect empty cart
      window.location.href = '/';
      return;
    }

    renderCheckout();
  }

  // Render Page Content
  function renderCheckout() {
    const listContainer = document.getElementById('checkout-summary-list');
    const subtotalText = document.getElementById('checkout-subtotal');
    const grandtotalText = document.getElementById('checkout-grand-total');
    const shippingSection = document.getElementById('shipping-address-section');

    const addressInputs = shippingSection?.querySelectorAll('input');

    if (!listContainer || !subtotalText || !grandtotalText) return;

    // Force hide shipping section & remove required attributes under all conditions
    if (shippingSection) shippingSection.style.display = 'none';
    addressInputs?.forEach(input => {
      input.removeAttribute('required');
    });

    const mode = getCurrencyMode();

    // Render list
    listContainer.innerHTML = cart.map(item => {
      const itemUsd = item.price * item.quantity;
      const itemCny = Math.round(itemUsd * 6.8);
      const priceText = mode === 'cny'
        ? `¥${itemCny} CNY`
        : `$${itemUsd.toFixed(2)}`;
      const secondaryPriceText = mode === 'cny'
        ? `$${itemUsd.toFixed(2)} USD`
        : `¥${itemCny} CNY`;

      return `
        <div class="flex items-center justify-between text-sm py-2 border-b border-[#292929]">
          <div class="min-w-0 pr-4">
            <span class="text-white font-bold block truncate font-sora">${item.name}</span>
            <span class="text-zinc-400 text-xs font-sans">${item.type === 'physical' ? `Size: ${item.size} × ${item.quantity}` : `Digital × ${item.quantity}`}</span>
          </div>
          <div class="flex flex-col items-end text-right shrink-0">
            <span class="text-[#E7AC08] font-sora font-bold">${priceText}</span>
            <span class="text-[9px] text-zinc-550 font-sans font-bold">${secondaryPriceText}</span>
          </div>
        </div>
      `;
    }).join('');

    const totalCost = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    const totalCostCny = Math.round(totalCost * 6.8);

    if (mode === 'cny') {
      subtotalText.innerHTML = `¥${totalCostCny} <span class="text-xs text-zinc-400 font-sans font-normal">($${totalCost.toFixed(2)} USD)</span>`;
      grandtotalText.innerHTML = `¥${totalCostCny} <span class="text-xs text-zinc-400 font-sans font-normal">($${totalCost.toFixed(2)} USD)</span>`;
    } else {
      subtotalText.innerHTML = `$${totalCost.toFixed(2)} <span class="text-xs text-zinc-400 font-sans font-normal">(¥${totalCostCny} CNY)</span>`;
      grandtotalText.innerHTML = `$${totalCost.toFixed(2)} <span class="text-xs text-zinc-400 font-sans font-normal">(¥${totalCostCny} CNY)</span>`;
    }

    // Set hidden inputs for form payload
    const cartSummaryString = cart.map(item => `${item.quantity}x ${item.name}${item.size ? ` (${item.size})` : ''}`).join(', ');
    const hiddenCartData = document.getElementById('hidden-cart-data') as HTMLInputElement;
    const hiddenTotalPrice = document.getElementById('hidden-total-price') as HTMLInputElement;

    if (hiddenCartData) hiddenCartData.value = cartSummaryString;
    if (hiddenTotalPrice) {
      hiddenTotalPrice.value = mode === 'cny'
        ? `¥${totalCostCny} CNY ($${totalCost.toFixed(2)} USD)`
        : `$${totalCost.toFixed(2)} USD (¥${totalCostCny} CNY)`;
    }

    updateBalancePaymentOption();
  }

  function updateBalancePaymentOption() {
    const balanceBtn = document.getElementById('pay-method-balance');
    const balanceSpan = document.getElementById('checkout-wallet-balance');
    const totalCost = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    
    if (balanceBtn && balanceSpan) {
      balanceSpan.textContent = userBalanceUsd.toFixed(2);
      if (currentUserUid !== 'guest' && userBalanceUsd >= totalCost) {
        balanceBtn.classList.remove('hidden');
      } else {
        balanceBtn.classList.add('hidden');
      }
    }
  }

  // Click-to-copy utility
  function setupCopyToClipboard(triggerId, textId) {
    const trigger = document.getElementById(triggerId);
    const element = document.getElementById(textId);
    if (!trigger || !element) return;

    trigger.addEventListener('click', () => {
      const textToCopy = element.textContent?.trim() || '';
      navigator.clipboard.writeText(textToCopy).then(() => {
        const originalText = trigger.textContent;
        trigger.textContent = 'Copied!';
        trigger.classList.add('bg-emerald-950/40', 'text-emerald-350');
        setTimeout(() => {
          trigger.textContent = originalText;
          trigger.classList.remove('bg-emerald-950/40', 'text-emerald-350');
        }, 1500);
      });
    });
  }

  setupCopyToClipboard('copy-crypto-btn', 'crypto-address-text');

  // Direct Click-to-copy for the crypto address text block
  const cryptoAddressText = document.getElementById('crypto-address-text');
  cryptoAddressText?.addEventListener('click', () => {
    const text = cryptoAddressText.textContent?.trim() || '';
    navigator.clipboard.writeText(text).then(() => {
      const originalText = cryptoAddressText.innerText;
      cryptoAddressText.innerText = "COPIED / 地址已复制 ✓";
      cryptoAddressText.style.color = "#E7AC08";
      setTimeout(() => {
        cryptoAddressText.innerText = text;
        cryptoAddressText.style.color = "";
      }, 1000);
    });
  });

  // Handle switching payment networks
  paymentButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Remove active classes from all buttons
      paymentButtons.forEach(b => {
        b.classList.remove('bg-[#E7AC08]', 'border-[#FAC514]', 'text-[#080808]');
        b.classList.add('bg-transparent', 'border-[#292929]', 'text-white');
      });

      // Add active classes to selected button
      btn.classList.remove('bg-transparent', 'border-[#292929]', 'text-white');
      btn.classList.add('bg-[#E7AC08]', 'border-[#FAC514]', 'text-[#080808]');

      // Fetch network attributes
      const name = btn.getAttribute('data-name') || '';
      const address = btn.getAttribute('data-address') || '';
      const badge = btn.getAttribute('data-badge') || '';
      const note = btn.getAttribute('data-note') || '';
      const id = btn.getAttribute('data-id') || '';

      if (id === 'BALANCE') {
        paymentCryptoContainer?.classList.add('hidden');
        txidInputContainer?.classList.add('hidden');
        inputTxID.removeAttribute('required');
      } else {
        paymentCryptoContainer?.classList.remove('hidden');
        txidInputContainer?.classList.remove('hidden');
        inputTxID.setAttribute('required', 'true');
        
        // Update inputs & display text
        if (badgeLabel) badgeLabel.textContent = badge;
        if (cryptoAddressText) cryptoAddressText.textContent = address;
        if (qrImage) {
          qrImage.src = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(address)}`;
        }
        if (noteParagraph) {
          noteParagraph.innerHTML = note;
        }
      }

      // Update inputs & display text
      if (hiddenPaymentMethod) hiddenPaymentMethod.value = name;
    });
  });

  // Submit flow
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg?.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting Verification...';

    const formData = new FormData(form);

    try {
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const paymentMethod = hiddenPaymentMethod.value;
      
      const isBalancePayment = paymentMethod.includes("余额");
      const txIdVal = isBalancePayment ? "Wallet-Deducted" : inputTxID.value;
      
      const totalUsd = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      const totalCny = Math.round(totalUsd * 6.8);

      if (isBalancePayment) {
        if (currentUserUid === 'guest') {
          throw new Error("请先登录会员账号再进行余额支付。 / Please log in first.");
        }
        
        // Fetch latest balance from DB
        const userDocRef = doc(dbInstance, 'users', currentUserUid);
        const userDocSnap = await getDoc(userDocRef);
        let latestBalanceUsd = 0;
        if (userDocSnap.exists()) {
          latestBalanceUsd = userDocSnap.data()?.balance_usd || 0;
        }
        if (latestBalanceUsd < totalUsd) {
          throw new Error("余额不足，请先充值或切换支付方式。 / Insufficient wallet balance.");
        }

        // Deduct balance
        const newBalanceUsd = latestBalanceUsd - totalUsd;
        await setDoc(userDocRef, {
          balance_usd: newBalanceUsd,
          email: email
        });
      }

      const orderData = {
        uid: currentUserUid,
        username: currentUserDisplayName || email.split('@')[0],
        email,
        items: cart.map(item => ({
          id: item.id,
          name: item.name,
          price: item.price,
          type: item.type,
          size: item.size || null,
          quantity: item.quantity,
          image: item.image
        })),
        paymentMethod: paymentMethod,
        txId: txIdVal,
        totalUsd,
        totalCny,
        status: isBalancePayment ? 'paid' : 'pending',
        createdAt: new Date().toISOString()
      };

      // 1. Create order document in database
      const orderRef = await addDoc(collection(dbInstance, 'orders'), orderData);
      const orderId = orderRef.id;

      // 1.5 Push order alert to Telegram Bot
      try {
        await fetch('/api/order-notify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            orderId: orderId,
            totalUsd: totalUsd,
            totalCny: totalCny,
            paymentMethod: orderData.paymentMethod,
            createdAt: orderData.createdAt,
            username: orderData.username
          })
        });
      } catch (err) {
        console.error("Failed to trigger Telegram order alert:", err);
      }

      // 2. Append database Order ID to the Web3Forms payload for email indexing
      formData.append('database_order_id', orderId);

      // 3. Submit notification via Web3Forms API
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });

      const result = await response.json();

      if (result.success) {
        // Clear cart
        localStorage.removeItem('boutique_cart');
        
        // Show success screen
        const refId = document.getElementById('checkout-reference-id');
        if (refId) refId.textContent = orderId;
        
        document.getElementById('checkout-main-grid')?.classList.add('hidden');
        document.getElementById('checkout-success-view')?.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        throw new Error(result.message || 'Form submission failed');
      }
    } catch (err: any) {
      console.error(err);
      if (errorMsg) {
        errorMsg.classList.remove('hidden');
        errorMsg.textContent = err.message || 'Submission error. Please verify database connection or checkout keys.';
      }
      submitBtn.disabled = false;
      submitBtn.textContent = 'Verify & Complete Order';
    }
  });

  // Run on load
  checkCart();
</script>
