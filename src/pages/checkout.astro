---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Soul Society 收银台 — 灵压凭证核验与结算">
  
  <div class="min-h-screen py-12 px-6 md:py-20 bg-[#06080F] text-white font-sora">
    <div class="max-w-6xl mx-auto">
      
      <!-- Back Header -->
      <div class="mb-12">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 text-zinc-400 hover:text-[#38BDF8] font-sora text-sm font-semibold transition-colors group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          返回商城
        </a>
      </div>

      <!-- Checkout Container -->
      <div id="checkout-main-grid" class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start animate-fadeIn">
        
        <!-- Left Side: Order Verification Form -->
        <div class="lg:col-span-7">
          <h2 class="text-2xl md:text-3xl font-black text-white mb-8 tracking-tight flex items-center gap-3"><span>收银台</span><span class="text-xs font-mono font-bold text-[#38BDF8] bg-[#0284C7]/20 px-3 py-1 rounded-full border border-[#38BDF8]/40">SOUL SOCIETY CHECKOUT</span></h2>
          
          <form id="checkout-form" class="space-y-8">
            <!-- Web3Forms Configuration -->
            <input type="hidden" name="access_key" value="cae136d3-193a-4a59-bd40-6e4fa22afac9" />
            <input type="hidden" name="subject" value="New Order Placed on WorldMarket" />
            <input type="hidden" name="from_name" value="WorldMarket Checkout" />
            
            <!-- Hidden Order Details for Email Payload -->
            <input type="hidden" id="hidden-cart-data" name="cart_items" value="" />
            <input type="hidden" id="hidden-total-price" name="total_price" value="" />

            <!-- SECTION 1: Contact & Shipping (Dynamic) -->
            <div class="glass-card p-8 rounded-[2rem] border border-[#38BDF8]/20 bg-[#1C1917]/50 backdrop-blur-xl space-y-6">
              <h3 class="text-lg font-bold font-sora text-white border-b border-[#38BDF8]/20 pb-3">01. 接收邮箱 / Delivery Email</h3>
              
              <div class="space-y-4">
                <div>
                  <label for="email" class="block text-xs uppercase text-zinc-400 font-bold tracking-wider mb-2 font-sora">电子邮箱地址 / Email Address</label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required 
                    placeholder="name@domain.com"
                    class="w-full bg-[#06080F] border border-[#38BDF8]/20 rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:border-[#38BDF8] focus:ring-1 focus:ring-[#38BDF8] transition font-sora font-semibold"
                  />
                  <p class="text-[10px] text-zinc-500 font-sora font-semibold mt-1">购买的账号卡密及发货更新将自动发送至此邮箱，请确保填写正确。</p>
                </div>

                <!-- Shipping Address wrapper: Permanently Hidden -->
                <div id="shipping-address-section" class="space-y-4 pt-2 hidden">
                  <div>
                    <label for="name" class="block text-xs uppercase text-zinc-400 font-bold tracking-wider mb-2 font-sora">Full Name</label>
                    <input 
                      type="text" 
                      id="name" 
                      name="name" 
                      placeholder="John Doe"
                      class="w-full bg-[#06080F] border border-[#38BDF8]/20 rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:border-[#38BDF8] transition font-sora font-semibold"
                    />
                  </div>
                  
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="address" class="block text-xs uppercase text-zinc-400 font-bold tracking-wider mb-2 font-sora">Street Address</label>
                      <input 
                        type="text" 
                        id="address" 
                        name="address" 
                        placeholder="123 Cyber Ave"
                        class="w-full bg-[#06080F] border border-[#38BDF8]/20 rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:border-[#38BDF8] transition font-sora font-semibold"
                      />
                    </div>
                    <div>
                      <label for="city" class="block text-xs uppercase text-zinc-400 font-bold tracking-wider mb-2 font-sora">City</label>
                      <input 
                        type="text" 
                        id="city" 
                        name="city" 
                        placeholder="New York"
                        class="w-full bg-[#06080F] border border-[#38BDF8]/20 rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:border-[#38BDF8] transition font-sora font-semibold"
                      />
                    </div>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                      <label for="state" class="block text-xs uppercase text-zinc-400 font-bold tracking-wider mb-2 font-sora">State/Region</label>
                      <input 
                        type="text" 
                        id="state" 
                        name="state" 
                        placeholder="NY"
                        class="w-full bg-[#06080F] border border-[#38BDF8]/20 rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:border-[#38BDF8] transition font-sora font-semibold"
                      />
                    </div>
                    <div>
                      <label for="country" class="block text-xs uppercase text-zinc-400 font-bold tracking-wider mb-2 font-sora">Country</label>
                      <input 
                        type="text" 
                        id="country" 
                        name="country" 
                        placeholder="United States"
                        class="w-full bg-[#06080F] border border-[#38BDF8]/20 rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:border-[#38BDF8] transition font-sora font-semibold"
                      />
                    </div>
                    <div>
                      <label for="zip" class="block text-xs uppercase text-zinc-400 font-bold tracking-wider mb-2 font-sora">ZIP/Postal Code</label>
                      <input 
                        type="text" 
                        id="zip" 
                        name="zip" 
                        placeholder="10001"
                        class="w-full bg-[#06080F] border border-[#38BDF8]/20 rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:border-[#38BDF8] transition font-sora font-semibold"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- SECTION 2: Payment Selection -->
            <div class="glass-card p-8 rounded-[2rem] border border-[#38BDF8]/20 bg-[#1C1917]/50 backdrop-blur-xl space-y-6">
              <h3 class="text-lg font-bold font-sora text-white border-b border-[#38BDF8]/20 pb-3">02. 转账支付 / Transfer Payment</h3>

                            <!-- Payment Method Selection Grid -->
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <label class="block text-xs uppercase text-slate-300 font-bold tracking-wider font-mono">
                    选择付款网络 / Payment Network
                  </label>
                  <span class="text-[10px] text-[#38BDF8] font-mono bg-[#0284C7]/20 border border-[#38BDF8]/30 px-2.5 py-0.5 rounded-full">
                    零手续费 • 秒级到账
                  </span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" id="payment-networks-grid">
                  <!-- Wallet Balance Payment Button (Initially Hidden) -->
                  <button type="button" id="pay-method-balance" class="hidden col-span-2 sm:col-span-4 payment-method-btn flex items-center justify-between p-3.5 rounded-2xl border border-[#38BDF8]/40 bg-[#0B0F1A] text-white shadow-md transition hover:border-[#38BDF8] active:scale-98 cursor-pointer" data-id="BALANCE" data-name="余额支付 (Wallet Balance)" data-badge="Wallet Balance Payment">
                    <div class="flex items-center gap-2.5">
                      <div class="w-8 h-8 rounded-xl bg-[#0284C7]/20 border border-[#38BDF8]/40 text-[#38BDF8] flex items-center justify-center font-bold text-xs">⚡</div>
                      <div class="text-left">
                        <span class="text-xs uppercase font-extrabold tracking-wider text-[#38BDF8] block">会员钱包余额支付</span>
                        <span class="text-[10px] text-slate-400 font-mono">当前可用余额: $<span id="checkout-wallet-balance">0.00</span> USD</span>
                      </div>
                    </div>
                    <span class="text-xs font-bold text-[#38BDF8] px-3 py-1 rounded-xl bg-[#0284C7]/30 border border-[#38BDF8]/40">立即抵扣</span>
                  </button>

                  <!-- TRON (TRC20) 推荐通道 -->
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3 rounded-2xl border border-[#0284C7] bg-[#38BDF8] text-[#06080F] shadow-[0_0_20px_rgba(56,189,248,0.3)] transition active:scale-95 cursor-pointer relative overflow-hidden" data-id="USDT_TRC20" data-address="TXLUKiCFzMsSxyAy6uR5WduCsnYXqXMJ1C" data-name="USDT (TRC-20)" data-badge="USDT TRON (TRC-20)" data-note="请向上述 TRON (TRC-20) 地址转入精确订单金额。转账成功后请复制 TxID 交易哈希进行凭据提交。<br/><span class='text-slate-400'>Please transfer exact USDT to the TRC-20 address above.</span>">
                    <span class="text-[9px] font-black uppercase tracking-widest bg-black/20 px-1.5 py-0.5 rounded-md mb-1 font-mono">POPULAR</span>
                    <span class="text-xs font-black uppercase tracking-wider">USDT</span>
                    <span class="text-[10px] font-bold font-mono">TRC-20 (Tron)</span>
                  </button>

                  <!-- BSC (BEP20) 极低费率 -->
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3 rounded-2xl border border-[#38BDF8]/20 bg-[#0B0F1A] text-white hover:border-[#38BDF8]/50 shadow-md transition active:scale-95 cursor-pointer" data-id="USDT_BEP20" data-address="0x1d6aa81a17701932b09bd45e018af2be5efa53de" data-name="USDT (BEP-20)" data-badge="USDT BSC (BEP-20)" data-note="⚠️ <b>注意：</b>请勿使用 opBNB 链存入 USDT，否则资产不可找回。转账完成后请填写 TxID 交易哈希。<br/><span class='text-slate-400'>BNB Smart Chain (BEP-20) Network. Do NOT use opBNB.</span>">
                    <span class="text-[9px] font-black uppercase tracking-widest text-[#38BDF8] bg-[#0284C7]/20 px-1.5 py-0.5 rounded-md mb-1 font-mono">LOW GAS</span>
                    <span class="text-xs font-black uppercase tracking-wider">USDT</span>
                    <span class="text-[10px] font-bold font-mono text-slate-400">BEP-20 (BSC)</span>
                  </button>

                  <!-- Solana (SOL) 高速链 -->
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3 rounded-2xl border border-[#38BDF8]/20 bg-[#0B0F1A] text-white hover:border-[#38BDF8]/50 shadow-md transition active:scale-95 cursor-pointer" data-id="USDT_SOL" data-address="925egwkSqvQkrGv9aCjJx5TAzcscCu9sAQMrt3VrwKXF" data-name="USDT (Solana)" data-badge="USDT Solana (SOL)" data-note="请向上述 Solana (SOL) 链地址转入精确订单金额。转账完成后填写交易签名/哈希。<br/><span class='text-slate-400'>Solana Network (USDT). Fast confirmation.</span>">
                    <span class="text-[9px] font-black uppercase tracking-widest text-emerald-400 bg-emerald-950/40 px-1.5 py-0.5 rounded-md mb-1 font-mono">FAST</span>
                    <span class="text-xs font-black uppercase tracking-wider">USDT</span>
                    <span class="text-[10px] font-bold font-mono text-slate-400">Solana (SOL)</span>
                  </button>

                  <!-- Ethereum (ERC20) 以太坊 -->
                  <button type="button" class="payment-method-btn flex flex-col items-center justify-center p-3 rounded-2xl border border-[#38BDF8]/20 bg-[#0B0F1A] text-white hover:border-[#38BDF8]/50 shadow-md transition active:scale-95 cursor-pointer" data-id="USDT_ERC20" data-address="0x1d6aa81a17701932b09bd45e018af2be5efa53de" data-name="USDT (ERC-20)" data-badge="USDT Ethereum (ERC-20)" data-note="请向上述 Ethereum (ERC-20) 地址转入精确订单金额。适合大额结算。<br/><span class='text-slate-400'>Ethereum Network (ERC-20). Recommended for high-value orders.</span>">
                    <span class="text-[9px] font-black uppercase tracking-widest text-indigo-300 bg-indigo-950/40 px-1.5 py-0.5 rounded-md mb-1 font-mono">ETH</span>
                    <span class="text-xs font-black uppercase tracking-wider">USDT</span>
                    <span class="text-[10px] font-bold font-mono text-slate-400">ERC-20 (Mainnet)</span>
                  </button>
                </div>
              </div>

              <!-- Payment Method Selection Storage -->
              <input type="hidden" id="hidden-payment-method" name="payment_method" value="USDT (TRC-20)" />

              <!-- CRYPTO DETAILS BOX (高保真专属卡片) -->
              <div id="payment-crypto-container" class="space-y-6">
                <div class="bg-[#0B0F1A] border border-[#38BDF8]/30 rounded-3xl p-6 sm:p-8 space-y-6 shadow-2xl flex flex-col items-center text-center backdrop-blur-xl relative overflow-hidden">
                  
                  <div class="flex items-center justify-between w-full">
                    <span id="payment-badge-label" class="text-xs font-black font-mono text-[#38BDF8] bg-[#0284C7]/20 px-3.5 py-1 rounded-full border border-[#38BDF8]/40 shadow-[0_0_15px_rgba(56,189,248,0.25)]">
                      USDT TRON (TRC-20)
                    </span>
                    <span class="text-[10px] font-mono text-slate-400 flex items-center gap-1.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                      节点在线
                    </span>
                  </div>

                  <!-- Dynamic QR Code -->
                  <div class="relative group">
                    <div class="w-44 h-44 bg-white p-3 rounded-2xl flex items-center justify-center border-2 border-[#38BDF8]/50 shadow-[0_0_30px_rgba(56,189,248,0.25)] group-hover:scale-103 transition-transform duration-300">
                      <img 
                        id="payment-qr-image"
                        src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=TXLUKiCFzMsSxyAy6uR5WduCsnYXqXMJ1C" 
                        alt="Payment QR Code" 
                        class="w-38 h-38 rounded-lg"
                      />
                    </div>
                  </div>

                  <!-- Wallet Address & Copy -->
                  <div class="w-full space-y-3">
                    <div class="flex items-center justify-between text-xs text-slate-400 font-mono">
                      <span>官方充值钱包地址 (点击可直接复制)</span>
                      <span id="copy-status-hint" class="text-[#38BDF8] font-bold"></span>
                    </div>

                    <div 
                      id="crypto-address-text" 
                      class="text-xs sm:text-sm font-mono text-white break-all bg-[#06080F] py-3.5 px-4 rounded-2xl border border-[#38BDF8]/30 select-all cursor-pointer hover:border-[#38BDF8] hover:bg-[#0284C7]/10 transition-all font-bold shadow-inner flex items-center justify-between gap-3 group"
                      title="点击直接复制地址"
                    >
                      <span id="address-display-val">TXLUKiCFzMsSxyAy6uR5WduCsnYXqXMJ1C</span>
                      <button 
                        type="button" 
                        id="copy-crypto-btn"
                        class="p-2 rounded-xl bg-white/5 group-hover:bg-[#0284C7]/30 text-[#38BDF8] shrink-0 transition"
                      >
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                      </button>
                    </div>
                  </div>

                  <!-- Note -->
                  <div id="payment-note-paragraph" class="text-xs text-slate-400 font-sans leading-relaxed border-t border-[#38BDF8]/20 pt-4 w-full text-left bg-white/2 p-3 rounded-xl">
                    请向上述 TRON (TRC-20) 地址转入精确订单金额。转账成功后请复制 TxID 交易哈希进行凭据提交。<br/>
                    <span class="text-slate-500">Please transfer exact USDT to the TRC-20 address above.</span>
                  </div>
                </div>

                <!-- 其他链付款通道提示栏 (如客户有其他链付款请联系客服付款) -->
                <div class="p-4 rounded-2xl bg-gradient-to-r from-[#0B0F1A] to-[#06080F] border border-[#38BDF8]/30 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-lg">
                  <div class="flex items-center gap-3 text-left">
                    <div class="w-9 h-9 rounded-xl bg-[#0284C7]/20 border border-[#38BDF8]/40 text-[#38BDF8] flex items-center justify-center shrink-0">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    </div>
                    <div>
                      <h5 class="text-xs font-bold text-white">其他网络与币种结算？</h5>
                      <p class="text-[11px] text-slate-400">如需使用 Polygon、Arbitrum、USDC 或其他链付款，请联系专席客服处理。</p>
                    </div>
                  </div>
                  <a 
                    href="https://t.me/puppyshop2Bot" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="px-4 py-2 rounded-xl bg-[#0284C7]/30 hover:bg-[#38BDF8] hover:text-[#06080F] text-[#38BDF8] border border-[#38BDF8]/50 text-xs font-bold transition flex items-center gap-2 shrink-0 cursor-pointer active:scale-95"
                  >
                    <span>联系专席客服</span>
                    <span>→</span>
                  </a>
                </div>

                <!-- Proof input -->
                <div id="txid-input-container" class="space-y-2 text-left">
                  <div class="flex items-center justify-between">
                    <label for="txid" class="block text-xs uppercase text-slate-300 font-bold tracking-wider font-mono">
                      转账交易哈希 / Transaction Hash (TxID) <span class="text-[#38BDF8]">*</span>
                    </label>
                    <span class="text-[10px] text-slate-500 font-mono">区块链唯一支付凭据</span>
                  </div>
                  <input 
                    type="text" 
                    id="txid" 
                    name="txid" 
                    required 
                    placeholder="请输入区块链转账成功后的 TxID 交易哈希 (例如: f89a7b...)"
                    class="w-full bg-[#06080F] border border-[#38BDF8]/30 rounded-2xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-[#38BDF8] focus:ring-2 focus:ring-[#38BDF8]/30 transition font-mono text-xs shadow-inner"
                  />
                  <p class="text-[10px] text-slate-400 font-sans leading-normal">
                    请填写您在钱包或交易所转账成功后生成的交易哈希 (TxID / Hash)，系统将自动匹配订单并在 5~15 分钟内完成卡密派发。
                  </p>
                </div>
              </div>

            <!-- Validation Error Alert (Hidden by default) -->
            <div id="error-message" class="hidden p-4 rounded-xl border border-red-900 bg-red-950/20 text-red-400 text-sm font-semibold font-sora">
              Something went wrong. Please verify the required inputs.
            </div>

            <!-- Submit Button -->
            <button 
              type="submit"
              id="submit-order-btn"
              class="w-full py-4 rounded-xl bg-[#38BDF8] border border-[#0284C7] text-[#080808] hover:bg-[#0284C7] font-bold uppercase tracking-wider text-sm font-sora transition-all duration-300 shadow-lg active:scale-[0.99] cursor-pointer"
            >
              确认并提交订单 / 链上核验并确认订单
            </button>
          </form>
        </div>
 
        <!-- Right Side: Order Summary -->
        <div class="lg:col-span-5">
          <div class="glass-card p-8 rounded-[2rem] border border-[#38BDF8]/20 bg-[#1C1917]/50 backdrop-blur-xl space-y-6 sticky top-28">
            <h3 class="text-lg font-bold font-sora text-white border-b border-[#38BDF8]/20 pb-3">订单汇总 / 订单汇总 / Order Summary</h3>
            
            <!-- Items list -->
            <div id="checkout-summary-list" class="space-y-4 max-h-[300px] overflow-y-auto pr-2">
              <!-- JS renders list items here -->
            </div>
 
            <!-- Price Breakdown -->
            <div class="pt-6 border-t border-[#38BDF8]/20 space-y-2 text-sm text-zinc-400 font-sora font-semibold">
              <div class="flex justify-between">
                <span>商品小计 / Subtotal</span>
                <span id="checkout-subtotal" class="text-white font-sora">$0.00</span>
              </div>
              <div class="flex justify-between">
                <span>配送方式 / Delivery</span>
                <span class="text-[#38BDF8] font-bold uppercase tracking-wider text-xs">自动发货 / 自动发货 / Auto Delivery</span>
              </div>
              <div class="flex justify-between text-[#38BDF8] font-bold font-sora text-xl pt-4 border-t border-[#38BDF8]/20">
                <span>实付总额 / Grand Total</span>
                <span id="checkout-grand-total">$0.00</span>
              </div>
            </div>
          </div>
        </div>

      </div>

                  <!-- SUCCESS SCREEN: 链上核实成功与卡密一键复制面板 (0 Emoji) -->
      <div id="checkout-success-view" class="hidden max-w-xl mx-auto text-center py-12 px-6 sm:px-8 space-y-7 glass-card border border-[#38BDF8]/40 rounded-[2.5rem] bg-[#0B0F1A]/95 backdrop-blur-2xl text-white shadow-[0_25px_60px_rgba(0,0,0,0.9)] animate-fadeIn">
        
        <!-- 灵压核验通过徽章 -->
        <div class="relative w-20 h-20 mx-auto flex items-center justify-center">
          <div class="absolute inset-0 rounded-full bg-[#0284C7]/30 blur-xl animate-pulse"></div>
          <div class="relative w-18 h-18 rounded-full bg-gradient-to-tr from-[#0284C7] to-[#38BDF8] border-2 border-[#38BDF8] flex items-center justify-center text-[#06080F] shadow-[0_0_30px_rgba(56,189,248,0.5)]">
            <svg class="w-9 h-9 text-[#06080F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
        </div>

        <div class="space-y-2.5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#0284C7]/20 border border-[#38BDF8]/40 text-[#38BDF8] text-xs font-bold font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
            <span>ON-CHAIN VERIFIED • 链上确认成功</span>
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            支付成功 • 卡密已派发
          </h2>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed max-w-md mx-auto">
            区块链转账确认已通过！您的专属数字商品卡密凭据如下，请妥善保管。
          </p>
        </div>

        <!-- 卡密专区：醒目展示与一键复制 -->
        <div class="p-5 rounded-2xl bg-[#06080F] border border-[#38BDF8]/40 text-left space-y-3 shadow-inner relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-black text-[#38BDF8] flex items-center gap-2">
              <svg class="w-4 h-4 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
              </svg>
              <span>数字商品卡密凭证 (CREDENTIALS)</span>
            </span>
            <span id="copy-cardkey-hint" class="text-[11px] font-bold text-emerald-400 font-mono"></span>
          </div>

          <!-- 动态卡密内容 -->
          <div 
            id="checkout-card-key-display" 
            class="p-3.5 bg-[#0B0F1A] border border-[#38BDF8]/30 rounded-xl font-mono text-xs sm:text-sm text-[#38BDF8] break-all select-all font-bold tracking-wide leading-relaxed shadow-sm"
          >
            正在为您提取专属授权卡密...
          </div>

          <!-- 一键复制卡密核心操作按钮 -->
          <button 
            type="button" 
            id="copy-final-key-btn"
            class="w-full py-3 rounded-xl bg-gradient-to-r from-[#0284C7] to-[#38BDF8] hover:brightness-115 text-white font-extrabold text-xs tracking-wider uppercase transition-all duration-200 shadow-[0_0_20px_rgba(56,189,248,0.4)] flex items-center justify-center gap-2 cursor-pointer active:scale-98"
          >
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
            <span id="copy-btn-text">一键复制卡密凭据</span>
          </button>
        </div>

        <!-- 订单参数卡 -->
        <div class="p-4 rounded-2xl bg-[#06080F]/70 border border-[#38BDF8]/20 space-y-1.5 text-left font-mono text-xs text-slate-400">
          <div class="flex justify-between items-center">
            <span>订单编号:</span>
            <span id="checkout-reference-id" class="text-white font-bold select-all"></span>
          </div>
          <div class="flex justify-between items-center">
            <span>交付保障:</span>
            <span class="text-emerald-400 font-bold">已写入安全订单库 (可凭邮箱随时查单)</span>
          </div>
        </div>

        <div class="pt-1 flex flex-col sm:flex-row gap-3 justify-center">
          <a 
            href="/query" 
            class="px-5 py-3 rounded-xl bg-white/5 border border-white/15 text-slate-200 hover:text-white hover:bg-white/10 font-bold text-xs uppercase tracking-wider transition active:scale-95 text-center flex items-center justify-center gap-1.5"
          >
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span>进入订单库查看全部记录</span>
          </a>
          <a 
            href="/" 
            class="px-5 py-3 rounded-xl bg-white/5 border border-white/15 text-slate-200 hover:text-white hover:bg-white/10 font-bold text-xs uppercase tracking-wider transition active:scale-95 text-center"
          >
            返回商城首页
          </a>
        </div>
      </div>

    </div>
  </div>

</BaseLayout>

<script>
  import { 
    authInstance, 
    dbInstance, 
    collection, 
    addDoc, 
    onAuthStateChanged,
    doc,
    getDoc,
    setDoc
  } from '../lib/firebase.js';

  // Checkout flow Logic
  let cart = [];
  let userBalanceUsd = 0;

  // Returns 'cny' for CJK languages, 'usd' for everything else
  function getCurrencyMode(): 'cny' | 'usd' {
    const lang = localStorage.getItem('active_language') || 'en';
    return ['zh-CN', 'zh-TW', 'ja', 'ko'].includes(lang) ? 'cny' : 'usd';
  }

  let currentUserUid = 'guest';
  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-message');
  const submitBtn = document.getElementById('submit-order-btn') as HTMLButtonElement;

  // Payment Selection Selector Elements
  const hiddenPaymentMethod = document.getElementById('hidden-payment-method') as HTMLInputElement;
  const paymentButtons = document.querySelectorAll('.payment-method-btn');
  const badgeLabel = document.getElementById('payment-badge-label');
  const qrImage = document.getElementById('payment-qr-image') as HTMLImageElement;
  const noteParagraph = document.getElementById('payment-note-paragraph');
  const txidInputContainer = document.getElementById('txid-input-container');
  const paymentCryptoContainer = document.getElementById('payment-crypto-container');

  // Form Fields
  const inputTxID = document.getElementById('txid') as HTMLInputElement;

  let currentUserDisplayName = '';

  // Watch Authentication State to auto-fill
  onAuthStateChanged(authInstance, async (user) => {
    if (user) {
      currentUserUid = user.uid;
      currentUserDisplayName = user.displayName || '';
      const emailField = document.getElementById('email') as HTMLInputElement;
      if (emailField && !emailField.value) {
        emailField.value = user.email || '';
      }

      // Fetch user wallet balance
      try {
        const userDocRef = doc(dbInstance, 'users', user.uid);
        const userDocSnap = await getDoc(userDocRef);
        if (userDocSnap.exists()) {
          userBalanceUsd = userDocSnap.data()?.balance_usd || 0;
        }
        updateBalancePaymentOption();
      } catch (err) {
      }
    }
  });

  // Load and check cart
  function checkCart() {
    let savedCart = localStorage.getItem('cart');
    if (!savedCart) savedCart = localStorage.getItem('boutique_cart');
    if (savedCart) {
      try {
        cart = JSON.parse(savedCart);
      } catch (e) {
        cart = [];
      }
    }

    if (cart.length === 0) {
      // Redirect empty cart
      window.location.href = '/';
      return;
    }

    renderCheckout();
  }

  // Render Page Content
  function renderCheckout() {
    const listContainer = document.getElementById('checkout-summary-list');
    const subtotalText = document.getElementById('checkout-subtotal');
    const grandtotalText = document.getElementById('checkout-grand-total');
    const shippingSection = document.getElementById('shipping-address-section');

    const addressInputs = shippingSection?.querySelectorAll('input');

    if (!listContainer || !subtotalText || !grandtotalText) return;

    // Force hide shipping section & remove required attributes under all conditions
    if (shippingSection) shippingSection.style.display = 'none';
    addressInputs?.forEach(input => {
      input.removeAttribute('required');
    });

    const mode = getCurrencyMode();

    // Render list
    listContainer.innerHTML = cart.map(item => {
      const itemUsd = item.price * item.quantity;
      const itemCny = Math.round(itemUsd * 6.8);
      const priceText = mode === 'cny'
        ? `¥${itemCny} CNY`
        : `$${itemUsd.toFixed(2)}`;
      const secondaryPriceText = mode === 'cny'
        ? `$${itemUsd.toFixed(2)} USD`
        : `¥${itemCny} CNY`;

      return `
        <div class="flex items-center justify-between text-sm py-2 border-b border-[#38BDF8]/20">
          <div class="min-w-0 pr-4">
            <span class="text-white font-bold block truncate font-sora">${item.name}</span>
            <span class="text-zinc-400 text-xs font-sans">${item.type === 'physical' ? `Size: ${item.size} × ${item.quantity}` : `Digital × ${item.quantity}`}</span>
          </div>
          <div class="flex flex-col items-end text-right shrink-0">
            <span class="text-[#38BDF8] font-sora font-bold">${priceText}</span>
            <span class="text-[9px] text-zinc-550 font-sans font-bold">${secondaryPriceText}</span>
          </div>
        </div>
      `;
    }).join('');

    const totalCost = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    const totalCostCny = Math.round(totalCost * 6.8);

    if (mode === 'cny') {
      subtotalText.innerHTML = `¥${totalCostCny} <span class="text-xs text-zinc-400 font-sans font-normal">($${totalCost.toFixed(2)} USD)</span>`;
      grandtotalText.innerHTML = `¥${totalCostCny} <span class="text-xs text-zinc-400 font-sans font-normal">($${totalCost.toFixed(2)} USD)</span>`;
    } else {
      subtotalText.innerHTML = `$${totalCost.toFixed(2)} <span class="text-xs text-zinc-400 font-sans font-normal">(¥${totalCostCny} CNY)</span>`;
      grandtotalText.innerHTML = `$${totalCost.toFixed(2)} <span class="text-xs text-zinc-400 font-sans font-normal">(¥${totalCostCny} CNY)</span>`;
    }

    // Set hidden inputs for form payload
    const cartSummaryString = cart.map(item => `${item.quantity}x ${item.name}${item.size ? ` (${item.size})` : ''}`).join(', ');
    const hiddenCartData = document.getElementById('hidden-cart-data') as HTMLInputElement;
    const hiddenTotalPrice = document.getElementById('hidden-total-price') as HTMLInputElement;

    if (hiddenCartData) hiddenCartData.value = cartSummaryString;
    if (hiddenTotalPrice) {
      hiddenTotalPrice.value = mode === 'cny'
        ? `¥${totalCostCny} CNY ($${totalCost.toFixed(2)} USD)`
        : `$${totalCost.toFixed(2)} USD (¥${totalCostCny} CNY)`;
    }

    updateBalancePaymentOption();
  }

  function updateBalancePaymentOption() {
    const balanceBtn = document.getElementById('pay-method-balance');
    const balanceSpan = document.getElementById('checkout-wallet-balance');
    const totalCost = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    
    if (balanceBtn && balanceSpan) {
      balanceSpan.textContent = userBalanceUsd.toFixed(2);
      if (currentUserUid !== 'guest' && userBalanceUsd >= totalCost) {
        balanceBtn.classList.remove('hidden');
      } else {
        balanceBtn.classList.add('hidden');
      }
    }
  }

  // Direct Click-to-copy for the crypto address text block
  const cryptoAddressText = document.getElementById('crypto-address-text');
  const copyHint = document.getElementById('copy-status-hint');
  const addressSpan = document.getElementById('address-display-val');

  function copyAddress() {
    const text = addressSpan?.textContent?.trim() || cryptoAddressText?.textContent?.trim() || '';
    navigator.clipboard.writeText(text).then(() => {
      if (copyHint) copyHint.textContent = '已复制到剪贴板 ✓';
      cryptoAddressText?.classList.add('border-emerald-400', 'bg-emerald-950/20');
      setTimeout(() => {
        if (copyHint) copyHint.textContent = '';
        cryptoAddressText?.classList.remove('border-emerald-400', 'bg-emerald-950/20');
      }, 1800);
    });
  }

  cryptoAddressText?.addEventListener('click', copyAddress);
  document.getElementById('copy-crypto-btn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    copyAddress();
  });

  // Handle switching payment networks
  paymentButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Remove active classes from all buttons
      paymentButtons.forEach(b => {
        b.classList.remove('bg-[#38BDF8]', 'border-[#0284C7]', 'text-[#080808]');
        b.classList.add('bg-transparent', 'border-[#38BDF8]/20', 'text-white');
      });

      // Add active classes to selected button
      btn.classList.remove('bg-transparent', 'border-[#38BDF8]/20', 'text-white');
      btn.classList.add('bg-[#38BDF8]', 'border-[#0284C7]', 'text-[#080808]');

      // Fetch network attributes
      const name = btn.getAttribute('data-name') || '';
      const address = btn.getAttribute('data-address') || '';
      const badge = btn.getAttribute('data-badge') || '';
      const note = btn.getAttribute('data-note') || '';
      const id = btn.getAttribute('data-id') || '';

      if (id === 'BALANCE') {
        paymentCryptoContainer?.classList.add('hidden');
        txidInputContainer?.classList.add('hidden');
        inputTxID.removeAttribute('required');
      } else {
        paymentCryptoContainer?.classList.remove('hidden');
        txidInputContainer?.classList.remove('hidden');
        inputTxID.setAttribute('required', 'true');
        
        // Update inputs & display text
        if (badgeLabel) badgeLabel.textContent = badge;
        if (addressSpan) addressSpan.textContent = address; else if (cryptoAddressText) cryptoAddressText.textContent = address;
        if (qrImage) {
          qrImage.src = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(address)}`;
        }
        if (noteParagraph) {
          noteParagraph.innerHTML = note;
        }
      }

      // Update inputs & display text
      if (hiddenPaymentMethod) hiddenPaymentMethod.value = name;
    });
  });

  // Submit flow
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg?.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting Verification...';

    const formData = new FormData(form);

    try {
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const paymentMethod = hiddenPaymentMethod.value;
      
      const isBalancePayment = paymentMethod.includes("余额");
      const txIdVal = isBalancePayment ? "Wallet-Deducted" : inputTxID.value;
      
      const totalUsd = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      const totalCny = Math.round(totalUsd * 6.8);

      if (isBalancePayment) {
        if (currentUserUid === 'guest') {
          throw new Error("请先登录会员账号再进行余额支付。 / Please log in first.");
        }
        
        // Fetch latest balance from DB
        const userDocRef = doc(dbInstance, 'users', currentUserUid);
        const userDocSnap = await getDoc(userDocRef);
        let latestBalanceUsd = 0;
        if (userDocSnap.exists()) {
          latestBalanceUsd = userDocSnap.data()?.balance_usd || 0;
        }
        if (latestBalanceUsd < totalUsd) {
          throw new Error("余额不足，请先充值或切换支付方式。 / Insufficient wallet balance.");
        }

        // Deduct balance
        const newBalanceUsd = latestBalanceUsd - totalUsd;
        await setDoc(userDocRef, {
          balance_usd: newBalanceUsd,
          email: email
        });
      }

      const orderData = {
        uid: currentUserUid,
        username: currentUserDisplayName || email.split('@')[0],
        email,
        items: cart.map(item => ({
          id: item.id,
          name: item.name,
          price: item.price,
          type: item.type,
          size: item.size || null,
          quantity: item.quantity,
          image: item.image
        })),
        paymentMethod: paymentMethod,
        txId: txIdVal,
        totalUsd,
        totalCny,
        status: isBalancePayment ? 'paid' : 'pending',
        createdAt: new Date().toISOString()
      };

      // 1. Create order document in database
      // ==========================================
      // 1. 触发服务端真实区块链链上转账核实
      // ==========================================
      if (!isBalancePayment) {
        submitBtn.textContent = '正在核验链上转账凭据 (On-Chain Checking)...';
        const verifyRes = await fetch('/api/verify-payment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            orderId: 'TEMP-' + Date.now(),
            email: email,
            txid: txIdVal,
            paymentMethod: paymentMethod,
            totalUsd: totalUsd,
            totalCny: totalCny,
            targetAddress: hiddenPaymentMethod.getAttribute('data-address') || ''
          })
        });

        const verifyData = await verifyRes.json();
        if (!verifyRes.ok || !verifyData.success) {
          throw new Error(verifyData.message || '链上核实未通过：未能检测到有效转账，请确认 TxID 后重试。');
        }
      }

      // ==========================================
      // 2. 链上核实通过 -> 写入数据库
      // ==========================================
      const orderRef = await addDoc(collection(dbInstance, 'orders'), orderData);
      const orderId = orderRef.id;

      // 1.5 Push order alert to Telegram Bot
      try {
        await fetch('/api/order-notify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            orderId: orderId,
            totalUsd: totalUsd,
            totalCny: totalCny,
            paymentMethod: orderData.paymentMethod,
            createdAt: orderData.createdAt,
            username: orderData.username
          })
        });
      } catch (err) {
        console.error("Failed to trigger Telegram order alert:", err);
      }

      // 2. Append database Order ID to the Web3Forms payload for email indexing
      formData.append('database_order_id', orderId);

      // 3. Submit notification via Web3Forms API
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });

      const result = await response.json();

      if (result.success) {
        // Clear cart
        localStorage.removeItem('cart'); localStorage.removeItem('boutique_cart');
        
                // Show success screen & render Card Key
        const refId = document.getElementById('checkout-reference-id');
        if (refId) refId.textContent = orderId;

        // 生成或派发专属卡密内容
        const cardKeyBox = document.getElementById('checkout-card-key-display');
        const copyKeyBtn = document.getElementById('copy-final-key-btn');
        const copyHint = document.getElementById('copy-cardkey-hint');
        const copyBtnText = document.getElementById('copy-btn-text');

        const cardKeyPayload = "SOUL-SOCIETY-" + orderId + "-" + Math.random().toString(36).substring(2, 8).toUpperCase();
        if (cardKeyBox) {
          cardKeyBox.textContent = cardKeyPayload;
        }

        if (copyKeyBtn) {
          copyKeyBtn.onclick = () => {
            navigator.clipboard.writeText(cardKeyPayload).then(() => {
              if (copyHint) copyHint.textContent = "已成功复制到剪贴板 ✓";
              if (copyBtnText) copyBtnText.textContent = "卡密已复制 ✓";
              copyKeyBtn.classList.add('brightness-125');
              setTimeout(() => {
                if (copyHint) copyHint.textContent = "";
                if (copyBtnText) copyBtnText.textContent = "一键复制卡密凭据";
                copyKeyBtn.classList.remove('brightness-125');
              }, 2000);
            });
          };
        }

        document.getElementById('checkout-main-grid')?.classList.add('hidden');
        document.getElementById('checkout-success-view')?.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        throw new Error(result.message || 'Form submission failed');
      }
    } catch (err: any) {
      console.error(err);
      if (errorMsg) {
        errorMsg.classList.remove('hidden');
        errorMsg.textContent = err.message || 'Submission error. Please verify database connection or checkout keys.';
      }
      submitBtn.disabled = false;
      submitBtn.textContent = 'Verify & Complete Order';
    }
  });

  // Run on load
  checkCart();
</script>
