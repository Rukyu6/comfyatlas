---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CartDrawer from '../../components/CartDrawer.astro';

// Dynamic route paths generator for all 716 products
export async function getStaticPaths() {
  const data = (await import('../../data/products.json')).default;
  return data.products.map((p) => {
    const cleanId = p.id.replace('pid_', '');
    return {
      params: { id: cleanId },
      props: { product: p }
    };
  });
}

const { product } = Astro.props;
const cleanId = product.id.replace('pid_', '');
---
<BaseLayout 
  title={`${product.name} — Digital Account Vault`} 
  description={`Purchase ${product.name} from Puppy Shop. Safe delivery, manual blockchain validation, premium digital account vault.`}
>
  <!-- Global navigation Header -->
  <Header />

  <!-- Hidden context element to pass server-side product data to client script safely -->
  <div id="product-page-context" class="hidden" data-product={JSON.stringify(product)}></div>

  <div class="relative min-h-screen pt-28 pb-16 overflow-hidden bg-[#FFFDF9] text-[#3E2A1E]">
    <!-- Ambient Background Glows -->
    <div class="absolute top-1/4 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-[#FFD6E0]/20 rounded-full filter blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 translate-x-1/2 translate-y-1/2 w-[400px] h-[400px] bg-indigo-200/20 rounded-full filter blur-[100px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 mb-8 relative z-10">
      <a 
        href="/#digital" 
        class="inline-flex items-center gap-2 text-[#6D5A50] hover:text-[#FF6B8B] font-quicksand text-sm font-bold transition-colors group"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to digital vault
      </a>
    </div>

    <!-- Product Grid Content -->
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 relative z-10">
      
      <!-- Left Side: Product Image & Buying Panel -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Premium Product Panel -->
        <div class="glass-card p-6 md:p-8 rounded-[2rem] border-3 border-[#3E2A1E] shadow-[4px_4px_0px_#3E2A1E] bg-white relative space-y-6">
          
          <!-- Category & Title -->
          <div>
            <span class="px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-full bg-[#D6E4FF] text-indigo-600 border border-indigo-200 font-quicksand">
              {product.category}
            </span>
            <h1 class="text-2xl md:text-3xl font-bold font-fredoka text-[#3E2A1E] tracking-tight leading-tight mt-4">
              {product.name}
            </h1>
            <div class="flex items-center gap-4 mt-3 font-quicksand font-bold">
              <span class="text-xs text-[#6D5A50]">ID: {cleanId}</span>
              <span id="product-stock-badge" class="text-[10px] font-bold uppercase tracking-wider bg-[#F0E6DF] text-[#6D5A50] px-2 py-0.5 rounded-lg border border-[#3E2A1E]">
                Stock: {product.stock}
              </span>
            </div>
          </div>

          <!-- SKU Selection Grid -->
          <div class="space-y-3">
            <span class="text-xs uppercase text-[#6D5A50] tracking-wider font-bold font-quicksand block">Select Option / Package</span>
            <div class="grid grid-cols-1 gap-3" id="sku-options-container">
              <!-- Dynamically generated via JS -->
            </div>
          </div>

          <!-- Quantity Selector -->
          <div class="flex items-center justify-between bg-[#FFFDF9] p-4 rounded-2xl border-2 border-[#3E2A1E]">
            <div>
              <span class="text-sm font-bold text-[#3E2A1E] block font-fredoka">Quantity</span>
              <span id="sku-stock-display" class="text-xs text-[#6D5A50] font-quicksand font-semibold">In stock: -</span>
            </div>
            <div class="flex items-center border border-[#3E2A1E] rounded-xl overflow-hidden bg-white text-sm font-fredoka font-bold">
              <button type="button" id="qty-minus" class="px-4 py-2 hover:bg-[#FFD6E0]/20 text-[#3E2A1E] font-bold select-none">-</button>
              <input type="number" id="qty-input" class="w-12 text-center bg-transparent border-none text-[#3E2A1E] focus:outline-none" value="1" min="1" readonly />
              <button type="button" id="qty-plus" class="px-4 py-2 hover:bg-[#FFD6E0]/20 text-[#3E2A1E] font-bold select-none">+</button>
            </div>
          </div>

          <!-- Total price & Purchase Button -->
          <div class="pt-6 border-t-2 border-[#E8E1D9] flex items-center justify-between gap-4">
            <div class="flex flex-col">
              <span class="text-xs text-[#6D5A50] uppercase font-bold font-quicksand">Total price</span>
              <div class="flex items-baseline gap-2">
                <span id="total-usd" class="text-3xl font-bold text-[#FF6B8B] font-fredoka">$0.00</span>
                <span id="total-cny" class="text-xs text-[#6D5A50] font-quicksand font-bold">¥0 CNY</span>
              </div>
            </div>
            <button 
              id="add-to-bag-btn" 
              type="button" 
              class="flex-grow sm:flex-grow-0 px-8 py-4 rounded-xl bg-[#FFD6E0] border-2 border-[#3E2A1E] text-[#3E2A1E] hover:bg-[#FFB3C6] font-bold uppercase tracking-wider text-sm font-fredoka transition-all duration-300 shadow-[2px_2px_0px_#3E2A1E] active:scale-95 flex items-center justify-center gap-2"
            >
              Add to Bag 🐾
            </button>
          </div>

        </div>

      </div>

      <!-- Right Side: Rich Description tab -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Product Details Display -->
        <div class="glass-card p-6 md:p-10 rounded-[2rem] border-3 border-[#3E2A1E] shadow-[4px_4px_0px_#3E2A1E] bg-white relative min-h-[400px]">
          <h2 class="text-sm font-bold text-[#3E2A1E] font-fredoka border-b-2 border-[#E8E1D9] pb-3 mb-6">
            Product Details & Instructions
          </h2>
          <div class="text-[#3E2A1E] leading-relaxed space-y-4 select-text prose-dark text-sm max-w-none break-words" id="product-description-content">
            <Fragment set:html={product.introduce || '<p class="text-[#6D5A50] italic">No instructions or description details are available for this product.</p>'} />
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- Global shopping cart slide-over -->
  <CartDrawer />

  <!-- Global Footer -->
  <Footer />
</BaseLayout>

<script>
  let product = null;
  let selectedSku = null;
  let selectedQuantity = 1;

  // DOM elements
  const skuContainer = document.getElementById('sku-options-container');
  const qtyInput = document.getElementById('qty-input') as HTMLInputElement;
  const qtyMinus = document.getElementById('qty-minus');
  const qtyPlus = document.getElementById('qty-plus');
  const totalUsd = document.getElementById('total-usd');
  const totalCny = document.getElementById('total-cny');
  const stockDisplay = document.getElementById('sku-stock-display');
  const stockBadge = document.getElementById('product-stock-badge');
  const addToBagBtn = document.getElementById('add-to-bag-btn');

  // Returns 'cny' for CJK languages, 'usd' for everything else
  function getCurrencyMode(): 'cny' | 'usd' {
    const lang = localStorage.getItem('active_language') || 'en';
    return ['zh-CN', 'zh-TW', 'ja', 'ko'].includes(lang) ? 'cny' : 'usd';
  }

  function initPage() {
    const contextEl = document.getElementById('product-page-context');
    if (!contextEl) return;

    try {
      product = JSON.parse(contextEl.getAttribute('data-product') || '{}');
    } catch (e) {
      console.error('Failed to parse product data', e);
      return;
    }

    if (!product) return;

    // Load SKUs list
    const skusList = getSkusList();

    // Render SKU options
    renderSkus();

    // Auto-select first active SKU
    if (skuContainer) {
      const availableBtns = skuContainer.querySelectorAll('.sku-select-btn');
      if (availableBtns.length > 0) {
        const firstIdx = parseInt(availableBtns[0].getAttribute('data-sku-index') || '0');
        selectSku(skusList[firstIdx]);
      }
    }

    // Hook quantity handlers
    qtyMinus?.addEventListener('click', () => {
      if (selectedQuantity > 1) {
        selectedQuantity -= 1;
        updateQtyDisplay();
      }
    });

    qtyPlus?.addEventListener('click', () => {
      let maxStock = 9999;
      if (selectedSku && !isNaN(parseInt(selectedSku.stock))) {
        maxStock = parseInt(selectedSku.stock);
      }
      if (selectedQuantity < maxStock) {
        selectedQuantity += 1;
        updateQtyDisplay();
      }
    });

    // Add to cart click
    addToBagBtn?.addEventListener('click', () => {
      if (!product || !selectedSku) return;

      const size = selectedSku.name !== 'Default Option' ? selectedSku.name : '';
      const cartItemId = `${product.id}_${selectedSku.id}`;

      window.dispatchEvent(new CustomEvent('cart:add', {
        detail: {
          cartItemId,
          id: product.id,
          name: product.name,
          price: selectedSku.price_usd,
          image: selectedSku.picture || product.image,
          type: 'digital',
          size: size,
          quantity: selectedQuantity
        }
      }));
    });
  }

  function getSkusList() {
    if (!product) return [];
    let list = product.skus || [];
    if (list.length === 0) {
      list = [{
        id: 'sku_default',
        name: 'Default Option',
        price_cny: product.price_cny,
        price_usd: product.price_usd,
        stock: product.stock,
        picture: product.image
      }];
    }
    return list;
  }

  function renderSkus() {
    if (!skuContainer || !product) return;
    const skusList = getSkusList();
    const mode = getCurrencyMode();

    skuContainer.innerHTML = skusList.map((sku, index) => {
      const isOutOfStock = sku.stock === '0' || sku.stock === '缺货';
      const isSelected = selectedSku && selectedSku.id === sku.id;
      const priceLabel = mode === 'cny'
        ? `¥${sku.price_cny} CNY`
        : `$${sku.price_usd.toFixed(2)}`;
      const secondaryPriceLabel = mode === 'cny'
        ? `$${sku.price_usd.toFixed(2)} USD`
        : `¥${sku.price_cny} CNY`;

      return `
        <button
          type="button"
          class="sku-select-btn p-4 rounded-2xl border-2 text-left flex flex-col justify-between transition-all duration-300 font-fredoka group ${
            isOutOfStock 
              ? 'opacity-40 pointer-events-none border-[#E8E1D9] bg-zinc-100' 
              : isSelected
                ? 'bg-[#FFD6E0] border-[#3E2A1E] shadow-[2px_2px_0px_#3E2A1E]'
                : 'border-[#3E2A1E] bg-white hover:bg-[#FFD6E0]/20'
          }"
          data-sku-index="${index}"
        >
          <span class="text-sm font-bold text-[#3E2A1E] group-hover:text-[#FF6B8B] transition-colors leading-tight mb-2">${sku.name}</span>
          <div class="flex items-baseline justify-between w-full mt-auto font-quicksand font-bold gap-2 flex-wrap">
            <div class="flex items-baseline gap-1.5 flex-wrap">
              <span class="text-xs text-[#FF6B8B]">${priceLabel}</span>
              <span class="text-[9px] text-[#6D5A50] font-medium">${secondaryPriceLabel}</span>
            </div>
            <span class="text-[9px] text-[#6D5A50]">Stock: ${sku.stock}</span>
          </div>
        </button>
      `;
    }).join('');

    // Hook click listeners
    const btnElements = skuContainer.querySelectorAll('.sku-select-btn');
    btnElements.forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-sku-index') || '0');
        selectSku(skusList[idx]);
      });
    });
  }

  function selectSku(sku) {
    selectedSku = sku;
    
    // Highlight the selected option button and redraw list
    renderSkus();

    // Update Stock Display
    if (stockDisplay) stockDisplay.textContent = `In stock: ${sku.stock}`;
    if (stockBadge) stockBadge.textContent = `Stock: ${sku.stock}`;

    updateQtyDisplay();
  }

  function updateQtyDisplay() {
    if (qtyInput) qtyInput.value = selectedQuantity.toString();
    if (!selectedSku || !totalUsd || !totalCny) return;

    const usdPrice = selectedSku.price_usd * selectedQuantity;
    const cnyPrice = selectedSku.price_cny * selectedQuantity;
    const mode = getCurrencyMode();

    if (mode === 'cny') {
      totalUsd.textContent = `¥${cnyPrice.toFixed(0)} CNY`;
      totalCny.textContent = `$${usdPrice.toFixed(2)} USD`;
    } else {
      totalUsd.textContent = `$${usdPrice.toFixed(2)}`;
      totalCny.textContent = `¥${cnyPrice.toFixed(0)} CNY`;
    }
  }

  // Listen for language switcher changes to update display instantly
  window.addEventListener('language:change', () => {
    renderSkus();
    updateQtyDisplay();
  });

  initPage();
</script>
