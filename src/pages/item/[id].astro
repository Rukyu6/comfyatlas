---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CartDrawer from '../../components/CartDrawer.astro';

export async function getStaticPaths() {
  const data = (await import('../../data/products.json')).default;
  return data.products.map((p) => {
    const cleanId = p.id.replace('pid_', '');
    return {
      params: { id: cleanId },
      props: { product: p }
    };
  });
}

const { product } = Astro.props;
const cleanId = product.id.replace('pid_', '');

// 深度净化商品原始 HTML：剥离全部外部链接、发卡网字眼、微信号/QQ号及刺眼色块
const rawIntroduce = product.introduce || '';
let cleanIntroduce = rawIntroduce
  .replace(/<a\s+[^>]*href=["'][^"']*["'][^>]*>(.*?)<\/a>/gi, '$1')
  .replace(/https?:\/\/[^\s<"'>]+/gi, '')
  .replace(/(chuhai91(\.(cc|store))?|aisub(\.(vip))?|aiee(\.(fun))?|quickplus(\.(vip))?|某某发卡网|发卡网|一手货源|拿货价|渠道价|代运营|接码平台)/gi, '')
  .replace(/(微信|微信号|vx|v信|QQ|扣扣|tg群|电报群|联系客服[：:])\s*[:：]?\s*[a-zA-Z0-9_\-\.\+]{4,25}/gi, '')
  .replace(/background(-color)?:\s*(#fff(fff)?|rgb\(255,\s*255,\s*255\)|white)[^;"]*;?/gi, '')
  .replace(/color:\s*(#243042|#000|#333|black)[^;"]*;?/gi, '')
  .replace(/📦|✅|⭐️|🔥|⚡|🐾|💎|🗡️|👑|💰/g, '')
  .trim();
---

<BaseLayout 
  title={`${product.name.replace(/【渠道\d+】/g, "").replace(/【凭证充足】/g, "").replace(/--24小时自助充值plus会员/g, "").replace(/-24小时自助充值pro会员/g, "").trim()} — Soul Society`} 
  description={`在 Soul Society 平台购买 ${product.name.replace(/【渠道\d+】/g, "").replace(/【凭证充足】/g, "").replace(/--24小时自助充值plus会员/g, "").replace(/-24小时自助充值pro会员/g, "").trim()}，独享质保，秒级自动发卡。`}
>
  <Header />

  <!-- 背景光晕 -->
  <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gradient-to-b from-[#0284C7]/20 via-[#38BDF8]/10 to-transparent rounded-full filter blur-[140px] pointer-events-none z-0"></div>

  <div id="product-page-context" class="hidden" data-product={JSON.stringify(product)}></div>

  <div class="relative min-h-screen pt-28 pb-16 overflow-hidden bg-[#06080F] text-white font-outfit">
    
    <!-- 返回面包屑 -->
    <div class="max-w-7xl mx-auto px-6 mb-8 relative z-10">
      <a 
        href="/#digital" 
        class="inline-flex items-center gap-2 text-slate-400 hover:text-[#38BDF8] text-xs font-bold transition-colors group"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>返回数字商品库</span>
      </a>
    </div>

    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 relative z-10">
      
      <!-- 左栏：商品规格与购买面板 -->
      <div class="lg:col-span-5 space-y-6">
        <div class="glass-card p-6 md:p-8 rounded-3xl border border-[#38BDF8]/25 bg-[#0B0F1A]/90 shadow-2xl relative space-y-6">
          <div>
            <span class="px-3 py-1 text-[10px] font-mono font-bold uppercase tracking-wider rounded-full bg-[#0284C7]/20 text-[#38BDF8] border border-[#38BDF8]/40">
              {product.category}
            </span>
            <h1 class="text-2xl md:text-3xl font-black text-white tracking-tight leading-tight mt-4">
              {product.name.replace(/【渠道\d+】/g, "").replace(/【凭证充足】/g, "").replace(/--24小时自助充值plus会员/g, "").replace(/-24小时自助充值pro会员/g, "").trim()}
            </h1>
            <div class="flex items-center gap-4 mt-3 font-mono">
              <span class="text-xs text-slate-500">ID: {cleanId}</span>
              <span id="product-stock-badge" class="text-[10px] font-bold uppercase tracking-wider bg-[#0284C7]/20 text-[#38BDF8] px-2.5 py-0.5 rounded-full border border-[#38BDF8]/30">
                现货库存: {product.stock}
              </span>
            </div>
          </div>

          <!-- SKU 规格选择区 -->
          <div class="space-y-3">
            <span class="text-xs uppercase text-slate-400 tracking-wider font-bold block font-mono">选择套餐规格</span>
            <div class="grid grid-cols-1 gap-2.5" id="sku-options-container">
            </div>
          </div>

          <!-- 数量选择器 -->
          <div class="flex items-center justify-between bg-[#06080F] p-4 rounded-2xl border border-white/10">
            <div>
              <span class="text-xs font-bold text-white block">购买数量</span>
              <span id="sku-stock-display" class="text-[11px] text-slate-400 font-mono">可拍件数: -</span>
            </div>
            <div class="flex items-center border border-white/15 rounded-xl overflow-hidden bg-[#0B0F1A] text-sm font-bold">
              <button type="button" id="qty-minus" class="px-3.5 py-1.5 hover:bg-white/10 text-white font-bold select-none cursor-pointer">-</button>
              <input type="number" id="qty-input" class="w-10 text-center bg-transparent border-none text-white focus:outline-none font-mono" value="1" min="1" readonly />
              <button type="button" id="qty-plus" class="px-3.5 py-1.5 hover:bg-white/10 text-white font-bold select-none cursor-pointer">+</button>
            </div>
          </div>

          <!-- 价格与加购 (纯人民币结算) -->
          <div class="pt-6 border-t border-white/10 flex items-center justify-between gap-4">
            <div class="flex flex-col">
              <span class="text-[10px] text-slate-400 uppercase font-mono font-bold">合计结算</span>
              <div class="flex items-baseline gap-2">
                <span id="final-total-cny" class="text-2xl md:text-3xl font-black text-[#38BDF8] font-mono drop-shadow-[0_0_10px_rgba(56,189,248,0.4)]">¥0</span>
              </div>
            </div>
            <button 
              id="add-to-bag-btn" 
              type="button" 
              class="flex-grow sm:flex-grow-0 px-8 py-3.5 rounded-xl bg-gradient-to-r from-[#0284C7] to-[#38BDF8] text-white font-extrabold uppercase tracking-wider text-xs shadow-[0_0_20px_rgba(56,189,248,0.4)] hover:brightness-110 active:scale-95 transition flex items-center justify-center gap-2 cursor-pointer"
            >
              <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span>加入结算清单</span>
            </button>
          </div>

        </div>
      </div>

      <!-- 右栏：商品富文本图文说明 + 统一售后保障政策 -->
      <div class="lg:col-span-7 space-y-6">
        <div class="glass-card p-6 md:p-8 rounded-3xl border border-[#38BDF8]/25 bg-[#0B0F1A]/90 shadow-2xl relative min-h-[450px]">
          <h2 class="text-sm font-bold text-white uppercase tracking-wider border-b border-white/10 pb-3 mb-6 flex items-center gap-2 font-mono">
            <svg class="w-4 h-4 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>商品详情与使用须知</span>
          </h2>
          
          <!-- 深度净化后的详情展示区 -->
          <div class="text-slate-200 leading-relaxed space-y-4 select-text text-xs md:text-sm max-w-none break-words custom-product-content" id="product-description-content">
            <Fragment set:html={cleanIntroduce || '<p class="text-slate-400">该商品为独享现货，下单后凭卡密直接登录使用。</p>'} />
          </div>

          <!-- 统一植入 Soul Society 售后服务与保障条款 -->
          <div class="mt-8 pt-6 border-t border-[#38BDF8]/20 space-y-4 font-mono">
            <div class="p-5 rounded-2xl bg-[#06080F]/80 border border-[#38BDF8]/30 space-y-3">
              <div class="text-[#38BDF8] font-black text-sm flex items-center gap-2">
                <svg class="w-4 h-4 text-[#38BDF8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span>Soul Society 售后服务与保障条款</span>
              </div>
              <div class="space-y-2 text-slate-300 leading-relaxed text-xs">
                <p><strong class="text-white">【首登质保】：</strong>独享一手资源，付款后系统自动发货。请在收到卡密后 24 小时内完成首次登录验证，首登出现密码错误或封禁无条件更换。</p>
                <p><strong class="text-white">【使用规范】：</strong>请使用干净独立的纯净网络环境登录，严禁短时间内频繁更换节点及设备，因用户个人网络触发官方风控不在质保范围。</p>
                <p><strong class="text-white">【修改密保】：</strong>首登成功后，请根据站内使用指引及时修改密码并绑定个人辅助邮箱/手机号，确保资产永久归您个人掌控。</p>
                <p><strong class="text-white">【自助查单】：</strong>所有订单永久存档于安全数据库中。您可随时通过顶栏「订单查询」凭下单时填写的电子邮箱一键提取全部历史卡密与配置教程。</p>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <CartDrawer />
  <Footer />
</BaseLayout>

<style is:global>
  .custom-product-content,
  .custom-product-content * {
    background-color: transparent !important;
    color: #E2E8F0 !important;
    border-color: rgba(56, 189, 248, 0.18) !important;
  }
  .custom-product-content div,
  .custom-product-content section {
    background-color: rgba(6, 8, 15, 0.6) !important;
    border: 1px solid rgba(56, 189, 248, 0.18) !important;
    border-radius: 1rem !important;
    padding: 1rem !important;
    margin-bottom: 0.85rem !important;
  }
  .custom-product-content h1,
  .custom-product-content h2,
  .custom-product-content h3,
  .custom-product-content h4,
  .custom-product-content strong,
  .custom-product-content b {
    color: #FFFFFF !important;
    font-weight: 800 !important;
  }
  .custom-product-content a {
    color: #38BDF8 !important;
    text-decoration: underline !important;
  }
</style>

<script>
  let product: any = null;
  let selectedSku: any = null;
  let selectedQuantity = 1;

  const skuContainer = document.getElementById('sku-options-container');
  const qtyInput = document.getElementById('qty-input') as HTMLInputElement;
  const qtyMinus = document.getElementById('qty-minus');
  const qtyPlus = document.getElementById('qty-plus');
  const stockDisplay = document.getElementById('sku-stock-display');
  const stockBadge = document.getElementById('product-stock-badge');
  const addToBagBtn = document.getElementById('add-to-bag-btn');

  function initPage() {
    const contextEl = document.getElementById('product-page-context');
    if (!contextEl) return;

    try {
      product = JSON.parse(contextEl.getAttribute('data-product') || '{}');
    } catch {
      return;
    }

    if (!product) return;

    const skusList = getSkusList();
    renderSkus();

    if (skuContainer) {
      const availableBtns = skuContainer.querySelectorAll('.sku-select-btn');
      if (availableBtns.length > 0) {
        const firstIdx = parseInt(availableBtns[0].getAttribute('data-sku-index') || '0');
        selectSku(skusList[firstIdx]);
      }
    }

    qtyMinus?.addEventListener('click', () => {
      if (selectedQuantity > 1) {
        selectedQuantity -= 1;
        updateQtyDisplay();
      }
    });

    qtyPlus?.addEventListener('click', () => {
      let maxStock = 9999;
      if (selectedSku && !isNaN(parseInt(selectedSku.stock))) {
        maxStock = parseInt(selectedSku.stock);
      }
      if (selectedQuantity < maxStock) {
        selectedQuantity += 1;
        updateQtyDisplay();
      }
    });

    addToBagBtn?.addEventListener('click', () => {
      if (!product || !selectedSku) return;

      const size = selectedSku.name !== 'Default Option' ? selectedSku.name : '';
      const cartItemId = `${product.id}_${selectedSku.id}`;

      let currentCart: any[] = [];
      try {
        currentCart = JSON.parse(localStorage.getItem('cart') || '[]');
      } catch {
        currentCart = [];
      }

      const existingIndex = currentCart.findIndex((i: any) => i.cartItemId === cartItemId);
      if (existingIndex > -1) {
        currentCart[existingIndex].quantity += selectedQuantity;
      } else {
        currentCart.push({
          cartItemId,
          id: product.id,
          name: product.name,
          priceCny: Math.round(selectedSku.price_cny),
          priceUsd: Math.ceil(selectedSku.price_cny / 7.2),
          image: selectedSku.picture || product.image,
          type: 'digital',
          size: size,
          quantity: selectedQuantity
        });
      }

      localStorage.setItem('cart', JSON.stringify(currentCart));
      window.dispatchEvent(new CustomEvent('cart-updated'));
      window.dispatchEvent(new CustomEvent('open-cart'));
    });
  }

  function getSkusList() {
    if (!product) return [];
    let list = product.skus || [];
    if (list.length === 0) {
      list = [{
        id: 'sku_default',
        name: '默认标准配置',
        price_cny: product.price_cny,
        price_usd: product.price_usd,
        stock: product.stock,
        picture: product.image
      }];
    }
    return list;
  }

  function renderSkus() {
    if (!skuContainer || !product) return;
    const skusList = getSkusList();

    skuContainer.innerHTML = skusList.map((sku: any, index: number) => {
      const isOutOfStock = sku.stock === '0' || sku.stock === '缺货';
      const isSelected = selectedSku && selectedSku.id === sku.id;
      const cnyVal = Math.round(sku.price_cny);

      return `
        <button
          type="button"
          class="sku-select-btn p-3.5 rounded-2xl border text-left flex items-center justify-between transition-all duration-200 group cursor-pointer ${
            isOutOfStock 
              ? 'opacity-40 pointer-events-none border-white/10 bg-black/40' 
              : isSelected
                ? 'bg-[#0284C7]/25 border-[#38BDF8] text-white shadow-[0_0_15px_rgba(56,189,248,0.2)]'
                : 'border-white/10 bg-[#06080F] text-slate-300 hover:border-white/30 hover:bg-white/[0.03]'
          }"
          data-sku-index="${index}"
        >
          <div>
            <span class="text-xs font-bold ${isSelected ? 'text-[#38BDF8]' : 'text-white'} block">${sku.name}</span>
            <span class="text-[10px] text-slate-500 font-mono">库存: ${sku.stock} 件</span>
          </div>
          <div class="text-right">
            <span class="text-sm font-black font-mono ${isSelected ? 'text-[#38BDF8]' : 'text-white'}">¥${cnyVal}</span>
          </div>
        </button>
      `;
    }).join('');

    const btnElements = skuContainer.querySelectorAll('.sku-select-btn');
    btnElements.forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-sku-index') || '0');
        selectSku(skusList[idx]);
      });
    });
  }

  function selectSku(sku: any) {
    selectedSku = sku;
    renderSkus();
    if (stockDisplay) stockDisplay.textContent = `现货库存: ${sku.stock} 件`;
    if (stockBadge) stockBadge.textContent = `现货库存: ${sku.stock}`;
    updateQtyDisplay();
  }

  // 精准映射 final-total-cny，解决详情页 0 元 Bug
  function updateQtyDisplay() {
    if (qtyInput) qtyInput.value = selectedQuantity.toString();
    const totalCnyEl = document.getElementById('final-total-cny');
    if (!selectedSku || !totalCnyEl) return;

    const totalCny = Math.round(selectedSku.price_cny) * selectedQuantity;
    totalCnyEl.textContent = `¥${totalCny}`;
  }

  initPage();
</script>
