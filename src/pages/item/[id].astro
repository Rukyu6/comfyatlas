---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CartDrawer from '../../components/CartDrawer.astro';

// Dynamic route paths generator for all 716 products
export async function getStaticPaths() {
  const data = (await import('../../data/products.json')).default;
  return data.products.map((p) => {
    const cleanId = p.id.replace('pid_', '');
    return {
      params: { id: cleanId },
      props: { product: p }
    };
  });
}

const { product } = Astro.props;
const cleanId = product.id.replace('pid_', '');
---
<BaseLayout 
  title={`${product.name} — Digital Account Vault`} 
  description={`Purchase ${product.name} from ComfyAtlas Store. Safe delivery, manual blockchain validation, premium digital account vault.`}
>
  <!-- Global navigation Header -->
  <Header />

  <!-- Hidden context element to pass server-side product data to client script safely -->
  <div id="product-page-context" class="hidden" data-product={JSON.stringify(product)}></div>

  <div class="relative min-h-screen pt-28 pb-16 overflow-hidden bg-[#0B0B0C] text-[#E4E4E7]">
    <!-- Ambient Background Glows -->
    <div class="absolute top-1/4 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-[#C5A880]/5 rounded-full filter blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 translate-x-1/2 translate-y-1/2 w-[400px] h-[400px] bg-emerald-500/5 rounded-full filter blur-[100px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 mb-8 relative z-10">
      <a 
        href="/#digital" 
        class="inline-flex items-center gap-2 text-zinc-400 hover:text-white font-outfit uppercase tracking-wider text-xs font-bold transition-colors group"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to digital vault
      </a>
    </div>

    <!-- Product Grid Content -->
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 relative z-10">
      
      <!-- Left Side: Product Image & Buying Panel -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Premium Product Panel -->
        <div class="glass-card p-6 md:p-8 rounded-3xl border border-white/5 bg-zinc-900/10 shadow-2xl relative space-y-6">
          
          <!-- Category & Title -->
          <div>
            <span class="px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              {product.category}
            </span>
            <h1 class="text-2xl md:text-3xl font-extrabold font-outfit text-white tracking-tight leading-tight mt-4">
              {product.name}
            </h1>
            <div class="flex items-center gap-4 mt-3">
              <span class="text-xs text-zinc-500">ID: {cleanId}</span>
              <span id="product-stock-badge" class="text-[10px] font-bold uppercase tracking-wider bg-zinc-800 text-zinc-400 px-2 py-0.5 rounded border border-zinc-700">
                Stock: {product.stock}
              </span>
            </div>
          </div>

          <!-- SKU Selection Grid -->
          <div class="space-y-3">
            <span class="text-xs uppercase text-zinc-400 tracking-wider font-semibold block">Select Option / Package</span>
            <div class="grid grid-cols-1 gap-3" id="sku-options-container">
              <!-- Dynamically generated via JS -->
            </div>
          </div>

          <!-- Quantity Selector -->
          <div class="flex items-center justify-between bg-black/40 p-4 rounded-2xl border border-white/5">
            <div>
              <span class="text-sm font-bold text-white block">Quantity</span>
              <span id="sku-stock-display" class="text-xs text-zinc-500">In stock: -</span>
            </div>
            <div class="flex items-center border border-white/10 rounded-xl overflow-hidden bg-black/20 text-sm">
              <button type="button" id="qty-minus" class="px-4 py-2 hover:bg-white/5 text-zinc-400 hover:text-white font-bold select-none">-</button>
              <input type="number" id="qty-input" class="w-12 text-center bg-transparent border-none text-white focus:outline-none font-outfit" value="1" min="1" readonly />
              <button type="button" id="qty-plus" class="px-4 py-2 hover:bg-white/5 text-zinc-400 hover:text-white font-bold select-none">+</button>
            </div>
          </div>

          <!-- Total price & Purchase Button -->
          <div class="pt-6 border-t border-white/5 flex items-center justify-between gap-4">
            <div class="flex flex-col">
              <span class="text-xs text-zinc-500 uppercase font-bold font-outfit">Total price</span>
              <div class="flex items-baseline gap-2">
                <span id="total-usd" class="text-3xl font-black text-[#C5A880]">$0.00</span>
                <span id="total-cny" class="text-xs text-zinc-500">¥0 CNY</span>
              </div>
            </div>
            <button 
              id="add-to-bag-btn" 
              type="button" 
              class="flex-grow sm:flex-grow-0 px-8 py-4 rounded-xl bg-white hover:bg-[#C5A880] hover:text-black text-black font-bold uppercase tracking-wider text-sm font-outfit transition-all duration-300 shadow-lg active:scale-95 flex items-center justify-center gap-2"
            >
              Add to Bag
            </button>
          </div>

        </div>

      </div>

      <!-- Right Side: Rich Description tab -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Product Details Display -->
        <div class="glass-card p-6 md:p-10 rounded-3xl border border-white/5 bg-zinc-900/10 shadow-2xl relative min-h-[400px]">
          <h2 class="text-xs uppercase text-zinc-400 tracking-wider font-semibold border-b border-white/5 pb-3 mb-6">
            Product Details & Instructions
          </h2>
          <div class="text-zinc-300 leading-relaxed space-y-4 select-text prose-dark text-sm max-w-none break-words" id="product-description-content">
            <Fragment set:html={product.introduce || '<p class="text-zinc-500 italic">No instructions or description details are available for this product.</p>'} />
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- Global shopping cart slide-over -->
  <CartDrawer />

  <!-- Global Footer -->
  <Footer />
</BaseLayout>

<script>
  let product = null;
  let selectedSku = null;
  let selectedQuantity = 1;

  // DOM elements
  const skuContainer = document.getElementById('sku-options-container');
  const qtyInput = document.getElementById('qty-input') as HTMLInputElement;
  const qtyMinus = document.getElementById('qty-minus');
  const qtyPlus = document.getElementById('qty-plus');
  const totalUsd = document.getElementById('total-usd');
  const totalCny = document.getElementById('total-cny');
  const stockDisplay = document.getElementById('sku-stock-display');
  const stockBadge = document.getElementById('product-stock-badge');
  const addToBagBtn = document.getElementById('add-to-bag-btn');

  function initPage() {
    const contextEl = document.getElementById('product-page-context');
    if (!contextEl) return;

    try {
      product = JSON.parse(contextEl.getAttribute('data-product') || '{}');
    } catch (e) {
      console.error('Failed to parse product data', e);
      return;
    }

    if (!product) return;

    // Load SKUs list
    let skusList = product.skus || [];
    if (skusList.length === 0) {
      skusList = [{
        id: 'sku_default',
        name: 'Default Option',
        price_cny: product.price_cny,
        price_usd: product.price_usd,
        stock: product.stock,
        picture: product.image
      }];
    }

    // Render SKU buttons
    if (skuContainer) {
      skuContainer.innerHTML = skusList.map((sku, index) => {
        const isOutOfStock = sku.stock === '0' || sku.stock === '缺货';
        return `
          <button
            type="button"
            class="sku-select-btn p-4 rounded-2xl border text-left flex flex-col justify-between transition-all duration-300 font-outfit group ${
              isOutOfStock 
                ? 'opacity-40 pointer-events-none border-zinc-950 bg-zinc-950/20' 
                : 'border-zinc-800 bg-zinc-900/40 hover:border-[#C5A880]/30 hover:bg-zinc-900'
            }"
            data-sku-index="${index}"
          >
            <span class="text-sm font-bold text-white group-hover:text-[#C5A880] transition-colors leading-tight mb-2">${sku.name}</span>
            <div class="flex items-baseline justify-between w-full mt-auto">
              <span class="text-xs font-semibold text-[#C5A880]">$${sku.price_usd.toFixed(2)}</span>
              <span class="text-[9px] text-zinc-500">Stock: ${sku.stock}</span>
            </div>
          </button>
        `;
      }).join('');

      // Auto-select first active SKU
      const availableBtns = skuContainer.querySelectorAll('.sku-select-btn');
      if (availableBtns.length > 0) {
        selectSku(skusList[parseInt(availableBtns[0].getAttribute('data-sku-index'))], availableBtns[0]);
      }

      // Hook click listeners
      availableBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-sku-index') || '0');
          selectSku(skusList[idx], btn);
        });
      });
    }

    // Hook quantity handlers
    qtyMinus?.addEventListener('click', () => {
      if (selectedQuantity > 1) {
        selectedQuantity -= 1;
        updateQtyDisplay();
      }
    });

    qtyPlus?.addEventListener('click', () => {
      let maxStock = 9999;
      if (selectedSku && !isNaN(parseInt(selectedSku.stock))) {
        maxStock = parseInt(selectedSku.stock);
      }
      if (selectedQuantity < maxStock) {
        selectedQuantity += 1;
        updateQtyDisplay();
      }
    });

    // Add to cart click
    addToBagBtn?.addEventListener('click', () => {
      if (!product || !selectedSku) return;

      const size = selectedSku.name !== 'Default Option' ? selectedSku.name : '';
      const cartItemId = `${product.id}_${selectedSku.id}`;

      window.dispatchEvent(new CustomEvent('cart:add', {
        detail: {
          cartItemId,
          id: product.id,
          name: product.name,
          price: selectedSku.price_usd,
          image: selectedSku.picture || product.image,
          type: 'digital',
          size: size,
          quantity: selectedQuantity
        }
      }));
    });
  }

  function selectSku(sku, btnElement) {
    selectedSku = sku;
    selectedQuantity = 1; // Reset quantity

    // Highlights
    const allBtns = skuContainer?.querySelectorAll('.sku-select-btn');
    allBtns?.forEach(b => {
      b.classList.remove('border-[#C5A880]', 'bg-[#C5A880]/5', 'glow-gold');
      b.classList.add('border-zinc-800', 'bg-zinc-900/40');
    });

    btnElement.classList.remove('border-zinc-800', 'bg-zinc-900/40');
    btnElement.classList.add('border-[#C5A880]', 'bg-[#C5A880]/5', 'glow-gold');

    // Update Stock Display
    if (stockDisplay) stockDisplay.textContent = `In stock: ${sku.stock}`;
    if (stockBadge) stockBadge.textContent = `Stock: ${sku.stock}`;

    updateQtyDisplay();
  }

  function updateQtyDisplay() {
    if (qtyInput) qtyInput.value = selectedQuantity.toString();
    if (!selectedSku || !totalUsd || !totalCny) return;

    const usdPrice = selectedSku.price_usd * selectedQuantity;
    const cnyPrice = selectedSku.price_cny * selectedQuantity;

    totalUsd.textContent = `$${usdPrice.toFixed(2)}`;
    totalCny.textContent = `¥${cnyPrice.toFixed(0)} CNY`;
  }

  initPage();
</script>
